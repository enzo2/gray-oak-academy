<%
  payload_type =
    if resource.applet&.persisted? || (resource.applet.present? && (resource.applet.title.present? || resource.applet.code.present?))
      "applet"
    elsif resource.file.attached?
      "file"
    elsif resource.content.present?
      "text"
    elsif resource.uri.present?
      category_value = resource.category.to_s.downcase
      if category_value.include?("video")
        "video"
      elsif category_value.include?("image")
        "image"
      else
        "url"
      end
    else
      "text"
    end
  payload_locked = resource.applet&.persisted? || (resource.persisted? && resource.file.attached?)
%>
<%= form_with(model: [:admin, resource], id: "resource-form", data: { controller: "embed-checker resource-form", resource_form_initial_type_value: payload_type, resource_form_payload_locked_value: payload_locked }) do |form| %>
  <% if resource.errors.any? %>
    <div class="mb-4 text-red-950 dark:text-red-300" role="alert">
      <h2 class="font-bold mb-2"><%= pluralize(resource.errors.count, "error") %> prohibited this resource from being saved:</h2>
      <ul class="list-disc list-inside">
        <% resource.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%# If lesson_plan is present, include it so the resource can be linked %>
  <% if local_assigns[:lesson_plan] %>
    <%= form.hidden_field :lesson_plan_id, value: lesson_plan.id %>
  <% end %>

  <p class="text-sm text-dim mb-4">
    <b>Resources</b> provide verified content for lessons, like multimedia, applets, documents, web links, or real-world items.<br>
    You can add videos URLs and other websites, images, PDFs, or plain text. To reference external resources (eg. software, book, person), just describe it.<br>
    For interactive applets, <%= link_to "ask the LLM", conversations_path, class: "underline" %>. 
  </p>

  <% tag_owner = resource.teacher || current_user %>
  <%# If this resource already has an associated persisted applet, lock category to "Applet" %>
  <% if resource.applet&.persisted? %>
    <div class="mb-4">
      <%= form.label :category, "Category", class: "form-label" %>
      Applet
      <%= form.hidden_field :category, value: "Applet" %>
    </div>
  <% else %>
    <div class="mb-4">
      <%= form.label :category, "Category (optional)", class: "form-label" %>
      <% category_options = Resource.distinct_categories_for(tag_owner) %>
      <%= form.combobox :category,
                        category_options,
                        free_text: true,
                        placeholder: "Select or enter category",
                        data: {
                          resource_form_target: "categoryInput",
                          action: "input->resource-form#categoryChanged change->resource-form#categoryChanged hw-combobox:selection->resource-form#categoryChanged hw-combobox:clear->resource-form#categoryChanged"
                        } %>
    </div>
  <% end %>

  <div class="mb-4">
    <%= form.label :description, class: "form-label" %>
    <%= form.text_area :description, rows: 4, class: "input-primary", required: true %>
  </div>

  <% tag_options = Resource.distinct_tags_for(tag_owner) %>
  <div class="mb-4">
    <%= form.label :tags, "Tags (optional)", class: "form-label" %>
    <%= form.combobox :tags,
                      tag_options,
                      free_text: true,
                      multiselect_chip_src: tag_chips_admin_resources_path,
                      placeholder: "Add tags..." %>
    <p class="text-sm text-dim mt-1">Type a tag and press Enter to add it. Tags are saved in lowercase.</p>
  </div>

  <div class="mb-4">
    <%= label_tag :resource_form_type, "Resource Type", class: "form-label" %>
    <%= select_tag :resource_form_type,
                   options_for_select([ [ "File", "file" ], [ "Website", "url" ], [ "Video", "video" ], [ "Image", "image" ], [ "Applet", "applet" ], [ "Text", "text" ] ], payload_type),
                   class: "input-primary w-full px-2 py-1.5 md:px-3 md:py-2",
                   disabled: payload_locked,
                   data: { resource_form_target: "typeSelect", action: "change->resource-form#changeType" } %>
    <% if resource.file.attached? %>
      <p class="text-sm text-dim mt-1">This resource already has a file attached. Delete the file first to switch types.</p>
    <% end %>
  </div>

  <hr class="hr-primary mb-2">

  <% unless resource.applet&.persisted? %>
    <div class="mb-4 <%= [ 'url', 'video', 'image' ].include?(payload_type) ? '' : 'hidden' %>" data-resource-form-target="urlSection">
      <div class="mb-2">
        <%= form.label :uri, "URL", class: "form-label", data: { resource_form_target: "urlLabel" } %>
        <%= form.url_field :uri, class: "input-primary" %>
      </div>

      <p class="text-sm text-dim mb-4 <%= (payload_type == 'url' || payload_type == 'video') ? '' : 'hidden' %>" data-resource-form-target="urlEmbedHelp">
        Sites must allow embedding to be shown on the chalkboard. Otherwise, the student will need to visit in a new tab.<br>
        Use this <sl-button outline size="small" data-action="click->embed-checker#openDialog">embed checker</sl-button> to verify.<br>
        For YouTube, you can paste a standard URL; it will be auto-converted to the embed URL.
      </p>
      <p class="text-sm text-dim mb-4 <%= payload_type == 'image' ? '' : 'hidden' %>" data-resource-form-target="urlImageHelp">
        Use a direct image URL (for example ending in .png, .jpg, or .webp). Embed checking is not required for images.
      </p>
      <sl-dialog style="--width: min(90vw, 800px);" class="<%= (payload_type == 'url' || payload_type == 'video') ? '' : 'hidden' %>" data-resource-form-target="embedDialogWrapper" data-embed-checker-target="dialog" label="Embed checker">
          <p>Make sure the site loads correctly. Many sites do not allow embedding.</p>
          <iframe title="Embed Checker" width="100%" height="600px" style="border: 1px solid #ccc;" data-embed-checker-target="embedCheckerIframe"></iframe>
      </sl-dialog>
    </div>
  <% end %>

  <% unless resource.applet&.persisted? %>
    <div class="mb-4 <%= payload_type == 'file' ? '' : 'hidden' %>" data-resource-form-target="fileSection">
      <p class="text-sm text-dim mb-2">
        PDFs can be viewed directly on the chalkboard. Other file types will appear as downloadable links.
      </p>
      <% if resource.file.attached? && resource.file.persisted? %>
        <%= form.label :file, "Current File", class: "form-label" %>
        <%= link_to resource.file.filename, rails_blob_path(resource.file, disposition: "attachment") %>
        <%= link_to delete_file_admin_resource_path(resource),
                    class: "inline-block",
                    data: {
                      turbo_method: :delete,
                      turbo_confirm: "Are you sure you want to delete this file?"
                    } do %>
          <sl-icon name="trash"></sl-icon>
        <% end %>
      <% else %>
        <%= form.label :file, "File", class: "form-label" %>
        <%= form.file_field :file, class: "input-primary" %>
      <% end %>
    </div>
  <% end %>

  <div class="mb-4 <%= payload_type == 'applet' ? '' : 'hidden' %>" data-resource-form-target="appletSection">
    <% applet = resource.applet || resource.build_applet(user: current_user) %>
    <% lesson_context_id = local_assigns[:lesson_plan]&.lesson_id %>
    <p class="text-sm text-dim mb-1">
      <i>Use chat to generate or revise compatible applets, then save them as resources.</i>
    </p>
    <% if applet.persisted? %>
      <p class="text-sm text-dim mb-2">
        <%= link_to "Revise this applet in chat",
            conversations_path(
              starter_template: "applet_revision",
              applet_id: applet.id,
              resource_id: resource.id,
              lesson_id: lesson_context_id
            ),
            data: { turbo_method: :post },
            class: "underline" %>
      </p>
    <% else %>
      <p class="text-sm text-dim mb-2">
        <%= link_to "Start a chat for applet creation",
            conversations_path,
            data: { turbo_method: :post },
            class: "underline" %>
      </p>
    <% end %>
    <%= form.fields_for :applet, applet do |applet_form| %>
      <%= applet_form.label :title, "Applet Title (for JavaScript applets)", class: "form-label" %>
      <%= applet_form.text_field :title, class: "input-primary mb-2" %>

      <%= applet_form.label :code, "Applet Code", class: "form-label" %>
      <%= applet_form.text_area :code, rows: 5, class: "input-primary font-mono text-xs", placeholder: "Due to special requirements, only use applets generated by LLM in this app." %>
    <% end %>
  </div>

  <div class="mb-4 <%= payload_type == 'text' ? '' : 'hidden' %>" data-resource-form-target="textSection">
    <p class="text-sm text-dim">
      Use this for quotations, excerpts, short instructions, and notes that do not need a URL, file, or applet.
    </p>
    <div class="mt-2">
      <%= form.label :content, "Text Content (optional)", class: "form-label" %>
      <%= form.text_area :content, rows: 5, class: "input-primary", placeholder: "Useful for quotations, excerpts, instructions, or short notes." %>
    </div>
  </div>

  <hr class="hr-primary my-2">

  <div class="mb-4 flex items-center justify-start">
    <%= form.check_box :include_by_default, class: "mr-2 checkbox-primary" %>
    <%= form.label :include_by_default, "Include by default on new lesson plans", class: "form-label" %>
  </div>

  <div class="flex items-center justify-between mb-4">
    <%= form.submit class: "btn-primary" %>
  </div>
<% end %>
