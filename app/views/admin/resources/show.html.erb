<h1 class="text-2xl font-bold mb-4">Resource Details</h1>

<div class="space-y-4">
  <div>
    <i>Category</i>
    <br>
    <%= @resource.category %>
  </div>

  <div>
    <i>Description</i>
    <br>
    <%= @resource.description %>
  </div>

  <div>
    <i>Text Content</i>
    <br>
    <%= @resource.content.presence || "No text content." %>
  </div>

  <div>
    <i>Approval</i>
    <br>
    <%= @resource.approved == false ? "Pending" : (@resource.approved == true ? "Approved (LLM-created)" : "Human-created") %>
    <% if @resource.approved == false %>
      <br>
      <%= button_to "Approve", approve_admin_resource_path(@resource), method: :patch, class: "btn-success mt-2" %>
    <% end %>
  </div>

  <div>
    <i>Tags</i>
    <br>
    <% if @resource.tags.any? %>
      <div class="mt-1 flex flex-wrap gap-1">
        <% @resource.tags.each do |tag| %>
          <span class="inline-flex items-center rounded-full bg-stone-200 px-2 py-0.5 text-[0.7rem] font-medium text-stone-700 dark:bg-stone-700 dark:text-stone-100"><%= tag %></span>
        <% end %>
      </div>
    <% else %>
      No tags.
    <% end %>
  </div>

  <div>
    <i>URI:</i>
    <br>
    <% if @resource.uri.present? %>
      <!-- Brakeman: URI is validated in the model and link text is escaped -->
      <%= link_to sanitize(@resource.uri_for_direct_visit), sanitize(@resource.uri_for_direct_visit, tags: []), target: "_blank", rel: "noopener noreferrer" %>
    <% else %>
      No URI provided.
    <% end %>
  </div>

  <div>
    <i>Attached File:</i>
    <br>
    <% if @resource.file.attached? %>
      <div class="flex items-center justify-baseline space-x-2 py-1">
        <%= link_to @resource.file.filename, rails_blob_path(@resource.file, disposition: "attachment") %>
        <%= button_to delete_file_admin_resource_path(@resource),
          method: :delete,
          data: { confirm: "Are you sure you want to delete this file?" },
          class: "hover:text-red-500 flex items-center" do %>
          <sl-icon name="trash"></sl-icon>
        <% end %>
      </div>
    <% else %>
      No attached file.
    <% end %>
  </div>

  <div>
    <i>Applet Code:</i>
    <br>
    <% if @resource.applet&.code.present? %>
      <details>
        <summary class="cursor-pointer hover:underline">View Applet Code (<%= @resource.applet.title %>)</summary>
        <% for_syntax_highlighting = "```js\n#{@resource.applet.code}\n```" %>
        <div class="bg-(--rouge-bg) text-xs p-2 max-h-[200px] overflow-y-auto">
          <%= markdown(for_syntax_highlighting) %>
        </div>
      </details>
    <% else %>
      No applet provided.
    <% end %>
  </div>

  <div>
    <i>Linked to Lesson Plans:</i>
    <br>
    <% if @resource.lesson_plans.any? %>
      <ul class="[&_li]:pl-3">
        <% @resource.lesson_plans.each do |lesson_plan| %>
          <li><%= link_to lesson_plan.lesson.title, admin_course_lesson_path(lesson_plan.lesson.course, lesson_plan.lesson), class: "hover:underline" %></li>
        <% end %>
      </ul>
    <% else %>
      Not linked to any lesson plans.
    <% end %>
  </div>
</div>

<div class="mt-6 flex items-center gap-2">
  <%= link_to 'Edit', edit_admin_resource_path(@resource), class: 'btn-primary' %>
  <%= button_to "Delete",
                admin_resource_path(@resource),
                method: :delete,
                data: { turbo_confirm: "Delete this resource?" },
                class: "btn-danger" %>
  <%= link_to 'Back', admin_resources_path, class: 'btn-secondary' %>
</div>
