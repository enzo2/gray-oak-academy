<h1 class="text-2xl font-bold mb-4">Resource Details</h1>

<div class="space-y-4">
  <div>
    <i>Category</i>
    <br>
    <%= @resource.category %>
  </div>

  <div>
    <i>Description</i>
    <br>
    <%= @resource.description %>
  </div>

  <div>
    <i>Text Content</i>
    <br>
    <%= @resource.content.presence || "No text content." %>
  </div>

  <div id="resource-approval">
    <i>Approval</i>
    <br>
    <%= @resource.approved == false ? "Pending" : (@resource.approved == true ? "Approved (LLM-created)" : "Human-created") %>
    <% if @resource.approved == false %>
      <br>
      <%= button_to "Approve", approve_admin_resource_path(@resource), method: :patch, class: "btn-success mt-2", data: { turbo_stream: true } %>
    <% end %>
  </div>

  <div>
    <i>Tags</i>
    <br>
    <% if @resource.tags.any? %>
      <div class="mt-1 flex flex-wrap gap-1">
        <% @resource.tags.each do |tag| %>
          <span class="inline-flex items-center rounded-full bg-stone-200 px-2 py-0.5 text-[0.7rem] font-medium text-stone-700 dark:bg-stone-700 dark:text-stone-100"><%= tag %></span>
        <% end %>
      </div>
    <% else %>
      No tags.
    <% end %>
  </div>

  <div>
    <i>URI:</i>
    <br>
    <% if @resource.uri.present? %>
      <!-- Brakeman: URI is validated in the model and link text is escaped -->
      <%= link_to sanitize(@resource.uri_for_direct_visit), sanitize(@resource.uri_for_direct_visit, tags: []), target: "_blank", rel: "noopener noreferrer" %>
      <div id="uri-check-result" class="mt-2">
        <%= button_to "Check Chalkboard embeddability", check_uri_admin_resource_path(@resource), method: :post, class: "btn-secondary", data: { turbo_stream: true } %>
      </div>
    <% else %>
      No URI provided.
    <% end %>
  </div>

  <div>
    <i>Attached File:</i>
    <br>
    <% if @resource.file.attached? %>
      <div class="flex items-center justify-baseline space-x-2 py-1">
        <%= link_to @resource.file.filename, rails_blob_path(@resource.file, disposition: "attachment") %>
        <%= button_to delete_file_admin_resource_path(@resource),
          method: :delete,
          data: { confirm: "Are you sure you want to delete this file?" },
          class: "flex items-center hover:text-danger-500" do %>
          <sl-icon name="trash"></sl-icon>
        <% end %>
      </div>
    <% else %>
      No attached file.
    <% end %>
  </div>

  <div>
    <i>Applet Preview:</i>
    <br>
    <% if @resource.applet.present? %>
      <% lesson_context_id = @resource.lesson_plans.first&.lesson_id %>
      <div class="mt-2">
        <%= link_to "Open Applet Preview",
                    run_applet_path(@resource.applet),
                    target: "_blank",
                    rel: "noopener noreferrer",
                    class: "btn-secondary" %>
        <%= link_to "Revise in Chat",
                    conversations_path(
                      starter_template: "applet_revision",
                      applet_id: @resource.applet.id,
                      resource_id: @resource.id,
                      lesson_id: lesson_context_id
                    ),
                    data: { turbo_method: :post },
                    class: "btn-secondary ml-2" %>
      </div>
      <div class="mt-3 overflow-hidden rounded border border-stone-300 bg-white dark:border-stone-700 dark:bg-stone-900">
        <iframe
          src="<%= run_applet_path(@resource.applet) %>"
          title="Applet Preview"
          sandbox="<%= Applet::SANDBOX_ATTRIBUTE %>"
          class="w-full min-h-[500px]"
          loading="lazy">
        </iframe>
      </div>
    <% else %>
      No applet provided.
    <% end %>
  </div>

  <div>
    <i>Applet Code:</i>
    <br>
    <% if @resource.applet&.code.present? %>
      <details>
        <summary class="cursor-pointer hover:underline">View Applet Code (<%= @resource.applet.title %>)</summary>
        <% for_syntax_highlighting = "```js\n#{@resource.applet.code}\n```" %>
        <div class="bg-(--rouge-bg) text-xs p-2 max-h-[200px] overflow-y-auto">
          <%= markdown(for_syntax_highlighting) %>
        </div>
      </details>
    <% else %>
      No applet provided.
    <% end %>
  </div>

  <div>
    <i>Linked to Lesson Plans:</i>
    <br>
    <% if @resource.lesson_plans.any? %>
      <ul class="[&_li]:pl-3">
        <% @resource.lesson_plans.each do |lesson_plan| %>
          <li><%= link_to lesson_plan.lesson.title, edit_admin_course_lesson_lesson_plan_path(lesson_plan.lesson.course, lesson_plan.lesson), class: "hover:underline" %></li>
        <% end %>
      </ul>
    <% else %>
      Not linked to any lesson plans.
    <% end %>
  </div>
</div>

<div class="mt-6 flex items-center gap-2">
  <%= link_to 'Edit', edit_admin_resource_path(@resource), class: 'btn-primary' %>
  <%= button_to "Delete",
                admin_resource_path(@resource),
                method: :delete,
                data: { turbo_confirm: "Delete this resource?" },
                class: "btn-danger" %>
  <%= link_to 'Back', admin_resources_path, class: 'btn-secondary' %>
</div>
