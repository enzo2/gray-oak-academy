<tr id="<%= dom_id(resource) %>" class="border-b border-stone-600 dark:border-stone-400 [&_td]:px-2 [&_td]:py-3">
  <td class=" text-left"><%= resource.category %></td>
  <td class="text-center"><%= truncate(resource.description, length: 150) %></td>
  <td class="text-center"><%= resource.include_by_default? ? 'Yes' : 'No' %></td>
  <td class="text-right">
    <div class="flex items-center justify-end gap-1">
      <%= link_to admin_resource_path(resource), class: 'btn-table-action' do %>
        <sl-icon name="eye"></sl-icon>
        View
      <% end %>
      <%= link_to edit_admin_resource_path(resource), class: 'btn-table-action' do %>
        <sl-icon name="pencil"></sl-icon>
        Edit
      <% end %>
      <%= button_to admin_resource_path(resource), method: :delete, data: { turbo_confirm: 'Are you sure?' }, class: 'btn-table-danger' do %>
        <sl-icon name="trash"></sl-icon>
        Delete
      <% end %>
    </div>
  </td>
</tr>
