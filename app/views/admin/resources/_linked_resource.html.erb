<div id="linked-<%= dom_id(resource) %>" class="flex space-x-2 items-center p-1 my-1 bg-stone-200 dark:bg-stone-700">
  <% if resource.approved == false %>
    <%= link_to delete_resource_admin_course_lesson_lesson_plan_path(lesson_plan.lesson.course, lesson_plan.lesson, resource_id: resource.id),
                data: { turbo_method: :delete, turbo_confirm: "Delete this resource from the library and all lesson plans?" },
                class: "ml-1 flex items-center text-danger-700 hover:text-danger-900",
                title: "Delete resource" do %>
      <sl-icon name="trash"></sl-icon>
    <% end %>
  <% else %>
    <%= link_to unlink_resource_admin_course_lesson_lesson_plan_path(lesson_plan.lesson.course, lesson_plan.lesson, resource_id: resource.id),
                data: { turbo_method: :delete },
                class: "ml-1 flex items-center text-danger-600 hover:text-danger-800",
                title: "Unlink resource" do %>
      <sl-icon name="file-earmark-minus"></sl-icon>
    <% end %>
  <% end %>
  <div class="flex flex-col">
    <% resource_label = [resource.category, resource.description].compact_blank.join(" - ") %>
    <% resource_href =
         if resource.applet.present?
           run_applet_path(resource.applet)
         elsif resource.file.attached?
           rails_blob_path(resource.file, disposition: "inline")
         elsif resource.uri.present?
           resource.uri_for_direct_visit
         else
           admin_resource_path(resource)
         end %>
    <% opens_direct_payload = resource.applet.present? || resource.file.attached? || resource.uri.present? %>
    <%= link_to resource_label,
                resource_href,
                class: "hover:underline text-stone-900 dark:text-stone-100 hover:text-stone-700 dark:hover:text-stone-200",
                target: (opens_direct_payload ? "_blank" : nil),
                rel: (opens_direct_payload ? "noopener noreferrer" : nil) %>
    <% if resource.applet.present? %>
      <span class="text-xs text-stone-500 dark:text-stone-400">
        <%= link_to "View details",
                    admin_resource_path(resource),
                    class: "underline hover:text-stone-700 dark:hover:text-stone-200" %>
      </span>
    <% end %>
    <% if resource.approved == false %>
      <span class="text-xs text-warning-700 dark:text-warning-300">
        Pending approval
        <%= link_to "Approve",
          approve_admin_resource_path(resource, lesson_plan_id: lesson_plan.id),
          data: { turbo_method: :patch, turbo_stream: true },
          class: "ml-2 text-success-700 underline dark:text-success-300" %>
      </span>
    <% end %>
    <% if resource.tags.any? %>
      <div class="mt-1 flex flex-wrap gap-1">
        <% resource.tags.each do |tag| %>
          <span class="inline-flex items-center rounded-full bg-stone-300 px-2 py-0.5 text-[0.65rem] font-medium text-stone-700 dark:bg-stone-600 dark:text-stone-100"><%= tag %></span>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
