<% if @resource.persisted? %>
  <% if @lesson_plan %>
    <%# Request is coming from the lesson plan edit form. %>
    <%= turbo_stream.append "linked-resources", partial: "admin/resources/linked_resource", locals: { resource: @resource, lesson_plan: @lesson_plan } %>
    <%= turbo_stream.remove "available-resource-#{@resource.id}" %>
  <% else %>
    <%# Not yet implemented. New Resource uses new.html.erb. %>
    <%#= turbo_stream.prepend "resources-table", partial: "admin/resources/resource", locals: { resource: @resource } %>
  <% end %>
<% else %>
  <%= turbo_stream.update "new_resource_form", partial: "admin/resources/form", locals: { resource: @resource } %>
<% end %>