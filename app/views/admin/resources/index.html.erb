<h1 class="text-2xl font-bold mb-4">Resources</h1>

<div class="mb-4">
  <%= link_to new_admin_resource_path, class: 'btn-primary' do %>
    <sl-icon name="plus-lg"></sl-icon>
    New Resource
  <% end %>
</div>

<div class="mb-4 min-w-0" data-controller="resource-filter">
  <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-3 mb-3">
    <div class="w-full lg:max-w-md">
      <label for="resource_search" class="block text-sm font-semibold text-stone-700 dark:text-stone-200 mb-1">Search</label>
      <%= text_field_tag :resource_search, "", placeholder: "Search resources...", class: "input-primary w-full px-2 py-1.5 md:px-3 md:py-2", data: { action: "input->resource-filter#filterResources", resource_filter_target: "searchInput" } %>
    </div>
    <% tag_filter_options = Resource.most_used_tags_for(current_user, limit: 20) %>
    <% category_filter_options = Resource.distinct_categories_for(current_user) %>
    <div class="w-full lg:max-w-md">
      <div class="grid grid-cols-2 gap-2 md:gap-3">
        <div class="w-full">
          <label for="resource_category_filter" class="block text-sm font-semibold text-stone-700 dark:text-stone-200 mb-1">Category</label>
          <%= select_tag :resource_category_filter,
                         options_for_select([["All categories", ""]] + category_filter_options.map { |category| [category, category] }),
                         class: "input-primary w-full px-2 py-1.5 md:px-3 md:py-2",
                         data: { action: "change->resource-filter#filterResources", resource_filter_target: "categorySelect" } %>
        </div>
        <div class="w-full">
          <label for="resource_tag_filter" class="block text-sm font-semibold text-stone-700 dark:text-stone-200 mb-1">Tag</label>
          <%= select_tag :resource_tag_filter,
                         options_for_select([["All tags", ""]] + tag_filter_options.map { |tag| [tag, tag] }),
                         class: "input-primary w-full px-2 py-1.5 md:px-3 md:py-2",
                         data: { action: "change->resource-filter#filterResources", resource_filter_target: "tagSelect" } %>
        </div>
      </div>
    </div>
  </div>

  <div class="w-full min-w-0">
    <div class="hidden md:grid min-w-0 items-end
                md:grid-cols-[minmax(0,1.2fr)_minmax(0,2.8fr)_minmax(0,0.8fr)_minmax(0,1fr)]
                gap-3 border-b border-stone-800 dark:border-stone-200 py-2 font-bold">
      <div>Category</div>
      <div>Description</div>
      <div class="text-center">Include by default</div>
      <div class="text-right">Actions</div>
    </div>

    <div id="resources-table-body" class="min-w-0">
      <% if @resources.any? %>
        <%= render @resources %>
        <div data-resource-filter-target="emptyState" class="hidden py-4 px-6 text-center border-t border-stone-600 dark:border-stone-400">
          No resources match your search.
        </div>
      <% else %>
        <div id="no_resources" class="py-4 px-6 text-center border-b border-stone-600 dark:border-stone-400">
          No resources added.
        </div>
      <% end %>
    </div>
  </div>
</div>
