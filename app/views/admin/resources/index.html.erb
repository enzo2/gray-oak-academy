<h1 class="text-2xl font-bold mb-4">Resources</h1>

<div class="mb-4">
  <%= link_to new_admin_resource_path, class: 'btn-primary' do %>
    <sl-icon name="plus-lg"></sl-icon>
    New Resource
  <% end %>
</div>

<div class="mb-4" data-controller="resource-filter">
  <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-3 mb-3">
    <div class="w-full md:max-w-md">
      <label for="resource_search" class="block text-sm font-semibold text-stone-700 dark:text-stone-200 mb-1">Search</label>
      <%= text_field_tag :resource_search, "", placeholder: "Search resources...", class: "input-primary w-full", data: { action: "input->resource-filter#filterResources" } %>
    </div>
  </div>

  <div class="w-full">
    <div class="hidden md:grid items-end
                md:grid-cols-[minmax(0,1.2fr)_minmax(0,2.8fr)_minmax(0,0.7fr)_minmax(0,0.7fr)]
                lg:grid-cols-[minmax(12rem,1.2fr)_minmax(20rem,2.8fr)_minmax(10rem,0.7fr)_minmax(10rem,0.7fr)]
                gap-3 border-b border-stone-800 dark:border-stone-200 py-2 font-bold">
      <div>Category</div>
      <div>Description</div>
      <div class="text-center">Include by default</div>
      <div class="text-right">Actions</div>
    </div>

    <div id="resources-table-body">
      <% if @resources.any? %>
        <%= render @resources %>
        <div data-resource-filter-target="emptyState" class="hidden py-4 px-6 text-center border-t border-stone-600 dark:border-stone-400">
          No resources match your search.
        </div>
      <% else %>
        <div id="no_resources" class="py-4 px-6 text-center border-b border-stone-600 dark:border-stone-400">
          No resources added.
        </div>
      <% end %>
    </div>
  </div>
</div>
