<%= form_with(model: [:admin, prompt], id: "prompts-form") do |form| %>
  <% if prompt.errors.any? %>
    <div class=" text-red-700 dark:text-red-300 px-4 py-3 mb-4" role="alert">
      <h2><%= pluralize(prompt.errors.count, "error") %> prohibited this prompt from being saved:</h2>
      <ul>
        <% prompt.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-4">
    <%= form.label :title, class: "form-label mb-2" %>
    <%= form.text_field :title, class: "form-input" %>
  </div>

  <div class="mb-4">
    <%= form.label :category, class: "form-label mb-2" %>
    <%= form.collection_select :category, Prompt.category_options, :first, :last, { include_blank: "Select a category", selected: nil }, { class: "form-select" } %>
  </div>

  <div class="mb-4">
    <%= form.label :prompt, class: "form-label mb-2" %>
    <%= form.text_area :prompt, rows: 10, class: "form-input" %>
  </div>

  <div class="flex items-center justify-between">
    <%= form.submit class: "btn-primary" %>
    <%= link_to "Cancel", admin_prompts_path, class: "inline-block align-baseline font-bold text-sm text-blue-500 hover:text-blue-800" %>
  </div>
<% end %>