<div class="grid grid-cols-[1fr_1fr_4fr_1fr] auto-rows-auto gap-4 py-2 items-center border-b" id="<%= dom_id(prompt) %>">
    <div class="text-left"><%= prompt.friendly_category_name %></div>
    <div class="text-left"><%= prompt.title %></div>
    <div class="text-left text-sm font-mono whitespace-pre-wrap" ><%= truncate(prompt.prompt, length: 200) %></div>
    <pre class="hidden" id="<%= dom_id(prompt) %>_text"><%= prompt.prompt %></pre>
    <div class="text-right">
      <div class="flex justify-end space-x-2">
        <% if prompt.teacher.present? %>
          <%= link_to "Edit", edit_admin_prompt_path(prompt), 
            class: "btn-secondary py-1 px-2 text-sm font-bold text-warning-800 hover:bg-warning-100 dark:text-warning-300 dark:hover:bg-warning-950" %>
          <%= button_to "Delete", admin_prompt_path(prompt), method: :delete, 
            class: "btn-danger py-1 px-2 text-sm font-bold", 
            data: { turbo_confirm: "Are you sure you want to delete this prompt?" } %>
        <% else %> 
          <%# Base system prompts cannot be deleted, but superusers can edit them. %>
          <sl-copy-button from="<%= dom_id(prompt) %>_text"></sl-copy-button>
          <% if current_user.role_superuser? %>
            <%= link_to "Edit", edit_admin_prompt_path(prompt), 
              class: "btn-secondary flex items-center px-2 py-1 text-sm font-bold text-forest-800 hover:bg-forest-100 dark:text-forest-300 dark:hover:bg-forest-950" %>
          <% end %>
        <% end %>
      </div>
    </div>
</div>
