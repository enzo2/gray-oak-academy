<%= turbo_frame_tag dom_id(prompt) do %>
<div class="grid grid-cols-[1fr_1fr_4fr_1fr] auto-rows-auto gap-4 py-2 items-center">
    <div class="text-left"><%= prompt.friendly_category_name %></div>
    <div class="text-left"><%= prompt.title %></div>
    <div class="text-left whitespace-normal break-words"><%= prompt.prompt %></div>
    <div class="text-right">
      <div class="flex justify-end space-x-2">
        <%= link_to "Edit", edit_admin_prompt_path(prompt), 
          class: "bg-yellow-500 hover:bg-yellow-700 text-white font-bold py-1 px-2 rounded text-sm", 
          data: { turbo_frame: "dashboard-content" } %>
        <%= button_to "Delete", admin_prompt_path(prompt), method: :delete, 
          class: "bg-red-500 hover:bg-red-700 text-white font-bold py-1 px-2 rounded text-sm", 
            data: { turbo_confirm: "Are you sure you want to delete this prompt?" } %>
      </div>
    </div>
</div>
<% end %>
