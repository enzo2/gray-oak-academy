 <div class="flex min-h-[calc(100dvh-2.5rem)]">
  <!-- Sidebar -->
  <aside class="w-52 border-r border-gray-400 px-4 pt-4">
    <h2 class="font-bold text-lg mb-4">Teacher Dashboard</h2>
    <nav>
      <ul>
        <li class="mb-2">
          <%= link_to "Course Manager", admin_courses_path, class: "hover:underline", data: { turbo_frame: "dashboard-content" } %>
        </li>
        <li class="mb-2">
          <%= link_to "Resources", admin_resources_path, class: "hover:underline", data: { turbo_frame: "dashboard-content" } %>
        </li>
        <li class="mb-2">
          <%= link_to "Students", admin_students_path, class: "hover:underline", data: { turbo_frame: "dashboard-content" } %>
        </li>
        <li class="mb-2">
          <%= link_to "Prompts", admin_prompts_path, class: "hover:underline", data: { turbo_frame: "dashboard-content" } %>
        </li>
        <li class="mb-2">
          <%= link_to "Tools", admin_tools_path, class: "hover:underline", data: { turbo_frame: "dashboard-content" } %>
        </li>
        <li class="mb-2">
          <%= link_to "LLM Chat", conversations_path, class: "hover:underline", data: { turbo_frame: "dashboard-content" } %>
        </li>
        <li class="mb-2">
          <%= link_to "Applets", applets_path, class: "hover:underline", data: { turbo_frame: "dashboard-content" } %>
        </li>
        <li class="mb-2">
          <%= link_to "Usage", admin_completions_path, class: "hover:underline", data: { turbo_frame: "dashboard-content" } %>
        </li>
        <!-- Add more sidebar items here -->
      </ul>
    </nav>
  </aside>

  <!-- Main content -->
  <main class="flex-1 px-4 pt-4">

    <%= turbo_stream_from "teacher-dashboard" %>

    <%= turbo_frame_tag "dashboard-content" do %>
      <p class="mb-4">Select a section from the sidebar.</p>
    <% end %>
  </main>
</div>
