<!DOCTYPE html>
<html>
<head>
  <title><%= @course.title %> - Printable Lessons</title>
  <style>
    body { font-family: Arial, sans-serif; }
    table { width: 100%; border-collapse: collapse; }
    th, td { border: 1px solid #ddd; padding: 8px; }
    th { background-color: #f2f2f2; }
  </style>
</head>
<body>
  <div class="printable-lessons">
    <h1><%= @course.title %> - Lessons</h1>
    <table class="w-full border-collapse">
      <thead>
        <tr class="border-b border-gray-800">
          <th class="py-2 px-3 text-left">#</th>
          <th class="py-2 px-3 text-left">Title</th>
          <th class="py-2 px-3 text-left">Goals</th>
          <th class="py-2 px-3 text-center">Duration (min)</th>
        </tr>
      </thead>
      <tbody>
        <% @course.lessons.each do |lesson| %>
          <tr class="border-b border-gray-600">
            <td class="py-2 px-3"><%= lesson.position %></td>
            <td class="py-2 px-3"><%= lesson.title %></td>
            <td class="py-2 px-3"><%= lesson.goals %></td>
            <td class="py-2 px-3 text-center"><%= lesson.approx_duration_min %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</body>
</html>