<%= turbo_frame_tag "lesson-form" do %>
  <div class="px-6 my-6 border-l border-gray-500">
    <h2 class="text-2xl font-bold mb-4">New Lesson</h2>
    <%= form_with(model: [:admin, @course, @lesson], local: true) do |f| %>
      <div class="mb-4">
        <%= f.label :title, class: "form-label" %>
        <%= f.text_field :title, class: "form-input" %>
      </div>

      <div class="mb-4">
        <%= f.label :goals, class: "form-label" %>
        <%= f.text_area :goals, class: "form-input" %>
      </div>

      <div class="mb-4">
        <%= f.label :approx_duration_min, "Approximate Duration (minutes)", class: "form-label" %>
        <%= f.number_field :approx_duration_min, class: "form-input" %>
      </div>

      <div class="flex items-center justify-between">
        <%= f.submit "Create Lesson", class: "btn-primary" %>
        <%= link_to "Cancel", admin_course_lessons_path(@course), class: "btn-primary" %>
      </div>
    <% end %>
  </div>
<% end %>