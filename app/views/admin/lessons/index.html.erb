<div class="flex flex-row justify-between">
  <%= link_to "Back to Courses", admin_courses_path, class: "block mb-4 hover:underline" %>
  <div class="flex flex-wrap items-center gap-2 mb-4">
    <% if @course.outline_guidance_report_present? %>
      <%= link_to outline_research_input_admin_course_path(@course, anchor: "guidance-report"), class: "btn-secondary" do %>
        <sl-icon name="file-earmark-richtext"></sl-icon>
        View Guidance Report
      <% end %>
    <% end %>
    <sl-button href="<%= printable_admin_course_lessons_path(@course) %>" target="_blank">
      <sl-icon slot="prefix" name="file-earmark-text"></sl-icon>
      Printable View
    </sl-button>
  </div>
</div>

<h2 class="text-2xl mb-5 block">Lessons for: <b> <%= @course.title %></b></h2>

<div class="mb-5">
  <div class="flex flex-wrap items-center gap-3 mb-2">
    <%= turbo_frame_tag Lesson.new do %>
      <%= link_to new_admin_course_lesson_path(@course), class: "btn-primary" do %>
        <sl-icon name="plus-lg"></sl-icon>
        New Lesson
      <% end %>
    <% end %>

    <% if @course.outline.present? %>
      <%= render "admin/lessons/generate_lessons_button", course: @course %>
    <% end %>
  </div>

  <div id="generate-lessons-info">
    <% if @course.outline.blank? %>
      <p class="text-sm italic">To generate the lessons via LLM, the <%= link_to "course outline", edit_admin_course_path(@course), class: "underline" %> must be filled in.</p>
    <% elsif @course.lessons.present? %>
      <p class="text-sm text-stone-500 dark:text-stone-400 italic">Generating more lessons will leave the existing lessons intact.</p>
    <% end %>
  </div>
</div>

<div class="w-full mt-4">
  <div class="hidden md:grid items-end
              md:grid-cols-[minmax(0,1.5fr)_minmax(0,3.4fr)_minmax(0,0.6fr)_minmax(0,0.5fr)]
              lg:grid-cols-[minmax(14rem,1.5fr)_minmax(18rem,3.4fr)_minmax(0,0.6fr)_minmax(11rem,0.5fr)]
              gap-3 border-b border-stone-800 dark:border-stone-200 py-2 font-bold">
    <div class="text-left">Title</div>
    <div class="text-left">Goals</div>
    <div class="text-center">Lesson Plan</div>
    <div class="text-right">Actions</div>
  </div>
  <div id="lessons-table-body">
    <%= render "lessons_table", course: @course %>
  </div>
</div>

<br>
