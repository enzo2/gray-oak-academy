<div class="flex flex-col items-center justify-center">
  <% unless lesson.first? %>
    <%= link_to move_higher_admin_course_lesson_path(lesson.course, lesson),
      data: { turbo_method: :patch },
      class: "flex items-center justify-center w-6 h-6 text-stone-500 hover:text-stone-900 dark:text-stone-400 dark:hover:text-stone-100 transition-colors" do %>
      <sl-icon name="chevron-up" class="text-lg"></sl-icon>
    <% end %>
  <% else %>
    <div class="w-6 h-6"></div>
  <% end %>
  
  <span class="text-xs font-bold text-stone-500 dark:text-stone-400 leading-none py-0.5 w-6 text-center"><%= lesson.position %></span>
  
  <% unless lesson.last? %>
    <%= link_to move_lower_admin_course_lesson_path(lesson.course, lesson),
      data: { turbo_method: :patch },
      class: "flex items-center justify-center w-6 h-6 text-stone-500 hover:text-stone-900 dark:text-stone-400 dark:hover:text-stone-100 transition-colors" do %>
      <sl-icon name="chevron-down" class="text-lg"></sl-icon>
    <% end %>
  <% else %>
    <div class="w-6 h-6"></div>
  <% end %>
</div>
