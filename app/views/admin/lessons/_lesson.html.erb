<tr id="<%= dom_id(lesson) %>" class="border-b border-stone-600 dark:border-stone-400">
  <td class="">
    <div class="flex flex-col items-center">
      <% unless lesson.first? %>
        <%= button_to move_higher_admin_course_lesson_path(lesson.course, lesson), 
          method: :patch, class: "[&_sl-icon-button::part(base)]:p-0 ", 
          data: { turbo_stream: true } do %>
          <sl-icon-button name="chevron-up" class="[&::part(base)]:transform [&::part(base)]:-translate-y-[-2px]"></sl-icon-button>
        <% end %>
      <% else %><div class="h-[18px]"></div><% end %>
      <span class=""><%= lesson.position %></span>
      <% unless lesson.last? %>
        <%= button_to move_lower_admin_course_lesson_path(lesson.course, lesson),
          method: :patch, class: "[&_sl-icon-button::part(base)]:p-0", 
          data: { turbo_stream: true } do %>
          <sl-icon-button name="chevron-down" class="[&::part(base)]:transform [&::part(base)]:-translate-y-[-2px]"></sl-icon-button>
        <% end %>
      <% else %><div class="h-[18px]"></div><% end %>
    </div>
  </td>
  <td class="py-2 px-3"><%= lesson.title %></td>
  <td class="py-2 px-3"><%= truncate(lesson.goals, length: 500) %></td>
  <td class="py-2 px-3 text-center"><%= lesson.approx_duration_min %></td>
  <td class="py-2 px-3 text-center">
  <%= link_to edit_admin_course_lesson_lesson_plan_path(lesson.course, lesson), class: "flex items-center justify-center hover:underline", data: { turbo_stream: true } do %>
    <span class="">
      <% if lesson.lesson_plan.present? %>
        <%= lesson.lesson_plan.status.titleize %>
      <% else %>
        <%= "None" %>
      <% end %>
    </span>
    <sl-icon-button name="pencil-square" size="medium" label="Edit Lesson Plan"></sl-icon-button>
    <% end %>
  </td>
  <td class="py-2 px-3 text-right [&_a:hover]:underline">
    <%= link_to "Edit", edit_admin_course_lesson_path(lesson.course, lesson), class: "inline-block mr-2", data: { turbo_stream: true } %>
    <%= button_to "Delete", admin_course_lesson_path(lesson.course, lesson), 
          method: :delete, 
          class: "inline-block mr-2 hover:underline", 
          data: { 
            turbo_confirm: "Are you sure? This will delete the associated lesson plan too." 
          } %>
  </td>
</tr>