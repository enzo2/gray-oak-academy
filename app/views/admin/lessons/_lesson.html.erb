<tr id="<%= dom_id(lesson) %>" class="border-b border-gray-600 dark:border-gray-400">
  <td class="py-2 px-3"><%= lesson.title %></td>
  <td class="py-2 px-3"><%= truncate(lesson.goals, length: 50) %></td>
  <td class="py-2 px-3 text-center"><%= lesson.approx_duration_min %></td>
  <td class="py-2 px-3 text-right [&_a:hover]:underline">
    <%= link_to "Edit", edit_admin_course_lesson_path(@course, lesson), class: "inline-block mr-2", data: { turbo_stream: true } %>
    <%= button_to "Delete", admin_course_lesson_path(@course, lesson), method: :delete, class: "inline-block mr-2 hover:underline", data: { turbo_confirm: "Are you sure you want to delete this lesson?" } %>
    <%= link_to "Edit Lesson Plan", edit_admin_course_lesson_lesson_plan_path(lesson.course, lesson), class: "inline-block", data: { turbo_stream: true  } %>
  </td>
</tr>