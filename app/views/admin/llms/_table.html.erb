<% if @llms&.any? %>
  <div class="overflow-x-auto">
    <table class="table-auto">
      <thead>
      <tr class="bg-stone-50 dark:bg-stone-900">
        <th class="px-2 py-1 text-left">Model</th>
        <th class="px-2 py-1 text-left">Provider <span class="font-normal">(✅=Shared)<span></th>
        <th class="px-2 py-1 text-right">Audio Input</th>
        <th class="px-2 py-1 text-right">Image Input</th>
        <th class="px-2 py-1 text-right">Image Output</th>
        <th class="px-2 py-1 text-right">Actions</th>
      </tr>
      </thead>
      <tbody>
        <% @llms.each_with_index do |llm, idx| %>
          <% supported_api = @supported_apis_map[llm.api_provider] %>
          <tr class="<%= idx.odd? ? 'bg-stone-200 dark:bg-stone-700' : '' %>">
            <td class="px-2 py-1">
              <%= llm.model %>
              <%= content_tag(:span, " (Archived)", class: "text-xs text-dim ml-1") if llm.archived? %>
            </td>
            <td class="px-2 py-1">
              <% if supported_api %>
                <%= link_to llm.api_provider, edit_admin_supported_api_path(supported_api), class: "hover:underline underline-offset-4" %>
                <%= link_to "✅", edit_admin_supported_api_path(supported_api), class: "ml-2 no-underline", title: "Shared API" %>
              <% else %>
                <%= llm.api_provider %>
              <% end %>
            </td>
            <td class="px-2 py-1 text-right">
              <% if current_user.role_superuser? && !llm.archived? %>
                <%= form_with(model: llm, url: admin_llm_path(llm), method: :patch, data: { turbo_stream: true }) do |f| %>
                  <%= f.check_box :supports_audio_input,
                        {
                          checked: llm.supports_audio_input,
                          data: {
                            controller: "auto-submit-toggle",
                            action: "auto-submit-toggle#submit"
                          },
                          class: "checkbox-primary",
                          id: "llm_#{llm.id}_supports_audio_input"
                        } %>
                <% end %>
              <% else %>
                <%= case llm.supports_audio_input? when true then "Yes" when false then "No" else "" end %>
              <% end %>
            <td class="px-2 py-1 text-right">
              <%= case llm.supports_image_input? when true then "Yes" when false then "No" else "" end %>
            </td>
            <td class="px-2 py-1 text-right">
              <%= case llm.supports_image_output? when true then "Yes" when false then "No" else "" end %>
            </td>
            <td class="px-2 py-1 text-right">
              <% if llm.archived? %>
                <%= button_to unarchive_admin_llm_path(llm), method: :patch, class: "text-xs btn-secondary", title: "Unarchive" do %>
                  <sl-icon name="arrow-counterclockwise"></sl-icon>
                <% end %>
              <% else %>
                <%= button_to archive_admin_llm_path(llm), method: :patch, data: { turbo_confirm: "Archive this LLM? It will be hidden from all selections." }, class: "text-xs btn-secondary", title: "Archive" do %>
                  <sl-icon name="archive"></sl-icon>
                <% end %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <p class="text-sm text-dim">No LLM models found for the current filters.</p>
<% end %>
