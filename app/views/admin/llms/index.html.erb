<div class="flex items-center justify-between mb-4">
  <h2 class="text-xl font-semibold">LLMs</h2>
</div>

<p class="mb-4 text-sm text-dim">
  Verified LLMs are shown on a per-API basis. If an API has been <%= link_to "added for teachers to use", admin_supported_apis_path, class: 'underline' %>, a checkbox is shown.<br>
  When using a shared API, teachers can only use models that have been verified. To add another model, verify it from the API dashboard or just chat with it.<br>
  To disallow a model from being used by teachers, archive it, or don't add it to start with. (Teachers can still use a personal API key with any provider/model.)<br>
  Please set whether raw audio input is supported for each model.
</p>

<%= form_with url: admin_llms_path, method: :get, local: true, class: "mb-4 flex flex-wrap items-end gap-2" do %>
  <div>
    <label class="form-label">Provider</label>
    <%= select_tag :provider,
      options_for_select(@providers, @provider),
      include_blank: "All providers",
      class: "input-primary pr-10" %>
  </div>

  <div>
    <label class="form-label">Model contains</label>
    <%= text_field_tag :q, @q, class: "input-primary" %>
  </div>

  <div class="flex items-center gap-4 mb-3">
    <div class="flex items-center gap-2">
      <%= radio_button_tag :archived, "", !params[:archived].present?, id: "archived_false", class: "radio-primary" %>
      <label for="archived_false" class="text-sm cursor-pointer">Active</label>
    </div>
    <div class="flex items-center gap-2">
      <%= radio_button_tag :archived, "1", params[:archived].present?, id: "archived_true", class: "radio-primary" %>
      <label for="archived_true" class="text-sm cursor-pointer">Archived</label>
    </div>
  </div>

  <div class="mb-1">
    <%= submit_tag "Filter", class: "btn-primary" %>
    <%= link_to "Clear Filters", admin_llms_path, class: "btn-secondary ml-2" %>
  </div>
<% end %>

<div id="llms_table">
  <%= render partial: "table" %>
</div>

<p class="text-dim text-xs mt-2">
  Image capability is only shown for OpenRouter.<br>
  Audio capability is automatically updated for OpenRouter. For other APIs, you must set manually (eg. Google OpenAI-compatible API).
</p>
