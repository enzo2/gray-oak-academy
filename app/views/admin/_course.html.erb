<div id="<%= dom_id(course) %>" class="bg-white shadow rounded-lg p-6 mb-4">
  <h3 class="text-xl font-semibold mb-2"><%= course.title %></h3>
  <p class="text-gray-600 mb-2"><%= course.summary %></p>
  <p class="text-sm text-gray-500 mb-2">Grade Level: <%= course.grade_level %></p>
  <div class="flex justify-between items-center">
    <%= link_to "Edit", edit_admin_course_path(course), class: "text-blue-500 hover:text-blue-700", data: { turbo_frame: "course-form" } %>
    <%= button_to "Delete", admin_course_path(course), method: :delete, class: "text-red-500 hover:text-red-700", data: { turbo_confirm: "Are you sure you want to delete this course?" } %>
    <%= link_to "View Lessons", admin_course_lessons_path(course), class: "text-green-500 hover:text-green-700", data: { turbo_frame: "lessons" } %>
  </div>
</div>