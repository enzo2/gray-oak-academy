<h1 class="text-2xl font-semibold mb-4">App Settings</h1>

<h2 class="text-xl font-semibold mb-2">
  Speech
  <% if AppSetting.speech_configured? || AppSetting.stt_configured? %>
    <sl-icon name="check-circle-fill" class="text-green-500 inline-block ml-2 align-middle text-lg"></sl-icon>
  <% end %>
</h2>

<%= form_with(model: @setting, url: admin_app_setting_path, method: :patch, class: "space-y-4") do |f| %>
  <% if @setting.errors.any? %>
    <div class="mb-4 text-red-700 dark:text-red-300">
      <%= pluralize(@setting.errors.count, "error") %> prevented saving:
      <ul class="list-disc list-inside">
        <% @setting.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :provider_supported_api_id, "Speech API Provider", class: "form-label" %>
    <%= f.collection_select :provider_supported_api_id, 
      SupportedApi.order(:api_base_uri), :id, :api_base_uri, 
      { include_blank: "Select a provider" }, { class: "form-select-primary" } %>
    <p class="text-xs text-dim mt-1">
      Choose which API will be used for TTS/STT. This must be OpenAI Speech endpoint compatible (<code>/audio/speech</code>).
    </p>
  </div>

  <div>
    <%= f.label :token_override, "Speech API token (override)", class: "form-label" %>
    <%= f.password_field :token_override, value: (@setting.token_override.present? ? AppSetting::MASKED_SECRET_VALUE : nil), class: "input-primary", autocomplete: "new-password", placeholder: "Paste token here (optional)" %>
    <p class="text-xs text-dim mt-1">
      When present, this token will be used instead of the provider's shared token for TTS/STT calls. Stored encrypted.
      <% if @setting.provider_supported_api&.api_access_token.present? %>
        <span class="text-green-600 dark:text-green-400">Shared OpenAI key is configured.</span>
      <% end %>
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <div>
      <%= f.label :tts_model, "TTS model", class: "form-label" %>
      <%= f.text_field :tts_model, class: "input-primary", placeholder: "gpt-4o-mini-tts" %>
    </div>

    <div>
      <%= f.label :tts_voice, "TTS voice", class: "form-label" %>
      <%= f.text_field :tts_voice, class: "input-primary", placeholder: "verse" %>
    </div>
  </div>

  <div>
    <%= f.label :tts_instructions, "TTS instructions", class: "form-label" %>
    <%= f.text_area :tts_instructions, class: "input-primary", rows: 1, placeholder: "Speak in a calm and friendly tone." %>
    <p class="text-xs text-dim">Instructions passed to the TTS model when generating speech.</p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-4" data-controller="stt-settings">
    <div>
      <%= f.label :stt_method, "STT method", class: "form-label" %>
      <%= f.select :stt_method,
            [["OpenAI Speech API", "speech"], ["LLM", "chat"]],
            {},
            class: "input-primary",
            data: { action: "change->stt-settings#update", stt_settings_target: "methodSelect" } %>
      <p class="text-xs text-dim mt-1">Choose whether transcriptions use the Speech API, or any audio LLM.</p>
    </div>

    <div data-stt-settings-target="speechWrapper">
      <%= f.label :stt_model, "STT model (Speech API)", class: "form-label" %>
      <%= f.text_field :stt_model,
            value: (@setting&.stt_method == "speech" ? @setting.stt_model : nil),
            class: "input-primary",
            placeholder: "gpt-4o-mini-transcribe",
            data: { stt_settings_target: "speechInput" } %>
      <p class="text-xs text-dim mt-1">OpenAI Speech API model</p>
    </div>

    <div data-stt-settings-target="chatWrapper" class="hidden">
      <%= f.label :stt_model_id, "LLM for transcriptions", class: "form-label" %>
      <% llms = Llm.list_selectable_audio_models %>
      <% groups = llms.group_by { |llm| (URI.parse(llm.api_provider).host rescue llm.api_provider) }.to_a %>
      <%= f.grouped_collection_select :stt_model_id,
            groups,
            :last,
            :first,
            :id,
            :model,
            { include_blank: "Select a model", selected: @setting&.stt_model_id },
            { class: "input-primary", data: { stt_settings_target: "chatInput" } } %>
      <p class="text-xs text-dim mt-1">LLMs supporting audio input can be used for transcription.</p>
    </div>
  </div>

  <h2 class="text-xl font-semibold mb-2 mt-4">
    Image Gen
    <% if AppSetting.image_generation_configured? %>
      <sl-icon name="check-circle-fill" class="text-green-500 inline-block ml-2 align-middle text-lg"></sl-icon>
    <% end %>
  </h2>
  <div>
    <%= f.label :image_llm_id, "Image generation model", class: "form-label" %>
    <% image_llms = Llm.list_selectable_image_models %>
    <% image_groups = image_llms.group_by { |llm| (URI.parse(llm.api_provider).host rescue llm.api_provider) }.to_a %>
    <%= f.grouped_collection_select :image_llm_id,
          image_groups,
          :last,
          :first,
          :id,
          :model,
          { include_blank: "Select a model", selected: @setting&.image_llm_id },
          { class: "input-primary" } %>
    <p class="text-xs text-dim mt-1">
      Only verified OpenRouter models that support image input & output are shown.
    </p>
  </div>

  <div>
    <%= f.label :image_generation_two_pass, class: "flex items-start cursor-pointer" do %>
      <%= f.check_box :image_generation_two_pass, class: "checkbox-primary mt-1 mr-2" %>
      <div>
        <span class="font-medium text-gray-700 dark:text-gray-300">Enable 2-pass generation (critique & regenerate)</span>
        <p class="text-xs text-dim mt-0.5">
          When enabled, the model will critique and regenerate the image to correct errors. Disable for faster generation or if using highly capable models (e.g. Gemini 3 Pro).
        </p>
      </div>
    <% end %>
  </div>

  <h2 class="text-xl font-semibold mb-2 mt-4">
    Embeddings
    <% if AppSetting.embeddings_configured? %>
      <sl-icon name="check-circle-fill" class="text-green-500 inline-block ml-2 align-middle text-lg"></sl-icon>
    <% end %>
  </h2>
    <p class="text-sm text-dim mb-2">Used for app functions like memories.</p>
  <div>
    <%= f.label :embedding_model, "Embedding model", class: "form-label" %>
    <%= f.text_field :embedding_model, class: "input-primary mb-1", placeholder: "google/gemini-embedding-001" %>
    <p class="text-xs text-dim mb-1">
      <b>Instructions:</b> Supports OpenRouter only. Enter an OpenRouter embedding model.<br>
      <% if SupportedApi.find_by(api_base_uri: "https://openrouter.ai/api/v1/")&.api_access_token.present? %>
        <span class="text-green-600 dark:text-green-400">OpenRouter token is configured.</span>
      <% else %>
        <span class="text-red-600 dark:text-red-400">Please add an OpenRouter shared access token in the LLM API settings.</span>
      <% end %> 
    </p>
  </div>

  <h2 class="text-xl font-semibold mt-4 mb-2">
    Cost & Usage Safeguards
  </h2>
  <p class="text-dim text-sm mb-2">Only works when OpenRouter is used.</p>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <div>
      <%= f.label :user_daily_budget, "User Daily Budget ($)", class: "form-label" %>
      <%= f.number_field :user_daily_budget, step: "0.01", class: "input-primary", placeholder: "e.g. 1.00" %>
      <p class="text-xs text-dim mt-1">
        Limit daily API spend per user. Active lessons are allowed to finish unless they exceed the max lesson cost.
      </p>
    </div>

    <div>
      <%= f.label :max_chat_cost, "Max Chat/Lesson Cost ($)", class: "form-label" %>
      <%= f.number_field :max_chat_cost, step: "0.01", class: "input-primary", placeholder: "e.g. 2.00" %>
      <p class="text-xs text-dim mt-1">
        Hard limit for a single conversation or lesson session to prevent runaway usage.
      </p>
    </div>
  </div>

  <h2 class="text-xl font-semibold mt-4 mb-2">
    Background Agent Runs
    <% if AppSetting.openai_agent_enabled? %>
      <sl-icon name="check-circle-fill" class="text-green-500 inline-block ml-2 align-middle text-lg"></sl-icon>
    <% end %>
  </h2>
  <p class="text-dim text-sm mb-2">
    Uses Responses background runs for backend agent tasks (independent of user LLM settings).
  </p>
  <% agent_supported_apis = @setting.openai_agent_supported_apis.order(:api_base_uri) %>
  <% selected_agent_provider_id = @setting.openai_agent_supported_api&.id %>
  <% selected_agent_provider_uri = @setting.openai_agent_supported_api&.api_base_uri.to_s %>
  <div
    data-controller="agent-model-settings"
    data-agent-model-settings-models-path-value="<%= llm_models_admin_app_setting_path %>"
    data-agent-model-settings-provider-uri-map-value="<%= agent_supported_apis.pluck(:id, :api_base_uri).to_h.to_json %>"
  >
    <div>
      <%= f.label :openai_agent_supported_api_id, "Background agent runs provider (OpenAI or xAI)", class: "form-label" %>
      <%= f.collection_select :openai_agent_supported_api_id,
        agent_supported_apis, :id, :api_base_uri,
        { selected: selected_agent_provider_id }, {
          class: "form-select-primary",
          data: {
            action: "change->agent-model-settings#updateModels",
            agent_model_settings_target: "providerSelect"
          }
        } %>
      <p class="text-xs text-dim mt-1">
        Choose the shared provider for background agent runs.
      </p>
    </div>
    <div>
      <%= f.label :openai_agent_model, "Background agent model", class: "form-label" %>
      <%= f.combobox "openai_agent_model",
        "#{llm_models_admin_app_setting_path}?api_uri=#{selected_agent_provider_uri}",
        name_when_new: "app_setting[openai_agent_model]",
        placeholder: "Select or enter model name",
        data: {
          action: "",
          agent_model_settings_target: "modelCombobox"
        } %>
      <p class="text-xs text-dim mt-1">
        Runs are only enabled when this field is set and the selected provider has a shared key.
        <% if @setting.openai_agent_access_token.present? %>
          <span class="text-green-600 dark:text-green-400">Shared provider key is configured.</span>
        <% else %>
          <span class="text-red-600 dark:text-red-400">Add a shared key for OpenAI or xAI in LLM APIs to enable this pipeline.</span>
        <% end %>
      </p>
    </div>
  </div>
  <div class="mt-3">
    <%= f.label :openai_agent_max_tool_turns, "Background run max tool turns", class: "form-label" %>
    <%= f.number_field :openai_agent_max_tool_turns, min: 1, step: 1, class: "input-primary", placeholder: @setting.openai_agent_max_tool_turns %>
    <p class="text-xs text-dim mt-1">
      Caps tool-call loop iterations for Responses background runs (agent jobs).
    </p>
  </div>

  <h2 class="text-xl font-semibold mt-4 mb-2">
    Exa Research
    <% if AppSetting.exa_enabled? %>
      <sl-icon name="check-circle-fill" class="text-green-500 inline-block ml-2 align-middle text-lg"></sl-icon>
    <% end %>
  </h2>
  <p class="text-dim text-sm mb-2">
    Exa search/contents and research APIs for higher-quality web grounding.
  </p>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <div>
      <%= f.label :exa_research_model, "Exa research model", class: "form-label" %>
      <%= f.text_field :exa_research_model, class: "input-primary", placeholder: "exa-research" %>
      <p class="text-xs text-dim mt-1">Use <code>exa-research</code> or <code>exa-research-pro</code>.</p>
    </div>
  </div>

  <div>
    <%= f.label :exa_api_key, "Exa API key", class: "form-label" %>
    <%= f.password_field :exa_api_key, value: (@setting.exa_api_key.present? ? AppSetting::MASKED_SECRET_VALUE : nil), class: "input-primary", autocomplete: "off", placeholder: "Paste EXA key (optional)" %>
    <p class="text-xs text-dim mt-1">
      Stored encrypted. When present, this key is used for Exa calls.
      <% if @setting.exa_api_key.present? %>
        <span class="text-green-600 dark:text-green-400">Exa API key is configured in App Settings.</span>
      <% elsif ENV["EXA_API_KEY"].present? %>
        <span class="text-green-600 dark:text-green-400">Using EXA_API_KEY from environment.</span>
      <% else %>
        <span class="text-red-600 dark:text-red-400">Add an Exa key to enable Exa search/contents/research services.</span>
      <% end %>
    </p>
  </div>

  <% if Rails.env.development? %>
    <div>
      <%= f.label :course_outline_research_stub_enabled, class: "flex items-start cursor-pointer" do %>
        <%= f.check_box :course_outline_research_stub_enabled, class: "checkbox-primary mt-1 mr-2" %>
        <div>
          <span class="font-medium text-gray-700 dark:text-gray-300">Enable outline research stub mode (development only)</span>
          <p class="text-xs text-dim mt-0.5">
            Bypasses real Exa and Responses calls for course outline research runs and uses deterministic stub data.
          </p>
        </div>
      <% end %>
    </div>
  <% end %>

  <div class="mt-6">
    <%= f.submit "Save App Settings", class: "btn-primary" %>
  </div>
  <br>
<% end %>
