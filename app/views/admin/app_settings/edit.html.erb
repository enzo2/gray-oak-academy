<h1 class="text-2xl font-semibold mb-4">App Settings</h1>

<h2 class="text-xl font-semibold mb-2">
  Speech
  <% if AppSetting.speech_configured? || AppSetting.stt_configured? %>
    <sl-icon name="check-circle-fill" class="ml-2 inline-block align-middle text-lg text-success-500"></sl-icon>
  <% end %>
</h2>

<% speech_providers = SupportedApi.speech_providers %>
<% selected_speech_provider_id = @setting.provider_supported_api&.id %>
<% selected_speech_provider_uri = @setting.provider_supported_api&.api_base_uri.to_s %>
<% speech_provider_label_map = speech_providers.to_h do |provider|
  label = case provider.api_base_uri
  when SupportedApi::OPENAI_BASE_URI
    "OpenAI"
  when SupportedApi::OPENROUTER_BASE_URI
    "OpenRouter"
  else
    "provider"
  end
  [ provider.id, label ]
end %>
<% speech_provider_token_map = speech_providers.to_h { |provider| [ provider.id, provider.api_access_token.present? ] } %>
<% selected_speech_provider_label = speech_provider_label_map[selected_speech_provider_id] || "provider" %>

<%= form_with(
      model: @setting,
      url: admin_app_setting_path,
      method: :patch,
      class: "space-y-4",
      data: {
        controller: "stt-settings",
        stt_settings_speech_models_path_value: speech_models_admin_app_setting_path,
        stt_settings_speech_voices_path_value: speech_voices_admin_app_setting_path,
        stt_settings_provider_uri_map_value: speech_providers.pluck(:id, :api_base_uri).to_h.to_json,
        stt_settings_provider_label_map_value: speech_provider_label_map.to_json,
        stt_settings_provider_token_map_value: speech_provider_token_map.to_json
      }
    ) do |f| %>
  <% if @setting.errors.any? %>
    <div class="mb-4 text-danger-700 dark:text-danger-300">
      <%= pluralize(@setting.errors.count, "error") %> prevented saving:
      <ul class="list-disc list-inside">
        <% @setting.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :provider_supported_api_id, "Speech API Provider", class: "form-label" %>
    <%= f.collection_select :provider_supported_api_id, 
      speech_providers, :id, :api_base_uri,
      { include_blank: "Select a provider", selected: selected_speech_provider_id },
      {
        class: "form-select-primary",
        data: {
          action: "change->stt-settings#providerChanged",
          stt_settings_target: "providerSelect"
        }
      } %>
    <p class="text-xs text-dim mt-1">
      Choose which API will be used for TTS/STT. Speech is currently supported through OpenAI or OpenRouter.
    </p>
  </div>

  <div>
    <%= f.label :token_override, "Speech API token (override)", class: "form-label" %>
    <%= f.password_field :token_override, value: (@setting.token_override.present? ? AppSetting::MASKED_SECRET_VALUE : nil), class: "input-primary", autocomplete: "new-password", placeholder: "Paste token here (optional)" %>
    <p class="text-xs text-dim mt-1">
      When present, this token will be used instead of the provider's shared token for TTS/STT calls. Stored encrypted.
      <span
        data-stt-settings-target="sharedTokenHint"
        class="text-success-600 dark:text-success-400 <%= @setting.provider_supported_api&.api_access_token.present? ? "" : "hidden" %>"
      >
        Shared <span data-stt-settings-target="sharedTokenProviderName"><%= selected_speech_provider_label %></span> key is configured.
      </span>
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <div>
      <%= f.label :tts_model, "TTS model", class: "form-label" %>
      <%= f.combobox "tts_model",
            "#{speech_models_admin_app_setting_path}?kind=tts&api_uri=#{selected_speech_provider_uri}",
            name_when_new: "app_setting[tts_model]",
            placeholder: "gpt-4o-mini-tts",
            data: {
              action: "input->stt-settings#ttsModelChanged hw-combobox:selection->stt-settings#ttsModelChanged hw-combobox:clear->stt-settings#ttsModelChanged",
              stt_settings_target: "ttsModelCombobox"
            } %>
    </div>

    <div>
      <%= f.label :tts_voice, "TTS voice", class: "form-label" %>
      <%= f.combobox "tts_voice",
            "#{speech_voices_admin_app_setting_path}?api_uri=#{selected_speech_provider_uri}&model=#{@setting.tts_model}",
            name_when_new: "app_setting[tts_voice]",
            placeholder: "verse",
            data: {
              action: "",
              stt_settings_target: "ttsVoiceCombobox"
            } %>
    </div>
  </div>

  <div>
    <%= f.label :tts_instructions, "TTS instructions", class: "form-label" %>
    <%= f.text_area :tts_instructions, class: "input-primary", rows: 1, placeholder: "Speak in a calm and friendly tone." %>
    <p class="text-xs text-dim">Instructions passed to the TTS model when generating speech.</p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <div>
      <%= f.label :stt_method, "STT method", class: "form-label" %>
      <%= f.select :stt_method,
            [["Speech API", "speech"], ["LLM", "chat"]],
            {},
            class: "input-primary",
            data: { action: "change->stt-settings#update", stt_settings_target: "methodSelect" } %>
      <p class="text-xs text-dim mt-1">Choose whether transcriptions use the Speech API, or any audio LLM.</p>
    </div>

    <div data-stt-settings-target="speechWrapper">
      <%= f.label :stt_model, "STT model (Speech API)", class: "form-label" %>
      <%= f.combobox "stt_model",
            "#{speech_models_admin_app_setting_path}?kind=stt&api_uri=#{selected_speech_provider_uri}",
            name_when_new: "app_setting[stt_model]",
            placeholder: "gpt-4o-mini-transcribe",
            data: {
              action: "",
              stt_settings_target: "speechInput speechModelCombobox"
            } %>
      <p class="text-xs text-dim mt-1">Speech API model</p>
    </div>

    <div data-stt-settings-target="chatWrapper" class="hidden">
      <%= f.label :stt_model_id, "LLM for transcriptions", class: "form-label" %>
      <% llms = Llm.list_selectable_audio_models %>
      <% groups = llms.group_by { |llm| (URI.parse(llm.api_provider).host rescue llm.api_provider) }.to_a %>
      <%= f.grouped_collection_select :stt_model_id,
            groups,
            :last,
            :first,
            :id,
            :model,
            { include_blank: "Select a model", selected: @setting&.stt_model_id },
            { class: "input-primary", data: { stt_settings_target: "chatInput" } } %>
      <p class="text-xs text-dim mt-1">LLMs supporting audio input can be used for transcription.</p>
    </div>
  </div>

  <h2 class="text-xl font-semibold mb-2 mt-4">
    Image Gen
    <% if AppSetting.image_generation_configured? %>
      <sl-icon name="check-circle-fill" class="ml-2 inline-block align-middle text-lg text-success-500"></sl-icon>
    <% end %>
  </h2>
  <div>
    <%= f.label :image_llm_id, "Image generation model", class: "form-label" %>
    <% image_llms = Llm.list_selectable_image_models %>
    <% image_groups = image_llms.group_by { |llm| (URI.parse(llm.api_provider).host rescue llm.api_provider) }.to_a %>
    <%= f.grouped_collection_select :image_llm_id,
          image_groups,
          :last,
          :first,
          :id,
          :model,
          { include_blank: "Select a model", selected: @setting&.image_llm_id },
          { class: "input-primary" } %>
    <p class="text-xs text-dim mt-1">
      Only verified OpenRouter models that support image output are shown. 2-pass generation also requires image input.
    </p>
  </div>

  <div>
    <%= f.label :image_generation_two_pass, class: "flex items-start cursor-pointer" do %>
      <%= f.check_box :image_generation_two_pass, class: "checkbox-primary mt-1 mr-2" %>
      <div>
        <span class="font-medium text-stone-700 dark:text-stone-300">Enable 2-pass generation (critique & regenerate)</span>
        <p class="text-xs text-dim mt-0.5">
          When enabled, the model will critique and regenerate the image to correct errors. Disable for faster generation or if using highly capable models (e.g. Gemini 3 Pro).
        </p>
      </div>
    <% end %>
  </div>

  <h2 class="text-xl font-semibold mb-2 mt-4">
    Embeddings
    <% if AppSetting.embeddings_configured? %>
      <sl-icon name="check-circle-fill" class="ml-2 inline-block align-middle text-lg text-success-500"></sl-icon>
    <% end %>
  </h2>
    <p class="text-sm text-dim mb-2">Used for app functions like memories.</p>
  <div>
    <%= f.label :embedding_model, "Embedding model", class: "form-label" %>
    <%= f.text_field :embedding_model, class: "input-primary mb-1", placeholder: "google/gemini-embedding-001" %>
    <p class="text-xs text-dim mb-1">
      <b>Instructions:</b> Supports OpenRouter only. Enter an OpenRouter embedding model.<br>
      <% if SupportedApi.find_by(api_base_uri: "https://openrouter.ai/api/v1/")&.api_access_token.present? %>
        <span class="text-success-600 dark:text-success-400">OpenRouter token is configured.</span>
      <% else %>
        <span class="text-danger-600 dark:text-danger-400">Please add an OpenRouter shared access token in the LLM API settings.</span>
      <% end %>
    </p>
  </div>

  <h2 class="text-xl font-semibold mt-4 mb-2">
    Cost & Usage Safeguards
  </h2>
  <p class="text-dim text-sm mb-2">Only works when OpenRouter is used.</p>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <div>
      <%= f.label :user_daily_budget, "User Daily Budget ($)", class: "form-label" %>
      <%= f.number_field :user_daily_budget, step: "0.01", class: "input-primary", placeholder: "e.g. 1.00" %>
      <p class="text-xs text-dim mt-1">
        Limit daily API spend per user. Active lessons are allowed to finish unless they exceed the max lesson cost.
      </p>
    </div>

    <div>
      <%= f.label :max_chat_cost, "Max Chat/Lesson Cost ($)", class: "form-label" %>
      <%= f.number_field :max_chat_cost, step: "0.01", class: "input-primary", placeholder: "e.g. 2.00" %>
      <p class="text-xs text-dim mt-1">
        Hard limit for a single conversation or lesson session to prevent runaway usage.
      </p>
    </div>
  </div>

  <h2 class="text-xl font-semibold mt-4 mb-2">
    Background Agent Runs
    <% if AppSetting.background_agent_enabled_for?(current_user) %>
      <sl-icon name="check-circle-fill" class="ml-2 inline-block align-middle text-lg text-success-500"></sl-icon>
    <% end %>
  </h2>
  <p class="text-dim text-sm mb-2">
    Uses Responses API runs for agent runs like Course Outline Research and Propose Resources.
  </p>
  <div class="mb-4">
    <%= f.label :background_agent_prefer_user_codex, class: "flex items-start cursor-pointer" do %>
      <%= f.check_box :background_agent_prefer_user_codex, class: "checkbox-primary mt-1 mr-2" %>
      <div>
        <span class="font-medium text-stone-700 dark:text-stone-300">
          Experimental: prefer each teacher's Codex login
        </span>
        <p class="text-xs text-dim mt-1">
          Teacher-initiated background tasks use that teacher's own connected OpenAI OAuth credential when valid.
        </p>
      </div>
    <% end %>
    <div class="mt-3">
      <%= f.label :background_agent_codex_model, "Codex background model", class: "form-label" %>
      <%= f.combobox "background_agent_codex_model",
        "#{llm_models_admin_app_setting_path}?api_uri=#{SupportedApi::OPENAI_CODEX_BASE_URI}",
        name_when_new: "app_setting[background_agent_codex_model]",
        placeholder: "Select or enter Codex model name" %>
      <p class="text-xs text-dim mt-1">
        Required when the experimental preference is enabled. This model is global; credentials remain per teacher.
      </p>
    </div>
  </div>
  <% agent_supported_apis = @setting.background_agent_supported_apis.order(:api_base_uri) %>
  <% selected_agent_provider_id = @setting.background_agent_supported_api&.id %>
  <% selected_agent_provider_uri = @setting.background_agent_supported_api&.api_base_uri.to_s %>
  <div
    data-controller="agent-model-settings"
    data-agent-model-settings-models-path-value="<%= llm_models_admin_app_setting_path %>"
    data-agent-model-settings-status-path-value="<%= background_agent_model_status_admin_app_setting_path %>"
    data-agent-model-settings-provider-uri-map-value="<%= agent_supported_apis.pluck(:id, :api_base_uri).to_h.to_json %>"
  >
    <div>
      <%= f.label :background_agent_supported_api_id, "Shared fallback provider", class: "form-label" %>
      <%= f.collection_select :background_agent_supported_api_id,
        agent_supported_apis, :id, :api_base_uri,
        { selected: selected_agent_provider_id }, {
          class: "form-select-primary",
          data: {
            action: "change->agent-model-settings#updateModels",
            agent_model_settings_target: "providerSelect"
          }
        } %>
    </div>
    <div>
      <%= f.label :background_agent_model, "Shared fallback model", class: "form-label" %>
      <%= f.combobox "background_agent_model",
        "#{llm_models_admin_app_setting_path}?api_uri=#{selected_agent_provider_uri}",
        name_when_new: "app_setting[background_agent_model]",
        placeholder: "Select or enter model name",
        data: {
          action: "input->agent-model-settings#modelChanged hw-combobox:selection->agent-model-settings#modelChanged hw-combobox:clear->agent-model-settings#modelChanged",
          agent_model_settings_target: "modelCombobox"
        } %>
      <p class="text-xs text-dim mt-1" data-agent-model-settings-target="status">
        The shared fallback requires this model and a provider key. Use a strongly agentic model with reliable tool use and structured output support.
        <% if @setting.background_agent_access_token.present? %>
          <span class="text-success-600 dark:text-success-400">Shared provider key is configured.</span>
        <% else %>
          <span class="text-warning-700 dark:text-warning-300">Add a shared key for this provider if background runs should have a fallback.</span>
        <% end %>
        <% if selected_agent_provider_uri == SupportedApi::OPENROUTER_BASE_URI && @setting.background_agent_model.present? %>
          <% agent_context_length = @setting.background_agent_context_length %>
          <% if agent_context_length.present? %>
            <span class="block text-success-600 dark:text-success-400 mt-1">
              Context metadata found: <%= number_to_delimited(agent_context_length) %> tokens. Stateless OpenRouter runs will stop near 80% reported input-token usage.
            </span>
          <% else %>
            <span class="block text-warning-700 dark:text-warning-300 mt-1">
              No local context metadata found for this OpenRouter agent model. Try adding the model first in LLM API settings.
            </span>
          <% end %>
        <% end %>
      </p>
    </div>
  </div>
  <div class="mt-3">
    <%= f.label :background_agent_max_tool_turns, "Background run max tool turns", class: "form-label" %>
    <%= f.number_field :background_agent_max_tool_turns, min: 1, step: 1, class: "input-primary", placeholder: @setting.background_agent_max_tool_turns %>
    <p class="text-xs text-dim mt-1">
      Caps tool-call loop iterations for Responses background runs (agent jobs).
    </p>
  </div>

  <h2 class="text-xl font-semibold mt-4 mb-2">
    Exa Research
    <% if AppSetting.exa_enabled? %>
      <sl-icon name="check-circle-fill" class="ml-2 inline-block align-middle text-lg text-success-500"></sl-icon>
    <% end %>
  </h2>
  <p class="text-dim text-sm mb-2">
    Exa search/contents and research APIs for higher-quality web grounding.
  </p>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <div>
      <%= f.label :exa_research_model, "Exa research model", class: "form-label" %>
      <%= f.text_field :exa_research_model, class: "input-primary", placeholder: "exa-research" %>
      <p class="text-xs text-dim mt-1">Use <code>exa-research</code> or <code>exa-research-pro</code>.</p>
    </div>
  </div>

  <div>
    <%= f.label :exa_api_key, "Exa API key", class: "form-label" %>
    <%= f.password_field :exa_api_key, value: (@setting.exa_api_key.present? ? AppSetting::MASKED_SECRET_VALUE : nil), class: "input-primary", autocomplete: "off", placeholder: "Paste EXA key (optional)" %>
    <p class="text-xs text-dim mt-1">
      Stored encrypted. When present, this key is used for Exa calls.
      <% if @setting.exa_api_key.present? %>
        <span class="text-success-600 dark:text-success-400">Exa API key is configured in App Settings.</span>
      <% elsif ENV["EXA_API_KEY"].present? %>
        <span class="text-success-600 dark:text-success-400">Using EXA_API_KEY from environment.</span>
      <% else %>
        <span class="text-danger-600 dark:text-danger-400">Add an Exa key to enable Exa search/contents/research services.</span>
      <% end %>
    </p>
  </div>

  <% if Rails.env.development? %>
    <div>
      <%= f.label :course_outline_research_stub_enabled, class: "flex items-start cursor-pointer" do %>
        <%= f.check_box :course_outline_research_stub_enabled, class: "checkbox-primary mt-1 mr-2" %>
        <div>
          <span class="font-medium text-stone-700 dark:text-stone-300">Enable outline research stub mode (development only)</span>
          <p class="text-xs text-dim mt-0.5">
            Bypasses real Exa and Responses calls for course outline research runs and uses deterministic stub data.
          </p>
        </div>
      <% end %>
    </div>
  <% end %>

  <div class="mt-6">
    <%= f.submit "Save App Settings", class: "btn-primary" %>
  </div>
  <br>
<% end %>
