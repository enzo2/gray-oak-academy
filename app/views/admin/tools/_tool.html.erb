<tr id="<%= dom_id(tool) %>" class="border-b border-stone-300 dark:border-stone-700">
  <td class="py-2 px-3"><%= tool.name %></td>
  <td class="py-2 px-3"><%= tool.description %></td>
  <td class="py-2 px-3 text-right whitespace-nowrap">
    <div class="flex justify-end space-x-2">
      <%= link_to "View", admin_tool_path(tool), 
        class: "btn-primary py-1 px-2 text-sm" %>
      <%= link_to "Edit", edit_admin_tool_path(tool), 
        class: "btn-primary px-2 py-1 bg-red-700 hover:bg-red-800 text-white font-bold text-sm" %>
    </div>
  </td>
</tr>
