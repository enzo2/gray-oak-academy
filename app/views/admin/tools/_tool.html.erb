<tr id="<%= dom_id(tool) %>" class="border-b border-gray-300 dark:border-gray-700">
  <td class="py-2 px-3"><%= tool.name %></td>
  <td class="py-2 px-3"><%= tool.description %></td>
  <td class="py-2 px-3 text-right">
    <div class="flex justify-end space-x-2">
      <%= link_to "View", admin_tool_path(tool), 
        class: "bg-blue-600 hover:bg-blue-800 text-white font-bold py-1 px-2 rounded-sm text-sm", 
        data: { turbo_frame: "dashboard-content" } %>
      <%= link_to "Edit", edit_admin_tool_path(tool), 
        class: "bg-yellow-500 hover:bg-yellow-700 text-white font-bold py-1 px-2 rounded-sm text-sm", 
        data: { turbo_frame: "dashboard-content" } %>
    </div>
  </td>
</tr>

