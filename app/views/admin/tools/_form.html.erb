<%= form_with(model: [:admin, tool], id: "tools-form") do |form| %>
  <% if tool.errors.any? %>
    <div class="text-red-700 dark:text-red-300 px-4 py-3 mb-4" role="alert">
      <h2><%= pluralize(tool.errors.count, "error") %> prohibited this tool from being saved:</h2>
      <ul>
        <% tool.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-4">
    <%= form.label :name, class: "form-label mb-2" %>
    <%= form.text_field :name, class: "form-input" %>
  </div>

  <div class="mb-4">
    <%= form.label :description, class: "form-label mb-2" %>
    <%= form.text_area :description, rows: 3, class: "form-input" %>
  </div>

  <div class="mb-4">
    <%= form.label :specifications, class: "form-label mb-2" %>
    <%= form.text_area :specifications, value: JSON.pretty_generate(tool.specifications), rows: 15, class: "form-input font-mono" %>
  </div>

  <div class="flex items-center justify-between">
    <%= form.submit class: "btn-primary" %>
    <%= link_to "Cancel", admin_tools_path, class: "inline-block align-baseline font-bold text-sm text-blue-500 hover:text-blue-800" %>
  </div>
<% end %>
