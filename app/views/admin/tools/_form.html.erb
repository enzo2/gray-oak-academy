<%= form_with(model: [:admin, tool], id: "tools-form") do |form| %>
  <% if tool.errors.any? %>
    <div class="mb-4 px-4 py-3 text-danger-700 dark:text-danger-300" role="alert">
      <h2><%= pluralize(tool.errors.count, "error") %> prohibited this tool from being saved:</h2>
      <ul>
        <% tool.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-4">
    <%= form.label :specifications, class: "form-label mb-2" %>
    <%= form.text_area :specifications, value: JSON.pretty_generate(tool.specifications), rows: 15, class: "input-primary font-mono" %>
  </div>

  <div class="flex items-center space-x-4">
    <%= form.submit class: "btn-primary" %>
    <%= link_to "Cancel", admin_tools_path, class: "inline-block align-baseline font-bold text-sm hover:underline" %>
  </div>
<% end %>
