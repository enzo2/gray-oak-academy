<%= turbo_frame_tag "dashboard-content" do %>
  <h2 class="text-xl font-bold mb-5">Tool Details</h2>

  <div class="my-4">
    <%= link_to "Back to Tools", admin_tools_path, class: "btn-primary", data: { turbo_frame: "dashboard-content" } %>
  </div>

  <br>

  <h3 class="text-2xl mt-4"><%= @tool.name %></h3>

  <div class="border-t">
    <dl>
      <div class="py-5">
        <dt><b>Description</b></dt>
        <dd class="mt-1"><%= @tool.description %></dd>
      </div>
      <div class="py-5">
        <dt class=""><b>Specifications</b></dt>
        <dd class="mt-1 pl-4">
          <pre class="whitespace-pre-wrap"><%= JSON.pretty_generate(@tool.specifications) %></pre>
        </dd>
      </div>
    </dl>
  </div>

<% end %>