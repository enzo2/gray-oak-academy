<%= turbo_frame_tag "dashboard-content" do %>
  <h1 class="text-2xl font-bold">LLM Conversation with Chalkboard</h1>
  <p class="mb-2">This is just for casual purposes or testing.</p>

  <div class="p-4 flex flex-row gap-8 h-[85dvh]" data-controller="code-executor">
    <!-- Chats Column -->
    <div class="flex-none w-32 pr-4 border-r border-gray-400">
      <div class="flex justify-between items-center mb-4">
        <h3 class="text-lg">Chats</h3>
        <%= button_to conversations_path, method: :post, class: "", 
            data: { turbo_frame: "conversation-panel" } do %>
          <sl-icon name="plus" class=""></sl-icon>
        <% end %>
      </div>
      <div class="mb-6">
        <%= render partial: "conversations/list", locals: { conversations: @conversations } %>
      </div>
    </div>

    <!-- Conversation Column -->
    <div class="w-[48rem]">
      <%= turbo_frame_tag "conversation-panel" do %>
        <%= render partial: "conversations/conversation", locals: { conversation: @conversation } %>
      <% end %>
    </div>

    <!-- Chalkboard Column -->
      <%= render partial: "shared/chalkboard" %>
  </div>

<% end %>
