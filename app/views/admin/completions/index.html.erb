<%= turbo_frame_tag "dashboard-content" do %>
  <h2 class="text-2xl font-bold mb-5">Usage</h2>
  
  <p>This reflects usage for the whole app across all users.</p>

  <%= form_tag admin_completions_path, method: :get, data: { turbo_frame: "dashboard-content" } do %>
    <div class="mb-4 flex items-center gap-2">
      <%= date_field_tag :start_date, params[:start_date], class: "input input-bordered" %>
      <%= date_field_tag :end_date, params[:end_date], class: "input input-bordered" %>
      <%= submit_tag "Filter by Date Range", class: "btn btn-primary" %>
    </div>
  <% end %>

  <%= render partial: "usage_table", locals: { usage_data: @usage_data } %>

  <p>Note: Actual cost is only recorded when OpenRouter is used.</p>
  <p>Note: Tokens are recorded according to the native tokenizer of the model, so summing different models' tokens might not be accurate.</p>

<% end %>
