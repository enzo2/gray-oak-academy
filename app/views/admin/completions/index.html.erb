<%= turbo_frame_tag "dashboard-content" do %>
  <h2 class="text-2xl font-bold mb-5">Usage</h2>
  
  <p>This reflects usage for the whole app across all users.</p>

  <table class="min-w-full divide-y divide-gray-200 mt-5">
    <thead class="">
      <tr>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Model</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">API Provider</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Total Prompt Tokens</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Total Completion Tokens</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Total Tokens</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Total Costs (USD)</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-200">
      <% @usage_data.each_with_index do |data, index| %>
        <tr class="<%= index.even? ? 'bg-white' : 'bg-gray-50' %>">
          <td class="px-6 py-4 whitespace-nowrap"><%= data.model %></td>
          <td class="px-6 py-4 whitespace-nowrap"><%= data.api_provider || 'N/A' %></td>
          <td class="px-6 py-4 whitespace-nowrap"><%= data.total_prompt_tokens %></td>
          <td class="px-6 py-4 whitespace-nowrap"><%= data.total_completion_tokens %></td>
          <td class="px-6 py-4 whitespace-nowrap"><%= data.total_tokens %></td>
          <td class="px-6 py-4 whitespace-nowrap"><%= number_to_currency(data.total_costs) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>

<% end %>
