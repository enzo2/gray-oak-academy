<tr id="<%= dom_id(lesson) %>" class="border-b">
  <td class="py-4 px-6"><%= lesson.title %></td>
  <td class="py-4 px-6"><%= lesson.goals %></td>
  <td class="py-4 px-6 text-center"><%= lesson.approx_duration_min %> minutes</td>
  <td class="py-4 px-6 text-right">
    <%= link_to "Edit", edit_admin_course_lesson_path(lesson.course, lesson), class: "inline-block mr-2", data: { turbo_frame: "lesson-form" } %>
    <%= button_to "Delete", admin_course_lesson_path(lesson.course, lesson), method: :delete, class: "inline-block mr-2", data: { turbo_confirm: "Are you sure you want to delete this lesson?" } %>
    <%= link_to "Edit Lesson Plan", edit_admin_course_lesson_lesson_plan_path(lesson.course, lesson), class: "inline-block", data: { turbo_frame: "lesson-plan" } %>
  </td>
</tr>