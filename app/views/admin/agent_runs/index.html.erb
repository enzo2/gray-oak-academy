<div class="flex flex-wrap items-center justify-between gap-3 mb-2">
  <h2 class="text-2xl font-bold">Agent Runs</h2>
  <%= button_to "Clear Logs",
      clear_admin_agent_runs_path,
      method: :delete,
      data: { turbo_confirm: "Clear all agent run logs? This cannot be undone." },
      class: "btn-secondary text-red-700 dark:text-red-300" %>
</div>
<p class="mb-4 text-sm text-dim">OpenAI Responses background runs.</p>
<%
  format_run_time = lambda do |value|
    next "" if value.blank?

    timestamp = value.respond_to?(:in_time_zone) ? value.in_time_zone : Time.zone.parse(value.to_s)
    timestamp.strftime("%Y-%m-%d %H:%M:%S")
  rescue ArgumentError, TypeError
    value.to_s
  end
%>

<% if @runs.any? %>
  <div class="overflow-x-auto">
    <table class="min-w-full divide-y divide-stone-200 dark:divide-stone-700">
      <thead class="bg-stone-50 dark:bg-stone-800">
        <tr class="[&>th]:px-4 [&>th]:py-3 [&>th]:text-left [&>th]:text-xs [&>th]:uppercase [&>th]:tracking-wider text-stone-500 dark:text-stone-400">
          <th>Status</th>
          <th>Run ID</th>
          <th>Teacher</th>
          <th>Model</th>
          <th>Source</th>
          <th>Submitted</th>
          <th>Finished</th>
          <th>Duration (s)</th>
          <th>Turns</th>
          <th>Tool Calls</th>
          <th>Task</th>
          <th>Error</th>
          <th>Trace</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-stone-200 dark:divide-stone-700">
        <% @runs.each_with_index do |run, idx| %>
          <tr class="[&>td]:px-4 [&>td]:py-2 align-top text-sm <%= idx.even? ? '' : 'bg-stone-100/60 dark:bg-stone-800/60' %>">
            <td>
              <% case run[:status].to_s %>
              <% when "completed" %>
                <span class="text-green-700 dark:text-green-400">completed</span>
              <% when "failed" %>
                <span class="text-red-700 dark:text-red-400">failed</span>
              <% else %>
                <span class="text-amber-700 dark:text-amber-300"><%= run[:status].presence || "submitted" %></span>
              <% end %>
            </td>
            <td class="font-mono text-xs"><%= run[:run_id] %></td>
            <td>
              <% if run[:teacher_id].present? %>
                <%= link_to(run[:teacher_name], admin_student_path(run[:teacher_id]), class: "underline underline-offset-2") %>
              <% else %>
                <%= run[:teacher_name] %>
              <% end %>
            </td>
            <td class="font-mono text-xs"><%= run[:model] %></td>
            <td><%= run[:source] %></td>
            <td><%= format_run_time.call(run[:submitted_at]) %></td>
            <td><%= format_run_time.call(run[:finished_at]) %></td>
            <td><%= run[:duration_seconds] %></td>
            <td><%= run[:tool_turn_count].to_i %></td>
            <td><%= run[:tool_call_count] %></td>
            <td class="max-w-md">
              <div><%= run[:task_preview] %></div>
              <% if run[:task_prompt].to_s.present? %>
                <details class="mt-1">
                  <summary class="cursor-pointer text-xs text-dim">Full task prompt</summary>
                  <pre class="mt-1 text-xs whitespace-pre-wrap bg-stone-100 dark:bg-stone-800 p-2 rounded overflow-x-auto"><%= run[:task_prompt] %></pre>
                </details>
              <% end %>
            </td>
            <td class="max-w-xs text-red-700 dark:text-red-400"><%= run[:error_message] %></td>
            <td>
              <% if run[:response_id].present? %>
                <%= link_to "View", admin_agent_runs_path(trace_response_id: run[:response_id]), class: "underline underline-offset-2" %>
              <% else %>
                <span class="text-dim">n/a</span>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <% if @trace_run.present? && @trace_data.present? %>
    <div class="mt-6">
      <h3 class="text-lg font-semibold mb-2">Run Trace: <span class="font-mono text-sm"><%= @trace_run[:response_id] %></span></h3>
      <% if @trace_data[:error].present? %>
        <p class="text-sm text-red-700 dark:text-red-400"><%= @trace_data[:error] %></p>
      <% end %>

      <h4 class="text-sm font-medium mt-4 mb-1">Tool Calls</h4>
      <% tool_call_summary = @trace_data[:tool_call_summary] || {} %>
      <div class="text-sm text-dim">
        Total: <b><%= tool_call_summary[:total_calls].to_i %></b> |
        Unique tools: <b><%= tool_call_summary[:unique_tools].to_i %></b>
      </div>

      <% if tool_call_summary[:counts_by_name].present? %>
        <ul class="mt-2 flex flex-wrap gap-2">
          <% tool_call_summary[:counts_by_name].each do |name, count| %>
            <li class="text-xs bg-stone-100 dark:bg-stone-800 px-2 py-1 rounded">
              <span class="font-mono"><%= name %></span>: <b><%= count %></b>
            </li>
          <% end %>
        </ul>
      <% end %>

      <% if tool_call_summary[:repeated_argument_patterns].present? %>
        <details class="mt-3">
          <summary class="text-sm font-medium cursor-pointer">Repeated Argument Patterns</summary>
          <ul class="space-y-2 mt-2">
            <% tool_call_summary[:repeated_argument_patterns].each do |pattern| %>
              <li class="text-xs bg-stone-100 dark:bg-stone-800 p-3 rounded">
                <span class="font-mono font-semibold"><%= pattern[:name] %></span>
                repeated <b><%= pattern[:count] %></b> times
                <div class="mt-1 text-dim"><%= pattern[:arguments_preview] %></div>
                <div class="mt-1 text-dim font-mono">fingerprint: <%= pattern[:argument_fingerprint].to_s.first(12) %></div>
              </li>
            <% end %>
          </ul>
        </details>
      <% end %>

      <% if @trace_data[:tool_calls].present? %>
        <details class="mt-3">
          <summary class="text-sm font-medium cursor-pointer">Detailed Calls</summary>
          <% calls_by_turn = @trace_data[:tool_calls].group_by { |tool_call| tool_call[:response_id].presence || "unknown_response" } %>
          <div class="space-y-3 mt-2">
            <% calls_by_turn.each_with_index do |(response_id, calls), turn_index| %>
              <div class="border border-stone-200 dark:border-stone-700 rounded p-2">
                <div class="text-xs font-semibold mb-2">
                  Turn <%= turn_index + 1 %>
                  <span class="text-dim font-normal">(<span class="font-mono"><%= response_id %></span>)</span>
                </div>
                <ul class="space-y-2">
                  <% calls.each do |tool_call| %>
                    <li class="text-xs bg-stone-100 dark:bg-stone-800 p-3 rounded">
                      <span class="font-mono font-semibold"><%= tool_call[:name] %></span>
                      <span class="text-dim">call_id:</span>
                      <span class="font-mono"><%= tool_call[:call_id] %></span>
                      <% if tool_call[:arguments_preview].present? %>
                        <div class="mt-1 text-dim"><%= tool_call[:arguments_preview] %></div>
                      <% end %>
                    </li>
                  <% end %>
                </ul>
              </div>
            <% end %>
          </div>
        </details>
      <% else %>
        <p class="text-sm text-dim mt-2">No tool calls were captured for this run.</p>
      <% end %>

      <% if @trace_data[:output_text].present? %>
        <details class="mt-4">
          <summary class="text-sm font-medium cursor-pointer">Assistant Output Text</summary>
          <pre class="text-xs whitespace-pre-wrap bg-stone-100 dark:bg-stone-800 p-3 rounded overflow-x-auto mt-2"><%= @trace_data[:output_text] %></pre>
        </details>
      <% end %>

      <% trace_task_prompt = @trace_data[:task_prompt].to_s.presence || @trace_run[:task_prompt].to_s.presence %>
      <% if trace_task_prompt.present? %>
        <details class="mt-4">
          <summary class="text-sm font-medium cursor-pointer">Submitted Task Prompt</summary>
          <pre class="text-xs whitespace-pre-wrap bg-stone-100 dark:bg-stone-800 p-3 rounded overflow-x-auto mt-2"><%= trace_task_prompt %></pre>
        </details>
      <% end %>

      <% if @trace_data[:instructions_text].present? %>
        <details class="mt-4">
          <summary class="text-sm font-medium cursor-pointer">Responses Instructions</summary>
          <pre class="text-xs whitespace-pre-wrap bg-stone-100 dark:bg-stone-800 p-3 rounded overflow-x-auto mt-2"><%= @trace_data[:instructions_text] %></pre>
        </details>
      <% end %>

      <% if @trace_data[:input_text].present? %>
        <details class="mt-4">
          <summary class="text-sm font-medium cursor-pointer">Responses Input Text</summary>
          <pre class="text-xs whitespace-pre-wrap bg-stone-100 dark:bg-stone-800 p-3 rounded overflow-x-auto mt-2"><%= @trace_data[:input_text] %></pre>
        </details>
      <% end %>

      <% if @trace_data[:response_json].present? %>
        <details class="mt-4">
          <summary class="text-sm font-medium cursor-pointer">Full Response (Raw JSON)</summary>
          <pre class="text-xs whitespace-pre-wrap bg-stone-100 dark:bg-stone-800 p-3 rounded overflow-x-auto mt-2"><%= @trace_data[:response_json] %></pre>
        </details>
      <% end %>
    </div>
  <% end %>
<% else %>
  <p class="text-dim">No agent runs recorded yet.</p>
<% end %>
