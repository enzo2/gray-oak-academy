<%= turbo_frame_tag "student-control-panel" do %>
  <h2 class="text-xl font-semibold mb-6"><%= @student.name %></h2>
  <h3 class="text-lg">Enrolled Courses</h3>
  <div class="w-full grid grid-cols-[repeat(auto-fill,16rem)] gap-4 mb-6">
    <% @student.enrollments.includes(:course).each do |enrollment| %>
      <div class="p-2 rounded border border-gray-300 dark:border-gray-700" id="<%= dom_id(enrollment) %>">
        <span class="font-medium"><%= enrollment.course.title %></span>

        <sl-progress-bar value="<%= enrollment.progress_percentage %>" max="100" style="width: 100%;"></sl-progress-bar>
        <span class="text-sm"><%= "#{enrollment.completed_lessons_count} / #{enrollment.total_lessons_count} lessons completed" %></span>
        <div class="flex items-center my-2">
          <% if enrollment.has_available_lesson? %>
            <sl-icon name="check-circle-fill" class="text-lg mr-2 shrink-0" title="Available lessons"></sl-icon>
            <span class="text-sm">Next lesson ready.</span>
          <% else %>
            <sl-icon name="exclamation-circle-fill" class="text-lg text-red-500 mr-2 shrink-0" title="No available lessons"></sl-icon>
            <span class="text-sm">No lessons available for student. Please 
              <%= link_to "publish a lesson plan", admin_course_lessons_path(enrollment.course), data: {turbo_frame: "dashboard-content"}, class: "underline" %>.
              </span>
          <% end %>
        </div>

        <%= button_to 'Unenroll', unenroll_admin_student_path(@student, course_id: enrollment.course.id),
            method: :delete,
            data: { turbo_confirm: 'Are you sure?' }, class: "btn-danger text-sm" %>
      </div>
    <% end %>
  </div>

  <div class="mb-6">
    <h3 class="text-lg">Enroll in a New Course</h3>
      <% available_courses = Course.available_for_enrollment(@student, current_user) %>
    <% if available_courses.any? %>
      <%= form_with url: enroll_admin_student_path(@student), method: :post, class: "mt-2 flex" do |form| %>
      <%= form.collection_select :course_id, available_courses, :id, :title,
        { prompt: "Select Course" }, { class: "form-select" } %>
        <%= form.submit 'Enroll', class: "btn-primary ml-2" %>
      <% end %>
    <% else %>
      <p class="text-sm">No courses available for enrollment.</p>
    <% end %>
  </div>

  <hr class="mb-6">

  <% if @student.teacher == current_user %>
    <%= button_to 'Un-adopt student', unadopt_admin_student_path(@student), 
      method: :delete, 
      data: { turbo_confirm: 'This will remove the student from your list. Are you sure?', turbo_frame: "dashboard-content" }, 
      class: "btn-danger text-sm" %>
  <% end %>
<% end %>