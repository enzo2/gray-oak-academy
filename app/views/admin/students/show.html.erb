<%= turbo_frame_tag "student-control-panel" do %>
  <div class="control-panel p-4">
    <h2 class="text-xl font-semibold"><%= @student.name %></h2>

    <div class="mb-6">
      <h3 class="text-lg font-semibold">Enrolled Courses</h3>
      <ul class="mt-2">
        <% @student.enrollments.includes(:course).each do |enrollment| %>
          <li class="flex justify-between items-center py-2" id="<%= dom_id(enrollment) %>">
            <div>
              <span class="font-medium"><%= enrollment.course.title %></span>
              <div class="mt-1">
                <sl-progress-bar value="<%= enrollment.progress_percentage %>" max="100" style="width: 250px;"></sl-progress-bar>
                <span class="text-sm"><%= "#{enrollment.completed_lessons} / #{enrollment.total_lessons} lessons completed" %></span>
                <%# add green or red icon for each enrollment reflecting whether there is at least one lesson whose lesson plan is "published" available for the student to complete  (teacher needs to publish lesson plans before student will be able to start the lessons)  %>
              </div>
            </div>
            <div class="flex items-center space-x-2">
              <%= button_to 'Unenroll', unenroll_admin_student_path(@student, course_id: enrollment.course.id), 
                method: :delete,
                data: { turbo_confirm: 'Are you sure?' }, class: "btn-danger" %>
            </div>
          </li>
        <% end %>
      </ul>
    </div>

    <div class="mb-6">
      <h3 class="text-lg font-semibold">Enroll in a New Course</h3>
      <%= form_with url: enroll_admin_student_path(@student), method: :post, class: "mt-2 flex space-x-2" do |form| %>
      <%= form.collection_select :course_id, Course.where(teacher: current_user).reject { |course| course.enrolled_in?(@student) }, :id, :title,
        { prompt: "Select Course" }, { class: "form-select" } %>
        <%= form.submit 'Enroll', class: "btn-primary" %>
      <% end %>
    </div>

    <% if @student.teacher == current_user %>
      <%= button_to 'Un-adopt', unadopt_admin_student_path(@student), 
        method: :delete, 
        data: { turbo_confirm: 'Are you sure?', turbo_frame: "dashboard-content" }, 
        class: "btn-danger" %>
    <% end %>
  </div>
<% end %>