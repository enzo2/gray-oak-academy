<h2 class="text-xl font-semibold">Manage Students</h2>

  <div class="py-4 flex flex-row gap-2">
    <!-- Students List Column -->
    <div class="basis-48 pr-2 border-r">
      <%= render partial: "students_nav", locals: { 
        my_students: current_user.students.order(last_name: :asc), 
        other_students: User.role_student.where.not(id: current_user.students.pluck(:id)) } %>
    </div>

    <!-- Student Dashboard Column -->
    <div id="student-dashboard" class="grow pl-4 max-w-7xl">
      <%= render 'student_dashboard' %>
    </div>
  </div>