<sl-tree class="mb-2 [&::part(treeitem)]:text-inherit" id="students-nav-tree">
  <sl-tree-item expanded class="">
    <strong>My Students</strong>
    <% my_students.each do |student| %>
      <sl-tree-item <%= 'selected' if @student&.id == student.id %>>
        <%= link_to student.name, admin_student_path(student), class: "hover:underline" %>
      </sl-tree-item>
    <% end.empty? and begin %>
      <sl-tree-item disabled>No students yet</sl-tree-item>
    <% end %>
  </sl-tree-item>

  <sl-tree-item>
    <strong>Other Students</strong>
    <% other_students.each do |student| %>
      <sl-tree-item>
        <div class="flex justify-between items-center w-full">
          <span><%= student.name %></span>
          <% if student.teacher.nil? %>
            <%= link_to adopt_admin_student_path(student), data: { 
                  turbo_method: :post, 
                  turbo_stream: true
                  } do %>
              <sl-icon-button 
                name="person-add" label="Adopt" 
                class="text-green-600 text-lg [&::part(base)]:p-[4px]"></sl-icon-button>
            <% end %>
          <% end %>
        </div>
      </sl-tree-item>
    <% end.empty? and begin %>
      <sl-tree-item disabled>No other students</sl-tree-item>
    <% end %>
  </sl-tree-item>
</sl-tree>

<hr class="hr-primary mb-2">

<button class="hover:text-green-500 hover:cursor-pointer" onclick="document.getElementById('new-student-modal').show()">
  <sl-icon name="person-add" class="mr-1"></sl-icon>
  New Student
</button>

<sl-dialog id="new-student-modal" label="Add Student" class="w-[400px]">
  <%= render 'new_student_modal' unless current_user.role_student? %>
</sl-dialog>
