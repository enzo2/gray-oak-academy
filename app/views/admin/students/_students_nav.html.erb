<div class="mb-2" data-controller="tree-view" id="students-list-tree">
  <div>
    <button type="button"
            class="flex items-center w-full text-left gap-1 px-0 py-1 cursor-pointer"
            aria-expanded="true"
            data-action="click->tree-view#toggle"
            aria-controls="my-students-content">
      <span class="flex items-center justify-center w-4 h-4 mr-1" data-tree-view-target="icon" aria-hidden="true"></span>
      <span class="font-semibold">My Students</span>
    </button>
    <div id="my-students-content" data-tree-view-target="content">
      <div class="pl-6">
        <% my_students.each do |student| %>
          <%= link_to student.name,
              admin_student_path(student),
              class: "block rounded px-2 py-1 hover:underline #{'bg-stone-300 dark:bg-stone-700' if @student&.id == student.id}" %>
        <% end.empty? and begin %>
          <div class="py-1 text-stone-500 dark:text-stone-400">No students yet</div>
        <% end %>
      </div>
    </div>
  </div>

  <div>
    <% other_students_expanded = defined?(@student) && other_students.include?(@student) %>
    <button type="button"
            class="flex items-center w-full text-left gap-1 px-0 py-1 cursor-pointer"
            aria-expanded="<%= other_students_expanded %>"
            data-action="click->tree-view#toggle"
            aria-controls="other-students-content">
      <span class="flex items-center justify-center w-4 h-4 mr-1" data-tree-view-target="icon" aria-hidden="true"></span>
      <span class="font-semibold">Other Students</span>
    </button>
    <div id="other-students-content" <%= 'hidden' unless other_students_expanded %> data-tree-view-target="content">
      <div class="pl-6">
        <% other_students.each do |student| %>
          <div class="flex justify-between items-center w-full px-2 py-1">

            <%# Superusers can navigate to any student's settings; teachers can only see the name %>
            <% if current_user.role_superuser? %>
              <%= link_to student.name, admin_student_path(student), 
              class: "block rounded px-2 py-1 hover:underline #{'bg-stone-300 dark:bg-stone-700' if @student&.id == student.id}" %>
            <% elsif current_user.role_admin? %>
              <span><%= student.name %></span>
            <% end %>

            <% if student.teacher.nil? %>
              <%= link_to adopt_admin_student_path(student),
                    class: "p-1 text-success-600 hover:text-success-500",
                    data: { turbo_method: :post } do %>
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z" />
                </svg>
              <% end %>
            <% end %>
          </div>
        <% end.empty? and begin %>
          <div class="py-1 text-stone-500 dark:text-stone-400">No other students</div>
        <% end %>
      </div>
    </div>
  </div>
</div>

<hr class="hr-primary mb-2">

  <button class="flex items-center hover:cursor-pointer hover:text-success-500" 
        data-show-dialog="new-student-modal">
  <svg class="w-5 h-5 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" 
          d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z" />
  </svg>
  New Student
</button>

<hr class="hr-primary my-2">

<%= link_to admin_student_path(current_user),
    class: "block rounded py-1 hover:underline #{'bg-stone-300 dark:bg-stone-700 pl-1' if @student&.id == current_user.id}" do %>
  <div class="flex flex-row items-center">
    <sl-icon name="person-circle" class="mr-1"></sl-icon>Me as student
  </div>
<% end %>


<sl-dialog id="new-student-modal" label="Add Student" style="--width: min(90vw, 400px);">
  <%= render 'new_student_modal' unless current_user.role_student? %>
</sl-dialog>
