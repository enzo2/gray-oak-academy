<h2 class="text-lg mb-2">Quick Lessons</h2>
<div class="w-full grid grid-cols-1 sm:grid-cols-[repeat(auto-fill,minmax(20rem,1fr))] gap-4 mb-6">
  <% if enrollments.any? %>
    <% enrollments.each do |enrollment| %>
      <% quick_lesson = enrollment.course %>
      <% lesson = quick_lesson.lessons.first %>
      <% lesson_plan = lesson&.lesson_plan %>
      <div id="<%= dom_id(enrollment) %>" class="p-4 rounded-sm border border-stone-300 dark:border-stone-700">
        <span class="font-medium mb-2 block"><%= quick_lesson.title %></span>
        <p class="mb-3 text-sm text-stone-600 dark:text-stone-400">
          <%= lesson_plan&.status&.titleize || "No Plan" %>
          <% if enrollment.completed? %>
            · Completed
          <% elsif enrollment.has_available_lesson? %>
            · Ready
          <% else %>
            · Awaiting publication
          <% end %>
        </p>

        <% if lesson %>
          <%= link_to edit_admin_course_lesson_lesson_plan_path(quick_lesson, lesson), class: "btn-primary text-sm inline-flex items-center" do %>
            <div class="flex items-center">
              <sl-icon name="journal-text" class="text-stone-700 dark:text-stone-200"></sl-icon>
              <span>&nbsp;Review Plan</span>
            </div>
          <% end %>
        <% end %>
      </div>
    <% end %>
  <% else %>
    <p>This student has no quick lessons.</p>
  <% end %>
</div>
