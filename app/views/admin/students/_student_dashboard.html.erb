<h2 class="text-xl font-semibold mb-1"><%= @student.name %></h2>

<div id="student-dashboard-tabs"
     data-controller="tabs"
     data-tabs-active-tab-value="<%= @active_tab %>">
  <% tab_nav_classes = "mb-4 flex flex-wrap gap-1 border-b border-stone-200 pb-2.5 max-[420px]:gap-[0.2rem] dark:border-stone-700" %>
  <% tab_button_classes = "rounded-[0.3rem] border border-transparent bg-transparent px-[0.55rem] py-[0.2rem] text-sm font-medium whitespace-nowrap text-stone-600 transition-colors duration-[120ms] hover:bg-stone-100 hover:text-stone-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-moss-500 max-[420px]:px-[0.4rem] max-[420px]:py-[0.15rem] max-[420px]:text-[0.88rem] dark:text-stone-400 dark:hover:bg-stone-800 dark:hover:text-stone-100 data-[state=open]:border-moss-700 data-[state=open]:bg-moss-600 data-[state=open]:text-white data-[state=open]:hover:bg-moss-600 data-[state=open]:hover:text-moss-100" %>
  <% tab_dropdown_viewport_classes = "absolute left-0 top-full z-50 pt-1 transition-opacity duration-150 data-[state=closed]:hidden data-[state=closing]:pointer-events-none data-[state=closing]:opacity-0" %>
  <% tab_dropdown_bg_classes = "min-w-44 rounded-md border border-stone-200 bg-white p-1 shadow-[0_4px_12px_-2px_rgb(0_0_0_/_0.1),0_2px_4px_-1px_rgb(0_0_0_/_0.06)] dark:border-stone-700 dark:bg-stone-900 dark:shadow-[0_4px_12px_-2px_rgb(0_0_0_/_0.3),0_2px_4px_-1px_rgb(0_0_0_/_0.2)]" %>
  <% tab_dropdown_item_classes = "flex w-full items-center rounded border-0 bg-transparent px-3 py-[0.4rem] text-left text-sm font-medium whitespace-nowrap text-stone-700 transition-colors duration-100 hover:bg-stone-100 hover:text-stone-900 focus-visible:outline-2 focus-visible:outline-offset-[-2px] focus-visible:outline-moss-500 dark:text-stone-300 dark:hover:bg-stone-800 dark:hover:text-stone-100" %>

  <div role="tablist" class="<%= tab_nav_classes %>">
    <button role="tab" type="button" class="<%= tab_button_classes %>"
            data-tabs-target="tab" data-tabs-panel="journal"
            data-action="click->tabs#show keydown->tabs#handleTabKeydown">Journal</button>

    <%# Courses tab — a pill tab that also opens a dropdown via the navbar controller %>
    <div class="relative" data-controller="navbar">
      <button role="tab" type="button" class="<%= "#{tab_button_classes} inline-flex items-center gap-1" %>"
              data-tabs-target="tab"
              data-tabs-panel="active_courses"
              data-tabs-group="active_courses past_courses enroll"
              data-tabs-menu-trigger="true"
              data-navbar-target="trigger"
              data-content-id="courses-dropdown"
              data-action="click->tabs#show
                           click->navbar#toggleMenu
                           keydown->tabs#handleTabKeydown
                           keydown->navbar#handleTriggerKeydown">
        Courses
        <sl-icon name="chevron-down" class="text-xs opacity-70"></sl-icon>
      </button>

      <div data-navbar-target="viewport"
           data-state="closed"
           class="<%= tab_dropdown_viewport_classes %>">
        <div data-navbar-target="background" class="<%= tab_dropdown_bg_classes %>">
          <div id="courses-dropdown" data-navbar-target="content" class="hidden">
            <button type="button" class="<%= tab_dropdown_item_classes %>"
                    data-tabs-panel="active_courses"
                    data-navbar-preserve-trigger-state-param="true"
                    data-action="click->tabs#show click->navbar#close">Active Courses</button>
            <button type="button" class="<%= tab_dropdown_item_classes %>"
                    data-tabs-panel="past_courses"
                    data-navbar-preserve-trigger-state-param="true"
                    data-action="click->tabs#show click->navbar#close">Past Courses</button>
            <button type="button" class="<%= tab_dropdown_item_classes %>"
                    data-tabs-panel="enroll"
                    data-navbar-preserve-trigger-state-param="true"
                    data-action="click->tabs#show click->navbar#close">Add Course</button>
          </div>
        </div>
      </div>
    </div>

    <button role="tab" type="button" class="<%= tab_button_classes %>"
            data-tabs-target="tab" data-tabs-panel="memories"
            data-action="click->tabs#show keydown->tabs#handleTabKeydown">Memories</button>
    <button role="tab" type="button" class="<%= tab_button_classes %>"
            data-tabs-target="tab" data-tabs-panel="applets"
            data-action="click->tabs#show keydown->tabs#handleTabKeydown">Applets</button>
    <button role="tab" type="button" class="<%= tab_button_classes %>"
            data-tabs-target="tab" data-tabs-panel="settings"
            data-action="click->tabs#show keydown->tabs#handleTabKeydown">Settings</button>
  </div>

  <div id="journal" role="tabpanel" data-tabs-target="panel">
    <div class="journal-wrapper" data-controller="journal-filter" data-journal-filter-infinite-scroll-outlet=".journal-timeline-container">
      <%= render "shared/journal_toolbar", url: journal_admin_student_path(@student) %>

      <div id="pending_observations" class="space-y-2 md:space-y-4 mb-6">
        <% if @pending_observations.present? %>
          <div class="flex items-center gap-2 mb-2">
            <sl-icon name="hourglass-split" class="text-amber-500"></sl-icon>
            <h3 class="font-semibold text-stone-600 dark:text-stone-400">Pending Observations</h3>
          </div>
          <% @pending_observations.each do |observation| %>
            <%= render "shared/journal_entry", item: observation, teacher_mode: true, pending_view: true %>
          <% end %>
          <hr class="border-stone-200 dark:border-stone-700 my-4">
        <% end %>
      </div>

      <div data-journal-filter-target="timeline">
        <%= render "shared/journal_timeline", teacher_mode: true %>
      </div>
    </div>
  </div>

  <div id="active_courses" role="tabpanel" data-tabs-target="panel">
    <% if @active_enrollments.presence %>
      <%= render 'active_courses', enrollments: @active_enrollments %>
    <% else %>
      <p>This student is not currently enrolled in any courses.</p>
    <% end %>
  </div>

  <div id="past_courses" role="tabpanel" data-tabs-target="panel">
    <% if @completed_enrollments.presence %>
      <%= render 'completed_courses', enrollments: @completed_enrollments %>
    <% else %>
      <p>This student has not completed any courses.</p>
    <% end %>

    <% if @orphaned_reports.presence %>
      <br>
      <hr class="my-2">
      <h2 class="text-lg mb-2">Orphaned Reports</h2>
      <p>Student Reports from previously deleted lessons were found:</p>
        <sl-details summary="Show Orphaned Reports" class="my-1 max-w-3xl">
          <% @orphaned_reports.each do |student_report| %>
            <div class="bg-stone-300 dark:bg-stone-700 rounded-lg my-2 px-4 py-2 pl-4
                          prose dark:prose-invert prose-stone
                          max-w-2xl
                          prose-p:mb-0 leading-tight
                          prose-li:my-0  prose-ul:my-0
                          prose-ul:marker:text-stone-800 dark:prose-ul:marker:text-stone-100">
              <span class="mb-3"><i>Completed <%= student_report.created_at.strftime("%B %d, %Y") %></i>:</span>
              <%= markdown(student_report.to_markdown) %>
            </div>
          <% end %>
        </sl-details>
    <% end %>
  </div>

  <div id="enroll" role="tabpanel" data-tabs-target="panel">
    <h3 class="text-lg">Enroll in a New Course</h3>
    <% available_courses = Course.available_for_enrollment(@student, current_user) %>
    <% if available_courses.any? %>
      <%= form_with url: enroll_admin_student_path(@student), method: :post, class: "mt-2 flex flex-col sm:flex-row gap-2 max-w-md", data: { turbo_stream: true } do |form| %>
        <%= form.collection_select :course_id, available_courses, :id, :title,
          { prompt: "Select Course" }, { class: "form-select-primary w-full" } %>
        <%= form.submit 'Enroll', class: "btn-primary w-full sm:w-auto" %>
      <% end %>
    <% else %>
      <p class="text-sm">No courses available for enrollment.</p>
    <% end %>
  </div>

  <div id="memories" role="tabpanel" data-tabs-target="panel">
    <h3 class="text-lg">Memories</h3>

    <p class="text-sm text-stone-600 dark:text-stone-400 mb-4">
      Memories are personal facts or recollections about the student.<br>
      They will be learned automatically over time, but you should add some manually too.<br>
      Don't include things relating to learning preferences or challenges; those belong in Observations.<br>
    </p>

    <div class="mb-4">
      <%= render 'admin/memories/form', memory: Memory.new %>
    </div>

    <div class="space-y-4" id="memories-list">
      <% if @memories.any? %>
        <%= render partial: "admin/memories/memory", collection: @memories %>
      <% else %>
        <p><i>No memories yet.</i></p>
      <% end %>
    </div>
  </div>

  <div id="applets" role="tabpanel" data-tabs-target="panel">
    <h2 class="text-lg mb-4">Applets</h2>
    <p class="mb-4 block">
      These are JavaScript applets the student has archived.
      <br>To re-use them in future lessons, convert to a Resource.
    </p>
    <%= render "applets/applets_table", applets: @student.applets %>
  </div>

  <div id="settings" role="tabpanel" data-tabs-target="panel">
    <h3 class="text-lg mb-4">Settings</h3>
      <% if @student.teacher_id == current_user.id %>
        <p class="text-sm text-dim mb-1">You can release the student so that another teacher can adopt them.</p>
        <%= button_to 'Release student', unadopt_admin_student_path(@student),
          method: :delete,
          data: { turbo_confirm: 'This will remove the student from your list. Are you sure?' },
          class: "btn-danger text-sm" %>
      <% end %>

      <% if current_user.role_superuser? && current_user != @student %>
        <details class="mt-4">
          <summary class="cursor-pointer text-red-600 font-bold">Danger Zone</summary>
          <div data-controller="modal">
            <button type="button" class="btn-danger text-sm mt-2 block" data-action="modal#open">DELETE STUDENT ACCOUNT</button>

            <div data-modal-target="content" class="hidden">
              <%= form_with url: admin_student_path(@student), method: :delete, class: "p-6", data: { controller: "confirmation", confirmation_confirm_text_value: "DELETE" } do |f| %>
                <div class="mb-4">
                  <h3 class="text-base font-semibold leading-6 text-stone-900 dark:text-stone-100" id="modal-title">Delete Student Account</h3>
                  <div class="mt-2">
                    <p class="text-sm text-stone-500 dark:text-stone-400">This cannot be undone. All student data will be lost. You should only remove accounts created in error.</p>
                  </div>
                </div>

                <div class="mb-4">
                  <label class="block text-sm font-medium leading-6 text-stone-900 dark:text-stone-100 mb-2">Type DELETE to confirm</label>
                  <input type="text" class="input-primary w-full" data-confirmation-target="input" placeholder="DELETE" autocomplete="off">
                </div>

                <div class="mt-5 sm:mt-6 sm:grid sm:grid-flow-row-dense sm:grid-cols-2 sm:gap-3">
                  <button type="submit" class="btn-danger w-full sm:col-start-2 opacity-50 cursor-not-allowed" disabled data-confirmation-target="confirmButton">Delete Student</button>
                  <button type="button" class="mt-3 inline-flex w-full justify-center rounded-sm bg-white dark:bg-stone-800 px-3 py-2 text-sm font-semibold text-stone-900 dark:text-stone-100 shadow-sm ring-1 ring-inset ring-stone-300 dark:ring-stone-600 hover:bg-stone-50 dark:hover:bg-stone-700 sm:col-start-1 sm:mt-0" data-action="modal#close">Cancel</button>
                </div>
              <% end %>
            </div>
          </div>
        </details>
      <% elsif !current_user.role_superuser? && current_user != @student %>
          <p class="text-sm text-dim">Only a superuser can delete student accounts.</p>
      <% elsif current_user == @student %>
        <p class="text-sm text-dim">There are no student settings, since you are looking at your own account.</p>
      <% end %>
  </div>

</div>
