<h2 class="text-xl font-semibold">Manage Students</h2>
<div class="py-4 flex flex-row gap-2">
  <!-- Students List Column -->
  <div class="basis-48 pr-2 border-r">
    <sl-tree class="mb-6">
      <sl-tree-item expanded>
        <strong>My Students</strong>
        <% @my_students.each do |student| %>
          <sl-tree-item>
            <%= link_to student.name, admin_student_path(student), 
                data: { turbo_frame: "student-control-panel" },
                class: "hover:underline" %>
          </sl-tree-item>
        <% end.empty? and begin %>
          <sl-tree-item disabled>No students yet</sl-tree-item>
        <% end %>
      </sl-tree-item>

      <sl-tree-item expanded>
        <strong>Other Students</strong>
        <% @other_students.each do |student| %>
          <sl-tree-item>
            <div class="flex justify-between items-center w-full">
              <span><%= student.name %></span>
              <% if student.teacher.nil? %>
                <%= link_to adopt_admin_student_path(student), data: { turbo_method: :post } do %>
                  <sl-icon-button 
                    name="person-add" label="Adopt" 
                    class="text-green-600 text-lg [&::part(base)]:p-[4px]"></sl-icon-button>
                <% end %>
              <% end %>
            </div>
          </sl-tree-item>
        <% end.empty? and begin %>
          <sl-tree-item disabled>No other students</sl-tree-item>
        <% end %>
      </sl-tree-item>
    </sl-tree>
  </div>

  <!-- Control Panel Column -->
  <div class="grow pl-4 max-w-7xl">
    <%= turbo_frame_tag "student-control-panel" do %>
      <p>Select a student to view their control panel.</p>
    <% end %>
  </div>
</div>
