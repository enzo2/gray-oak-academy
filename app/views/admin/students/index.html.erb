<%= turbo_frame_tag "dashboard-content" do %>
  <h2 class="text-xl font-semibold">Manage Students</h2>
  <div class="py-4 flex flex-row gap-4">
    <!-- Students List Column -->
    <div class="basis-48 pr-2 border-r">
      <h3 class="text-lg mb-4">My Students</h3>
      <div class="mb-6">
        <ul class="divide-y divide-stone-200 dark:divide-stone-700">
          <% @my_students.each do |student| %>
            <li class="py-1">
              <div class="flex justify-between items-center">
                  <%= link_to student.name, admin_student_path(student), data: { turbo_frame: "student-control-panel" }, class: "hover:underline font-medium" %>
              </div>
            </li>
          <% end.empty? and begin %>
            <i>No students yet</i>
          <% end %>
        </ul>
      </div>

      <hr class="mb-4">

      <div class="mb-6">
        <h2 class="text-lg mb-4">Other Students</h2>
        <ul class="divide-y divide-stone-200 dark:divide-stone-700">
          <% @other_students.each do |student| %>
            <li class="py-1">
              <div class="flex justify-between items-center">
                <span class="font-medium">
                  <%= student.name %>
                </span>
                <% if student.teacher.nil? %>
                  <%= button_to 'Adopt', adopt_admin_student_path(student), method: :post, 
                      data: { turbo_stream: true },
                      class: "btn-primary" %>
                <% end %>
              </div>
            </li>
          <% end.empty? and begin %>
            <i>No other students</i>
          <% end %>
        </ul>
      </div>
    </div>

    <!-- Control Panel Column -->
    <div class="grow pl-4">
      <%= turbo_frame_tag "student-control-panel" do %>
        <p>Select a student to view their control panel.</p>
      <% end %>
    </div>
  </div>
<% end %>