<%= turbo_frame_tag "dashboard-content" do %>
  <div class="p-4 flex">
    <!-- Students List Column -->
    <div class="w-1/3 pr-4 border-r">
      <h1 class="text-2xl font-bold mb-4">Students Panel</h1>

      <div class="mb-6">
        <h2 class="text-xl font-semibold">My Students</h2>
        <ul>
          <% @my_students.each do |student| %>
            <li class="border-b border-gray-200 py-4">
              <div class="flex justify-between items-center">
                <span class="font-medium">
                  <%= link_to student.name, admin_student_path(student), data: { turbo_frame: "student-control-panel" }, class: "text-blue-500 hover:underline" %>
                </span>
              </div>
            </li>
          <% end %>
        </ul>
      </div>

      <div class="mb-6">
        <h2 class="text-xl font-semibold">Other Students</h2>
        <ul>
          <% @other_students.each do |student| %>
            <li class="border-b border-gray-200 py-4">
              <div class="flex justify-between items-center">
                <span class="font-medium">
                  <%= student.name %>
                </span>
                <%= button_to 'Adopt', adopt_admin_student_path(student), method: :post, 
                data: { turbo_stream: true },
                class: "btn-primary" %>
              </div>
            </li>
          <% end %>
        </ul>
      </div>
    </div>

    <!-- Control Panel Column -->
    <div class="w-2/3 pl-4">
      <%= turbo_frame_tag "student-control-panel" do %>
        <p>Select a student to view their control panel.</p>
      <% end %>
    </div>
  </div>
<% end %>
