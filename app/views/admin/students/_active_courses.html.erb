<h3 class="text-lg mb-2">Enrolled Courses</h3>
<div class="w-full grid grid-cols-1 sm:grid-cols-[repeat(auto-fill,minmax(20rem,1fr))] gap-4 mb-6">

  <% enrollments.each do |enrollment| %>
    <div id="<%= dom_id(enrollment) %>" class="p-4 rounded-sm border border-stone-300 dark:border-stone-700">
      <span class="font-medium mb-2 block"><%= enrollment.course.title %></span>

      <div class="mb-4 block">
        <%= render partial: "enrollments/enrollment_progress_bar", locals: { enrollment: enrollment } %>
      </div>

      <div class="mb-4 flex justify-start">
        <% if enrollment.has_available_lesson? %>
          <% if current_user == enrollment.student # Allow teachers to take lessons for themselves %>
            <%= link_to student_lesson_path(enrollment.next_available_lesson), 
                  class: "block btn-primary text-sm" do %>
              <div class="flex items-center">
                <sl-icon name="check-circle-fill" class="text-stone-700 dark:text-stone-300 pr-2"></sl-icon>
                <span>&nbsp;<%= enrollment.next_available_lesson.started_by?(current_user) ? "Continue" : "Start next" %> lesson</span>
              </div>
            <% end %>
          <% else %>
            <sl-icon name="check-circle-fill" class="text-lg mr-2 shrink-0 text-green-500" title="Available lessons"></sl-icon>
            <span class="text-sm">Next lesson ready.</span>
          <% end %>
        <% else %>
          <sl-icon name="exclamation-circle-fill" class="text-lg text-yellow-500 mr-2 shrink-0" title="No available lessons"></sl-icon>
          <span class="text-sm">No lessons available for student. Please 
            <%= link_to "publish a lesson plan", admin_course_lessons_path(enrollment.course), class: "underline" %>.
            </span>
        <% end %>
      </div>

      <% if enrollment.completed_lessons_count > 0 %>
        <div class="mb-4">
          <%= link_to enrollment_path(enrollment), class: "btn-primary text-sm inline-flex items-center" do %>
            <div class="flex items-center">
              <sl-icon name="journal-bookmark" class="text-stone-700 dark:text-stone-200"></sl-icon>
              <span>&nbsp;View Past Lessons</span>
            </div>
          <% end %>
        </div>
      <% end %>

      <div data-controller="modal">
        <button type="button" class="btn-danger text-sm" data-action="modal#open">Un-enroll</button>
        <div data-modal-target="content" class="hidden">
            <%= form_with url: unenroll_admin_student_path(@student, course_id: enrollment.course.id), method: :delete, class: "p-6", 
                  data: {  controller: "confirmation", confirmation_confirm_text_value: "UNENROLL" } do |f| %>
                <div class="mb-4">
                  <h3 class="text-base font-semibold leading-6 text-stone-900 dark:text-stone-100" id="modal-title">Un-enroll from <%= enrollment.course.title %></h3>
                  <div class="mt-2">
                    <p class="text-sm text-stone-500 dark:text-stone-400">
                      WARNING! This will delete all student progress and cannot be reversed.
                      <br><br>
                      Student reports will be orphaned. It is better to retain the enrollment for record-keeping.
                    </p>
                  </div>
                </div>

                <div class="mb-4">
                  <label class="block text-sm font-medium leading-6 text-stone-900 dark:text-stone-100 mb-2">Type UNENROLL to confirm</label>
                  <input type="text" class="input-primary w-full" data-confirmation-target="input" placeholder="UNENROLL" autocomplete="off">
                </div>

                <div class="mt-5 sm:mt-6 sm:grid sm:grid-flow-row-dense sm:grid-cols-2 sm:gap-3">
                  <button type="submit" class="btn-danger w-full sm:col-start-2 opacity-50 cursor-not-allowed" disabled data-confirmation-target="confirmButton">Un-enroll</button>
                  <button type="button" class="mt-3 inline-flex w-full justify-center rounded-sm bg-white dark:bg-stone-800 px-3 py-2 text-sm font-semibold text-stone-900 dark:text-stone-100 shadow-sm ring-1 ring-inset ring-stone-300 dark:ring-stone-600 hover:bg-stone-50 dark:hover:bg-stone-700 sm:col-start-1 sm:mt-0" data-action="modal#close">Cancel</button>
                </div>
            <% end %>
        </div>
      </div>

    </div>
  <% end %>

</div>
