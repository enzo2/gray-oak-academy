<h2 class="text-2xl font-bold mb-5">Courses</h2>

<div class="mb-4">
  <%= turbo_frame_tag Course.new do %>
    <%= link_to "New Course", new_admin_course_path, class: "btn-primary" %>
  <% end %>
</div>

<table class="w-full border-collapse mb-8">
  <thead>
    <tr class="border-b border-stone-800 dark:border-stone-200">
      <th class="py-2 px-3 text-left">Title</th>
      <th class="py-2 px-3 text-left">Summary</th>
      <th class="py-2 px-3 text-center">Grade Level</th>
      <th class="py-2 px-3 text-center">Status</th>
      <th class="py-2 px-3 text-right">Actions</th>
    </tr>
  </thead>
  <tbody id="courses-table-body">
      <% if @active_courses.any? %>
        <%= render @active_courses %>
      <% else %>
        <tr id="no_courses">
          <td colspan="5" class="py-4 px-6 text-center">No courses added.</td>
        </tr>
      <% end %>
  </tbody>
</table>

<% if @archived_courses.any? %>
  <h3 class="text-xl font-semibold mb-2">Archived Courses</h3>
  <table class="w-full border-collapse">
    <thead>
      <tr class="border-b border-stone-800 dark:border-stone-200">
        <th class="py-2 px-3 text-left">Title</th>
        <th class="py-2 px-3 text-left">Summary</th>
        <th class="py-2 px-3 text-center">Grade Level</th>
        <th class="py-2 px-3 text-center">Status</th>
        <th class="py-2 px-3 text-right">Actions</th>
      </tr>
    </thead>
    <tbody id="archived-courses-table-body">
      <%= render @archived_courses %>
    </tbody>
  </table>
<% end %>