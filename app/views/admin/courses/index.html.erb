<h2 class="text-2xl font-bold mb-5">Courses</h2>

<div class="mb-4">
  <%= turbo_frame_tag Course.new do %>
    <%= link_to new_admin_course_path, class: "btn-primary" do %>
      <sl-icon name="plus-lg"></sl-icon>
      New Course
    <% end %>
  <% end %>
</div>

<div class="w-full mb-8">
  <div class="hidden md:grid items-end
              md:grid-cols-[minmax(0,1.5fr)_minmax(0,3.4fr)_minmax(0,0.6fr)_minmax(0,0.5fr)]
              lg:grid-cols-[minmax(14rem,1.5fr)_minmax(18rem,3.4fr)_minmax(0,0.6fr)_minmax(9rem,0.5fr)]
              gap-3 border-b border-stone-800 dark:border-stone-200 py-2 font-bold">
    <div>Title</div>
    <div>Summary</div>
    <div class="text-left">Status</div>
    <div class="text-right">Actions</div>
  </div>
  
  <div id="courses-table-body">
      <% if @active_courses.any? %>
        <%= render @active_courses %>
      <% else %>
        <div id="no_courses" class="py-4 px-6 text-center border-b border-stone-600 dark:border-stone-400">
          No courses added.
        </div>
      <% end %>
  </div>
</div>

<% if @archived_courses.any? %>
  <h3 class="text-xl font-semibold mb-2">Archived Courses</h3>
  <div class="w-full">
    <div class="hidden md:grid
                md:grid-cols-[minmax(0,1.5fr)_minmax(0,3.4fr)_minmax(0,0.6fr)_minmax(0,0.5fr)]
              lg:grid-cols-[minmax(14rem,1.5fr)_minmax(18rem,3.4fr)_minmax(0,0.6fr)_minmax(11rem,0.5fr)]
                gap-3 border-b border-stone-800 dark:border-stone-200 py-2 font-bold">
      <div>Title</div>
      <div>Summary</div>
      <div class="text-left">Status</div>
      <div class="text-right">Actions</div>
    </div>

    <div id="archived-courses-table-body">
      <%= render @archived_courses %>
    </div>
  </div>
<% end %>
