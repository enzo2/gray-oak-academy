  <table class="w-full border-collapse">
    <thead>
      <tr class="border-b">
        <th class="py-2 px-6 text-left">Title</th>
        <th class="py-2 px-6 text-left">Summary</th>
        <th class="py-2 px-6 text-center">Grade Level</th>
        <th class="py-2 px-6 text-right">Actions</th>
      </tr>
    </thead>
    <tbody>
      <% if @courses.any? %>
        <% @courses.each do |course| %>
          <%= render partial: "course", locals: { course: course } %>
        <% end %>
      <% else %>
        <tr>
          <td colspan="4" class="py-4 px-6 text-center">No courses available.</td>
        </tr>
      <% end %>
    </tbody>
  </table>