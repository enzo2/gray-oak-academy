<%= form_with(model: [:admin, course], id: "course-form") do |f| %>
  <% if course.errors.any? %>
    <div class="mb-4 text-red-950 dark:text-red-300">
      <%= pluralize(course.errors.count, "error") %> prevented this course from being saved.
      <ul>
        <% course.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-4">
    <%= f.label :title, class: "form-label" %>
    <%= f.text_field :title, class: "form-input", required: true %>
  </div>

  <div class="mb-4">
    <%= f.label :summary, class: "form-label" %>
    <p class="block text-sm mb-2"><i>Briefly describe the course goals.</i></p>
    <%= f.text_area :summary, class: "form-input", required: true %>
  </div>

  <div class="mb-4">
    <%= f.label :grade_level, class: "form-label" %>
    <%= f.text_field :grade_level, class: "form-input", required: true %>
  </div>

  <div class="mb-4" data-controller="outline" data-outline-target="fieldContainer">
    <%= f.label :outline, "Course Outline", class: "form-label" %>
    <p class="block text-sm mb-2">      
      <i>The outline will be used to generate the list of lessons. Include any desired content.<br>
      You can also have the LLM generate it for you.
      </i>
    </p>

    <% if course.outline.empty? && course.persisted? %>
      <%= link_to generate_outline_admin_course_path(course), 
        data: { 
          turbo_method: :post,
          turbo_confirm: "This will call the LLM to generate an outline. Are you sure?" }, 
          class: "block mb-2" do %>
        <sl-button id="generate-outline-button-<%= course.id %>" outline variant="success">
          <sl-icon slot="prefix" name="lightbulb"></sl-icon>
          Generate outline
        </sl-button>
      <% end %>
    <% end %>

    <% if course.outline.any? %>
      <% course.outline.each do |item| %>
        <div class="flex items-center mb-2 space-x-2">
          <%= text_field_tag "course[outline_topics][]", item.keys.first, placeholder: "Topic", class: "form-input w-1/4" %>
          <%= text_field_tag "course[outline_details][]", item.values.first, placeholder: "Details", class: "form-input w-3/4" %>
          <sl-icon-button name="arrow-up" class="move-up" data-action="click->outline#moveUp"></sl-icon-button>
          <sl-icon-button name="arrow-down" class="move-down" data-action="click->outline#moveDown"></sl-icon-button>
          <sl-icon-button name="x-circle" class="remove-field" data-action="click->outline#removeField"></sl-icon-button>
        </div>
      <% end %>
    <% end %>
    <sl-button class="mb-2" data-action="click->outline#addField" outline>
      <sl-icon slot="prefix" name="plus-circle"></sl-icon>
      Add outline item
    </sl-button>
    <template>
      <div class="flex items-center mb-2 space-x-2">
        <%= text_field_tag "course[outline_topics][]", "", placeholder: "Topic", class: "form-input w-1/4", required: true %>
        <%= text_field_tag "course[outline_details][]", "", placeholder: "Details", class: "form-input w-3/4", required: true %>
        <sl-icon-button name="arrow-up" class="move-up" data-action="click->outline#moveUp"></sl-icon-button>
        <sl-icon-button name="arrow-down" class="move-down" data-action="click->outline#moveDown"></sl-icon-button>
        <sl-icon-button name="x-circle" class="remove-field" data-action="click->outline#removeField"></sl-icon-button>
      </div>
    </template>
  </div>

  <div class="flex flex-row space-x-5">
    <%= f.submit "Submit", class: "btn-primary" %>
    <%= link_to "Cancel", admin_courses_path, class: "btn-primary" %>
  </div>
<% end %>
