<%= form_with(model: [:admin, course], id: course_form_dom_id(course)) do |f| %>
  <% if course.errors.any? %>
    <div class="mb-4 text-danger-950 dark:text-danger-300">
      <%= pluralize(course.errors.count, "error") %> prevented this course from being saved.
      <ul>
        <% course.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-4">
    <%= f.label :title, class: "form-label" %>
    <%= f.text_field :title, class: "input-primary", required: true %>
  </div>

  <div class="mb-4">
    <%= f.label :summary, class: "form-label" %>
    <p class="block text-sm mb-2"><i>Briefly describe the course goals. This will be used to generate the outline.</i></p>
    <%= f.text_area :summary, class: "input-primary", required: true, rows: 4 %>
  </div>

  <div class="mb-2">
    <%= f.label :grade_level, class: "form-label" %>
    <%= f.text_field :grade_level, class: "input-primary", required: true %>
  </div>
  <p class="text-sm mb-4"><i>Hint: The grade level is useful for tuning the LLM's behavior. It doesn't have the be the exact grade level of the student.</i></p>

  <div class="mb-4 relative"
       data-controller="outline"
       data-action="submit@document->outline#guardResearchStart"
       data-outline-target="fieldContainer">
    <%= f.label :outline, "Course Outline", class: "form-label" %>
    <p class="block text-sm mb-2">   
      <i>
        <% if course.outline.empty? %>To have the LLM draft the course outline, leave it blank for now.<br><% end %>   
        The outline will be used by the LLM to generate the list of lessons. Include any desired content.
      </i>
    </p>

    <%= render "admin/courses/outline_research_lock_state", course: course %>
    <div class="hidden absolute inset-0 z-10 rounded-md bg-stone-50/85 backdrop-blur-[1px] dark:bg-stone-950/80"
         data-outline-target="lockOverlay"
         aria-hidden="true">
      <div class="flex h-full items-center justify-center p-6">
        <div class="max-w-xl rounded-md border border-stone-300 bg-white/95 px-4 py-3 text-center text-sm text-stone-700 shadow-sm dark:border-stone-700 dark:bg-stone-900/95 dark:text-stone-200">
          <p class="font-semibold">Course Editor Locked</p>
          <p class="mt-1" data-outline-target="lockMessage"></p>
        </div>
      </div>
    </div>

    <div class="outline-fields space-y-3">
      <% if course.outline.any? %>
        <% course.outline.each_with_index do |item, index| %>
          <div class="outline-field group rounded-sm border-l-3 border-moss-400 dark:border-moss-700 bg-paper-50 dark:bg-paper-950/40 shadow-sm focus-within:shadow-md transition-shadow" data-index="<%= index %>">
            <div class="flex items-center gap-1 px-2 py-1.5 bg-paper-100/80 dark:bg-paper-900/30 rounded-tr-sm">
              <span class="text-paper-500 dark:text-paper-600 text-xs font-mono select-none shrink-0 mr-0.5"><%= index + 1 %></span>
              <%= text_field_tag "course[outline_topics][]", item.keys.first, placeholder: "Topic", class: "flex-1 bg-transparent border-none focus:ring-0 focus:outline-none text-sm font-semibold tracking-wide uppercase text-moss-800 dark:text-moss-300 placeholder-paper-700 dark:placeholder-paper-600 py-0 px-1" %>
              <div class="flex items-center shrink-0 opacity-0 group-hover:opacity-100 focus-within:opacity-100 transition-opacity">
                <sl-icon-button name="chevron-up" class="move-up text-xs" data-action="click->outline#moveUp" data-index="<%= index %>"></sl-icon-button>
                <sl-icon-button name="chevron-down" class="move-down text-xs" data-action="click->outline#moveDown" data-index="<%= index %>"></sl-icon-button>
                <sl-icon-button name="x-lg" class="remove-field text-xs" data-action="click->outline#removeField"></sl-icon-button>
              </div>
            </div>
            <%= text_area_tag "course[outline_details][]", item.values.first, placeholder: "Describe the scope, themes, goals, or notes for this topic...", class: "outline-native-autosize w-full bg-transparent border-none focus:ring-0 focus:outline-none text-sm leading-relaxed text-paper-900 dark:text-paper-200 placeholder-paper-700 dark:placeholder-paper-600 px-3 py-2 resize-none overflow-hidden", rows: 1, data: { action: "input->outline#autoResize" } %>
          </div>
        <% end %>
      <% end %>
    </div>
    <sl-button class="mt-3 mb-2" data-action="click->outline#addField" outline>
      <sl-icon slot="prefix" name="plus-circle"></sl-icon>
      Add outline item
    </sl-button>
    <template>
      <div class="outline-field group rounded-sm border-l-3 border-moss-400 dark:border-moss-700 bg-paper-50 dark:bg-paper-950/40 shadow-sm focus-within:shadow-md transition-shadow">
        <div class="flex items-center gap-1 px-2 py-1.5 bg-paper-100/80 dark:bg-paper-900/30 rounded-tr-sm">
          <span class="text-paper-500 dark:text-paper-600 text-xs font-mono select-none shrink-0 mr-0.5">&bull;</span>
          <%= text_field_tag "course[outline_topics][]", "", placeholder: "Topic", class: "flex-1 bg-transparent border-none focus:ring-0 focus:outline-none text-sm font-semibold tracking-wide uppercase text-moss-800 dark:text-moss-300 placeholder-paper-700 dark:placeholder-paper-600 py-0 px-1", required: true %>
          <div class="flex items-center shrink-0 opacity-0 group-hover:opacity-100 focus-within:opacity-100 transition-opacity">
            <sl-icon-button name="chevron-up" class="move-up text-xs" data-action="click->outline#moveUp"></sl-icon-button>
            <sl-icon-button name="chevron-down" class="move-down text-xs" data-action="click->outline#moveDown"></sl-icon-button>
            <sl-icon-button name="x-lg" class="remove-field text-xs" data-action="click->outline#removeField"></sl-icon-button>
          </div>
        </div>
        <%= text_area_tag "course[outline_details][]", "", placeholder: "Describe the scope, themes, goals, or notes for this topic...", class: "outline-native-autosize w-full bg-transparent border-none focus:ring-0 focus:outline-none text-sm leading-relaxed text-paper-900 dark:text-paper-200 placeholder-paper-700 dark:placeholder-paper-600 px-3 py-2 resize-none overflow-hidden", required: true, rows: 1, data: { action: "input->outline#autoResize" } %>
      </div>
    </template>
  </div>

  <div class="flex flex-row space-x-5">
    <span>
      <%= f.submit "Save", class: "btn-primary" %>
      <%= link_to "Cancel", admin_courses_path, class: "btn-secondary" %>
    </span>
  </div>
<% end %>
