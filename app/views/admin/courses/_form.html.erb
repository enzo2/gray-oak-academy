<%= form_with(model: [:admin, @course], id: "course-form") do |f| %>
  <% if @course.errors.any? %>
    <div class="mb-4 text-red-950 dark:text-red-300">
      <%= pluralize(@course.errors.count, "error") %> prevented this course from being saved.
      <ul>
        <% @course.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-4">
    <%= f.label :title, class: "form-label" %>
    <%= f.text_field :title, class: "form-input" %>
  </div>

  <div class="mb-4">
    <%= f.label :summary, class: "form-label" %>
    <%= f.text_area :summary, class: "form-input" %>
  </div>

  <div class="mb-4">
    <%= f.label :grade_level, class: "form-label" %>
    <%= f.text_field :grade_level, class: "form-input" %>
  </div>

  <!--update to support dynamic key:value entry-->
  <div class="mb-4">
    <%= f.label :outline, class: "form-label" %>
    <%= f.text_area :outline, class: "form-input" %>
  </div>

  <div class="flex flex-row space-x-5">
    <%= f.submit "Submit", class: "btn-primary" %>
    <%= link_to "Cancel", admin_courses_path, class: "btn-primary" %>
  </div>
<% end %>