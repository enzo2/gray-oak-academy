<%= form_with(model: [:admin, @course], id: "course-form") do |f| %>
  <% if @course.errors.any? %>
    <div class="mb-4 text-red-950 dark:text-red-300">
      <%= pluralize(@course.errors.count, "error") %> prevented this course from being saved.
      <ul>
        <% @course.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-4">
    <%= f.label :title, class: "form-label" %>
    <%= f.text_field :title, class: "form-input" %>
  </div>

  <div class="mb-4">
    <%= f.label :summary, class: "form-label" %>
    <%= f.text_area :summary, class: "form-input" %>
  </div>

  <div class="mb-4">
    <%= f.label :grade_level, class: "form-label" %>
    <%= f.text_field :grade_level, class: "form-input" %>
  </div>

<div class="mb-4" data-controller="outline" data-outline-target="fieldContainer">
  <%= f.label :outline, "Course Outline", class: "form-label" %>
  <% outline_data = @course.outline.presence || { "" => "" } %>
  <% outline_data.each do |key, value| %>
    <div class="flex mb-2 space-x-2">
      <%= text_field_tag "course[outline_keys][]", key, placeholder: "Key", class: "form-input w-1/4" %>
      <%= text_field_tag "course[outline_values][]", value, placeholder: "Value", class: "form-input w-3/4" %>
      <sl-icon-button name="x-circle" class="remove-field p-2" data-action="click->outline#removeField"></sl-icon-button>
    </div>
  <% end %>
  <sl-icon-button name="plus-circle" label="Add outline section" class="my-2" data-action="click->outline#addField">Add Outline Field</sl-icon-button>
</div>

  <div class="flex flex-row space-x-5">
    <%= f.submit "Submit", class: "btn-primary" %>
    <%= link_to "Cancel", admin_courses_path, class: "btn-primary" %>
  </div>
<% end %>