<div class="w-full max-w-7xl">
  <%= link_to "Back to courses", admin_courses_path, class: "inline-block hover:underline mb-2" %>

  <h2 class="text-2xl my-2">Edit Course: <b><%= @course.title %></b></h2>
  <% outline_present = @course.outline.present? %>
  <% outline_research_available = AppSetting.background_agent_enabled_for?(current_user) && AppSetting.exa_enabled? %>

  <% if outline_present && outline_research_available %>
    <%= render "admin/courses/outline_research_panel_container", course: @course %>
  <% end %>

  <% unless outline_present %>
    <div class="mb-6 border border-stone-300 dark:border-stone-700 rounded-md p-4">
      <h3 class="text-lg font-semibold mb-2">Generate Outline</h3>
      <p class="text-sm mb-3">
        This course does not have an outline yet. You can generate one now.
      </p>
      <%= form_with url: generate_outline_admin_course_path(@course, source: "edit"), method: :post,
        data: { controller: "button-loading" },
        class: "inline-flex" do %>
        <button type="submit" id="generate-outline-button-<%= @course.id %>" class="btn-success inline-flex items-center justify-center gap-2">
          <sl-icon name="lightbulb"></sl-icon>
          <span>Generate Outline</span>
        </button>
      <% end %>
    </div>
  <% end %>

  <%= render "admin/courses/form", course: @course %>

  <% if outline_present && outline_research_available %>
    <%= render "admin/courses/outline_research_snapshot_container", course: @course %>
  <% end %>
  <br>
</div>
