<div class="w-full max-w-7xl">
  <%= link_to "Back to courses", admin_courses_path, class: "inline-block hover:underline mb-2" %>

  <h2 class="text-2xl my-2">Edit Course: <b><%= @course.title %></b></h2>
  <% outline_present = @course.outline.present? %>
  <% outline_research_available = AppSetting.openai_agent_enabled? && AppSetting.exa_enabled? %>

  <%= render "admin/courses/form", course: @course %>

  <% unless outline_present %>
    <div class="mt-6 border border-stone-300 dark:border-stone-700 rounded-md p-4">
      <h3 class="text-lg font-semibold mb-2">Generate Outline</h3>
      <p class="text-sm mb-3">
        This course does not have an outline yet. You can generate one now from this page.
      </p>
      <%= form_with url: generate_outline_admin_course_path(@course), method: :post, local: true do %>
        <button type="submit" class="btn-primary">Generate Outline</button>
      <% end %>
    </div>
  <% end %>

  <% if outline_present && outline_research_available %>
    <%= render "admin/courses/outline_research_panel", course: @course %>
  <% end %>
  <br>
</div>
