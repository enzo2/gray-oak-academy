<div id="outline-research-panel" class="mt-6 mb-6 border border-stone-300 dark:border-stone-700 rounded-md p-4">
  <h3 class="text-xl font-semibold mb-2">Outline Research</h3>
  <p class="text-sm mb-3">
    Optional course-level research pass. This can take ~5 minutes and will produce a report plus teacher questions.
  </p>

  <% show_research_button = course.outline_research_stage != "completed" %>
  <div class="flex flex-wrap gap-2 items-center mb-3">
    <% disable_research_button = course.outline_research_in_progress? || course.outline_research_restart_blocked? %>
    <% if show_research_button %>
      <%= form_with url: start_outline_research_admin_course_path(course),
                    method: :post,
                    data: {
                      outline_research_start: true,
                      outline_dirty_message: "Save or discard your course edits before starting outline research."
                    } do %>
        <button type="submit" class="btn-success inline-flex items-center justify-center gap-2" <%= "disabled" if disable_research_button %>>
          <% if course.outline_research_in_progress? %>
            <sl-spinner></sl-spinner>
            Research In Progress
          <% else %>
            <sl-icon name="search"></sl-icon>
            Research Outline
          <% end %>
          </button>
      <% end %>
    <% end %>

    <% if course.course_prior_state.present? %>
      <%= form_with url: undo_outline_research_changes_admin_course_path(course), method: :post do %>
        <button type="submit" class="btn-secondary">Undo Latest Agent Changes</button>
      <% end %>
    <% end %>

    <% if course.outline_research_review_page_available? %>
      <%= link_to "Review Research Workspace",
                  outline_research_input_admin_course_path(course),
                  class: "btn-secondary" %>
    <% end %>
  </div>
  <% unless show_research_button %>
    <p class="text-xs text-dim mb-3">Research complete. Use the workspace link below to review outcomes.</p>
  <% end %>

  <% outline_research = course.outline_research_hash %>
  <% exa_status = outline_research.dig("exa_research", "status").to_s.downcase %>
  <% exa_running = course.outline_research_stage == "researching_outline" && %w[queued pending in_progress running processing].include?(exa_status) %>
  <% apply_agent_summary_md = outline_research["apply_agent_summary_md"].to_s %>
  <% apply_completed_at_raw = outline_research["apply_completed_at"].to_s %>
  <% apply_completed_at = begin Time.zone.parse(apply_completed_at_raw) rescue nil end %>
  <% outline_failed_classes = "rounded border border-danger-300 bg-danger-50/70 px-4 py-[0.9rem] dark:border-danger-800 dark:bg-danger-950/20" %>
  <% outline_failed_header_classes = "flex items-center gap-3" %>
  <% outline_failed_badge_classes = "inline-flex h-[1.8rem] w-[1.8rem] items-center justify-center rounded-full bg-gradient-to-b from-danger-600 to-danger-700 text-[0.95rem] font-bold text-white ring-2 ring-danger-500/20" %>
  <% outline_complete_classes = "rounded border border-moss-500/45 bg-gradient-to-b from-moss-100/70 to-stone-100/70 px-4 py-[0.9rem] dark:border-moss-700 dark:from-stone-900 dark:to-stone-800" %>
  <% outline_complete_header_classes = "flex items-center gap-3" %>
  <% outline_complete_badge_classes = "inline-flex h-[1.8rem] w-[1.8rem] items-center justify-center rounded-full bg-gradient-to-b from-moss-600 to-moss-700 text-[0.9rem] font-bold text-white ring-2 ring-moss-500/25" %>
  <% outline_complete_report_classes = "prose mt-3 max-w-none rounded border border-stone-300 bg-white/90 px-[0.85rem] py-3 text-sm dark:border-stone-700 dark:bg-stone-900/90 dark:prose-invert" %>
  <% source_anchor_count = Array(outline_research["source_anchors"]).size %>
  <% question_count = Array(course.outline_guidance_questions).size %>
  <% unanswered_count = course.unanswered_research_question_ids.size %>
  <% has_content_below_status = course.outline_research_stage == "failed" ||
                                course.outline_research_stage == "completed" ||
                                source_anchor_count.positive? ||
                                question_count.positive? ||
                                course.outline_research_input_open? %>
  <p class="text-sm mb-2">
    <b>Status:</b> <%= course.outline_research_stage.humanize %><%= raw(" &mdash; running...") if exa_running %>
  </p>
  <% if course.outline_research_error.present? %>
    <p class="mb-2 text-sm text-danger-700 dark:text-danger-300">
      <b>Error:</b> <%= course.outline_research_error %>
    </p>
  <% end %>
  <% if course.outline_research_stage == "failed" %>
    <div class="<%= outline_failed_classes %> mb-3">
      <div class="<%= outline_failed_header_classes %>">
        <span class="<%= outline_failed_badge_classes %>" aria-hidden="true">!</span>
        <div>
          <h4 class="font-semibold text-base">Research run failed</h4>
          <% if course.outline_research_resumable_run? %>
            <p class="text-sm">This run can still be resumed from the review workspace after confirming teacher inputs.</p>
          <% else %>
            <p class="text-sm">This run is not resumable. Start a new outline research run to continue.</p>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>
  <% if has_content_below_status %>
    <div class="mt-3 mb-4 border-t border-stone-200 dark:border-stone-700"></div>
  <% end %>

  <% if course.outline_research_stage == "completed" %>
    <div class="<%= outline_complete_classes %> mb-4">
      <div class="<%= outline_complete_header_classes %>">
        <span class="<%= outline_complete_badge_classes %>" aria-hidden="true">✓</span>
        <div>
          <h4 class="font-semibold text-base">Research Pipeline Complete</h4>
          <p class="text-sm">Guidance has been applied and your course has been updated.</p>
        </div>
      </div>
      <% if apply_completed_at.present? %>
        <p class="text-xs text-stone-600 dark:text-stone-300 mt-2">
          Completed <%= apply_completed_at.strftime("%b %-d, %Y %-I:%M %p %Z") %>
        </p>
      <% end %>
      <% if apply_agent_summary_md.present? %>
        <div class="<%= outline_complete_report_classes %>">
          <%= markdown(apply_agent_summary_md) %>
        </div>
      <% else %>
        <p class="text-sm mt-2">No completion summary was returned by the model.</p>
      <% end %>
    </div>
  <% end %>

  <% if source_anchor_count.positive? || question_count.positive? %>
    <div class="mb-3 text-sm">
      <% if source_anchor_count.positive? %>
        <p><b>Source anchors:</b> <%= source_anchor_count %> total.</p>
      <% end %>
      <% if question_count.positive? %>
        <p><b>Teacher questions:</b> <%= question_count %> total, <%= unanswered_count %> unanswered.</p>
      <% end %>
    </div>
  <% end %>

  <% if course.outline_research_input_open? %>
    <div class="border border-stone-200 dark:border-stone-700 rounded p-3">
      <h4 class="font-semibold mb-2"><%= course.awaiting_outline_research_input? ? "Awaiting Teacher Input" : "Research Workspace Available" %></h4>
      <p class="text-sm mb-3">
        <% if course.awaiting_outline_research_input? %>
          Continue in the dedicated review workspace to inspect findings, answer teacher questions, and resume the apply phase.
        <% elsif course.outline_research_resumable_run? %>
          Continue in the review workspace to inspect findings, adjust answers, and resume this failed run.
        <% else %>
          Continue in the review workspace to inspect findings before starting a new run from this page.
        <% end %>
      </p>
      <%= link_to "Review Outline Research",
                  outline_research_input_admin_course_path(course),
                  class: "btn-secondary" %>
    </div>
  <% end %>
</div>
