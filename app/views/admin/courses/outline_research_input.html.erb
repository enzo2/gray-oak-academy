<% outline_research = @course.outline_research_hash %>
<% source_anchors = @source_anchors || Array(outline_research["source_anchors"]).map { |anchor| anchor.is_a?(Hash) ? anchor : {} } %>
<% questions = @questions || Array(@course.outline_guidance_questions).select { |q| q.is_a?(Hash) && q["id"].to_s.present? } %>
<% answers = @course.outline_guidance_answers_hash %>
<% unanswered = @course.unanswered_research_question_ids.size %>
<% resumable_run = @course.outline_research_resumable_run? %>
<% ready_to_resume = resumable_run && unanswered.zero? %>
<% apply_agent_summary_md = outline_research["apply_agent_summary_md"].to_s %>
<% apply_completed_at_raw = outline_research["apply_completed_at"].to_s %>
<% apply_completed_at = begin Time.zone.parse(apply_completed_at_raw) rescue nil end %>
<% apply_in_progress = @course.outline_research_stage == "applying_guidance_updates" %>
<% pipeline_completed = @course.outline_research_stage == "completed" %>
<% outline_failed_classes = "rounded border border-red-300 bg-red-50/70 px-4 py-[0.9rem] dark:border-red-800 dark:bg-red-950/20" %>
<% outline_failed_header_classes = "flex items-center gap-3" %>
<% outline_failed_badge_classes = "inline-flex h-[1.8rem] w-[1.8rem] items-center justify-center rounded-full bg-gradient-to-b from-red-600 to-red-700 text-[0.95rem] font-bold text-white ring-2 ring-red-500/20" %>
<% outline_complete_classes = "rounded border border-moss-500/45 bg-gradient-to-b from-moss-100/70 to-stone-100/70 px-4 py-[0.9rem] dark:border-moss-700 dark:from-stone-900 dark:to-stone-800" %>
<% outline_complete_header_classes = "flex items-center gap-3" %>
<% outline_complete_badge_classes = "inline-flex h-[1.8rem] w-[1.8rem] items-center justify-center rounded-full bg-gradient-to-b from-moss-600 to-moss-700 text-[0.9rem] font-bold text-white ring-2 ring-moss-500/25" %>
<% outline_complete_report_classes = "prose mt-3 max-w-none rounded border border-stone-300 bg-white/90 px-[0.85rem] py-3 text-sm dark:border-stone-700 dark:bg-stone-900/90 dark:prose-invert" %>
<% outline_findings_classes = "rounded border border-stone-300 bg-stone-50/90 px-[0.95rem] py-[0.85rem] dark:border-stone-700 dark:bg-stone-900/90" %>
<% stepper_shell_classes = "rounded border border-stone-300 bg-gradient-to-b from-stone-50 to-stone-100 p-3 min-[769px]:p-[0.85rem] min-[900px]:p-[1.1rem] dark:border-stone-700 dark:from-stone-900 dark:to-stone-800" %>
<% research_progress_classes = "relative mb-6 grid grid-cols-3 gap-[0.4rem] pt-[0.1rem] before:pointer-events-none before:absolute before:left-[calc(100%/6)] before:right-[calc(100%/6)] before:top-[1.1rem] before:z-0 before:h-[2px] before:bg-stone-400/70 before:content-[''] dark:before:bg-stone-600/75 min-[900px]:before:top-[1.12rem]" %>
<% research_progress_step_classes = "group relative z-10 flex min-h-[2.45rem] min-[900px]:min-h-[5.1rem] flex-col items-center justify-start gap-[0.4rem] min-[900px]:gap-[0.6rem] border-0 bg-transparent px-[0.2rem] py-[0.1rem] text-stone-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-moss-500 dark:text-stone-200" %>
<% research_progress_dot_classes = "inline-flex h-8 w-8 min-[900px]:h-[2.05rem] min-[900px]:w-[2.05rem] items-center justify-center rounded-full border border-stone-400 bg-stone-100/80 text-[0.88rem] min-[900px]:text-[0.92rem] font-bold text-stone-800 dark:border-stone-600 dark:bg-stone-900/90 dark:text-stone-300 group-data-[state=active]:border-moss-600 group-data-[state=active]:bg-moss-600 group-data-[state=active]:text-white group-data-[state=complete]:border-moss-500 group-data-[state=complete]:bg-moss-200 group-data-[state=complete]:text-stone-900 dark:group-data-[state=complete]:border-moss-600 dark:group-data-[state=complete]:bg-moss-800 dark:group-data-[state=complete]:text-stone-100" %>
<% research_progress_label_classes = "hidden text-center text-[0.85rem] font-semibold leading-tight min-[900px]:block" %>
<% research_progress_meta_classes = "hidden text-center text-[0.72rem] leading-tight opacity-80 min-[900px]:block" %>
<% step_panel_classes = "rounded border border-stone-200 bg-stone-50/90 p-4 dark:border-stone-700 dark:bg-stone-900/90" %>
<% stepper_nested_classes = "rounded border border-stone-200 bg-stone-50/90 p-[0.85rem] dark:border-stone-700 dark:bg-stone-900/90" %>
<% nested_stepper_nav_classes = "mb-4 flex flex-wrap gap-[0.4rem] overflow-visible pb-0" %>
<% nested_step_indicator_classes = "group flex items-center justify-center rounded-none border-0 bg-transparent p-0 text-stone-700 transition-transform duration-150 ease-in-out hover:-translate-y-px focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-moss-500 dark:text-stone-200 data-[state=active]:text-stone-900 dark:data-[state=active]:text-stone-100" %>
<% nested_step_indicator_dot_classes = "inline-flex h-[1.7rem] w-[1.7rem] items-center justify-center rounded-full border border-stone-400 bg-transparent text-[0.82rem] font-bold text-inherit group-data-[state=active]:border-moss-600 group-data-[state=active]:bg-moss-600 group-data-[state=active]:text-white" %>
<% question_nav_arrow_classes = "btn-secondary h-8 w-8 p-0 [&>sl-icon]:text-[0.95rem]" %>
<% autosave_status_base_classes = "text-xs transition-colors duration-150" %>
<% report_and_findings = capture do %>
  <% if @course.outline_guidance_report_md.present? %>
    <div id="guidance-report" class="mb-6 border border-stone-200 dark:border-stone-700 rounded p-4 bg-stone-50/60 dark:bg-stone-900/40">
      <h3 class="font-semibold mb-2">Guidance Report</h3>
      <div class="prose dark:prose-invert max-w-none">
        <%= markdown(@course.outline_guidance_report_md) %>
      </div>
    </div>
  <% end %>

  <div id="source-anchors" class="<%= outline_findings_classes %> mb-6 border border-stone-200 dark:border-stone-700 rounded p-4 bg-stone-50/60 dark:bg-stone-900/40">
    <h3 class="font-semibold mb-2">Raw Research Findings</h3>

    <div class="mb-4">
      <h4 class="font-semibold mb-1">Source Anchors</h4>
      <% if source_anchors.any? %>
        <div class="space-y-3">
          <% source_anchors.each_with_index do |anchor, idx| %>
            <% anchor_hash = anchor.is_a?(Hash) ? anchor : {} %>
            <div class="rounded border border-stone-200 dark:border-stone-700 p-3 bg-white/70 dark:bg-stone-900/50">
              <div class="flex flex-wrap items-start justify-between gap-2">
                <p class="text-sm font-semibold"><%= anchor_hash["title"].presence || "Source #{idx + 1}" %></p>
                <%= link_to "Convert to Resource",
                            convert_source_anchor_to_resource_admin_course_path(@course, source_anchor_index: idx),
                            class: "btn-secondary",
                            data: {
                              turbo_method: :post,
                              turbo_confirm: "Create a new resource from this source anchor?"
                            } %>
              </div>
              <% if anchor_hash["url"].present? %>
                <p class="text-xs mt-1">
                  <%= link_to anchor_hash["url"], anchor_hash["url"], target: "_blank", rel: "noopener", class: "underline break-all" %>
                </p>
              <% end %>
              <% if anchor_hash["excerpt"].present? %>
                <p class="text-sm mt-2"><%= anchor_hash["excerpt"] %></p>
              <% end %>
              <% highlights = Array(anchor_hash["highlights"]) %>
              <% if highlights.any? %>
                <ul class="list-disc pl-5 text-sm mt-2">
                  <% highlights.each do |highlight| %>
                    <li><%= highlight %></li>
                  <% end %>
                </ul>
              <% end %>
              <% if anchor_hash["notes"].present? %>
                <p class="text-xs text-dim mt-2"><%= anchor_hash["notes"] %></p>
              <% end %>
            </div>
          <% end %>
        </div>
      <% else %>
        <p class="text-sm text-dim">No source anchors were captured for this run.</p>
      <% end %>
    </div>

    <div class="mb-4">
      <h4 class="font-semibold mb-1">Coverage Gaps</h4>
      <% coverage_gaps = Array(outline_research["coverage_gaps"]) %>
      <% if coverage_gaps.any? %>
        <ul class="list-disc pl-5 space-y-1 text-sm">
          <% coverage_gaps.each do |item| %>
            <li><%= item %></li>
          <% end %>
        </ul>
      <% else %>
        <p class="text-sm text-dim">No coverage gaps returned.</p>
      <% end %>
    </div>

    <div class="mb-4">
      <h4 class="font-semibold mb-1">Factual Notes</h4>
      <% factual_notes = Array(outline_research["factual_notes"]) %>
      <% if factual_notes.any? %>
        <ul class="list-disc pl-5 space-y-1 text-sm">
          <% factual_notes.each do |item| %>
            <li><%= item %></li>
          <% end %>
        </ul>
      <% else %>
        <p class="text-sm text-dim">No factual notes returned.</p>
      <% end %>
    </div>

    <div class="mb-0">
      <h4 class="font-semibold mb-1">Alternative Approaches</h4>
      <% alternative_approaches = Array(outline_research["alternative_approaches"]) %>
      <% if alternative_approaches.any? %>
        <ul class="list-disc pl-5 space-y-1 text-sm">
          <% alternative_approaches.each do |item| %>
            <li><%= item %></li>
          <% end %>
        </ul>
      <% else %>
        <p class="text-sm text-dim">No alternate approaches returned.</p>
      <% end %>
    </div>
  </div>
<% end %>

<div class="w-full max-w-5xl">
  <div class="flex flex-wrap items-center gap-2 mb-2">
    <%= link_to "Back to course editor", edit_admin_course_path(@course), class: "inline-block hover:underline" %>
  </div>

  <h2 class="text-2xl my-2">
    <%= @read_only_report_mode ? "Outline Research Report" : "Outline Research Input" %>: <b><%= @course.title %></b>
  </h2>
  <p class="text-sm mb-4">
    Stage: <b><%= @course.outline_research_stage.humanize %></b>
  </p>

  <% if @course.outline_research_stage == "failed" %>
    <div class="<%= outline_failed_classes %> mb-4">
      <div class="<%= outline_failed_header_classes %>">
        <span class="<%= outline_failed_badge_classes %>" aria-hidden="true">!</span>
        <div>
          <h3 class="font-semibold text-base">Outline Research Run Failed</h3>
          <% if resumable_run %>
            <p class="text-sm">This run can be resumed after you review and finalize teacher inputs.</p>
          <% else %>
            <p class="text-sm">This failed run cannot be resumed because no previous response id is available.</p>
          <% end %>
        </div>
      </div>
      <% if @course.outline_research_error.present? %>
        <p class="text-sm mt-2">
          <b>Error:</b> <%= @course.outline_research_error %>
        </p>
      <% end %>
      <% unless resumable_run %>
        <div class="mt-3">
          <%= link_to "Back to course editor", edit_admin_course_path(@course), class: "btn-secondary" %>
        </div>
      <% end %>
    </div>
  <% elsif @course.outline_research_error.present? %>
    <p class="text-sm text-red-700 dark:text-red-300 mb-4">
      <b>Error:</b> <%= @course.outline_research_error %>
    </p>
  <% end %>

  <% if @read_only_report_mode %>
    <% status_badge_text = pipeline_completed ? "✓" : "..." %>
    <% status_banner = capture do %>
      <div class="<%= outline_complete_classes %> mb-4">
        <div class="<%= outline_complete_header_classes %>">
          <span class="<%= outline_complete_badge_classes %>" aria-hidden="true"><%= status_badge_text %></span>
          <div>
            <% if pipeline_completed %>
              <h3 class="font-semibold text-base">Research Pipeline Complete</h3>
              <p class="text-sm">Guidance has already been applied. Use this page as your report and audit view.</p>
            <% elsif apply_in_progress %>
              <h3 class="font-semibold text-base">Apply Phase In Progress</h3>
              <p class="text-sm">Teacher inputs have been submitted and the agent is currently applying updates. Refresh this page to check status.</p>
            <% else %>
              <h3 class="font-semibold text-base">Outline Research Report</h3>
              <p class="text-sm">This page is currently read-only for review and audit.</p>
            <% end %>
          </div>
        </div>
        <% if pipeline_completed && apply_completed_at.present? %>
          <p class="text-xs text-stone-600 dark:text-stone-300 mt-2">
            Completed <%= apply_completed_at.strftime("%b %-d, %Y %-I:%M %p %Z") %>
          </p>
        <% end %>
        <% if apply_agent_summary_md.present? %>
          <div class="<%= outline_complete_report_classes %>">
            <%= markdown(apply_agent_summary_md) %>
          </div>
        <% end %>
      </div>
    <% end %>

    <%= status_banner if apply_in_progress || pipeline_completed %>
    <%= report_and_findings %>
    <%= status_banner unless apply_in_progress || pipeline_completed %>
  <% else %>
    <%= form_with url: submit_outline_research_inputs_admin_course_path(@course),
                  method: :patch,
                  class: stepper_shell_classes,
                  data: {
                    controller: "stepper outline-research-autosave",
                    action: "stepper:change->outline-research-autosave#handleStepperChange",
                    stepper_variant_value: "parent",
                    stepper_start_value: 0,
                    "outline-research-autosave-url-value": submit_outline_research_inputs_admin_course_path(@course)
                  } do %>
      <%= hidden_field_tag :from_outline_research_input, "1" %>

      <nav class="<%= research_progress_classes %>" aria-label="Research workflow steps">
        <button type="button"
                class="<%= research_progress_step_classes %>"
                data-stepper-target="indicator"
                data-step-index="0"
                data-state="active"
                aria-current="step"
                data-action="stepper#go">
          <span class="<%= research_progress_dot_classes %>">1</span>
          <span class="<%= research_progress_label_classes %>">Question Responses</span>
          <span class="<%= research_progress_meta_classes %>"><span data-outline-research-autosave-target="unansweredCount"><%= unanswered %></span> unanswered</span>
        </button>

        <button type="button"
                class="<%= research_progress_step_classes %>"
                data-stepper-target="indicator"
                data-step-index="1"
                data-state="upcoming"
                data-action="stepper#go">
          <span class="<%= research_progress_dot_classes %>">2</span>
          <span class="<%= research_progress_label_classes %>">Additional Comments</span>
          <span class="<%= research_progress_meta_classes %>">Optional context</span>
        </button>

        <button type="button"
                class="<%= research_progress_step_classes %>"
                data-stepper-target="indicator"
                data-step-index="2"
                data-state="upcoming"
                data-action="stepper#go">
          <span class="<%= research_progress_dot_classes %>">3</span>
          <span class="<%= research_progress_label_classes %>">Resume Agent</span>
          <span class="<%= research_progress_meta_classes %>" data-outline-research-autosave-target="resumeReadinessMeta"><%= ready_to_resume ? "Ready" : "Blocked" %></span>
        </button>
      </nav>

      <section class="<%= step_panel_classes %>" data-stepper-target="step">
        <h3 class="text-xl font-semibold mb-2">Question Responses</h3>
        <p class="text-sm mb-4">Answer each question by selecting an option, or choose Other.</p>

        <% if questions.any? %>
          <div data-controller="stepper" data-stepper-variant-value="nested" class="<%= stepper_nested_classes %>">
            <nav class="<%= nested_stepper_nav_classes %>" aria-label="Guidance questions">
              <% questions.each_with_index do |question, idx| %>
                <% question_id = question["id"].to_s %>
                <% answered = !@course.unanswered_research_question_ids.include?(question_id) %>
                <button type="button"
                        class="<%= nested_step_indicator_classes %>"
                        data-stepper-target="indicator"
                        data-step-index="<%= idx %>"
                        data-state="<%= idx.zero? ? "active" : "upcoming" %>"
                        aria-current="<%= "step" if idx.zero? %>"
                        data-action="stepper#go"
                        aria-label="Question <%= idx + 1 %> <%= answered ? "completed" : "pending" %>">
                  <span class="<%= nested_step_indicator_dot_classes %>"><%= idx + 1 %></span>
                </button>
              <% end %>
            </nav>

            <% questions.each_with_index do |question, idx| %>
              <% question_hash = question.is_a?(Hash) ? question : {} %>
              <% question_id = question_hash["id"].to_s %>
              <% parsed_answer = parse_outline_guidance_answer(answers[question_id]) %>
              <% option_a = outline_question_choice_label(question_hash, "A") %>
              <% option_b = outline_question_choice_label(question_hash, "B") %>
              <% option_c = outline_question_choice_label(question_hash, "C") %>

              <div class="rounded border border-stone-200 dark:border-stone-700 p-4 bg-white/70 dark:bg-stone-900/50 <%= "hidden" unless idx.zero? %>" data-stepper-target="step">
                <p class="font-semibold mb-3"><%= question_hash["question"] %></p>

                <div class="space-y-2 text-sm">
                  <label class="block">
                    <%= radio_button_tag "question_choices[#{question_id}]", "A", parsed_answer["choice"] == "A" %>
                    <span class="ml-1"><%= option_a %></span>
                  </label>
                  <label class="block">
                    <%= radio_button_tag "question_choices[#{question_id}]", "B", parsed_answer["choice"] == "B" %>
                    <span class="ml-1"><%= option_b %></span>
                  </label>
                  <label class="block">
                    <%= radio_button_tag "question_choices[#{question_id}]", "C", parsed_answer["choice"] == "C" %>
                    <span class="ml-1"><%= option_c %></span>
                  </label>
                  <label class="block">
                    <%= radio_button_tag "question_choices[#{question_id}]", "OTHER", parsed_answer["choice"] == "OTHER" %>
                    <span class="ml-1">Other</span>
                  </label>
                </div>

                <div class="mt-3">
                  <label class="form-label" for="question_other_text_<%= question_id %>">Other response text</label>
                  <%= text_area_tag "question_other_text[#{question_id}]",
                                    parsed_answer["other_text"],
                                    id: "question_other_text_#{question_id}",
                                    class: "input-primary",
                                    rows: 2,
                                    placeholder: "Required when selecting Other." %>
                </div>
              </div>
            <% end %>

            <div class="mt-4 flex items-center gap-2">
              <button type="button"
                      class="<%= question_nav_arrow_classes %>"
                      data-stepper-target="prevButton"
                      data-action="stepper#prev"
                      aria-label="Previous question"
                      title="Previous question">
                <sl-icon name="arrow-left" aria-hidden="true"></sl-icon>
                <span class="sr-only">Previous question</span>
              </button>
              <button type="button"
                      class="<%= question_nav_arrow_classes %>"
                      data-stepper-target="nextButton"
                      data-action="stepper#next"
                      aria-label="Next question"
                      title="Next question">
                <sl-icon name="arrow-right" aria-hidden="true"></sl-icon>
                <span class="sr-only">Next question</span>
              </button>
            </div>
          </div>
        <% else %>
          <p class="text-sm text-dim">No guidance questions were generated for this run.</p>
        <% end %>
      </section>

      <section class="<%= step_panel_classes %> hidden" data-stepper-target="step">
        <h3 class="text-xl font-semibold mb-2">Additional Comments</h3>
        <p class="text-sm mb-4">Optional: share any final guidance for the agent before apply.</p>

        <label class="form-label" for="additional_comments">Teacher comments</label>
        <%= text_area_tag :additional_comments,
                          @course.outline_guidance_additional_comments,
                          id: "additional_comments",
                          class: "input-primary",
                          rows: 5,
                          placeholder: "Constraints, priorities, concerns, or style guidance for the updates." %>
      </section>

      <section class="<%= step_panel_classes %> hidden" data-stepper-target="step">
        <h3 class="text-xl font-semibold mb-2">Resume Agent Apply Phase</h3>
        <% if !resumable_run %>
          <p class="text-sm mb-3">
            This failed run cannot be resumed because no previous response id is available. Start a new outline research run from the course editor.
          </p>
        <% elsif ready_to_resume %>
          <p class="text-sm mb-3">
            All required teacher inputs are complete. You can resume the run and allow the agent to apply updates.
          </p>
        <% else %>
          <p class="text-sm mb-3">
            Resume will unlock after all required inputs are complete.
          </p>
        <% end %>

        <div class="mb-3 text-sm">
          <p>Remaining unanswered questions: <b data-outline-research-autosave-target="unansweredCount"><%= unanswered %></b></p>
        </div>

        <% if resumable_run %>
          <label class="inline-flex items-center gap-2 mb-4 text-sm">
            <%= check_box_tag :allow_agent_modifications, "1", false, class: "checkbox-primary" %>
            I approve the agent to modify this course.
          </label>

          <div class="flex flex-wrap gap-2">
            <button type="submit"
                    formaction="<%= resume_outline_research_admin_course_path(@course) %>"
                    class="btn-success"
                    data-outline-research-autosave-target="resumeButton"
                    <%= "disabled" unless ready_to_resume %>>
              Resume and Apply
            </button>
          </div>
        <% else %>
          <%= link_to "Back to course editor", edit_admin_course_path(@course), class: "btn-secondary" %>
        <% end %>
      </section>

      <div class="mt-6 flex flex-wrap items-center justify-between gap-3 border-t border-stone-200 pt-4 dark:border-stone-700">
        <div class="flex flex-wrap gap-2">
          <button type="button" class="btn-secondary" data-stepper-target="prevButton" data-action="stepper#prev">Previous Section</button>
          <button type="button" class="btn-primary" data-stepper-target="nextButton" data-action="stepper#next">Next Section</button>
        </div>
        <p class="<%= autosave_status_base_classes %> text-stone-600 dark:text-stone-300" aria-live="polite" data-outline-research-autosave-target="status">
          Progress saves automatically when you move between questions or sections.
        </p>
      </div>
    <% end %>

    <%= report_and_findings %>
  <% end %>
</div>
