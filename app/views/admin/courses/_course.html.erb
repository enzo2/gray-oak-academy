<tr id="<%= dom_id(course) %>" class="border-b border-stone-600 dark:border-stone-400">
  <td class="py-2 px-3"><%= course.title %></td>
  <td class="py-2 px-3"><%= course.summary %></td>
  <td class="py-2 px-3 text-center"><%= course.grade_level %></td>
  <td class="py-2 px-3 text-center">
    <% if course.enrollments.any? %>
      <% count = course.enrollments.count %>
      <%= count %> <%= "student".pluralize(count) %> enrolled
    <% elsif course.status_archived? %>
      Archived
    <% elsif course.outline.empty? %>
      <%= form_with url: generate_outline_admin_course_path(course), method: :post, 
        data: { 
          turbo_confirm: "This will call the LLM to generate an outline. You may want to switch to a thinking LLM. Proceed?",
          controller: "shoelace-button-loading" }, 
        class: "inline-block" do |form| %>
        <sl-button type="submit" size="small" variant="success" id="generate-outline-button-<%= course.id %>" 
          outline>
          <sl-icon slot="prefix" name="lightbulb"></sl-icon>
          Generate outline
        </sl-button>
      <% end %>
    <% elsif course.lessons.empty? %>
      No lessons added
    <% else %>
      Under development
    <% end %>
  </td>
  <td class="py-2 px-3 text-right [&_a:hover]:underline">
    <div class="flex flex-col items-end">
      <% if course.status_active? %>
        <%= link_to "View/Edit Lessons", admin_course_lessons_path(course), class: "block" %>
        <%= link_to "Edit Course", edit_admin_course_path(course), class: "block", data: { turbo_stream: true } %>
        <%= button_to "Archive", archive_admin_course_path(course), method: :patch, class: "block hover:underline text-orange-800", data: { turbo_stream: true } %>
      <% else %>
        <%= button_to "Unarchive", unarchive_admin_course_path(course), method: :patch, class: "block hover:underline text-green-600", data: { turbo_stream: true } %>
      <% end %>

      <% if course.enrollments.empty? && course.status_archived? %>
        <%= button_to "Delete", admin_course_path(course), 
          method: :delete, 
          class: "block hover:underline text-red-500", 
          data: { turbo_confirm: "Are you sure you want to delete this course? This will delete everything, and you will also lose track of any student reports!" } %>
      <% end %>
      

    </div>
  </td>
</tr>