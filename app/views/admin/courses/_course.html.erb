<tr id="<%= dom_id(course) %>" class="border-b border-stone-600 dark:border-stone-400">
  <td class="py-2 px-3"><%= course.title %></td>
  <td class="py-2 px-3"><%= course.summary %></td>
  <td class="py-2 px-3 text-center"><%= course.grade_level %></td>
  <td class="py-2 px-3 text-center">
    <% if course.enrollments.any? %>
      <% count = course.enrollments.count %>
      <%= count %> <%= "student".pluralize(count) %> enrolled
    <% elsif course.status_archived? %>
      Archived
    <% elsif course.outline.empty? %>
      <%= form_with url: generate_outline_admin_course_path(course), method: :post, 
        data: { 
          turbo_confirm: "This will call the LLM to generate an outline. You may want to set a thinking LLM. Proceed?",
          controller: "shoelace-button-loading" }, 
        class: "inline-block" do |form| %>
        <sl-button type="submit" size="small" variant="success" id="generate-outline-button-<%= course.id %>" 
          outline>
          <sl-icon slot="prefix" name="lightbulb"></sl-icon>
          Generate outline
        </sl-button>
      <% end %>
    <% elsif course.lessons.empty? %>
      No lessons added
    <% else %>
      Under development
    <% end %>
  </td>
  <td class="py-2 px-3 text-right">
    <div class="flex flex-col items-end gap-1 [&_sl-icon]:text-base">
      <% if course.status_active? %>
        <%= link_to admin_course_lessons_path(course), class: "btn-table-action w-full" do %>
          <sl-icon name="collection" class="text-xl!"></sl-icon>
          View/Edit Lessons
        <% end %>
        <%= link_to edit_admin_course_path(course), class: "btn-table-action w-full" do %>
          <sl-icon name="pencil"></sl-icon>
          Edit Course
        <% end %>
        <%= button_to archive_admin_course_path(course), method: :patch, class: "btn-table-action w-full", data: { turbo_stream: true } do %>
          <sl-icon name="archive"></sl-icon>
          Archive
        <% end %>
      <% else %>
        <%= button_to unarchive_admin_course_path(course), method: :patch, class: "btn-table-action w-full", data: { turbo_stream: true } do %>
          <sl-icon name="arrow-counterclockwise"></sl-icon>
          Unarchive
        <% end %>
      <% end %>

      <% if course.enrollments.empty? && course.status_archived? %>
        <%= button_to admin_course_path(course), 
          method: :delete, 
          class: "btn-table-danger w-full", 
          data: { turbo_confirm: "Are you sure you want to delete this course? This will delete everything, and you will also lose track of any student reports!" } do %>
          <sl-icon name="trash"></sl-icon>
          Delete
        <% end %>
      <% end %>
    </div>
  </td>
</tr>
