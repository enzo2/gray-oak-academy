<tr id="<%= dom_id(course) %>" class="border-b border-gray-600 dark:border-gray-400">
  <td class="py-2 px-3"><%= course.title %></td>
  <td class="py-2 px-3"><%= course.summary %></td>
  <td class="py-2 px-3 text-center"><%= course.grade_level %></td>
  <td class="py-2 px-3 text-right">
    <%= link_to "Edit", edit_admin_course_path(course), class: "inline-block mr-2", data: { turbo_stream: true } %>
    <%= button_to "Delete", admin_course_path(course), method: :delete, class: "inline-block mr-2", data: { turbo_confirm: "Are you sure you want to delete this course?" } %>
    <%= link_to "View Lessons", admin_course_lessons_path(course), class: "inline-block", data: { turbo_frame: "dashboard-content" } %>
  </td>
</tr>