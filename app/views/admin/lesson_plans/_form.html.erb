<% if lesson_plan.content.blank? %>
  <p class="mb-2"><i>You can use the LLM to generate lesson plan content. You should review and enhance it with your own resources.</i></p>
  <%= form_with url: generate_content_admin_course_lesson_lesson_plan_path(lesson.course, lesson), method: :post, 
    data: { 
      turbo_confirm: "This will call the LLM to generate lesson plan content and suggested resources. You may want to set a thinking LLM. Proceed?",
      controller: "shoelace-button-loading" }, 
    class: "inline-block mb-4" do |form| %>
    <sl-button type="submit" variant="success" outline id="">
      <sl-icon slot="prefix" name="lightbulb"></sl-icon>
      Generate Lesson Plan
    </sl-button>
  <% end %>
<% end %>

<%= form_with(model: [:admin, lesson.course, lesson, lesson_plan], url: admin_course_lesson_lesson_plan_path(lesson.course, lesson), method: :patch, id: "lesson-plan-form") do |f| %>
  <% if lesson_plan.errors.any? %>
    <div class="mb-4 text-red-800 dark:text-red-300" id="lesson-plan-errors">
      <%= pluralize(lesson_plan.errors.count, "error") %> prevented this lesson plan from being saved.
      <ul>
        <% lesson_plan.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-4" data-controller="outline" data-outline-target="fieldContainer">
    <%= f.label :content, class: "form-label" %>
    <details class="block text-sm mb-2 pl-2">
      <summary>What's this?</summary>
      The content will be used by the LLM tutor to conduct the lesson.<br>
      As examples, you could specify <b>knowledge, resources, exercises, teaching methods, generative applets, or evaluation criteria</b> for the lesson.<br>
      <b>Resources</b> may be referenced, but the actual resource should be linked to the lesson plan below ('Linked Resources').<br>
      To create a reflection/recap/debrief lesson, add an <b>"Offline Activity"</b> content item with instructions for the student to perform away from the device, followed by a <b>"Reflection"</b> or <b>"Recap"</b> content item with debrief prompts.</i>
    </details>
    <% content_data = lesson_plan.content.presence || [{ "" => "" }] %>
    <% content_data.each do |item| %>
      <div class="flex items-center mb-1 space-x-2">
        <%= text_field_tag "lesson_plan[content_keys][]", item.keys.first, placeholder: "Content type", class: "input-primary w-1/4 py-1", required: true %>
        <%= text_field_tag "lesson_plan[content_values][]", item.values.first, placeholder: "Details", class: "input-primary w-3/4 py-1", required: true %>
        <sl-icon-button name="arrow-up" class="move-up" data-action="click->outline#moveUp"></sl-icon-button>
        <sl-icon-button name="arrow-down" class="move-down" data-action="click->outline#moveDown"></sl-icon-button>
        <sl-icon-button name="x-circle" class="remove-field" data-action="click->outline#removeField"></sl-icon-button>
      </div>
    <% end %>
    <sl-button class="mb-2" data-action="click->outline#addField" outline>
      <sl-icon slot="prefix" name="plus-circle"></sl-icon>
      Add content section
    </sl-button>
    <template>
      <div class="flex items-center mb-2 space-x-2">
        <%= text_field_tag "lesson_plan[content_keys][]", "", placeholder: "Content type", class: "input-primary w-1/4 py-1", required: true %>
        <%= text_field_tag "lesson_plan[content_values][]", "", placeholder: "Details", class: "input-primary w-3/4 py-1", required: true %>
        <sl-icon-button name="arrow-up" class="move-up" data-action="click->outline#moveUp"></sl-icon-button>
        <sl-icon-button name="arrow-down" class="move-down" data-action="click->outline#moveDown"></sl-icon-button>
        <sl-icon-button name="x-circle" class="remove-field" data-action="click->outline#removeField"></sl-icon-button>
      </div>
    </template>
  </div>

  <% if lesson_plan.suggested_resources.present? %>
    <div class="mb-4">
      <label class="form-label">Suggested Resources</label>
      <p class="block text-sm mb-2">
        <i>Not included unless you obtain and add as a linked resource.</i>
      </p>
      <ul class="list-disc ml-2">
        <% lesson_plan.suggested_resources.each_with_index do |resource, idx| %>
          <li class="mb-2 flex space-x-2 items-center" id="suggested-resource-<%= idx %>">
            <%= link_to remove_suggested_resource_admin_course_lesson_lesson_plan_path(lesson.course, lesson, idx),
                  method: :delete,
                  data: { 
                    turbo_method: :delete,
                    turbo_confirm: 'Remove this suggested resource?' 
                    }, 
                  class: 'flex items-center' do %>
              <sl-icon name="trash" class="text-gray-500 hover:text-red-500"></sl-icon>
            <% end %>
            <span class="font-semibold"><%= resource.keys.first %></span>: <%= resource.values.first %>
          </li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-4">
    <%= f.label "Chalkboard", class: "form-label" %>
    <div class="flex items-center">
      <%= f.check_box :chalkboard_enabled, class: "mr-2 checkbox-primary" %>
      <span>Enable chalkboard for this lesson</span>
    </div>
    <p class="text-sm text-dim mt-1"><i>Hint: The chalkboard works best on desktop/laptop.</i></p>
  </div>

  <div class="mb-4">
    <%= f.label :audio, "Audio Input", class: "form-label" %>
    <div class="space-y-1 max-w-md">
      <% audio_descriptions = {
           "enabled" => "Allows speech input.",
           "only" => "Forces speech input. Text entry disabled."
         } %>
      <%= f.collection_radio_buttons :audio, LessonPlan.audios.keys, :to_s, :to_s do |b| %>
        <div class="flex items-start gap-3">
          <%= b.radio_button(class: "mt-1 radio-primary") %>
          <div class="flex-1">
            <%= b.label(class: "block text-sm font-medium text-neutral-700 dark:text-neutral-300") do %>
               <%= b.value == 'only' ? 'Audio Only' : b.text.titleize %>
            <% end %>
            <p class="text-xs text-dim">
              <%= audio_descriptions[b.value] %>
            </p>
          </div>
        </div>
      <% end %>
    </div>
    
    <% unless AppSetting.speech_configured? %>
      <p class="text-xs text-dim mt-2">
        Speech has not been configured. Contact the webmaster.
      </p>
    <% end %>
  </div>
  
  <div class="mb-4">
    <%= f.label :status, class: "form-label" %>
    <p class="block text-sm mb-2"><i>The lesson will be available to students once it is published. Don't forget to add resources below.</i></p>
    <div class="[&_label]:mr-4 [&_input]:mr-2">
      <%= f.collection_radio_buttons :status, LessonPlan.statuses.keys, :to_s, :titleize do |b| %>
        <%= b.label(:"data-value" => b.value) { b.radio_button(class: "radio-primary") + b.text } %>
      <% end %>
    </div>
  </div>

  <div class="flex flex-row space-x-5 mb-4">
    <%= f.submit "Save", class: "btn-primary" %>
    <%= link_to "Cancel", admin_course_lessons_path(lesson.course), class: "btn-secondary" %>
  </div>
<% end %>
