<% if lesson_plan.content.blank? %>
  <p class="mb-2"><i>You can use the LLM to generate lesson plan content and locate web-based resources. You should review and enhance with your own resources.</i></p>
  <%= render "admin/lesson_plans/generate_lesson_plan_button", lesson: lesson, lesson_plan: lesson_plan %>
<% end %>

<%= form_with(model: [:admin, lesson.course, lesson, lesson_plan], url: admin_course_lesson_lesson_plan_path(lesson.course, lesson), method: :patch, id: "lesson-plan-form") do |f| %>
  <% if lesson_plan.errors.any? %>
    <div class="mb-4 text-danger-800 dark:text-danger-300" id="lesson-plan-errors">
      <%= pluralize(lesson_plan.errors.count, "error") %> prevented this lesson plan from being saved.
      <ul>
        <% lesson_plan.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-4" data-controller="outline" data-outline-target="fieldContainer">
    <%= f.label :content, class: "form-label" %>
    <details class="block text-sm mb-2 pl-2">
      <summary>What's this?</summary>
      The content will be used by the LLM tutor to conduct the lesson.<br>
      As examples, you could specify <b>knowledge, resources, exercises, teaching methods, generative applets, or evaluation criteria</b> for the lesson.<br>
      <b>Resources</b> may be referenced, but the actual resource should be linked to the lesson plan below ('Linked Resources').<br>
      To create a reflection/recap/debrief lesson, add an <b>"Offline Activity"</b> content item with instructions for the student to perform away from the device, followed by a <b>"Reflection"</b> or <b>"Recap"</b> content item with debrief prompts.
    </details>
    <% content_data = lesson_plan.content.presence || [{ "" => "" }] %>
    <div class="outline-fields space-y-3">
      <% content_data.each_with_index do |item, index| %>
        <div class="outline-field group rounded-sm border-l-3 border-moss-400 dark:border-moss-700 bg-paper-50 dark:bg-paper-950/40 shadow-sm focus-within:shadow-md transition-shadow" data-index="<%= index %>">
          <div class="flex items-center gap-1 px-2 py-1.5 bg-paper-100/80 dark:bg-paper-900/30 rounded-tr-sm">
            <span class="text-paper-400 dark:text-paper-600 text-xs font-mono select-none shrink-0 mr-0.5"><%= index + 1 %></span>
            <%= text_field_tag "lesson_plan[content_keys][]", item.keys.first, placeholder: "Content type (Knowledge, Exercise, Resource...)", class: "flex-1 bg-transparent border-none focus:ring-0 focus:outline-none text-sm font-semibold tracking-wide uppercase text-moss-800 dark:text-moss-300 placeholder-paper-400 dark:placeholder-paper-600 py-0 px-1", required: true %>
            <div class="flex items-center shrink-0 opacity-0 group-hover:opacity-100 focus-within:opacity-100 transition-opacity">
              <sl-icon-button name="chevron-up" class="move-up text-xs" data-action="click->outline#moveUp" data-index="<%= index %>"></sl-icon-button>
              <sl-icon-button name="chevron-down" class="move-down text-xs" data-action="click->outline#moveDown" data-index="<%= index %>"></sl-icon-button>
              <sl-icon-button name="x-lg" class="remove-field text-xs" data-action="click->outline#removeField"></sl-icon-button>
            </div>
          </div>
          <%= text_area_tag "lesson_plan[content_values][]", item.values.first, placeholder: "Describe what the lesson should include, or how it should be taught.", class: "outline-native-autosize w-full bg-transparent border-none focus:ring-0 focus:outline-none text-sm leading-relaxed text-paper-900 dark:text-paper-200 placeholder-paper-400 dark:placeholder-paper-600 px-3 py-2 resize-none overflow-hidden", required: true, rows: 1, data: { action: "input->outline#autoResize" } %>
        </div>
      <% end %>
    </div>
    <sl-button class="mt-3 mb-2" data-action="click->outline#addField" outline>
      <sl-icon slot="prefix" name="plus-circle"></sl-icon>
      Add content section
    </sl-button>
    <template>
      <div class="outline-field group rounded-sm border-l-3 border-moss-400 dark:border-moss-700 bg-paper-50 dark:bg-paper-950/40 shadow-sm focus-within:shadow-md transition-shadow">
        <div class="flex items-center gap-1 px-2 py-1.5 bg-paper-100/80 dark:bg-paper-900/30 rounded-tr-sm">
          <span class="text-paper-400 dark:text-paper-600 text-xs font-mono select-none shrink-0 mr-0.5">&bull;</span>
          <%= text_field_tag "lesson_plan[content_keys][]", "", placeholder: "Content type (Knowledge, Exercise, Resource...)", class: "flex-1 bg-transparent border-none focus:ring-0 focus:outline-none text-sm font-semibold tracking-wide uppercase text-moss-800 dark:text-moss-300 placeholder-paper-400 dark:placeholder-paper-600 py-0 px-1", required: true %>
          <div class="flex items-center shrink-0 opacity-0 group-hover:opacity-100 focus-within:opacity-100 transition-opacity">
            <sl-icon-button name="chevron-up" class="move-up text-xs" data-action="click->outline#moveUp"></sl-icon-button>
            <sl-icon-button name="chevron-down" class="move-down text-xs" data-action="click->outline#moveDown"></sl-icon-button>
            <sl-icon-button name="x-lg" class="remove-field text-xs" data-action="click->outline#removeField"></sl-icon-button>
          </div>
        </div>
        <%= text_area_tag "lesson_plan[content_values][]", "", placeholder: "Describe what the lesson should include, or how it should be taught.", class: "outline-native-autosize w-full bg-transparent border-none focus:ring-0 focus:outline-none text-sm leading-relaxed text-paper-900 dark:text-paper-200 placeholder-paper-400 dark:placeholder-paper-600 px-3 py-2 resize-none overflow-hidden", required: true, rows: 1, data: { action: "input->outline#autoResize" } %>
      </div>
    </template>
  </div>

  <% if lesson_plan.suggested_resources.present? %>
    <div class="mb-4">
      <label class="form-label">Suggested Resources</label>
      <p class="block text-sm mb-2">
        <i>Not included unless you obtain and add as a linked resource.</i>
      </p>
      <ul class="space-y-3">
        <% lesson_plan.suggested_resources.each_with_index do |resource, idx| %>
          <li class="flex items-start gap-2" id="suggested-resource-<%= idx %>">
            <%= link_to remove_suggested_resource_admin_course_lesson_lesson_plan_path(lesson.course, lesson, idx),
                  method: :delete,
                  data: { 
                    turbo_method: :delete,
                    turbo_confirm: 'Remove this suggested resource?' 
                    }, 
                  class: 'mt-1 shrink-0 flex items-center' do %>
              <sl-icon name="trash" class="text-stone-500 hover:text-danger-500 dark:text-stone-400 dark:hover:text-danger-400"></sl-icon>
            <% end %>
            <div class="min-w-0 whitespace-normal wrap-break-word">
              <span class="font-semibold"><%= resource.keys.first %></span><span class="mr-1">:&nbsp;</span><%= resource.values.first %>
            </div>
          </li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-4">
    <%= f.label "Chalkboard", class: "form-label" %>
    <div class="flex items-center">
      <%= f.check_box :chalkboard_enabled, class: "mr-2 checkbox-primary" %>
      <span>Enable chalkboard for this lesson</span>
    </div>
    <p class="text-sm text-dim mt-1"><i>Hint: The chalkboard works best on desktop/laptop.</i></p>
  </div>

  <div class="mb-4">
    <%= f.label :audio, "Audio Input", class: "form-label" %>
    <div class="space-y-1 max-w-md">
      <% audio_descriptions = {
           "enabled" => "Allows speech input.",
           "only" => "Forces speech input. Text entry disabled."
         } %>
      <%= f.collection_radio_buttons :audio, LessonPlan.audios.keys, :to_s, :to_s do |b| %>
        <div class="flex items-start gap-3">
          <%= b.radio_button(class: "mt-1 radio-primary") %>
          <div class="flex-1">
            <%= b.label(class: "block text-sm font-medium text-stone-700 dark:text-stone-300") do %>
               <%= b.value == 'only' ? 'Audio Only' : b.text.titleize %>
            <% end %>
            <p class="text-xs text-dim">
              <%= audio_descriptions[b.value] %>
            </p>
          </div>
        </div>
      <% end %>
    </div>
    
    <% unless AppSetting.speech_configured? %>
      <p class="text-xs text-dim mt-2">
        Speech has not been configured. Contact the webmaster.
      </p>
    <% end %>
  </div>
  
  <div class="mb-4">
    <%= f.label :status, class: "form-label" %>
    <p class="block text-sm mb-2"><i>The lesson will be available to students once it is published. Pending linked resources must be approved first.</i></p>
    <% status_radio_classes = "radio-primary" %>
    <% status_radio_classes = "#{status_radio_classes} border-danger-400 dark:border-danger-800" if lesson_plan.errors[:status].any? %>
    <div class="flex flex-wrap gap-x-6 gap-y-2">
      <% LessonPlan.statuses.keys.each do |status_value| %>
        <label for="lesson_plan_status_<%= status_value %>" data-value="<%= status_value %>" class="inline-flex items-center gap-2">
          <%= radio_button_tag "lesson_plan[status]", status_value, lesson_plan.status == status_value, id: "lesson_plan_status_#{status_value}", class: status_radio_classes %>
          <span><%= status_value.titleize %></span>
        </label>
      <% end %>
    </div>
  </div>

  <div class="flex flex-row space-x-5 mb-4">
    <%= f.submit "Save", class: "btn-primary" %>
    <%= link_to "Cancel", admin_course_lessons_path(lesson.course), class: "btn-secondary" %>
  </div>
<% end %>
