<%= form_with(model: [:admin, lesson.course, lesson, lesson_plan], url: admin_course_lesson_lesson_plan_path(lesson.course, lesson), method: :patch, id: "lesson-plan-form") do |f| %>
  <% if lesson_plan.errors.any? %>
    <div class="mb-4 text-red-800 dark:text-red-300" id="lesson-plan-errors">
      <%= pluralize(lesson_plan.errors.count, "error") %> prevented this lesson plan from being saved.
      <ul>
        <% lesson_plan.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <% if lesson_plan.content.blank? %>
    <div class="mb-4" id="gen-content-btn">
      <p class="mb-2"><i>You can use the LLM to generate lesson plan content. However, you should at least review and enhance it with your own resources.</i></p>
      <div class="block">
        <%= link_to "Generate Lesson Plan", generate_content_admin_course_lesson_lesson_plan_path(lesson.course, lesson), 
          class: "btn-primary my-2", 
          data: { turbo_confirm: "This will call the LLM to generate lesson plan content.", turbo_stream: true, turbo_method: :post } %>
      </div>
    </div>
  <% end %>

  <div class="mb-4" data-controller="outline" data-outline-target="fieldContainer">
    <%= f.label :content, class: "form-label" %>
    <p class="block text-sm mb-2"><i>
      The content will be used by the LLM tutor to conduct the lesson.<br>
      As examples, you could specify knowledge, resources, exercises, teaching methods, generative applets, or evaluation criteria for the lesson.<br>
      Resources must be added and linked to the lesson plan (you can do so once the plan is saved to draft status).</i></p>
    <% content_data = lesson_plan.content.presence || [{ "" => "" }] %>
    <% content_data.each do |item| %>
      <div class="flex items-center mb-1 space-x-2">
        <%= text_field_tag "lesson_plan[content_keys][]", item.keys.first, placeholder: "Content type", class: "input-primary w-1/4 py-1", required: true %>
        <%= text_field_tag "lesson_plan[content_values][]", item.values.first, placeholder: "Details", class: "input-primary w-3/4 py-1", required: true %>
        <sl-icon-button name="arrow-up" class="move-up" data-action="click->outline#moveUp"></sl-icon-button>
        <sl-icon-button name="arrow-down" class="move-down" data-action="click->outline#moveDown"></sl-icon-button>
        <sl-icon-button name="x-circle" class="remove-field" data-action="click->outline#removeField"></sl-icon-button>
      </div>
    <% end %>
    <sl-button class="mb-2" data-action="click->outline#addField" outline>
      <sl-icon slot="prefix" name="plus-circle"></sl-icon>
      Add content section
    </sl-button>
    <template>
      <div class="flex items-center mb-2 space-x-2">
        <%= text_field_tag "lesson_plan[content_keys][]", "", placeholder: "Content type", class: "input-primary w-1/4 py-1", required: true %>
        <%= text_field_tag "lesson_plan[content_values][]", "", placeholder: "Details", class: "input-primary w-3/4 py-1", required: true %>
        <sl-icon-button name="arrow-up" class="move-up" data-action="click->outline#moveUp"></sl-icon-button>
        <sl-icon-button name="arrow-down" class="move-down" data-action="click->outline#moveDown"></sl-icon-button>
        <sl-icon-button name="x-circle" class="remove-field" data-action="click->outline#removeField"></sl-icon-button>
      </div>
    </template>
  </div>

  <div class="mb-4">
    <%= f.label "Chalkboard", class: "form-label" %>
    <div class="flex items-center">
      <%= f.check_box :chalkboard_enabled, class: "mr-2 checkbox-primary" %>
      <span>Enable chalkboard for this lesson</span>
    </div>
    <p class="text-sm text-dim mt-1"><i>Hint: The chalkboard requires a wide screen. Disable to allow for cell phone use.</i></p>
  </div>

  <div class="mb-4">
    <%= f.label :audio, "Audio Input", class: "form-label" %>
    <div class="[&_label]:mr-4 [&_input]:mr-2">
      <%= f.collection_radio_buttons :audio, LessonPlan.audios.keys, :to_s, :titleize do |b| %>
       <%= b.label(:"data-value" => b.value) { b.radio_button(class: "radio-primary") + b.text } %>
      <% end %>
    </div>
    <p class="block text-sm mt-1">
      Disabled: <i>Raw audio input disabled, but transcription allowed (if set up).</i><br>
      Enabled: <i>Raw audio input used if supported by the LLM.</i><br>
      Audio Only: <i>Text entry disabled. Raw audio used if supported, otherwise transcription. (Great for mobile device use, outdoors lessons, etc.)</i><br>
    <%= link_to "Set up Speech API to ensure transcription is available.", edit_user_registration_path(), class: "link-primary", target: "_blank" unless current_user.setting.speech_configured? %>
    </p>
  </div>

  <div class="mb-4">
    <%= f.label :status, class: "form-label" %>
    <p class="block text-sm mb-2"><i>The lesson will be available to students once it is published. Don't forget to add resources below.</i></p>
    <div class="[&_label]:mr-4 [&_input]:mr-2">
      <%= f.collection_radio_buttons :status, LessonPlan.statuses.keys, :to_s, :titleize do |b| %>
        <%= b.label(:"data-value" => b.value) { b.radio_button(class: "radio-primary") + b.text } %>
      <% end %>
    </div>
  </div>

  <div class="flex flex-row space-x-5 mb-4">
    <%= f.submit "Submit", class: "btn-primary" %>
    <%= link_to "Cancel", admin_course_lessons_path(lesson.course), class: "btn-primary" %>
  </div>
<% end %>
