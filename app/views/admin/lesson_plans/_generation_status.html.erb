<% show_completed = local_assigns.fetch(:show_completed, true) %>

<% if lesson_plan.generation_in_progress? %>
  <p class="mt-2 text-sm text-blue-700 dark:text-blue-300">
    <% if lesson_plan.generation_stage == "proposing_resources" %>
      Proposing and validating resources...
    <% else %>
      Generating lesson plan content...
    <% end %>
  </p>
<% elsif lesson_plan.generation_stage == "failed" %>
  <p class="mt-2 text-sm text-red-700 dark:text-red-300">
    <b>Generation failed.</b>
    <%= lesson_plan.generation_error %>
  </p>
<% elsif show_completed && lesson_plan.generation_stage == "completed" %>
  <p class="mt-2 text-sm text-green-700 dark:text-green-300">
    Last generation completed.
  </p>
<% end %>
