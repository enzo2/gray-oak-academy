<h2 class="text-xl mb-4">Linked Resources</h2>
<p class="block text-sm mb-2"><i>Linked Resources will be available for the tutor to use.<br>
                                 Pending resources must be approved before publishing.<br>
                                 If you want to make sure the tutor uses it, link it and then mention it in Content above.</i></p>

<%= render partial: "admin/lesson_plans/propose_resources_button", locals: { lesson: lesson, lesson_plan: lesson_plan } %>

<% if lesson_plan.resources.pending_approval.exists? %>
  <p class="mb-3 text-sm text-warning-700 dark:text-warning-300">
    Some linked resources are pending approval. You must approve them before publishing this lesson plan.
  </p>
<% end %>

<div class="mb-4" data-controller="resource-filter">
  <h3 class="text-lg font-semibold mb-2">Currently Linked</h3>
  <div id="linked-resources" class="mb-4">
    <% if lesson_plan.resources.any? %>
      <% lesson_plan.resources.each do |resource| %>
        <%= render partial: 'admin/resources/linked_resource', locals: { resource: resource, lesson_plan: lesson_plan } %>
      <% end %>
    <% else %>
      <p id="no-linked-resources-msg"><i>No resources linked to this lesson plan.</i></p>
    <% end %>
  </div>

  <h3 class="text-lg font-semibold mb-2">Find/Add Resources</h3>        
  <div class="mb-2">
    <%= text_field_tag :resource_search, "", placeholder: "Search resources...", class: "input-primary w-full px-2 py-1.5 md:px-3 md:py-2", data: { action: "input->resource-filter#filterResources", resource_filter_target: "searchInput" } %>
  </div>
  <% tag_filter_options = Resource.most_used_tags_for(current_user, limit: 20) %>
  <% category_filter_options = Resource.distinct_categories_for(current_user) %>
  <div class="mb-2">
    <div class="grid grid-cols-2 gap-2">
      <%= select_tag :resource_category_filter,
                     options_for_select([["All categories", ""]] + category_filter_options.map { |category| [category, category] }),
                     class: "input-primary w-full px-2 py-1.5 md:px-3 md:py-2",
                     data: { action: "change->resource-filter#filterResources", resource_filter_target: "categorySelect" } %>
      <%= select_tag :resource_tag_filter,
                     options_for_select([["All tags", ""]] + tag_filter_options.map { |tag| [tag, tag] }),
                     class: "input-primary w-full px-2 py-1.5 md:px-3 md:py-2",
                     data: { action: "change->resource-filter#filterResources", resource_filter_target: "tagSelect" } %>
    </div>
  </div>
  <div id="available-resources" class="max-h-60 overflow-y-auto border border-stone-500 rounded-sm p-2 mb-4">
    <% available_resources.each do |resource| %>
      <div id="available-resource-<%= resource.id %>" data-resource-filter-target="availableResource" data-resource-filter-searchable="<%= "#{resource.category} #{resource.description} #{resource.tags&.join(' ')}".strip %>" data-resource-filter-tags="<%= resource.tags.join(',') %>" data-resource-filter-category="<%= resource.category.to_s %>">
        <%= render partial: 'admin/resources/available_resource', locals: { resource: resource, lesson_plan: lesson_plan } %>
      </div>
    <% end %>
  </div>
</div>

<div id="new_resource">
  <%= render partial: 'admin/lesson_plans/new_resource_button', locals: { lesson: lesson } %>
</div>

<br><br>
