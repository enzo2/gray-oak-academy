<%
  #Helper since it may be called from controller with instance vars, or from Job with local vars
  lesson = local_assigns[:lesson] || @lesson if defined?(@lesson)
  lesson_plan = local_assigns[:lesson_plan] || @lesson_plan if defined?(@lesson_plan)
%>


<%= link_to "Back to Lessons", admin_course_lessons_path(lesson.course), class: "block mb-4 hover:underline" %>

<div class="w-full max-w-7xl">

  <h2 class="text-2xl mb-4">Edit Lesson Plan: <b><%= lesson.title %></b></h2>

  <div class="mb-4">  
    <span class="form-label">Lesson Goals</span>
    <%= lesson.goals %>
  </div>

  <%= render "admin/lesson_plans/form", lesson: lesson, lesson_plan: lesson_plan %>
  <div class="mb-4" id="lesson-plan-form-result"></div>

  <% if lesson_plan.persisted? %>
    <%= render "admin/lesson_plans/delete_button", lesson: lesson %>
  <% end %>

  <hr class="my-4">

  <%= render "admin/lesson_plans/manage_resources", lesson: lesson, lesson_plan: lesson_plan, available_resources: current_user.resources.where.not(id: lesson_plan.resource_ids) %>

</div>
