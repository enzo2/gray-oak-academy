 <%= turbo_stream.append "flash_bar", partial: "shared/flash" %>

<% if @lesson_plan.errors.any? %>
  <%= turbo_stream.replace("lesson-plan-form", partial: "form", locals: { lesson: @lesson, lesson_plan: @lesson_plan }) %>
<% else %>
  
  <%= turbo_stream.remove "lesson-plan-errors" %>

  <% if @lesson_plan.new_record? %>
    <%= turbo_stream.after("lesson-plan-form-result", 
        partial: "admin/lesson_plans/delete_button",
        locals: { lesson: @lesson } ) %>
  <% end %>
<% end %>
