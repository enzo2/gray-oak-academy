<%= turbo_frame_tag "new_resource" do %>
  <%= form_with(model: [:admin, @lesson.course, @lesson, @lesson_plan, Resource.new], url: add_resource_admin_course_lesson_lesson_plan_path(@lesson.course, @lesson, @lesson_plan), method: :post) do |f| %>
    <div class="mb-2">
      <%= f.label :category, class: "form-label" %>
      <%= f.text_field :category, class: "form-input" %>
    </div>
    <div class="mb-2">
      <%= f.label :description, class: "form-label" %>
      <%= f.text_area :description, class: "form-textarea" %>
    </div>
    <div class="mb-2">
      <%= f.label :uri, class: "form-label" %>
      <%= f.url_field :uri, class: "form-input" %>
    </div>
    <%= f.submit "Add Resource", class: "btn-primary" %>
  <% end %>
<% end %>