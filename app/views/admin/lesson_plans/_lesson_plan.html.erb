<div id="<%= dom_id(lesson_plan) %>" class="bg-white shadow rounded-lg p-6 mb-4">
  <h4 class="text-lg font-semibold mb-2">Lesson Plan for <%= lesson_plan.lesson.title %></h4>
  <pre class="bg-gray-100 p-4 rounded"><%= JSON.pretty_generate(lesson_plan.content) %></pre>
  <p class="text-sm text-gray-500 mt-2">Status: <%= lesson_plan.status.capitalize %></p>
  <div class="flex justify-between items-center mt-4">
    <%= link_to "Edit", edit_admin_course_lesson_lesson_plan_path(lesson_plan.lesson.course, lesson_plan.lesson), class: "text-blue-500 hover:text-blue-700", data: { turbo_frame: "lesson-plan" } %>
  </div>
</div>