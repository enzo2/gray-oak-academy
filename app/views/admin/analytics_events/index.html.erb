<div class="flex flex-wrap items-center justify-between gap-3 mb-2">
  <h2 class="text-2xl font-bold">Analytics Events</h2>
  <%= button_to "Clear Logs",
      clear_admin_analytics_events_path,
      method: :delete,
      data: { turbo_confirm: "Clear all analytics events? This cannot be undone." },
      class: "btn-secondary text-danger-700 dark:text-danger-300" %>
</div>
<p class="mb-4 text-sm text-dim">Bounded stream of Events emitted through Rails.event.</p>

<% if @events.any? %>
  <div class="overflow-x-auto">
    <table class="min-w-full divide-y divide-stone-200 dark:divide-stone-700">
      <thead class="bg-stone-50 dark:bg-stone-800">
        <tr class="[&>th]:px-4 [&>th]:py-3 [&>th]:text-left [&>th]:text-xs [&>th]:uppercase [&>th]:tracking-wider text-stone-500 dark:text-stone-400">
          <th>Emitted At</th>
          <th>Type</th>
          <th>Category</th>
          <th>Subject</th>
          <th>Message</th>
          <th>Recipients</th>
          <th>Link</th>
          <th>Details</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-stone-200 dark:divide-stone-700">
        <% @events.each_with_index do |event, idx| %>
          <tr class="[&>td]:px-4 [&>td]:py-2 align-top text-sm <%= idx.even? ? '' : 'bg-stone-100/60 dark:bg-stone-800/60' %>">
            <td class="font-mono text-xs"><%= event[:emitted_at] %></td>
            <td class="font-mono text-xs"><%= event[:event_type] %></td>
            <td><%= event[:category] %></td>
            <td><%= event[:subject] %></td>
            <td class="max-w-md"><%= event[:message] %></td>
            <td class="font-mono text-xs"><%= event[:recipient_ids].join(", ") %></td>
            <td>
              <% if event[:link].present? %>
                <%= link_to "Open", event[:link], class: "underline underline-offset-2" %>
              <% else %>
                <span class="text-dim">n/a</span>
              <% end %>
            </td>
            <td class="min-w-48">
              <% if event[:params].present? %>
                <details>
                  <summary class="cursor-pointer text-xs text-dim">Params</summary>
                  <pre class="mt-1 text-xs whitespace-pre-wrap bg-stone-100 dark:bg-stone-800 p-2 rounded overflow-x-auto"><%= JSON.pretty_generate(event[:params]) %></pre>
                </details>
              <% else %>
                <span class="text-dim">n/a</span>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <p class="text-dim">No analytics events recorded yet.</p>
<% end %>
