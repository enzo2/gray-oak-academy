<section data-testid="awaiting-lessons" class="rounded-sm border border-stone-200 bg-white p-4 dark:border-stone-800 dark:bg-stone-900">
  <h2 class="text-lg font-semibold text-stone-900 dark:text-stone-100">Students Awaiting Lessons</h2>
  <p class="mt-1 text-sm text-stone-600 dark:text-stone-400">
    Active enrollments with no published next lesson available.
  </p>

  <% if dashboard[:awaiting_lesson_enrollments].any? %>
    <ul class="mt-3 space-y-2">
      <% dashboard[:awaiting_lesson_enrollments].each do |enrollment| %>
        <li data-testid="awaiting-lesson-row" class="rounded-sm border border-stone-200 p-3 dark:border-stone-700">
          <p class="text-sm font-semibold text-stone-900 dark:text-stone-100"><%= enrollment.student.name %></p>
          <p class="text-xs text-stone-600 dark:text-stone-400"><%= enrollment.course.title %></p>
          <div class="mt-2 flex flex-wrap items-center gap-2">
            <%= link_to "Open student", admin_student_path(enrollment.student, active_tab: "active_courses"), class: "text-xs underline underline-offset-2 text-stone-700 hover:text-stone-900 dark:text-stone-300 dark:hover:text-stone-100" %>
            <span class="text-stone-300 dark:text-stone-600">|</span>
            <%= link_to "Publish lesson plan", admin_course_lessons_path(enrollment.course), class: "text-xs underline underline-offset-2 text-stone-700 hover:text-stone-900 dark:text-stone-300 dark:hover:text-stone-100" %>
          </div>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="mt-3 text-sm text-stone-600 dark:text-stone-400">No students are currently waiting for new lessons.</p>
  <% end %>
</section>
