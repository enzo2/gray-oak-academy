<section data-testid="recent-activity" class="rounded-sm border border-stone-200 bg-white p-4 dark:border-stone-800 dark:bg-stone-900">
  <h2 class="text-lg font-semibold text-stone-900 dark:text-stone-100">Recent Activity</h2>
  <p class="mt-1 text-sm text-stone-600 dark:text-stone-400">
    Lesson completions, profile updates, and student feedback.
  </p>

  <% if dashboard[:recent_activity_items].any? %>
    <ul class="mt-3 space-y-2">
      <% dashboard[:recent_activity_items].each do |item| %>
        <% badge_label, badge_classes = case item[:kind]
          when :lesson_completed
            ["Lesson", "bg-success-100 text-success-900 dark:bg-success-800 dark:text-success-100 dark:ring-1 dark:ring-success-500/30"]
          when :profile_generated
            ["Profile", "bg-forest-100 text-forest-900 dark:bg-forest-800 dark:text-forest-100 dark:ring-1 dark:ring-forest-500/30"]
          else
            ["Feedback", "bg-paper-200 text-paper-900 dark:bg-paper-800 dark:text-paper-50 dark:ring-1 dark:ring-paper-500/30"]
          end %>

        <li data-testid="recent-activity-row" class="rounded-sm border border-stone-200 p-3 dark:border-stone-700">
          <div class="flex flex-wrap items-center gap-2">
            <span class="rounded-full px-2 py-0.5 text-xs font-semibold <%= badge_classes %>"><%= badge_label %></span>
            <span class="text-xs text-stone-500 dark:text-stone-400"><%= time_ago_in_words(item[:occurred_at]) %> ago</span>
          </div>
          <%= link_to item[:title], item[:path], class: "mt-1 block text-sm font-semibold text-stone-900 underline decoration-stone-300 underline-offset-2 hover:decoration-stone-500 dark:text-stone-100 dark:decoration-stone-600" %>
          <p class="mt-1 text-xs text-stone-600 dark:text-stone-400"><%= item[:subtitle] %></p>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="mt-3 text-sm text-stone-600 dark:text-stone-400">No recent activity yet.</p>
  <% end %>
</section>
