<section data-testid="lesson-activity-overview" class="rounded-sm border border-stone-200 bg-white p-4 dark:border-stone-800 dark:bg-stone-900">
  <div class="flex flex-wrap items-center justify-between gap-2">
    <h2 class="text-lg font-semibold text-stone-900 dark:text-stone-100">7-Day Lesson Activity</h2>
    <div class="flex flex-wrap items-center gap-3 text-xs text-stone-600 dark:text-stone-400">
      <span class="inline-flex items-center gap-1"><span class="inline-block h-2 w-2 rounded-full bg-moss-500"></span>Started</span>
      <span class="inline-flex items-center gap-1"><span class="inline-block h-2 w-2 rounded-full bg-success-500"></span>Completed</span>
    </div>
  </div>
  <% started_total = dashboard[:lesson_activity_7d].sum { |day| day[:started_count] } %>
  <% completed_total = dashboard[:lesson_activity_7d].sum { |day| day[:completed_count] } %>
  <% max_count = dashboard[:lesson_activity_max_count].to_i %>
  <% y_axis_labels = dashboard_y_axis_labels(max_count) %>

  <div class="mt-2 text-xs text-stone-600 dark:text-stone-400">
    <span><strong class="text-stone-800 dark:text-stone-200"><%= started_total %></strong> started</span>
    <span class="mx-1">|</span>
    <span><strong class="text-stone-800 dark:text-stone-200"><%= completed_total %></strong> completed</span>
  </div>

  <div class="mt-3 overflow-x-auto">
    <div class="min-w-[22rem] relative">
      <div class="pr-8">
        <div class="relative h-48 border-b border-l border-stone-200 dark:border-stone-700">
          <div class="pointer-events-none absolute inset-0">
            <div class="absolute inset-x-0 top-0 border-t border-stone-200/80 dark:border-stone-700/70"></div>
            <div class="absolute inset-x-0 top-1/2 border-t border-stone-200/80 dark:border-stone-700/70"></div>
          </div>

          <div class="absolute inset-x-1 inset-y-1 grid grid-cols-7 gap-1.5 sm:gap-2">
            <% dashboard[:lesson_activity_7d].each do |day| %>
              <div data-testid="lesson-activity-day"
                   data-date="<%= day[:date].iso8601 %>"
                   data-started="<%= day[:started_count] %>"
                   data-completed="<%= day[:completed_count] %>"
                   class="flex items-end justify-center gap-1">
                <div class="w-2.5 rounded-t-sm bg-moss-500 sm:w-3"
                     title="<%= "#{day[:date].strftime('%a, %b %-d')}: #{day[:started_count]} started" %>"
                     style="height: <%= dashboard_bar_height(day[:started_count], max_count) %>"></div>
                <div class="w-2.5 rounded-t-sm bg-success-500 sm:w-3"
                     title="<%= "#{day[:date].strftime('%a, %b %-d')}: #{day[:completed_count]} completed" %>"
                     style="height: <%= dashboard_bar_height(day[:completed_count], max_count) %>"></div>
              </div>
            <% end %>
          </div>
        </div>

        <div class="mt-1 grid grid-cols-7 gap-1.5 sm:gap-2">
          <% dashboard[:lesson_activity_7d].each do |day| %>
            <div class="text-center text-[10px] text-stone-600 dark:text-stone-400">
              <span><%= day[:date].strftime("%a") %></span>
            </div>
          <% end %>
        </div>
      </div>

      <div class="pointer-events-none absolute right-0 top-0 h-48 w-7 text-[10px] text-stone-500 dark:text-stone-400">
        <% if y_axis_labels[:top].present? %>
          <span data-testid="lesson-activity-y-axis-top" class="absolute -top-1 right-0"><%= y_axis_labels[:top] %></span>
        <% end %>
        <% if y_axis_labels[:middle].present? %>
          <span data-testid="lesson-activity-y-axis-middle" class="absolute top-1/2 right-0 -translate-y-1/2"><%= y_axis_labels[:middle] %></span>
        <% end %>
        <span data-testid="lesson-activity-y-axis-bottom" class="absolute -bottom-1 right-0"><%= y_axis_labels[:bottom] %></span>
      </div>
    </div>
  </div>
</section>
