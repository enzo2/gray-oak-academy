<section data-testid="unread-notifications" class="rounded-sm border border-stone-200 bg-white p-4 dark:border-stone-800 dark:bg-stone-900">
  <div class="flex items-start justify-between gap-3">
    <h2 class="text-lg font-semibold text-stone-900 dark:text-stone-100">Unread Notifications</h2>
    <span class="rounded-full bg-blue-100 px-2 py-0.5 text-xs font-semibold text-blue-900 dark:bg-blue-900/40 dark:text-blue-200">
      <%= dashboard[:unread_notifications_total] %>
    </span>
  </div>

  <% if dashboard[:unread_notifications].any? %>
    <ul class="mt-3 space-y-2">
      <% dashboard[:unread_notifications].each do |notification| %>
        <li data-testid="unread-notification-row" class="rounded-sm border border-stone-200 p-3 dark:border-stone-700">
          <p class="text-sm text-stone-900 dark:text-stone-100"><%= notification.message %></p>
          <p class="mt-1 text-xs text-stone-500 dark:text-stone-400"><%= time_ago_in_words(notification.created_at) %> ago</p>
          <% if notification.link.present? && !notification.link.match?(/\Ajavascript:/i) %>
            <%= link_to "View details", notification.link, class: "mt-2 inline-block text-xs underline underline-offset-2 text-stone-700 hover:text-stone-900 dark:text-stone-300 dark:hover:text-stone-100" %>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="mt-3 text-sm text-stone-600 dark:text-stone-400">No unread notifications.</p>
  <% end %>

  <div class="mt-3">
    <%= link_to "Go to notifications", notifications_path, class: "text-sm font-medium underline underline-offset-2 text-stone-700 hover:text-stone-900 dark:text-stone-300 dark:hover:text-stone-100" %>
  </div>
</section>
