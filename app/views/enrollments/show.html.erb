<% quick_lesson = @enrollment.course.kind_quick_lesson? %>
<% teacher_back_tab = quick_lesson ? :quick_lessons : (@enrollment.completed? ? :past_courses : :active_courses) %>
<% student_back_tab = params[:active_tab].presence&.to_sym || (quick_lesson ? :quick_lessons : (@enrollment.completed? ? :past_courses : :courses)) %>
<% back_path =
  if current_user.role_teacher?
    admin_student_path(@enrollment.student, active_tab: teacher_back_tab)
  else
    student_root_path(active_tab: student_back_tab)
  end %>
<% wrapper_classes = current_user.role_teacher? ? "max-w-5xl" : "p-2 sm:p-4 max-w-5xl mx-auto" %>

<div class="<%= wrapper_classes %>">
  <div class="mb-4">
    <%= link_to back_path, class: "inline-flex items-center gap-1 text-sm underline" do %>
      <sl-icon name="arrow-left"></sl-icon>
      <span>
        <%= current_user.role_teacher? ? "Back to Student Dashboard" : "Back to Dashboard" %>
      </span>
    <% end %>
  </div>

  <h2 class="text-2xl mb-2"><%= @enrollment.course.title %></h2>

  <% if @enrollment.completed? && quick_lesson %>
    <p class="mb-4">Quick lesson completed.</p>
  <% elsif @enrollment.completed? %>
    <% course_report = @enrollment.student_reports.first %>
    <% if course_report %>
      <p class="mb-4">Course completed on <%= course_report.created_at.strftime("%B %d, %Y") %>.</p>
      <div class="mt-2 mb-4 max-w-2xl rounded-lg border border-stone-200 bg-white px-4 py-3 shadow-sm dark:border-stone-700 dark:bg-stone-900">
        <h3 class="mb-3 text-lg font-semibold">Course report</h3>
        <%= render "student_reports/editable",
                   report: course_report,
                   editable: current_user.role_teacher?,
                   context: "enrollment" %>
      </div>
    <% else %>
      <p class="mb-4">Course completed.</p>
    <% end %>
  <% else %>
    <p class="mb-2">You are enrolled in this <%= quick_lesson ? "quick lesson" : "course" %>, and have <%= @enrollment.remaining_lessons %> <%= "lesson".pluralize(@enrollment.remaining_lessons) %> left.</p>
  <% end %>

  <h3 class="text-xl mb-2"><%= quick_lesson ? "Lesson" : "Lessons" %>:</h3>
  <% @enrollment.course.lessons.each do |lesson| %>
    <% student_reports = lesson.student_reports.where(student: @enrollment.student) %>
    <sl-details summary="<%= "✔ " unless student_reports.empty? %><%= lesson.title %>" class="my-1">
      <p class="mb-4">
        <b>Lesson Goals:</b>
        <%= lesson.goals %>
      </p>

      <% lesson_progress = lesson.lesson_progresses.find_by(student: @enrollment.student) %>
      <% if lesson_progress %>
        <div class="mb-4 text-sm text-stone-600 dark:text-stone-400">
          <p>Started: <%= lesson_progress.created_at.strftime("%B %d, %Y %H:%M") %></p>
          <% if lesson_progress.completed_at %>
            <p>Completed: <%= lesson_progress.completed_at.strftime("%B %d, %Y %H:%M") %></p>
          <% end %>
          <% if lesson_progress.duration.to_i > 0 %>
            <p>Time Spent: <%= (lesson_progress.duration / 60.0).round(1) %> minutes</p>
          <% end %>

          <% if lesson_progress.conversation %>
            <div class="mt-2">
              <%= link_to conversation_path(lesson_progress.conversation),
                    class: "inline-flex items-center gap-1 text-forest-600 hover:text-forest-800 dark:text-forest-400 dark:hover:text-forest-200",
                    target: "_blank" do %>
                <sl-icon name="chat-square-text"></sl-icon>
                <span>Review Conversation</span>
              <% end %>
            </div>
          <% end %>
        </div>
      <% end %>

      <% student_reports.each do |student_report| %>
        <div class="my-2 max-w-2xl rounded-lg border border-stone-200 bg-white px-4 py-3 shadow-sm dark:border-stone-700 dark:bg-stone-900">
          <p class="mb-3 text-xs text-stone-500 dark:text-stone-400">
            Completed <%= student_report.created_at.strftime("%B %d, %Y") %>
          </p>
          <%= render "student_reports/editable",
                     report: student_report,
                     editable: current_user.role_teacher?,
                     context: "enrollment" %>
        </div>
      <% end %>
    </sl-details>
  <% end %>
</div>
