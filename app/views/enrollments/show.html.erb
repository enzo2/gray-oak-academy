<h2 class="text-2xl mb-2"><%= @enrollment.course.title %></h2>

<% if @enrollment.completed? %>
  <p class="mb-4">Course completed on <%= @enrollment.student_reports.first.created_at.strftime("%B %d, %Y") %>.</p>
  <div class="bg-stone-300 dark:bg-stone-700 rounded-lg mt-2 mb-4 px-4 py-2 pl-4
              prose dark:prose-invert prose-stone
              max-w-2xl
              prose-p:mb-0 leading-tight
              prose-li:my-0 prose-ul:my-0
              prose-ul:marker:text-stone-800 dark:prose-ul:marker:text-stone-100">
    <h3 class="mb-3">Course report</h3>
    <%= markdown(@enrollment.student_reports.first.to_markdown) %>
  </div>
<% elsif %>
  <p class="mb-2">This course is not yet completed.</p>
<% end %>

<h3 class="text-xl mb-2">Lessons:</h3>
<% @enrollment.course.lessons.each do |lesson| %>
  <% student_reports = lesson.student_reports.where(student: @enrollment.student)%>
  <sl-details summary="<%= "✔ " unless student_reports.empty? %><%= lesson.title %>" class="my-1">
    <p class="mb-4">
      <b>Lesson Goals:</b>
      <%= lesson.goals %>
    </p>
    <% student_reports.each do |student_report| %>
      <div class="bg-stone-300 dark:bg-stone-700 rounded-lg my-2 px-4 py-2 pl-4
                    prose dark:prose-invert prose-stone
                    max-w-2xl
                    prose-p:mb-0 leading-tight
                    prose-li:my-0  prose-ul:my-0
                    prose-ul:marker:text-stone-800 dark:prose-ul:marker:text-stone-100">
        <span class="mb-3"><i>Completed <%= student_report.created_at.strftime("%B %d, %Y") %></i>:</span>
        <%= markdown(student_report.to_markdown) %>
      </div>
    <% end %>
  </sl-details>
<% end %>