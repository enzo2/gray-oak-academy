<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || ENV["APP_NAME"] || "Gray Oak Academy" %></title>
    <meta property="og:title" content="<%= ENV["APP_NAME"] || "Gray Oak Academy" %>">
    <meta property="og:type" content="website">
    <meta name="robots" content="noindex, nofollow, noarchive">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <meta
      name="theme-color"
      content="#dbe5cc"
      media="(prefers-color-scheme: light)">
    <meta
      name="theme-color"
      content="#485340"
      media="(prefers-color-scheme: dark)">
    <meta name="turbo-refresh-method" content="morph">
    <meta name="turbo-refresh-scroll" content="preserve">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

 		<%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
		<%= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>
		
    <!--
    <link rel="icon" href="/icon.png" type="image/png">
     -->
   <%= favicon_link_tag 'logo_icon_negative.svg', type: "image/svg+xml" %>

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= combobox_style_tag %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= action_cable_meta_tag %>
    <%= javascript_importmap_tags %>
  </head>

  <%# Height is left to the main content, eg. max-h-[calc(100dvh-2.5rem)] %>
  <body class="bg-stone-100 text-stone-800 dark:bg-stone-800 dark:text-stone-100">
    <div data-controller="toast">
      <ol
        class="fixed z-[1000] w-[calc(100vw-2rem)] max-w-sm pointer-events-none"
        data-toast-target="container"
        data-action="mouseenter->toast#handleMouseEnter mouseleave->toast#handleMouseLeave"
        aria-live="polite"
        aria-atomic="false"
        role="status">
      </ol>
    </div>

    <header class="h-10 border-b border-stone-400"> <%# h-10 = 2.5rem %>
      <nav class="flex justify-between items-center">
        <div class="pl-2 flex flex-row space-x-2 items-center" id="nav-left-items">
          <%= link_to root_path, class: "flex flex-row space-x-2" do %>
            <%= image_tag "logo_icon.svg", size: "30", class: "bg-stone-100 dark:hidden" %>
            <%= image_tag "logo_icon_negative.svg", size: "30", class: "hidden dark:block bg-stone-800" %>
            <span class="text-xl font-bold font-serif hidden md:inline"><%= ENV["APP_NAME"] || "Gray Oak Academy" %></span>
          <% end %>
          <%= yield :header_buttons %>
        </div>

        <div class="flex items-center [&_a:hover]:underline" id="nav-right-items">
          <% if user_signed_in? %>
            <a href="<%= notifications_path %>" class="sm:hidden mr-2 relative text-2xl text-stone-600 dark:text-stone-300 flex items-center">
              <sl-icon name="bell"></sl-icon>
              <span class="absolute -top-1 -right-2">
                <%= render "notifications/counter", count: current_user.notifications.unread.count, id: "notifications_counter_mobile" %>
              </span>
            </a>
            <sl-dropdown class="sm:hidden" placement="bottom-end" skidding="50">
              <sl-icon-button name="three-dots-vertical" label="Main Menu" slot="trigger" class="text-2xl"></sl-icon-button>
              <sl-menu>
                <sl-menu-item data-click-child><a href="<%= root_path %>">Dashboard</a></sl-menu-item>
                <sl-menu-item data-click-child><a href="<%= notifications_path %>">Notifications <%= render "notifications/counter", count: current_user.notifications.unread.count, id: "notifications_counter_menu" %></a></sl-menu-item>
                <% if current_user.role_teacher? %>
                  <sl-menu-item data-click-child><a href="<%= admin_help_path %>" data-testid="teacher-guide-nav-link-mobile">Guide</a></sl-menu-item>
                <% end %>
                <sl-menu-item data-click-child><a href="<%= edit_user_registration_path %>">Settings</a></sl-menu-item>
                <sl-menu-item data-click-child><%= link_to "Log out", destroy_user_session_path, method: :delete, data: { turbo_method: :delete } %></sl-menu-item>
              </sl-menu>
            </sl-dropdown>
            <div class="space-x-4 hidden sm:block pr-4">
              <%= link_to "Dashboard", root_path, class: "" %>
              <%= link_to notifications_path, class: "group inline-flex items-center" do %>
                Notifications
                <span class="ml-1">
                  <%= render "notifications/counter", count: current_user.notifications.unread.count, id: "notifications_counter_desktop" %>
                </span>
              <% end %>
              <% if current_user.role_teacher? %>
                <%= link_to "Guide", admin_help_path, class: "", data: { testid: "teacher-guide-nav-link-desktop" } %>
              <% end %>
              <%= link_to "Settings", edit_user_registration_path, class: "" %>
              <%= link_to "Log out", destroy_user_session_path, method: :delete, data: { turbo_method: :delete }, class: "" %>
            </div>
          <% end %>
          <div class="text-2xl md:pr-4" id="dark_mode_switch"
               data-controller="tooltip"
               data-tooltip-content="Toggle Light Mode"
               data-tooltip-placement-value="bottom">
            <sl-icon-button name="sun" class="dark-mode-toggle"></sl-icon-button>
          </div>
        </div>
      </nav>
      <!-- Flash payloads are routed through this target and rendered by the custom toast controller -->
      <%# Flash.now[:abc] instead of flash[:abc] is needed for turbo_stream renders %>
      <%# To send a flash message via Action Cable, broadcast shared/flash to flash_bar %>
      <div id="flash_bar" class="hidden" data-controller="flash-toast-bridge" data-turbo-temporary>
        <%= render "shared/flash" if flash.any? %>
      </div>
    </header>

    <%# Use content_for :body to add the main content %>
    <%= content_for?(:body) ? yield(:body) : yield %>

    <footer id="footer">

    </footer>
  </body>
</html>
