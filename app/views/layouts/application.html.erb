<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || ENV["APP_NAME"] %></title>
    <meta property="og:title" content="<%= ENV["APP_NAME"] %>">
    <meta property="og:type" content="website">
    <meta name="robots" content="noindex, nofollow, noarchive">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="manifest" href="/manifest.json">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <%= stylesheet_link_tag "tailwind", "inter-font", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-gray-50 dark:bg-gray-800 text-gray-900 dark:text-white min-h-screen">
    <header class="border-b border-gray-400">
      <nav class="flex px-5 py-5 justify-between items-center">
        <div class="flex flex-row space-x-5" id="nav-left-items">
          <div class="" id="app_logotype">
            <%= link_to root_path, class: "text-xl font-bold" do %>
              <%= ENV["APP_NAME"] %>
            <% end %>
          </div>
          <%= render "shared/flash" %>
        </div>

        <div class="flex items-center space-x-5" id="nav-right-items">
          <% if user_signed_in? %>
            <%= link_to "Dashboard", root_path, class: "" %>
            <%= button_to "Log out", destroy_user_session_path, method: :delete, class: "" %>
          <% else %>
            <%= link_to "Log in", new_user_session_path, class: "" %>
          <% end %>
          <div class="" id="dark_mode_switch">
            <sl-icon-button name="moon-stars" class="dark-mode-toggle" onclick="toggleDarkMode();"></sl-icon-button>
          </div>
          </div>
        </div>
      </nav>
    </header>

    <%= yield %>

    <footer>
      <hr>
      <div class="mx-3 my-3 prose">
        <!--footer content -->
      </div>
    </footer>
  </body>
</html>
