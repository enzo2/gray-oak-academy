<%# The admin namespace base view includes the navigation elements, and turbo_stream_from, for teacher dashboards %>

<% content_for :header_buttons do %>
  <sl-icon-button
    name="list"
    label="Open navigation"
    class="text-2xl md:hidden pr-2"
    onclick="document.getElementById('admin-drawer').show()"
    aria-controls="admin-drawer"
    title="Open navigation">
  </sl-icon-button>
<% end %>

<% content_for :body do %>
  <div class="flex flex-row min-h-[calc(100dvh-2.5rem)]"> <%# Fill the viewport, minus the header height. %>
    <!-- Mobile drawer (shoelace) -->
  <sl-drawer id="admin-drawer" placement="left" class="" 
             style="--size:16rem;--header-spacing:0;--body-spacing:0;">
    <div class="p-4">
      <%= render "layouts/admin/sidebar" %>
    </div>
  </sl-drawer>

  <!-- Desktop sidebar -->
  <aside class="hidden md:block md:w-34 flex-none border-r border-stone-400 px-4 pt-2">
    <%= render "layouts/admin/sidebar" %>
  </aside>

    <!-- Main content -->
    <main class="grow px-4 pt-4">
      <%= turbo_stream_from "teacher_#{current_user.id}-dashboard" %>
      <%= yield %>
    </main>
  </div>
<% end %>

<%# Need to explicitly render the application layout for some reason, even though class BaseController inherits from ApplicationController %>
<%= render template: "layouts/application" %>
