<%# locals: (path:, label:, icon:) %>
<%= link_to path, aria: { label: label }, class: "group w-full flex items-center justify-between gap-2 rounded-md px-2 py-1.5 text-left text-sm text-stone-700 hover:bg-stone-100 focus-visible:bg-stone-100 focus:outline-hidden disabled:cursor-not-allowed disabled:opacity-50 dark:text-stone-100 dark:hover:bg-stone-700/50 dark:focus-visible:bg-stone-700/50" do %>
  <div class="flex min-w-0 items-center gap-1.5">
    <div class="flex items-center justify-center group-disabled:opacity-50 group-data-disabled:opacity-50">
      <sl-icon name="<%= icon %>" class="text-lg"></sl-icon>
    </div>
    <div class="flex min-w-0 grow items-center gap-2.5 group-data-no-contents-gap:gap-0">
      <div class="truncate"><%= label %></div>
    </div>
  </div>
<% end %>
