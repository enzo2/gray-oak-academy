<div id="<%= dom_id(report) %>_card">
  <div class="flex items-center gap-2 mb-2">
    <span class="badge bg-blue-100 text-blue-800 border-blue-200 text-xs">
      <% if report.reportable_type == 'User' %>
        Profile Report
      <% elsif report.reportable_type == 'LessonProgress' %>
        Lesson Report: <%= report.reportable&.lesson&.title %>
      <% elsif report.reportable_type == 'Enrollment' %>
        Course Report: <%= report.reportable&.course&.title %>
      <% else %>
        Report
      <% end %>
    </span>
  </div>

  <div class="prose dark:prose-invert prose-sm leading-normal text-stone-800 dark:text-stone-300 max-h-48 overflow-hidden relative group">
    <%= markdown(report.to_markdown) %>
    <div class="absolute inset-x-0 bottom-0 h-12 bg-gradient-to-t from-white dark:from-stone-800 to-transparent group-hover:hidden"></div>
  </div>
  
  <!-- Expand button logic could be added here or just keep it simple for MVP -->
  <div class="mt-2 text-center">
    <button class="text-xs text-blue-600 hover:underline" onclick="this.parentElement.previousElementSibling.classList.toggle('max-h-48'); this.parentElement.previousElementSibling.lastElementChild.classList.toggle('hidden'); this.innerText = this.innerText === 'Show Less' ? 'Show More' : 'Show Less'">Show More</button>
  </div>
</div>
