<%= form_with(model: Message.new, 
      url: conversation_messages_path(conversation), 
      id: "#{dom_id(conversation)}_message_form",
      class: "",
      data: { controller: "new-message" }
    ) do |form| %>

  <% if local_assigns[:error].present? %>
    <div class="mb-4 p-2 bg-red-100 dark:bg-red-900 text-red-700 dark:text-red-100 rounded-md">
      <%= error %>
    </div>
  <% end %>

  <div data-new-message-target="previewArea" class="flex mt-2 bg-neutral-200 dark:bg-neutral-700 rounded-md p-4 hidden"></div>
  <div class="relative">
    <div class="
               [&_sl-textarea::part(form-control-input)]:shadow-none 
               relative
               ">
      <sl-textarea 
        resize="auto" 
        rows="1" 
        name="message[content]" 
        placeholder="Type your message..." 
        class="w-full
              [&::part(base)]:min-h-[80px]
              [&::part(base)]:pl-1 
              [&::part(base)]:pr-[4.75rem]
              [&::part(base)]:pb-6
              [&::part(base)]:pt-2
              [&::part(base)]:border-1
              [&::part(base)]:rounded-none
              [&::part(base)]:rounded-t-md
              [&::part(base)]:border-neutral-200 
              dark:[&::part(base)]:border-0 
              [&::part(base)]:focus:shadow-none 
              [&::part(base)]:focus:ring-offset-0 
              [&::part(base)]:focus:ring-0
              [&::part(textarea)]:min-h-[50px]
              [&::part(textarea)]:max-h-64
              [&::part(textarea)]:overflow-y-auto
              "
        data-new-message-target="contentField"
        data-action="
          input->new-message#toggleSubmitButton 
          keydown.enter->new-message#submit:prevent
          paste->new-message#paste"
      ></sl-textarea>
      
      <div data-new-message-target="helpText" 
           class="text-xs text-neutral-500 hidden absolute bottom-1 right-2">
        Shift+Enter for new line
      </div>
    </div>

    <div class="absolute right-[5px] top-[6px] flex items-center space-x-1">
      <%= form.file_field :images, multiple: true, class: "hidden", data: { new_message_target: "fileInput", action: "new-message#handleFiles" }, accept: "image/png, image/jpeg, image/webp" %>
      
      <sl-dropdown placement="top-end">
        <sl-icon-button slot="trigger" name="images" class="" data-new-message-target="imagesMenuButton"></sl-icon-button>
        <sl-menu data-new-message-target="imagesMenu">
          <sl-menu-item value="file">
            Upload Image
            <sl-icon slot="suffix" name="paperclip"></sl-icon>
          </sl-menu-item>
          <sl-menu-item value="url">
            Link to URL
            <sl-icon slot="suffix" name="link"></sl-icon>
          </sl-menu-item>
        </sl-menu>
      </sl-dropdown>

      <button type="submit" class="text-xl" data-new-message-target="submitButton" data-action="click->new-message#submit">
        <sl-icon-button name="arrow-right-square" class="hidden" data-new-message-target="submitIcon"></sl-icon-button>
        <div data-new-message-target="submitSpinner" class="hidden p-[6px]">
          <sl-spinner></sl-spinner>
        </div>
      </button>
    </div>

    <%= form.hidden_field :images_data, data: { new_message_target: "imagesData" } %>
  </div>

  <sl-dialog label="Add image via URL" class="" data-new-message-target="urlDialog">
    <sl-input data-new-message-target="urlInput" data-action="keydown.enter->new-message#handleUrlInput:prevent" placeholder="Enter image URL" class=""></sl-input>
    <sl-button slot="footer" data-action="click->new-message#handleUrlInput">Submit</sl-button>
  </sl-dialog>
<% end %>