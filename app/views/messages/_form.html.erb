<% audio_setting = conversation.audio_setting %>

<%= form_with(model: Message.new, 
      url: conversation_messages_path(conversation), 
      id: "#{dom_id(conversation)}_message_form",
      class: "",
      data: { 
        controller: "new-message audio-recorder",
        action: "camera:photo@document->new-message#addCameraPhoto camera:availability@document->new-message#setCameraAvailability",
        new_message_conversation_id_value: conversation.id,
        new_message_audio_setting_value: audio_setting, # Refers to whether audio input is disabled/enabled/enforced for the conversation/lesson.
        audio_recorder_audio_setting_value: audio_setting, 
        audio_recorder_audio_input_permitted_value: conversation.audio_input_permitted?, # Refers to whether the LLM supports raw audio input, and audio_setting is not disabled.
        audio_recorder_stt_available_value: AppSetting.stt_configured?,
        audio_recorder_conversation_id_value: conversation.id
      }
  ) do |form| %>

  <% if local_assigns[:error].present? %>
    <div class="mb-4 rounded-md bg-danger-100 p-2 text-danger-800 dark:bg-danger-900/50 dark:text-danger-100">
      <%= error %>
    </div>
  <% end %>

  <div data-new-message-target="previewArea" id="previewArea"
       class="mt-2 hidden flex-wrap gap-2 rounded-md bg-stone-200 p-3 dark:bg-stone-700"></div>

  <div class="relative">
    <div class="relative
               [&_sl-textarea::part(form-control-input)]:shadow-none">
      <sl-textarea
        resize="auto"
        rows="1"
        name="message[content]"
        placeholder="Type your message..." <%# Default value—will be changed by audio_recorder_controller if audio/stt is possible %>
        class="w-full
              [&::part(base)]:min-h-[80px]
              [&::part(base)]:pl-0
              [&::part(base)]:pr-[4.75rem]
              [&::part(base)]:pb-6
              [&::part(base)]:pt-2
              [&::part(base)]:border-1
              [&::part(base)]:rounded-none
              [&::part(base)]:rounded-t-md
              [&::part(base)]:border-stone-200
              dark:[&::part(base)]:border-0
              [&::part(base)]:shadow-none!
              [&::part(base)]:focus:ring-offset-0
              [&::part(base)]:focus:ring-0
              [&::part(textarea)]:min-h-[50px]
              [&::part(textarea)]:max-h-64
              [&::part(textarea)]:overflow-y-auto"
        data-new-message-target="contentField"
        data-audio-recorder-target="textarea"
        data-action="
          input->new-message#toggleSubmitButton
          keydown.enter->new-message#submit:prevent
          <%= if audio_setting == "only" then "paste@window->new-message#paste" else "paste->new-message#paste" end %>
          chalkboard:screenshot@window->new-message#addScreenshotFromEvent
          chalkboard:browser-screenshot-request@window->new-message#captureBrowserScreenshot
          "
        <% if audio_setting == "only" %>
          disabled
        <% end %>
      ></sl-textarea>

      <div data-new-message-target="helpText" data-audio-recorder-target="helpText"
           data-default-value="<%= audio_setting == "only" ? "Audio-only lesson: press spacebar to start recording" : "" %>"
           class="absolute bottom-1 left-4 text-xs text-stone-500 dark:text-stone-400 <%= "hidden" unless audio_setting == "only" %>">
        <% if audio_setting == "only" %>
          Audio-only lesson: press spacebar to start recording
        <% end %>
      </div>
    </div>

    <div class="absolute right-[8px] <%= audio_setting == "only" ? "bottom-[6px]" : "" %> top-[6px] flex items-center">
      <%= form.file_field :images, multiple: true, class: "hidden", data: { new_message_target: "fileInput", action: "new-message#handleFiles" }, accept: "image/png, image/jpeg, image/webp" %>

      <sl-dropdown placement="top-end">
        <sl-icon-button slot="trigger" name="images" class="text-xl" data-new-message-target="imagesMenuButton"></sl-icon-button>
        <sl-menu data-new-message-target="imagesMenu">
          <sl-menu-item value="camera" class="hidden" data-new-message-target="cameraMenuItem">
            Take Photo
            <sl-icon slot="suffix" name="camera"></sl-icon>
          </sl-menu-item>
          <sl-menu-item value="file">
            Upload Image
            <sl-icon slot="suffix" name="paperclip"></sl-icon>
          </sl-menu-item>
          <sl-menu-item value="url">
            Link to URL
            <sl-icon slot="suffix" name="link"></sl-icon>
          </sl-menu-item>
          <sl-menu-item value="screenshot" class="hidden" data-new-message-target="screenshotMenuItem">
            Screenshot
            <sl-icon slot="suffix" name="display"></sl-icon>
          </sl-menu-item>
        </sl-menu>
      </sl-dropdown>

      <sl-icon-button
        <%# hidden by default; shown if audio recording is supported (llm supports audio & audio permitted, or transcription configured) %>
        class="hidden text-xl <%= 'text-4xl' if audio_setting == "only" %>"
        name="mic" id="recordButton"
        data-audio-recorder-target="recordButton"
        data-action="click->audio-recorder#toggleRecording
                     <%= "keydown.space@window->audio-recorder#toggleRecording:prevent" if audio_setting == "only" %>">
      </sl-icon-button>
      
    </div>
    <div class="absolute right-[6px] bottom-[6px] flex items-center">
      <button type="submit" class="text-xl" aria-label="Send message" title="Send message" data-new-message-target="submitButton" data-action="click->new-message#submit">
        <sl-icon-button name="arrow-right-square" class="hidden" data-new-message-target="submitIcon"></sl-icon-button>
        <div data-new-message-target="submitSpinner" class="hidden p-[6px] flex items-center gap-[3px]">
          <span class="block h-[5px] w-[5px] rounded-full bg-stone-400 animate-pulse-dot"></span>
          <span class="block h-[5px] w-[5px] rounded-full bg-stone-400 animate-pulse-dot [animation-delay:0.2s]"></span>
          <span class="block h-[5px] w-[5px] rounded-full bg-stone-400 [animation-delay:0.4s] animate-pulse-dot"></span>
        </div>
      </button>
    </div>

    <%= form.hidden_field :images_data, data: { new_message_target: "imagesData" } %>
  </div>

  <sl-dialog label="Add image via URL" data-new-message-target="urlDialog">
    <sl-input data-new-message-target="urlInput" 
              data-action="keydown.enter->new-message#handleUrlInput:prevent" 
              placeholder="Enter full image URL (https://...)" 
    ></sl-input>
    <sl-button slot="footer" data-action="click->new-message#handleUrlInput">Submit</sl-button>
  </sl-dialog>

  <div data-controller="modal"
       id="<%= dom_id(conversation) %>_camera_modal"
       data-modal-panel-class-value="relative transform overflow-hidden rounded-lg bg-white dark:bg-stone-900 text-left shadow-xl transition-all sm:my-8 sm:w-full sm:max-w-2xl border border-stone-200 dark:border-stone-700">
    <div data-modal-target="content"
         data-controller="camera"
         data-camera-modal-id-value="<%= dom_id(conversation) %>_camera_modal"
         data-action="new-message:camera-open@document->camera#open new-message:camera-check@document->camera#initializeAvailability modal:open@document->camera#handleModalOpen modal:close@document->camera#handleModalClose"
         class="hidden">
      <div class="p-4 sm:p-6">
        <div class="flex items-center justify-between mb-3">
          <h2 class="text-lg font-semibold text-stone-900 dark:text-stone-100">Capture photo</h2>
          <button type="button" class="text-stone-500 hover:text-stone-700 dark:text-stone-400 dark:hover:text-stone-200" aria-label="Close camera" title="Close camera" data-action="modal#close">
            <sl-icon name="x-lg" class="text-xl"></sl-icon>
          </button>
        </div>

        <div class="bg-black/80 rounded-md overflow-hidden flex items-center justify-center relative">
          <div class="absolute top-2 right-2 z-10 flex gap-2">
            <sl-icon-button
              name="phone-flip"
              label="Switch camera"
              class="text-white [&::part(base)]:bg-black/60 [&::part(base)]:border-0 [&::part(base)]:rounded-full [&::part(base)]:hover:bg-black/70"
              data-camera-target="switchButton"
              data-action="click->camera#switchCamera">
            </sl-icon-button>
            <sl-icon-button
              name="arrow-left-right"
              label="Mirror preview"
              class="text-white [&::part(base)]:bg-black/60 [&::part(base)]:border-0 [&::part(base)]:rounded-full [&::part(base)]:hover:bg-black/70"
              data-camera-target="mirrorButton"
              data-action="click->camera#toggleMirror"
              aria-pressed="false">
            </sl-icon-button>
          </div>
          <video data-camera-target="video" class="w-full max-h-[60vh] object-contain" autoplay playsinline></video>
          <img data-camera-target="preview" class="hidden w-full max-h-[60vh] object-contain" alt="Captured preview">
        </div>

        <p class="mt-2 text-sm text-stone-500 dark:text-stone-400" data-camera-target="status"></p>
        <canvas data-camera-target="canvas" class="hidden"></canvas>

        <div class="mt-4 flex flex-wrap gap-2 justify-end">
          <sl-button variant="default" data-action="modal#close">Cancel</sl-button>
          <sl-button variant="default" class="hidden" data-camera-target="retakeButton" data-action="click->camera#retakeCamera">Retake</sl-button>
          <sl-button variant="primary" data-camera-target="captureButton" data-action="click->camera#captureCamera">Capture</sl-button>
          <sl-button variant="primary" class="hidden" data-camera-target="useButton" data-action="click->camera#useCameraPhoto">Use photo</sl-button>
        </div>
      </div>
    </div>
  </div>
<% end %>
