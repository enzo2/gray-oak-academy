<%= form_with(model: Message.new, 
      url: conversation_messages_path(conversation), 
      id: "#{dom_id(conversation)}_message_form",
      data: { controller: "new-message" }
    ) do |form| %>
  <div data-new-message-target="previewArea" class="flex mt-2 bg-gray-100 dark:bg-gray-700 rounded-md p-4 hidden"></div>
  <div class="my-5 flex items-center">
    <sl-dropdown placement="top-end">
      <sl-icon-button slot="trigger" name="images" class="text-xl"></sl-icon-button>
      <sl-menu data-new-message-target="menu">
        <sl-menu-item value="file">
          Upload Image
          <sl-icon slot="suffix" name="paperclip"></sl-icon>
        </sl-menu-item>
        <sl-menu-item value="url">
          Link to URL
          <sl-icon slot="suffix" name="link"></sl-icon>
        </sl-menu-item>
      </sl-menu>
    </sl-dropdown>
    <%= form.file_field :images, multiple: true, class: "hidden", data: { new_message_target: "fileInput", action: "new-message#handleFiles" }, accept: "image/png, image/jpeg, image/webp" %>
    <sl-dialog label="Add image via URL" class="" data-new-message-target="urlDialog">
      <sl-input data-new-message-target="urlInput" data-action="new-message#handleUrl" placeholder="Enter image URL" class=""></sl-input>
      <sl-button slot="footer" data-action="click->new-message#submitUrl">Submit</sl-button>
    </sl-dialog>
    <%= form.text_field :content, class: "form-input flex-grow mr-2", autofocus: true, data: { new_message_target: "contentField" } %>
    <%= form.hidden_field :images_data, data: { new_message_target: "imagesData" } %>
    <%= form.button type: :submit, class: "text-xl" do %>
      <sl-icon name="arrow-right-square" label="Send"></sl-icon>
    <% end %>
  </div>
<% end %>

