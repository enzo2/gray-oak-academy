<% if message.role_user? %>
  <div id="<%= dom_id(message) %>_content"
        class="message-content bg-moss-light dark:bg-moss-dark rounded-md my-2 px-4 py-2 w-fit">
    <% if message.content.blank? && message.images.empty? && message.audios.empty? %>
      <%# This is used when an audio message is being transcribed. %>
      <sl-spinner></sl-spinner>
    <% elsif message.content.blank? && message.images.empty? && message.audios.any? %>
      <i class="text-dim text-sm">Transcribing...</i>&nbsp;<sl-spinner></sl-spinner>
    <% else %>
      <% message.images.each_with_index do |image, idx| %>
        <div data-controller="modal" 
             class="inline-block"
             data-modal-panel-class-value="relative transform overflow-hidden rounded-lg bg-white dark:bg-stone-900 text-left shadow-xl transition-all sm:my-8 w-auto max-w-[95vw] border border-stone-200 dark:border-stone-700">
          <% if image.uri.present? %>
            <%= image_tag(image.uri, 
                  alt: (image.description.presence || "Image #{idx + 1}"), 
                  class: "m-2 max-w-[150px] max-h-[150px] object-contain cursor-pointer hover:opacity-90",
                  data: { action: "click->modal#open" }) %>
            
            <div data-modal-target="content" class="hidden relative flex justify-center items-center bg-stone-100 dark:bg-stone-900 p-0">
               <button type="button" class="absolute top-0 right-0 p-3 text-stone-500 hover:text-stone-700 dark:text-stone-400 dark:hover:text-stone-200 z-10" aria-label="Close image preview" title="Close image preview" data-action="modal#close">
                  <sl-icon name="x-lg" class="text-2xl"></sl-icon>
               </button>
               <%= image_tag(image.uri, 
                    alt: (image.description.presence || "Image #{idx + 1}"), 
                    class: "max-h-[85vh] max-w-full object-contain") %>
            </div>
          <% else %>
            <% variant_thumb = image.file.variant(resize_to_limit: [150, 150]) %>
            <% variant_large = image.file.variant(resize_to_limit: [1200, 1200]) %>
            <%= image_tag(rails_representation_path(variant_thumb),
                          alt: (image.description.presence || "Image #{idx + 1}"),
                          class: "m-2 max-w-[150px] max-h-[150px] object-contain cursor-pointer hover:opacity-90",
                          data: { action: "click->modal#open" }) %>
            
            <div data-modal-target="content" class="hidden relative flex justify-center items-center bg-stone-100 dark:bg-stone-900 p-0">
               <button type="button" class="absolute top-0 right-0 p-3 text-stone-500 hover:text-stone-700 dark:text-stone-400 dark:hover:text-stone-200 z-10" aria-label="Close image preview" title="Close image preview" data-action="modal#close">
                  <sl-icon name="x-lg" class="text-2xl"></sl-icon>
               </button>
               <%= image_tag(rails_representation_path(variant_large),
                             alt: (image.description.presence || "Image #{idx + 1}"),
                             class: "max-h-[85vh] max-w-full object-contain") %>
            </div>
          <% end %>
        </div>
      <% end %>
      <%# No need to provide the audio, since it is going to be transcribed and purged within a few seconds. %>
      <%# message.audios.each do |audio| %>
        <!--<div class="my-2">
          <%#= audio_tag(audio.file, autoplay: false, controls: true) %>
        </div>-->
      <%# end %>
      <%= simple_format(message.content, {}, wrapper_tag: "p") %>
    <% end %>
  </div>
<% elsif message.role_assistant? || (message.role_tool? && message.images.any?) %>
  <div class="message-content pt-2
              font-serif
              prose dark:prose-invert prose-stone max-w-none
              prose-h1:text-2xl
              prose-h2:text-xl
              prose-h3:text-lg
              prose-h4:text-base
              prose-ul:my-2 prose-li:my-0 
              prose-ul:marker:text-stone-800 dark:prose-ul:marker:text-stone-100
              space-y-3
              prose-pre:leading-tight
              prose-pre:bg-(--rouge-bg)
              prose-pre:overflow-x-auto
              [&_div.highlighted-code-block_pre]:overflow-y-auto
              [&_div.highlighted-code-block_pre]:max-h-[350px]
              [&_div.highlighted-code-block_pre]:max-w-full
              "
        id="<%= dom_id(message) %>_content"
        data-conversation-target="assistantMessageContent">
    <% if effectively_blank_text?(message.content) && message.images.empty? && message.tool_calls.nil? %>
      <% if message.persisted? %>
        <i class="text-dim text-sm">LLM had nothing to say.</i>
      <% else %>
        <%# Placeholder: accent tree handles the "thinking" indicator %>
      <% end %>
    <% else %>

      <% message.images.each_with_index do |image, idx| %>
        <div data-controller="modal" 
             class="inline-block"
             data-modal-panel-class-value="relative transform overflow-hidden rounded-lg bg-white dark:bg-stone-900 text-left shadow-xl transition-all sm:my-8 w-auto max-w-[95vw] border border-stone-200 dark:border-stone-700">
          <% if image.uri.present? %>
            <%= image_tag(image.uri,
                          alt: (image.description.presence || "Image #{idx + 1}"),
                          class: "max-w-[150px] max-h-[150px] object-contain cursor-pointer hover:opacity-90",
                          data: { action: "click->modal#open" }) %>

            <div data-modal-target="content" class="hidden relative flex justify-center items-center bg-stone-100 dark:bg-stone-900 p-0">
               <button type="button" class="absolute top-0 right-0 p-3 text-stone-500 hover:text-stone-700 dark:text-stone-400 dark:hover:text-stone-200 z-10" aria-label="Close image preview" title="Close image preview" data-action="modal#close">
                  <sl-icon name="x-lg" class="text-2xl"></sl-icon>
               </button>
               <%= image_tag(image.uri,
                             alt: (image.description.presence || "Image #{idx + 1}"),
                             class: "max-h-[85vh] max-w-full object-contain") %>
            </div>
          <% else %>
            <% small_variant = image.file.variant(resize_to_limit: [512,512]) %>
            <% large_variant = image.file.variant(resize_to_limit: [1200,1200]) %>
            <%= image_tag(rails_representation_path(small_variant),
                          alt: (image.description.presence || "Image #{idx + 1}"),
                          class: "max-w-full rounded-md object-contain cursor-pointer hover:opacity-90",
                          data: { action: "click->modal#open" }) %>

            <div data-modal-target="content" class="hidden relative flex justify-center items-center bg-stone-100 dark:bg-stone-900 p-0">
               <button type="button" class="absolute top-0 right-0 p-3 text-stone-500 hover:text-stone-700 dark:text-stone-400 dark:hover:text-stone-200 z-10" aria-label="Close image preview" title="Close image preview" data-action="modal#close">
                  <sl-icon name="x-lg" class="text-2xl"></sl-icon>
               </button>
               <%= image_tag(rails_representation_path(large_variant),
                             alt: (image.description.presence || "Image #{idx + 1}"),
                             class: "max-h-[85vh] max-w-full object-contain") %>
            </div>
          <% end %>
        </div>
      <% end %>

      <% reasoning_lines = reasoning_summary_lines(message.reasoning_details) %>
      <% if message.role_assistant? && message.tool_calls.present? && reasoning_lines.present? %>
        <details class="not-prose group/reasoning first:mt-0 mt-1 mb-1 last:mb-2">
          <summary class="inline-flex cursor-pointer select-none list-none items-center gap-1.5 text-sm font-medium font-sans transition-colors text-stone-600 hover:text-stone-500 dark:text-stone-400 dark:hover:text-stone-300">
            <svg class="h-3 w-3 shrink-0 transition-transform duration-150 group-open/reasoning:rotate-90" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/>
            </svg>
            Reasoning
          </summary>
          <div class="space-y-2 pl-4">
            <% reasoning_lines.each do |line| %>
              <div class="prose prose-stone max-w-none text-xs dark:prose-invert text-stone-600 dark:text-stone-400 [&>*:first-child]:mt-0 [&>*:last-child]:mb-0 [&_*]:font-sans [&_*]:text-xs [&_*]:leading-relaxed">
                <%= markdown(line) %>
              </div>
            <% end %>
          </div>
        </details>
      <% end %>

      <%= markdown(message.content) if effectively_present_text?(message.content) && !message.role_tool? %>

      <% if message.tool_calls.present? %>
        <% tool_names = friendly_tool_name(message.tool_calls.map { |tool_call| tool_call.dig("function", "name") }.join(", ")) %>
        <div class="not-prose first:mt-0 mt-1 mb-1 last:mb-2 flex max-w-full flex-wrap items-center gap-x-1.5 gap-y-0.5 font-sans text-sm text-stone-600 dark:text-stone-400">
          <span class="font-semibold ">Used <%= "tool".pluralize(message.tool_calls.count) %>:</span>
          <span class="break-words"><%= tool_names %></span>
        </div>
      <% end %>
    <% end %>
  </div>
<% end %>

<%# Tool result messages will not be shown to the user %>
