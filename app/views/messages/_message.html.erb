<div id="<%= dom_id(message) %>">
  <% if message.role_user? %>
    <div class="bg-sky-200 dark:bg-sky-800 rounded-lg my-2 px-4 py-2 w-fit"
      data-conversation-target="user">
      <% message.images.each do |image| %>
        <%= image_tag(image.uri || image.file.variant(resize_to_limit: [150, 150]), alt: image.description, class: "m-2 max-w-[150px] max-h-[150px] object-contain") %>
      <% end %>
      <%= simple_format(message.content, {}, wrapper_tag: "p") %>
    </div>
  <%# handle assistant messages %>
  <% elsif message.content.blank? # && message.images.blank? %>
    <div class="border-stone-200 dark:border-stone-700 border rounded-lg my-2 py-2 flex justify-center items-center"
      data-conversation-target="assistant">
      <sl-spinner></sl-spinner>
    </div>
  <% else %>
    <div class="rounded-lg my-2 py-2
                prose dark:prose-invert prose-stone
                font-serif
                [&_pre]:not-prose
                prose-h1:text-2xl
                prose-h2:text-xl
                prose-h3:text-lg
                prose-h4:text-base
                max-w-none
                prose-ul:my-2 prose-li:my-0 
                prose-ul:marker:text-stone-800 dark:prose-ul:marker:text-stone-100
                [&>:not(:first-child)]:mt-3
                [&>:not(:last-child)]:mb-3
                "
          data-code-executor-target="message"
          data-conversation-target="assistant">
      <%= markdown(message.content) %>
    </div>
  <% end %>
</div>