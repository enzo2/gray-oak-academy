<div id="<%= dom_id(message) %>" class="w-full"
     <%= "data-conversation-target=user" if message.role_user? %>
     <%= "data-conversation-target=assistant" if message.role_assistant? %>
     >
  <% if message.role_user? %>
    <div class="bg-moss-light dark:bg-moss-dark rounded-md my-2 px-4 py-2 w-fit">
      <% message.images.each do |image| %>
        <%= image_tag(image.uri || image.file.variant(resize_to_limit: [150, 150]), alt: image.description, class: "m-2 max-w-[150px] max-h-[150px] object-contain") %>
      <% end %>
      <% message.audios.each do |audio| %>
        <div class="my-2">
          <%= audio_tag(audio.file, autoplay: false, controls: true) %>
        </div>
      <% end %>
      <%= simple_format(message.content, {}, wrapper_tag: "p") %>
    </div>
  <% elsif message.role_assistant? %>
    <div class="py-2
                font-serif
                prose dark:prose-invert prose-stone max-w-none
                prose-h1:text-2xl
                prose-h2:text-xl
                prose-h3:text-lg
                prose-h4:text-base
                prose-ul:my-2 prose-li:my-0 
                prose-ul:marker:text-stone-800 dark:prose-ul:marker:text-stone-100
                [&>:not(:first-child)]:mt-3
                [&>:not(:last-child)]:mb-3
                prose-pre:leading-tight
                prose-pre:bg-[var(--rouge-bg)]
                prose-pre:overflow-x-auto
                [&_div.highlighted-code-block_pre]:overflow-y-auto
                [&_div.highlighted-code-block_pre]:max-h-[350px]
                [&_div.highlighted-code-block_pre]:max-w-full
                "
          id="<%= dom_id(message) %>_content"
          data-conversation-target="assistantContent"
          <% if message.content.present? && current_user.settings.speech_configured? %>data-controller="tts"<% end %>>
      <% if message.content.blank? %>
       <sl-spinner></sl-spinner>
      <% else %>
        <% content_with_tts = message.content.strip %>
        <%# Add TTS button only if message has content AND speech is configured for the user %>
        <% if message.content.present? && current_user.settings.speech_configured? %>
          <% tts_button_html = capture do %>
            <sl-icon-button 
              name="volume-up" 
              label="Read aloud" 
              data-tts-target="button" 
              data-action="click->tts#play"
              data-message-id-param="<%= message.id %>" 
              data-tts-state="idle" 
              class="[&::part(base)]:p-0 [&::part(base)]:pb-1
                     text-stone-500 hover:text-stone-700 
                     dark:text-stone-400 dark:hover:text-stone-200 
                     ml-2 align-middle"></sl-icon-button><sl-spinner 
              data-tts-target="spinner" 
              class="hidden p-0 ml-2"></sl-spinner>
          <% end.strip %>
          <% Rails.logger.debug "TTS button HTML: #{tts_button_html.inspect}" %>
          <% content_with_tts += tts_button_html %>
        <% end %>
        <%# Render the combined content through the markdown helper %>
        <%= markdown(content_with_tts) %>
      <% end %>
    </div>
  <% end %>
</div>
