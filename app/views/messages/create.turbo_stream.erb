<%= turbo_stream.append "#{dom_id(@message.conversation)}_messages" do %>
  <%= render "message", message: @message %>
  <%= render "message", message: Message.new(role: :assistant, content: "") %>
<% end %>

<%= turbo_stream.replace "#{dom_id(@message.conversation)}_message_form" do %>
  <%= render "form", conversation: @message.conversation %>
<% end %>