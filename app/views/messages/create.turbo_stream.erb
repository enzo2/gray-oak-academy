<%# The controller saves the user's new message. 
    The model broadcast_append_to will then render the new message, which also includes a placeholder for the assistant reply. 
    This view only needs to handle other UI updates. %>

<%= turbo_stream.replace "#{dom_id(@message.conversation)}_message_form" do %>
  <%= render "form", conversation: @message.conversation %>
<% end %>

<%= turbo_stream.update "context-usage-bar" do %>
  <% Rails.logger.debug "Updating context usage bar: #{@message.conversation.context_usage.inspect}" %>
  <%= render "conversations/context_usage_bar", context_usage: @message.conversation.context_usage %>
<% end %>

<%= turbo_stream.remove "lesson-duration" %>