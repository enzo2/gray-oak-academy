<% actions_content = capture do %>
  <%= button_to(edit_memory_path(memory),
                method: :get,
                form: { data: { turbo_stream: true } },
                aria: { label: "Edit memory" },
                title: "Edit memory",
                class: "mr-2 hover:text-moss-500") do %>
    <sl-icon name="pencil"></sl-icon>
  <% end %>

  <%= button_to(memory_path(memory),
                method: :delete,
                form: { data: { turbo_confirm: "Delete this memory?" } },
                aria: { label: "Delete memory" },
                title: "Delete memory",
                class: "hover:text-danger-500") do %>
    <sl-icon name="trash"></sl-icon>
  <% end %>
<% end %>

<%= render "memories/memory_base",
           memory: memory,
           actions: actions_content %>
