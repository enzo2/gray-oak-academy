<div id="memories-panel">
  <h2 class="text-lg font-semibold">Memories</h2>

  <p class="mb-4 text-sm">
    Memories are anything the LLM should know about you.
    <% if current_user.role_teacher? %>
      <br><i class="text-dim">To manage students' memories, go to the <%= link_to "Students dashboard", admin_students_path, class: "underline" %>.</i>
    <% end %>
  </p>

  <div class="space-y-4" id="memories-list">
    <% if @memories.any? %>
      <%= render partial: "memories/memory", collection: @memories %>
    <% else %>
      <p class="italic">No memories yet. Please add some for a better experience.</p>
    <% end %>
  </div>

  <div class="mt-6">
    <%= render "memories/form", memory: Memory.new %>
  </div>
</div>