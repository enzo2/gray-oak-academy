<%= form_with(model: memory, class: "border border-stone-200 dark:border-stone-700 rounded-lg p-4 mb-4") do |f| %>
  <% if memory.errors.any? %>
    <div class="alert alert-error mb-4">
      <%= pluralize(memory.errors.count, "error") %> prohibited this memory from being saved:
      <ul>
        <% memory.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

    <div class="mb-2">
    <%= f.label :body, "New Memory", class: "form-label mb-1" %>
    <%= f.text_area :body, class: "input-primary", rows: 2, placeholder: "Memories should be concise and descriptive." %>
  </div>

  <div class="flex gap-2">
    <%= f.submit "Add Memory", class: "btn-primary py-1 px-2" %>
  </div>
<% end %>
