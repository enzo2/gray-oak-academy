<%= turbo_stream.replace dom_id(@memory) do %>
  <%= form_with(model: @memory, method: :patch,
                id: dom_id(@memory, :form),
                class: "border border-stone-200 dark:border-stone-700 rounded-lg p-4 mb-4") do |f| %>

    <div id="<%= dom_id(@memory, :errors) %>"></div>

    <div class="mb-2">
      <%= f.label :body, "Edit Memory", class: "form-label mb-1" %>
      <%= f.text_area :body, rows: 2, required: true,
                      class: "input-primary" %>
    </div>

    <div class="flex gap-2 justify-end">
      <%= f.submit "Save", class: "btn-primary py-1 px-3" %>
    </div>
  <% end %>
<% end %>

<%= turbo_stream.update "flash_bar", partial: "shared/flash" %>

<% if @memory.errors.any? %>
  <%= turbo_stream.update(dom_id(@memory, :errors)) do %>
    <div class="mb-2 text-danger-500 dark:text-danger-400">
      <%= pluralize(@memory.errors.count, "error") %> prohibited this memory from being saved:
      <ul>
        <% @memory.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>
<% end %>
