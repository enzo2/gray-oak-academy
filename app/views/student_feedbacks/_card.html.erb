<div id="<%= dom_id(feedback) %>_card">
  <div class="mb-2 prose dark:prose-invert prose-sm leading-normal text-stone-800 dark:text-stone-300 italic">
    "<%= simple_format(feedback.content, {}, wrapper_tag: "span") %>"
  </div>
  
  <div class="flex items-center justify-end text-xs text-stone-500 dark:text-stone-400">
    <% if feedback.lesson_progress %>
      <span>Re: <%= feedback.lesson_progress.lesson.title %></span>
    <% end %>
  </div>
</div>
