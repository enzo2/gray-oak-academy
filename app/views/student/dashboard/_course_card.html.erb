<div id="<%= dom_id(enrollment) %>" class="border rounded-sm p-4 border-stone-300 dark:border-stone-700">
  <h2 class="text-xl font-semibold mb-6"><%= enrollment.course.title %></h2>

  <div class="mb-4">
    <%= render partial: "enrollments/enrollment_progress_bar", locals: { enrollment: enrollment } %>
  </div>

  <div class="mt-2 mb-4 *:my-1">
    <% if enrollment.completed? %>
      <%= button_to enrollment_path(enrollment), method: :get, data: { turbo_stream: true }, class: "btn-primary" do %>
        <div class="flex items-center">
          <sl-icon name="file-text" class="text-green-500"></sl-icon>
          <span class="text-sm">&nbsp;View course summary</span>
        </div>
      <% end %>
    <% elsif enrollment.has_available_lesson? %>
      <%= link_to student_lesson_path(enrollment.next_available_lesson), 
            class: "inline-block btn-primary text-sm" do %>
        <div class="flex items-center">
          <sl-icon name="check-circle-fill" class="text-stone-700 dark:text-stone-300"></sl-icon>
          <span>&nbsp;<%= enrollment.next_available_lesson.started_by?(current_user) ? "Continue" : "Start next" %> lesson</span>
        </div>
      <% end %>
    <% else %>
      <div>
        <sl-icon name="exclamation-circle-fill" class="text-lg text-yellow-500 mr-2 shrink-0" title="No available lessons"></sl-icon>
        <span class="text-sm">No lessons available. Check with teacher.</span>
      </div>
    <% end %>

    <% unless enrollment.completed? %>
      <%= button_to enrollment_path(enrollment), 
            method: :get, 
            data: { turbo_stream: true },
            class: "btn-primary text-sm" do %>
        <div class="flex items-center">
          <sl-icon name="file-text" class="text-stone-700 dark:text-stone-300"></sl-icon>
          <span>&nbsp;View progress</span>
        </div>
      <% end %>
     <% end %>
  </div>
</div>