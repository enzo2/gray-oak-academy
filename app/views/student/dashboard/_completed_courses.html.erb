<h2 class="text-lg mb-4">Completed Courses</h2>
<div class="w-full grid grid-cols-1 sm:grid-cols-[repeat(auto-fill,minmax(20rem,1fr))] gap-4 mb-6">
  <% if enrollments.any? %>
    <% enrollments.each do |enrollment| %>
      <%= render 'course_card', enrollment: enrollment %>
    <% end %>
  <% else %>
    <p>You don't have any previous courses.</p>
  <% end %>
</div>
