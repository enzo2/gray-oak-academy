<h2 class="text-2xl mb-2"><%= @enrollment.course.title %></h2>

<% if @enrollment.completed? %>
  <p class="mb-4">Course completed on <%= @enrollment.student_reports.first.created_at.strftime("%B %d, %Y") %>.</p>
  <div class="bg-gray-300 dark:bg-gray-700 rounded-lg my-2 px-4 py-2 pl-4
              prose dark:prose-invert
              prose-li:my-0 marker:prose-ul:text-gray-800 dark:marker:prose-ul:text-gray-100">
    <h3 class="mb-3">Course report</h3>
    <%= markdown(@enrollment.student_reports.first.to_markdown) %>
  </div>
<% elsif %>
  <p>This course is not yet completed.</p>
<% end %>

<% @enrollment.course.lessons.each do |lesson| %>
  <h4 class="mb-2 font-bold"><%= lesson.title %></h3>
  <%# insert table of lessons and student lesson reports %>
<% end %>