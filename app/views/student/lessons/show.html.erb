<div class="flex h-[calc(100dvh-2.5rem)] overflow-hidden">
  <!-- Chat Column -->
  <div class="h-full w-1/3 max-w-2xl px-4 py-2 flex flex-col border-r border-gray-200 dark:border-gray-700">
    <!-- Lesson Info -->
    <h1 class="flex-none text-xl font-semibold mb-1 inline-block"><%= @lesson.title %></h1>
    <div class="flex-none flex items-center gap-2">
      <sl-icon name="clock" class="text-gray-500"></sl-icon>
      <span class="text-sm text-gray-600 dark:text-gray-400">Approx. <%= @lesson.approx_duration_min %> minutes</span>
    </div>
    <hr class="flex-none border-gray-500 my-2">

    <!-- Conversation -->
    <%= turbo_frame_tag "conversation-panel", class: "flex-grow overflow-hidden" do %>   
      <%= render partial: "conversations/conversation", locals: { conversation: @conversation } %>
    <% end %>
  </div>

  <!-- Chalkboard Area - flex-1 - grows as needed -->
  <div class="flex-1 bg-slate-100 dark:bg-gray-900">
    <div id="chalkboard" class="w-full h-full">
    </div>
  </div>
</div>
