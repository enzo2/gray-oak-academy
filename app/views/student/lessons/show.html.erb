<div class="flex h-[calc(100dvh-2.5rem)] overflow-hidden">
  <!-- Chat Column -->
  <div class="h-full min-w-0 
              grow xl:max-2xl:max-w-[32rem] 2xl:max-w-[40rem]
              px-2 md:px-4 pt-2 
              flex flex-col 
              border-r border-stone-200 dark:border-stone-700">
    <!-- Lesson Info -->
    <h1 class="flex-none text-xl font-semibold mb-1 inline-block"><%= @lesson.title %></h1>

    <% if @conversation.messages.length < 2 %>
      <div class="flex-none flex items-center gap-2 mb-1" id="lesson-duration">
        <sl-icon name="clock" class="text-stone-500"></sl-icon>
        <span class="text-sm text-stone-600 dark:text-stone-400">Approx. <%= @lesson.approx_duration_min %> minutes</span>
      </div>
    <% end %>

    <!-- Conversation -->
    <%= turbo_frame_tag "conversation-panel", class: "grow overflow-hidden" do %>   
      <%= render partial: "conversations/conversation", locals: { conversation: @conversation } %>
    <% end %>
  </div>

  <!-- Chalkboard Area - remainder of space - grow as needed -->
  <% if @lesson.lesson_plan&.chalkboard_enabled? %>
    <%= render partial: "shared/chalkboard" %>
  <% end %>
</div>
