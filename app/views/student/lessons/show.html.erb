<div class="flex h-[calc(100dvh-2.5rem)] overflow-hidden" data-controller="code-executor">
  <!-- Chat Column -->
  <div class="h-full w-[40rem] max-w-2xl px-4 pt-2 flex flex-col border-r border-gray-200 dark:border-gray-700">
    <!-- Lesson Info -->
    <h1 class="flex-none text-xl font-semibold mb-1 inline-block"><%= @lesson.title %></h1>
    <div class="flex-none flex items-center gap-2 mb-2">
      <sl-icon name="clock" class="text-gray-500"></sl-icon>
      <span class="text-sm text-gray-600 dark:text-gray-400">Approx. <%= @lesson.approx_duration_min %> minutes</span>
    </div>

    <!-- Conversation -->
    <%= turbo_frame_tag "conversation-panel", class: "grow overflow-hidden" do %>   
      <%= render partial: "conversations/conversation", locals: { conversation: @conversation } %>
    <% end %>
  </div>

  <!-- Chalkboard Area - remainder of space - grow as needed -->
  <%= render partial: "shared/chalkboard" %>
</div>
