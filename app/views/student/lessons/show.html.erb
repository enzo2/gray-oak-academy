<%# We want the page fill the viewport, minus the header height, without any scrollbar or excess at the bottom %>
<div class="flex h-[calc(100dvh-2.5rem)] max-h-[calc(100dvh-2.5rem)] overflow-hidden"
    data-controller="drawer chalkboard collapsible">
  <!-- Conversation Column -->
  <div class="h-full min-w-0 
              grow xl:max-2xl:max-w-[32rem] 2xl:max-w-[40rem]
              px-2 md:px-4
              flex flex-col 
              border-r border-stone-200 dark:border-stone-700">
    <!-- Lesson Info -->
    <div class="flex items-center justify-between space-x-2 text-xl">
      <div><!-- Left title -->
       <h1 class="font-semibold"><%= @lesson.title %></h1>
      </div>
      <div class="flex flex-row items-center"><!-- Right buttons -->
        <div class="flex items-center text-sm mr-2" 
             data-controller="connection-status"
             data-connection-status-connected-icon-value="cloud-check"
             data-connection-status-disconnected-icon-value="cloud-slash"
             data-connection-status-connected-class="text-success-600 dark:text-success-500"
             data-connection-status-disconnected-class="text-red-600 dark:text-red-500">
          <div data-controller="railsblocks--tooltip" 
               data-tooltip-content="Connecting..." 
               data-connection-status-target="tooltip"
               class="pt-1">
            <sl-icon name="cloud" class="text-xl" data-connection-status-target="indicator"></sl-icon>
          </div>
        </div>
        <% if @lesson.lesson_plan&.chalkboard_enabled? %>
        <sl-icon-button
            name="easel"
            class="xl:hidden"
            label="Open chalkboard"
            aria-label="Open chalkboard"
            data-action="click->drawer#open"
            data-drawer-id="chalkboard">
        </sl-icon-button>
        <% end %>
        <sl-dropdown class="" placement="bottom-end">
          <sl-icon-button name="three-dots-vertical" label="Additional chat options" slot="trigger" class="text-lg"></sl-icon-button>
          <sl-menu>
            <% if AppSetting.speech_configured? %>
              <sl-menu-item onclick="window.dispatchEvent(new Event('toggleAutoRead'))">
                <div class="flex items-center justify-start">
                  <sl-icon-button 
                    id="auto-read-toggle"
                    name="<%= @conversation.auto_read_default ? "volume-up" : "volume-mute" %>" 
                    label="Auto-read" 
                    class="text-xl [&::part(base)]:pt-2">
                  </sl-icon-button>
                  <span class="pl-2">Auto-read</span>
                </div>
              </sl-menu-item>
            <% end %>
            <sl-menu-item>
              <div class="flex items-center justify-start" data-action="click->collapsible#toggle">
                <sl-icon-button  data-collapsible-target="button" name="chevron-down" label="Details"></sl-icon-button>
                <span class="pl-2">Chat info</span>
              </div>
            </sl-menu-item>
            <sl-menu-item onclick="document.getElementById('feedback-dialog').show()">
              <div class="flex items-center justify-start">
                <sl-icon-button name="chat-left-text" label="Provide Feedback" class="text-lg"></sl-icon-button>
                <span class="pl-2">Feedback</span>
              </div>
            </sl-menu-item>
          </sl-menu>
        </sl-dropdown>
      </div>
    </div>

    <% if @conversation.messages.length < 2 %>
    <!-- Will be removed after first user message -->
    <div class="flex-none flex items-center gap-2 mb-1" id="lesson-duration">
      <sl-icon name="clock" class="text-stone-500"></sl-icon>
      <span class="text-sm text-stone-600 dark:text-stone-400">Approx. <%= @lesson.approx_duration_min %> minutes</span>
    </div>
    <% end %>

    <!-- Conversation Details - collapsible -->
    <div id="conversation-details" data-collapsible-target="panel" class="hidden">
      <div class="flex justify-between items-center space-x-4 mb-1">
        <div class="flex justify-start items-center space-x-2">
          <span class="text-dim text-sm">LLM: <i><%= @conversation.llm_in_use_name %></i></span>
        </div>
        <div class="xl:hidden max-w-36 text-right text-dim text-xs italic leading-none">Wider screen recommended for chalkboard.</div>
      </div>
      <%= turbo_frame_tag "context-usage-bar" do %>
        <%= render partial: "conversations/context_usage_bar", locals: { context_usage: @conversation.context_usage } %>
      <% end %>
    </div>

    <hr class="border-stone-500">

    <!-- Conversation -->
    <%= render partial: "conversations/conversation", locals: { conversation: @conversation } %>
  </div>

  <!-- Chalkboard Area - remainder of space - grow as needed -->
  <% if @lesson.lesson_plan&.chalkboard_enabled? %>
    <!-- Chalkboard Column (desktop) -->
    <%= render partial: "shared/chalkboard" %>

    <%# Mobile Chalkboard Drawer - mobile-first overlay for small screens %>
    <sl-drawer style="--size: 100dvw;--header-spacing:0;--body-spacing:0rem;--footer-spacing:0;" 
              placement="end" data-drawer-target="drawer" data-drawer-id="chalkboard" >

      <div class="h-full">
        <%# Single-instance host where the chalkboard DOM will be moved into for mobile %>
        <div data-chalkboard-target="host" class="flex flex-col h-full bg-slate-100 dark:bg-stone-900"></div>
      </div>
    </sl-drawer>
  <% end %>
</div>

<!-- Feedback Modal -->
<sl-dialog id="feedback-dialog" label="Feedback" class="dialog-overview" data-controller="dialog" data-action="turbo:submit-end->dialog#submitEnd">
  <div id="feedback_modal_content">
    <%= form_with model: [:student, StudentFeedback.new], data: { turbo_stream: true }, class: "space-y-4" do |f| %>
      <%= f.hidden_field :lesson_progress_id, value: @conversation.lesson_progress&.id %>
      <div>
        <%= f.label :content, "Here, you can save feedback on the lesson. It will help improve and personalize future lessons.", class: "label" %>
        <%= f.text_area :content, rows: 4, class: "textarea input-primary w-full", required: true, placeholder: "I specifically liked/disliked..." %>
      </div>
      <div class="flex justify-end gap-2">
        <sl-button slot="footer" variant="primary" type="submit">Submit Feedback</sl-button>
      </div>
    <% end %>
  </div>
</sl-dialog>
