<% frame_id_prefix = local_assigns[:frame_id_prefix].to_s %>
<% entry_dom_id_prefix = local_assigns[:entry_dom_id_prefix].to_s %>
<% card_frame_id = observation_card_frame_id(observation, frame_id_prefix) %>
<% card_context_params = observation_card_context_params(frame_id_prefix: frame_id_prefix, entry_dom_id_prefix: entry_dom_id_prefix) %>
<%= turbo_frame_tag card_frame_id do %>
  <div class="mb-2 text-sm leading-normal text-stone-800 dark:text-stone-300">
    <%= simple_format(observation.content) %>
  </div>
  
  <div class="flex items-center justify-between text-xs mt-2">
    <% status_classes = case observation.status
       when "approved" then "bg-emerald-100 dark:bg-emerald-900 text-emerald-800 dark:text-emerald-200 border-emerald-200 dark:border-emerald-800"
       when "rejected" then "bg-red-100 dark:bg-red-900 text-red-800 dark:text-red-200 border-red-200 dark:border-red-800"
       else "bg-yellow-100 dark:bg-yellow-900 text-yellow-800 dark:text-yellow-200 border-yellow-200 dark:border-yellow-800"
       end %>
    <div class="flex items-center gap-1.5">
      <span class="px-2 py-0.5 rounded border <%= status_classes %>">
        <%= observation.status.humanize %>
      </span>
      <% if observation.status_approved? %>
        <div
          class="inline-flex"
          data-controller="tooltip"
          data-tooltip-content="Weight. Over time, observations decay from 100% to 0%. You can re-validate to reset.">
          <span class="px-2 py-0.5 rounded border bg-stone-100 dark:bg-stone-800 text-stone-700 dark:text-stone-200 border-stone-200 dark:border-stone-700">
            <%= (observation.effective_weight.to_f * 100).round %>%
          </span>
        </div>
      <% end %>
    </div>
    
    <% if local_assigns[:teacher_mode] %>
      <div class="flex gap-2">
        <% if observation.status_pending? %>
          <%= button_to "Approve", admin_observation_path(observation), method: :patch, 
                params: { observation: { status: :approved } }.merge(card_context_params), 
                class: "text-emerald-600 hover:text-emerald-800 font-bold hover:cursor-pointer", 
                form: { class: "inline", data: { turbo_stream: true } } %>
          <span class="text-stone-300">|</span>
          <%= button_to "Reject", admin_observation_path(observation), method: :patch, 
                params: { observation: { status: :rejected } }.merge(card_context_params), 
              class: "text-red-600 hover:text-red-800 hover:cursor-pointer", 
              form: { class: "inline", data: { turbo_stream: true } } %>
          <span class="text-stone-300">|</span>
        <% elsif observation.status_approved? %>
          <div
            class="inline-flex"
            data-controller="tooltip"
            data-tooltip-content="Observations decay over time. Re-validate if it still applies.">
            <%= button_to "Re-validate", revalidate_admin_observation_path(observation), method: :patch,
                  params: card_context_params,
                  class: "text-emerald-600 hover:text-emerald-800 font-medium hover:cursor-pointer",
                  form: { class: "inline", data: { turbo_stream: true } } %>
          </div>
          <span class="text-stone-300">|</span>
        <% end %>

        <%= link_to "Edit", edit_admin_observation_path(observation, card_context_params), 
            class: "text-stone-500 hover:text-stone-800 dark:hover:text-stone-200", 
            data: { turbo_frame: card_frame_id } %>
        
        <span class="text-stone-300">|</span>
        
        <%= button_to "Delete", admin_observation_path(observation), 
            method: :delete, 
            params: card_context_params,
            class: "text-stone-500 hover:text-red-800 dark:hover:text-red-400 cursor-pointer", 
            form: { class: "inline", data: { turbo_confirm: "Are you sure you want to delete this observation?", turbo_stream: true } } %>
      </div>
    <% end %>
  </div>
<% end %>
