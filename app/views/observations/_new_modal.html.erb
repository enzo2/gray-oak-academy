<sl-dialog id="new-observation-dialog" class="dialog-overview" 
           style="--width: min(90vw, 600px); --header-spacing:0; --body-spacing:0;">
  <%= form_with model: [ :admin, Observation.new(student: @student) ], 
        data: { turbo_stream: true }, 
        class: "pt-0 px-8 pb-6 space-y-4" do |f| %>
    <%= f.hidden_field :student_id %>

    <h2 class="text-lg">New Observation</h2>

    <p class="text-sm">
      Observations are specific insights about the student's educational progress, such as key moments, patterns, strengths/weaknesses.<br>
      They're usually generated by the LLM after lessons. Add one manually to help inform the LLM's picture of the student during upcoming lessons. Older observations are considered less relevant.<br>
      Personal memories should be added under the Memories tab, not here.
    </p>
    
    <div>
      <%= f.label :content, "Observation", class: "label hidden" %>
      <%= f.text_area :content, rows: 3, class: "input-primary w-full", required: true, placeholder: "Be very specific, e.g. 'Student retention improves when abstract concepts are mapped to physical analogies'" %>
      <div class="text-xs text-dim mt-1">
        This observation will be considered approved and added to the student's context for future lessons.
      </div>
    </div>

    <div slot="footer" class="flex justify-end gap-4 mt-4">
      <button type="button" class="cursor-pointer" data-hide-dialog>Cancel</button>
      <%= f.submit "Save Observation", class: "btn-primary" %>
    </div>
  <% end %>
</sl-dialog>
