<div style="font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto; padding: 20px; background-color: #f8f9fa; border-radius: 10px;">
  <h1 style="color: #333; text-align: center;">Hello <%= @resource.email %>!</h1>

  <p style="color: #555; font-size: 16px; line-height: 1.5;">Your account has been locked due to an excessive number of unsuccessful sign in attempts.</p>

  <p style="color: #555; font-size: 16px; line-height: 1.5;">Click the link below to unlock your account:</p>

  <div style="text-align: center; margin-top: 30px;">
    <%= link_to 'Unlock my account', unlock_url(@resource, unlock_token: @token), style: "display: inline-block; padding: 10px 20px; background-color: #ffc107; color: #333; text-decoration: none; border-radius: 5px; font-weight: bold;" %>
  </div>

  <p style="color: #777; font-size: 14px; margin-top: 30px; text-align: center;">If you didn't request this, please ignore this email.</p>
</div>
