<div style="font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto; padding: 20px; background-color: #f8f9fa; border-radius: 10px;">
  <h1 style="color: #333; text-align: center;">Hello <%= @resource.email %>!</h1>

  <p style="color: #555; font-size: 16px; line-height: 1.5;">We're contacting you to notify you that your password has been changed.</p>

  <p style="color: #777; font-size: 14px; margin-top: 30px; text-align: center;">If you didn't make this change, please contact our support team immediately.</p>
</div>
