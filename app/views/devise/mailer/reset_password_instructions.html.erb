<div style="font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto; padding: 20px; background-color: #f8f9fa; border-radius: 10px;">
  <h1 style="color: #333; text-align: center;">Hello <%= @resource.email %>!</h1>

  <p style="color: #555; font-size: 16px; line-height: 1.5;">Someone has requested a link to change your password. You can do this through the link below.</p>

  <div style="text-align: center; margin-top: 30px;">
    <%= link_to 'Change my password', edit_password_url(@resource, reset_password_token: @token), style: "display: inline-block; padding: 10px 20px; background-color: #28a745; color: #ffffff; text-decoration: none; border-radius: 5px; font-weight: bold;" %>
  </div>

  <p style="color: #555; font-size: 16px; line-height: 1.5; margin-top: 30px;">If you didn't request this, please ignore this email.</p>
  <p style="color: #555; font-size: 16px; line-height: 1.5;">Your password won't change until you access the link above and create a new one.</p>

  <p style="color: #777; font-size: 14px; margin-top: 30px; text-align: center;">This is an automated message, please do not reply.</p>
</div>
