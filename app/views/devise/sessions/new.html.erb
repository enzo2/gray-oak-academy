<main class="md:container md:mx-auto px-15 flex justify-center items-center">
  <div class="p-8 min-h-1/2 max-w-md w-full">

    <h2 class="text-2xl font-bold mb-6 text-gray-800 dark:text-white">Log in</h2>

    <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
      <div class="mb-4">
        <%= f.label :email, class: "form-label" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-input" %>
      </div>

      <div class="mb-4">
        <%= f.label :password, class: "form-label" %>
        <%= f.password_field :password, autocomplete: "current-password", class: "form-input" %>
      </div>

      <% if devise_mapping.rememberable? %>
        <div class="mb-4 flex items-center">
          <%= f.check_box :remember_me, class: "form-checkbox" %>
          <%= f.label :remember_me, class: "ml-2 block text-sm text-gray-700 dark:text-gray-300" %>
        </div>
      <% end %>

      <div class="mb-6">
        <%= f.submit "Log in", class: "btn-primary" %>
      </div>
    <% end %>

    <%= render "devise/shared/links" %>

  </div>
</main>