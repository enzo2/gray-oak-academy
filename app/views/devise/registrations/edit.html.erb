<main class="container mx-auto p-2 max-w-160">
  <h2 class="text-2xl">Settings</h2>

  <sl-tab-group class="[&::part(body)]:overflow-visible">
    <% if current_user.role_teacher? %>
      <sl-tab slot="nav" panel="api" <%= 'active' if @active_tab == :api %>>LLMs</sl-tab>
    <% end %>
    <sl-tab slot="nav" panel="notifications" <%= 'active' if @active_tab == :notifications %>>Notifications</sl-tab>
    <sl-tab slot="nav" panel="memories" <%= 'active' if @active_tab == :memories %>>Memories</sl-tab>
    <sl-tab slot="nav" panel="account" <%= 'active' if @active_tab == :account %>>Account</sl-tab>

    <% if current_user.role_teacher? %>
      <sl-tab-panel name="api" <%= 'active' if @active_tab == :api %>>
        <%= render "user_settings/api", settings: current_user.settings %>
      </sl-tab-panel>
    <% end %>

    <sl-tab-panel name="notifications" <%= 'active' if @active_tab == :notifications %>>
      <%= render "user_settings/notifications", settings: current_user.settings %>
    </sl-tab-panel>

    <sl-tab-panel name="memories" <%= 'active' if @active_tab == :memories %>>
      <%= render "memories/panel" %>
    </sl-tab-panel>

    <sl-tab-panel name="account" <%= 'active' if @active_tab == :account %>>
      <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put, data: { turbo: false } }) do |f| %>
        <%= render "devise/shared/error_messages", resource: resource %>

          <div class="mb-4">
            <%= f.label :first_name, class: "form-label" %>
            <%= f.text_field :first_name, autofocus: true, class: "input-primary" %>
          </div>

          <div class="mb-4">
            <%= f.label :last_name, class: "form-label" %>
            <%= f.text_field :last_name, class: "input-primary" %>
          </div>

        <div class="mb-4">
          <%= f.label :email, class: "form-label" %>
          <%= f.email_field :email, autocomplete: "email", class: "input-primary" %>
        </div>

        <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
          <div class="mb-4 text-sm text-stone-600 dark:text-stone-400">Currently waiting confirmation for: <%= resource.unconfirmed_email %></div>
        <% end %>

        <div class="mb-4">
          <%= f.label :password, class: "form-label" %>
          <%= f.password_field :password, autocomplete: "new-password", class: "input-primary" %>
          <% if @minimum_password_length %>
            <p class="mt-1 text-sm text-stone-600 dark:text-stone-400"><%= @minimum_password_length %> characters minimum (leave blank if you don't want to change it)</p>
          <% end %>
        </div>

        <div class="mb-4">
          <%= f.label :password_confirmation, class: "form-label" %>
          <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "input-primary" %>
        </div>

        <div class="mb-4">
          <%= f.label :current_password, class: "form-label" %>
          <%= f.password_field :current_password, autocomplete: "current-password", class: "input-primary" %>
          <p class="mt-1 text-sm text-stone-600 dark:text-stone-400">We need your current password to confirm your changes</p>
        </div>

        <div class="mb-6">
          <%= f.submit "Update", class: "btn-primary" %>
        </div>
      <% end %>

      <% if current_user.role_teacher? && current_user.taught_courses.any? %>
        <hr class="hr-primary">

        <div class="mb-4 mx-auto" data-controller="modal">
          <h3 class="text-lg font-bold mb-2 mt-6">Transfer Assets</h3>
          <p class="mb-4 text-sm text-stone-600 dark:text-stone-400">
            Before deleting your account, you must transfer your courses to another teacher.
          </p>

          <button type="button" class="btn-primary" data-action="modal#open">Transfer Assets</button>

          <div data-modal-target="content" class="hidden">
            <%= form_tag transfer_user_assets_path, method: :post, class: "p-6", data: { turbo: false, controller: "railsblocks--confirmation", railsblocks__confirmation_confirm_text_value: "TRANSFER" } do %>
              <div class="mb-4">
                <h3 class="text-base font-semibold leading-6 text-stone-900 dark:text-stone-100" id="modal-title">Transfer All Assets</h3>
                <div class="mt-2">
                  <p class="text-sm text-stone-500 dark:text-stone-400">Are you sure you want to transfer all your courses? This cannot be undone.</p>
                </div>
              </div>

              <div class="mb-4">
                <label class="form-label">Transfer to:</label>
                <%= collection_select :target_user_id, nil,
                    User.where(role: [:admin, :superuser]).where.not(id: current_user.id),
                    :id, :name,
                    { prompt: "Select a teacher" },
                    { name: "target_user_id", class: "input-primary w-full", required: true } %>
              </div>

              <div class="mb-4">
                <label class="block text-sm font-medium leading-6 text-stone-900 dark:text-stone-100 mb-2">Type TRANSFER to confirm</label>
                <input type="text" class="input-primary w-full" data-railsblocks--confirmation-target="input" placeholder="TRANSFER" autocomplete="off">
              </div>

              <div class="mt-5 sm:mt-6 sm:grid sm:grid-flow-row-dense sm:grid-cols-2 sm:gap-3">
                <button type="submit" class="btn-primary w-full sm:col-start-2 opacity-50 cursor-not-allowed" disabled data-railsblocks--confirmation-target="confirmButton">Transfer Assets</button>
                <button type="button" class="mt-3 inline-flex w-full justify-center rounded-sm bg-white dark:bg-stone-800 px-3 py-2 text-sm font-semibold text-stone-900 dark:text-stone-100 shadow-sm ring-1 ring-inset ring-stone-300 dark:ring-stone-600 hover:bg-stone-50 dark:hover:bg-stone-700 sm:col-start-1 sm:mt-0" data-action="modal#close">Cancel</button>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>

      <% if current_user.role_teacher? %>
        <hr class="hr-primary">

        <div class="mb-4 mx-auto" data-controller="modal">
          <h3 class="text-lg font-bold mb-2 mt-6">Delete my account</h3>

          <button type="button" class="btn-danger w-48" data-action="modal#open">Delete my account</button>

          <div data-modal-target="content" class="hidden">
            <%= form_with url: registration_path(resource_name), method: :delete, class: "p-6", data: { controller: "railsblocks--confirmation", railsblocks__confirmation_confirm_text_value: "DELETE" } do |f| %>
              <div class="mb-4">
                <h3 class="text-base font-semibold leading-6 text-stone-900 dark:text-stone-100">Delete Account</h3>
                <div class="mt-2">
                  <p class="text-sm text-stone-500 dark:text-stone-400">Are you sure you want to delete your account? All of your data will be permanently removed. This action cannot be undone.</p>
                </div>
              </div>

              <div class="mb-4">
                <label class="block text-sm font-medium leading-6 text-stone-900 dark:text-stone-100 mb-2">Type DELETE to confirm</label>
                <input type="text" class="input-primary w-full" data-railsblocks--confirmation-target="input" placeholder="DELETE" autocomplete="off">
              </div>

              <div class="mt-5 sm:mt-6 sm:grid sm:grid-flow-row-dense sm:grid-cols-2 sm:gap-3">
                <button type="submit" class="btn-danger w-full sm:col-start-2 opacity-50 cursor-not-allowed" disabled data-railsblocks--confirmation-target="confirmButton">Delete Account</button>
                <button type="button" class="mt-3 inline-flex w-full justify-center rounded-sm bg-white dark:bg-stone-800 px-3 py-2 text-sm font-semibold text-stone-900 dark:text-stone-100 shadow-sm ring-1 ring-inset ring-stone-300 dark:ring-stone-600 hover:bg-stone-50 dark:hover:bg-stone-700 sm:col-start-1 sm:mt-0" data-action="modal#close">Cancel</button>
              </div>
            <% end %>
          </div>
        </div>
      <% else %>
        <hr class="hr-primary mb-4">
        <span class="text-dim">To delete your account, you must ask your teacher.</span>
      <% end %>

    </sl-tab-panel>
  </sl-tab-group>
</main>
