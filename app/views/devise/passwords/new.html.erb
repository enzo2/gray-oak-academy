<main class="mcontainer mx-auto max-w-96 px-2 py-4">
  <h2 class="text-2xl font-bold mb-6 text-stone-800 dark:text-white">Forgot your password?</h2>

  <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <div class="mb-4">
      <%= f.label :email, class: "form-label" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "input-primary" %>
    </div>

    <div class="mb-6">
      <%= f.submit "Send me reset password instructions", class: "btn-primary" %>
    </div>
  <% end %>

  <%= render "devise/shared/links" %>

</main>
