<div class="grow bg-slate-100 dark:bg-gray-900 flex flex-col h-full" data-controller="print-chalkboard">
  <div id="chalkboard_toolbar" class="h-8 p-2 flex justify-start shrink-0">
    <button 
      id="printButton" 
      data-print-chalkboard-controller="printButton" 
      data-action="click->print-chalkboard#print"
      class="hover:bg-gray-300 dark:hover:bg-gray-700 rounded border-b">
      <sl-icon name="printer"></sl-icon>
    </button>
  </div>
  <div id="chalkboard" class="flex-1 p-4 overflow-auto" data-code-executor-target="chalkboard" data-print-chalkboard-target="chalkboard"></div>
</div>