<%
  toast_type_for_flash = {
    "success" => "success",
    "error" => "error",
    "danger" => "danger",
    "warning" => "warning",
    "alert" => "warning",
    "notice" => "info",
    "info" => "info"
  }
%>

<% flash.each do |message_type, message| %>
  <% next if message.blank? %>
  <% Array(message).each do |entry| %>
    <% next if entry.blank? %>
    <div
      class="hidden"
      data-flash-toast-bridge-target="message"
      data-toast-type="<%= toast_type_for_flash.fetch(message_type.to_s, "default") %>"
      data-html-safe="<%= entry.respond_to?(:html_safe?) && entry.html_safe? %>"
      data-turbo-temporary>
      <%= entry %>
    </div>
  <% end %>
<% end %>
