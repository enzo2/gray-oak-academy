<% timeline_items.each do |item| %>
  <div class="relative flex items-center justify-between md:justify-normal md:odd:flex-row-reverse group is-active journal-entry">
    <!-- Icon -->
    <div class="flex items-center justify-center w-10 h-10 rounded-full border border-white bg-white text-slate-500 shadow shrink-0 md:order-1 md:group-odd:-translate-x-1/2 md:group-even:translate-x-1/2 z-10">
      <% case item %>
      <% when Observation %>
        🎥
      <% when StudentFeedback %>
        💬
      <% when StudentReport %>
        <% if item.reportable_type == 'User' %>
          📜
        <% else %>
          📝
        <% end %>
      <% when Memory %>
        🧠
      <% end %>
    </div>
    
    <!-- Card -->
    <div class="w-[calc(100%-4rem)] md:w-[calc(50%-2.5rem)] bg-white dark:bg-stone-800 p-4 rounded border border-slate-200 dark:border-stone-700 shadow">
      <div class="fle items-center justify-between mb-1">
        <div class="font-bold text-slate-900 dark:text-white text-sm mb-1">
          <%= item.created_at.strftime("%b %d, %Y at %l:%M %p") %>
        </div>
      </div>
      
      <% case item %>
      <% when Observation %>
        <%= render "observations/card", observation: item, teacher_mode: teacher_mode %>
      <% when StudentFeedback %>
        <%= render "student_feedbacks/card", feedback: item %>
      <% when StudentReport %>
        <%= render "student_reports/card", report: item %>
      <% when Memory %>
        <%= render "memories/card", memory: item %>
      <% end %>
    </div>
  </div>
<% end %>
