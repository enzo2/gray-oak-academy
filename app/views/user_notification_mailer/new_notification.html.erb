<h2><%= @linked_subject || message.subject if defined?(message) && message.respond_to?(:subject) %></h2>

<div style="margin-bottom: 20px; font-size: 16px; color: #333;">
  <%= simple_format(@message) %>
</div>

<% if @link %>
  <div style="margin-top: 20px;">
    <%= link_to "View Details", @link, style: "display: inline-block; padding: 10px 20px; background-color: #007bff; color: white; text-decoration: none; border-radius: 5px;" %>
  </div>
<% end %>
