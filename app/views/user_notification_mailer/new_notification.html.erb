<% email_subject = defined?(message) && message.respond_to?(:subject) ? message.subject : nil %>

<h2 class="email-title"><%= email_subject %></h2>

<div class="email-body">
  <% if @override_body_partial.present? %>
    <%= render partial: @override_body_partial, locals: { notification_params: @notification_params, message_text: @message } %>
  <% else %>
    <%= simple_format(@message) %>
  <% end %>
</div>

<% if @link %>
  <p class="email-actions">
    <%= link_to "View Details", @link, class: "email-button" %>
  </p>
<% end %>
