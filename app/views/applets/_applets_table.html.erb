<div data-controller="copy-code">
  <% if applets.presence %>
    <div class="w-full md:max-w-3xl flex flex-col gap-2">
      <div class="hidden md:flex flex-row justify-between border-b border-stone-800 dark:border-stone-200 py-2">
        <div class="font-bold">Title</div>
        <div class="font-bold">Actions</div>
      </div>
      
      <div id="applets-table-body" class="flex flex-col gap-2">
          <% applets.each do |applet| %>
            <div id="<%= dom_id(applet) %>" class="flex flex-col md:flex-row md:items-center justify-between p-3 border border-stone-200 dark:border-stone-700 rounded-md bg-stone-50 dark:bg-stone-900 gap-3">
              <div class="font-medium break-all"><%= applet.title %></div>
              <div class="flex flex-wrap items-center gap-2 md:justify-end">
                <sl-button variant="default" size="small" data-action="click->copy-code#copy" data-copy-code-url="<%= applet_path(applet) %>">
                  <sl-icon slot="prefix" name="copy"></sl-icon>
                  Copy
                </sl-button>
                <% if !applet.resource_id? && current_user.role_teacher? %>
                  <%= link_to save_as_resource_applet_path(applet),
                      class: "flex items-center",
                      data: { 
                        turbo_method: :post,
                        turbo_confirm: "This will save the applet as a Resource that can be linked to lesson plans. Proceed?" } do %>
                    <sl-button variant="default" size="small" data-copy-code-url="<%= applet_path(applet)%>">
                      <sl-icon slot="prefix" name="pin"></sl-icon>
                      Convert to Resource
                    </sl-button>
                  <% end %>
                  <%= link_to applet_path(applet),
                    class: "flex items-center justify-center text-red-400 dark:text-red-700 hover:text-red-600 dark:hover:text-red-900 p-1.5 rounded-md hover:bg-red-50 dark:hover:bg-red-950",
                    data: {
                      turbo_method: :delete,
                      turbo_confirm: "Are you sure you want to delete this applet?"
                    } do %>
                    <sl-icon name="trash" class="text-base"></sl-icon>
                  <% end %>
                <% elsif applet.resource_id? && current_user.role_teacher? %>
                  <%= link_to admin_resource_path(applet.resource), class: "flex items-center" do %>
                    <sl-button variant="default" size="small">
                      <sl-icon slot="prefix" name="folder-symlink"></sl-icon>
                      View
                    </sl-button>
                  <% end %>
                <% end %>
              </div>
            </div>
          <% end %>
      </div>
    </div>
  <% else %>
    <hr class="mb-4 prose dark:prose-invert prose-stone">
    No applets found.
  <% end %>

  <sl-dialog label="Copied" class="" data-copy-code-target="successDialog">
    Code has been copied to clipboard!
  </sl-dialog>
</div>
