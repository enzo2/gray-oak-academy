<div data-controller="copy-code">
  <% if applets.presence %>
    <table class="w-1/2screen border-separate border-spacing-y-2">
      <thead>
        <tr class="">
          <th class="py-2 text-left border-b border-gray-800 dark:border-gray-200"></th>
          <th class="py-2 text-right border-b border-gray-800 dark:border-gray-200"></th>
        </tr>
      </thead>
      <tbody id="applets-table-body">

          <% applets.each do |applet| %>
            <tr id="<%= dom_id(applet) %>" class="">
              <td><%= applet.title %></td>
              <td class="text-right flex justify-end space-x-2">
                <sl-button variant="default" size="small" data-action="click->copy-code#copy" data-copy-code-url="<%= applet_path(applet)%>">
                  <sl-icon slot="prefix" name="copy"></sl-icon>
                  Copy to Clipboard
                </sl-button>
                <%= link_to applet_path(applet), 
                    class: "flex items-center px-2 text-red-800 hover:text-red-900",
                    data: { 
                      turbo_method: :delete,
                      turbo_confirm: "Are you sure you want to delete this applet?"
                    } do %>
                  <sl-icon name="trash" class=""></sl-icon>
                <% end %>
              </td>
            </tr>
          <% end %>
        
          <td colspan="2" class="py-4 px-6 text-center"></td>
        
      </tbody>
    </table>
  <% else %>
    No applets found.
  <% end %>

  <sl-dialog label="Copied" class="" data-copy-code-target="successDialog">
    Code has been copied to clipboard!
  </sl-dialog>
</div>