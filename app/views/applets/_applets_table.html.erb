<div data-controller="copy-code">
  <% if applets.presence %>
    <table class="w-1/2screen border-separate border-spacing-y-2">
      <thead>
        <tr class="">
          <th class="py-2 text-left border-b border-gray-800 dark:border-gray-200">Title</th>
          <th class="py-2 text-right border-b border-gray-800 dark:border-gray-200">Actions</th>
        </tr>
      </thead>
      <tbody id="applets-table-body">

          <% applets.each do |applet| %>
            <tr id="<%= dom_id(applet) %>" class="">
              <td><%= applet.title %></td>
              <td class="text-right flex justify-end space-x-2">
                <button data-action="click->copy-code#copy" data-copy-code-url="<%= applet_path(applet)%>" class="bg-blue-500 hover:bg-blue-700 text-white font-bold py-1 px-2 rounded text-sm">
                  Copy to Clipboard
                </button>
                <%= button_to "Delete", applet_path(applet), method: :delete, 
                  class: "bg-red-500 hover:bg-red-700 text-white font-bold py-1 px-2 rounded text-sm", 
                  data: { turbo_confirm: "Are you sure you want to delete this applet?" } %>
              </td>
            </tr>
          <% end %>
        
          <td colspan="2" class="py-4 px-6 text-center"></td>
        
      </tbody>
    </table>
  <% else %>
    No applets found.
  <% end %>
  <sl-dialog label="Copied" class="" data-copy-code-target="successDialog">
    Code has been copied to clipboard!
  </sl-dialog>
</div>