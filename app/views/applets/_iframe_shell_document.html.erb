<%
  app_name = ENV["APP_NAME"] || "Gray Oak Academy"
  shell_title = local_assigns.fetch(:title, "Applet Preview | #{app_name}")
  shell_theme = local_assigns.fetch(:theme, "light")
  shell_html_class = local_assigns.fetch(:html_class, shell_theme == "dark" ? "dark" : "")
  shell_initial_theme = local_assigns.fetch(:initial_theme, shell_theme)
  shell_code = local_assigns.fetch(:code)
  shell_script_nonce = local_assigns.fetch(:script_nonce, content_security_policy_nonce)
  shell_sandbox_min_height = local_assigns.fetch(:sandbox_min_height, "400px")
  shell_sandbox_max_height = local_assigns.fetch(:sandbox_max_height, "100vh")
  shell_include_result_bridge = local_assigns.fetch(:include_result_bridge, false)
  shell_console_info_enabled = local_assigns.fetch(:console_info_enabled, true)
  shell_include_preview_metadata = local_assigns.fetch(:include_preview_metadata, true)
  shell_tailwind_async = local_assigns.fetch(:tailwind_async, false)
%>
<!DOCTYPE html>
<html lang="en" class="<%= shell_html_class %>" data-goa-applet-shell="v1">
  <head>
    <title><%= shell_title %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="robots" content="noindex, nofollow, noarchive">
    <% if shell_include_preview_metadata %>
      <%= csrf_meta_tags %>
      <%= csp_meta_tag %>
      <%= favicon_link_tag "logo_icon_negative.svg", type: "image/svg+xml" %>
    <% end %>
    <% if shell_tailwind_async %>
      <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4" nonce="<%= shell_script_nonce %>" async></script>
    <% else %>
      <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4" nonce="<%= shell_script_nonce %>"></script>
    <% end %>
    <style nonce="<%= shell_script_nonce %>">
      @import url('https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&family=Merriweather:ital,opsz,wght@0,18..144,300..900;1,18..144,300..900&display=swap');
      :root {
        color-scheme: light;
        --goa-applet-bg: #ffffff;
        --goa-applet-fg: #292524;
        --goa-applet-muted: #6b7280;
        --goa-applet-console-object-bg: #f3f4f6;
        --goa-applet-console-object-border: #e5e7eb;
      }
      :root.dark {
        color-scheme: dark;
        --goa-applet-bg: #1c1917;
        --goa-applet-fg: #f5f5f4;
        --goa-applet-muted: #a8a29e;
        --goa-applet-console-object-bg: #292524;
        --goa-applet-console-object-border: #57534e;
      }
      html, body { min-height: 100%; background: var(--goa-applet-bg); color: var(--goa-applet-fg); }
      body { margin: 0; padding: 10px; font-family: "Inter", "Segoe UI", Optima, Futura, "Gill Sans MT", "Gill Sans", sans-serif; }
      #sandbox {
        min-height: <%= shell_sandbox_min_height %>;
        max-height: <%= shell_sandbox_max_height %>;
        overflow-y: auto;
        scrollbar-width: thin;
        scrollbar-color: rgba(156, 163, 175, 0.5) transparent;
      }
      .console-log {
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
        margin: 4px 0;
        font-size: 0.8em;
        line-height: 1;
        word-break: break-word;
        white-space: pre-wrap;
      }
      .console-error {
        color: #dc2626;
        font-weight: 500;
        background: rgba(220, 38, 38, 0.1);
        padding: 4px 8px;
        border-radius: 4px;
      }
      .console-warn {
        color: #d97706;
        background: rgba(217, 119, 6, 0.1);
        padding: 4px 8px;
        border-radius: 4px;
      }
      .console-info {
        color: #2563eb;
        background: rgba(37, 99, 235, 0.1);
        padding: 4px 8px;
        border-radius: 4px;
      }
      .console-debug { color: var(--goa-applet-muted); }
      .console-object {
        background: var(--goa-applet-console-object-bg);
        padding: 8px;
        border-radius: 4px;
        white-space: pre-wrap;
        margin: 4px 0;
        border: 1px solid var(--goa-applet-console-object-border);
      }
    </style>
    <style type="text/tailwindcss" nonce="<%= shell_script_nonce %>">
      @custom-variant dark (&:where(.dark, .dark *));
      @theme { --font-sans: "InterVariable", sans-serif; --font-serif: "Merriweather", serif; }
    </style>
    <script nonce="<%= shell_script_nonce %>">
      (function() {
        function applyTheme(theme) {
          document.documentElement.classList.toggle("dark", theme === "dark");
        }

        function requestTheme() {
          try {
            window.parent.postMessage({ source: "goa-theme-request", v: 1 }, "*");
          } catch (e) { /* no-op */ }
        }

        applyTheme(<%= raw json_escape(shell_initial_theme.to_json) %>);
        window.addEventListener("message", function(event) {
          const data = event.data || {};
          if (data.source === "goa-theme" && data.v === 1) applyTheme(data.theme);
        });
        requestTheme();
      })();
    </script>
    <script type="importmap" nonce="<%= shell_script_nonce %>">
      {
        "imports": {
          "react": "https://esm.sh/react",
          "react/": "https://esm.sh/react/",
          "react-dom/": "https://esm.sh/react-dom/",
          "p5": "https://esm.sh/p5?standalone",
          "three": "https://esm.sh/three"
        }
      }
    </script>
    <script nonce="<%= shell_script_nonce %>">
      (function() {
        const createMemoryStorage = () => {
          let store = {};
          return {
            getItem(key) { return Object.prototype.hasOwnProperty.call(store, key) ? store[key] : null; },
            setItem(key, value) { store[key] = String(value); },
            removeItem(key) { delete store[key]; },
            clear() { store = {}; },
            key(index) { return Object.keys(store)[index] || null; },
            get length() { return Object.keys(store).length; }
          };
        };
        try {
          const testKey = "__storage_test__";
          window.localStorage.setItem(testKey, "1");
          window.localStorage.removeItem(testKey);
        } catch (e) {
          Object.defineProperty(window, "localStorage", { value: createMemoryStorage(), configurable: true });
        }
      })();
    </script>
    <% if shell_include_result_bridge %>
      <script nonce="<%= shell_script_nonce %>">
        // Results bridge: applets call window.GOA.report({...}) to send a result
        // to the host, which authenticates the message by iframe source and
        // routes it to the tutor. See applet_result_channel.js.
        (function () {
          function send(type, name, data, doSend) {
            try {
              window.parent.postMessage(
                { source: "goa-applet", v: 1, type: type, name: name || null, data: (data === undefined ? null : data), send: doSend === true },
                "*"
              );
            } catch (e) { /* no-op */ }
          }
          window.GOA = {
            // report(data) buffers the result for the student to send; pass
            // { send: true } to deliver it immediately as a turn.
            report: function (data, opts) { send("result", null, data, !!(opts && opts.send)); }
          };
        })();
      </script>
    <% end %>
    <script nonce="<%= shell_script_nonce %>">
      // Override console
      const goaConsoleInfoEnabled = <%= raw json_escape(shell_console_info_enabled.to_json) %>;
      window.console = {
        _format: function(args, className) {
          const logElement = document.createElement('div');
          logElement.className = 'console-log ' + (className || '');
          args.forEach(arg => {
            if (arg instanceof Error) {
              const errorDiv = document.createElement('div');
              errorDiv.className = 'console-error';
              errorDiv.textContent = arg.toString();
              if (arg.stack) {
                const stackDiv = document.createElement('pre');
                stackDiv.className = 'console-debug';
                stackDiv.textContent = arg.stack;
                errorDiv.appendChild(stackDiv);
              }
              logElement.appendChild(errorDiv);
            } else if (typeof arg === 'object') {
              try {
                const objDiv = document.createElement('div');
                objDiv.className = 'console-object';
                objDiv.textContent = JSON.stringify(arg, null, 2);
                logElement.appendChild(objDiv);
              } catch (e) {
                logElement.textContent += '[Circular Object]';
              }
            } else {
              const span = document.createElement('span');
              span.textContent = String(arg) + ' ';
              logElement.appendChild(span);
            }
          });
          const appendLog = () => {
            const sandbox = document.getElementById('sandbox');
            if (sandbox) {
              sandbox.appendChild(logElement);
            } else {
              setTimeout(appendLog, 10);
            }
          };
          appendLog();
        },
        log: function(...args) {
          this._format(args);
        },
        error: function(...args) {
          this._format(args, 'console-error');
        },
        warn: function(...args) {
          this._format(args, 'console-warn');
        },
        info: function(...args) {
          if (goaConsoleInfoEnabled) this._format(args, 'console-info');
        },
        debug: function(...args) {
          // Ignore debug logs.
        }
      };
    </script>
  </head>
  <body>
    <div id="sandbox"></div>
    <script type="module" nonce="<%= shell_script_nonce %>">
      const codeToExecute = <%= raw json_escape(shell_code.to_json) %>;
      const blob = new Blob([codeToExecute], { type: 'text/javascript' });
      const moduleUrl = URL.createObjectURL(blob);

      import(moduleUrl).catch(error => {
        console.error(error);
      }).finally(() => {
        URL.revokeObjectURL(moduleUrl);
      });
    </script>
  </body>
</html>
