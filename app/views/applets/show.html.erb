<%= turbo_frame_tag "dashboard-content" do %>
  <h2 class="text-xl font-bold mb-5">Applet Details</h2>

  <div class="my-4">
    <%= link_to "Back to Applets", applets_path, class: "btn-primary", data: { turbo_frame: "dashboard-content" } %>
  </div>

  <br>

  <h3 class="text-2xl mt-4"><%= @applet.title %></h3>

  <div class="border-t">
    <dl>
      <div class="py-5">
        <dd class="mt-1 pl-4">
          <pre class="whitespace-pre-wrap"><%= @applet.code %></pre>
        </dd>
      </div>
    </dl>
  </div>

<% end %>