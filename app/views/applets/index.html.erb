<%= turbo_frame_tag "dashboard-content" do %>
  <h1 class="text-2xl font-bold mb-5">Applets</h1>

  <p class="mb-4">Archived applets from past chats/lessons.</p>

  <table class="w-1/2screen border-collapse">
    <thead>
      <tr class="border-b border-gray-800 dark:border-gray-200">
        <th class="py-2 px-3 text-left">Title</th>
        <th class="py-2 px-3 text-right">Actions</th>
      </tr>
    </thead>
    <tbody id="applets-table-body">
      <% if @applets.any? %>
        <% @applets.each do |applet| %>
          <tr id="<%= dom_id(applet) %>">
            <td><%= applet.title %></td>
            <td class="text-right flex justify-end space-x-2">
              <%= link_to "Show", applet_path(applet),
                class: "bg-blue-500 hover:bg-blue-700 text-white font-bold py-1 px-2 rounded text-sm"  %>
              <%= button_to "Delete", applet_path(applet), method: :delete, 
                class: "bg-red-500 hover:bg-red-700 text-white font-bold py-1 px-2 rounded text-sm", 
                  data: { turbo_confirm: "Are you sure you want to delete this applet?" } %>
            </td>
          </tr>
        <% end %>
      <% else %>
        <td colspan="2" class="py-4 px-6 text-center">No applets!</td>
      <% end %>
    </tbody>
  </table>

<% end %>

