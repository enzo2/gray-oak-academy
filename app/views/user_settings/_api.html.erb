<%= form_with(model: settings, url: user_settings_path, method: :patch, id: "llm-settings-form") do |f| %>
  <% oauth_enabled = OpenaiOauthService.configured? %>
  <% oauth_uses_device_flow = true %>
  <% oauth_connected = settings.openai_oauth_connected? %>
  <% oauth_identity = settings.openai_oauth_email.presence || settings.openai_oauth_sub.presence %>
  <% codex_base_uri = SupportedApi::OPENAI_CODEX_BASE_URI %>
  <% selected_api_base_uri = settings.llm_api_base_uri.to_s.presence || settings.effective_llm_api_base_uri.to_s %>
  <% show_oauth_for_selected_base = selected_api_base_uri == codex_base_uri %>
  <% if settings.errors.any? %>
    <div class="mb-4 text-red-950 dark:text-red-300">
      <%= pluralize(settings.errors.count, "error") %> prevented the settings from being saved.
      <ul>
        <% settings.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div data-controller="llm-settings" 
       data-llm-settings-models-path-value="<%= user_settings_llm_models_path %>" 
       data-llm-settings-supported-uris-value="<%= SupportedApi.selectable_uris.to_json %>" 
       data-llm-settings-has-user-token-value="<%= settings.llm_api_access_token.present? %>" 
       data-llm-settings-env-base-uri-value="<%= ensure_trailing_slash(ENV['OPENAI_API_BASE_URL']) %>"
       data-llm-settings-env-key-present-value="<%= ENV['OPENAI_API_KEY'].present? %>"
       data-llm-settings-codex-base-uri-value="<%= codex_base_uri %>"
  >
    <p class="mb-4 text-sm text-dim">
        <i>Note: If you leave any of these blank, the default settings will be used, if available.</i>
    </p>

    <div data-llm-settings-target="oauthSection" class="mb-4 rounded-md border border-stone-300/80 bg-stone-100/60 p-3 dark:border-stone-700 dark:bg-stone-900/40 <%= show_oauth_for_selected_base ? '' : 'hidden' %>">
      <p class="form-label mb-1">OpenAI OAuth</p>
      <p class="text-sm text-dim mb-1">
        If you have ChatGPT Plus, connect your OpenAI account to use ChatGPT Codex for chat.
      </p>
      <% if oauth_enabled %>
        <p class="text-sm mb-2">
          <% if oauth_connected %>
            <span class="font-semibold text-moss-700 dark:text-moss-300">Connected</span>
            <% if oauth_identity.present? %>
              as <span class="font-mono"><%= oauth_identity %></span>
            <% end %>.
          <% else %>
            <span class="text-dim">Not connected.</span>
          <% end %>
        </p>

        <% if oauth_connected %>
          <%= link_to "Disconnect OpenAI",
                      user_settings_openai_oauth_disconnect_path,
                      class: "btn-secondary text-sm py-1 px-2",
                      data: { turbo_method: :delete, turbo_confirm: "Disconnect your OpenAI account from this app?" } %>
        <% else %>
          <%= link_to "Connect OpenAI",
                      user_settings_openai_oauth_connect_path,
                      class: "btn-secondary text-sm py-1 px-2",
                      data: { turbo: false } %>
        <% end %>
      <% else %>
        <p class="text-sm text-amber-700 dark:text-amber-300">
          OpenAI OAuth is unavailable on this server.
        </p>
      <% end %>
    </div>

    <div class="mb-1"> 
      <%= f.label :llm_api_base_uri, "LLM API base URI", class: "form-label" %>
      <%= f.combobox "llm_api_base_uri",
                      Llm.list_api_base_uri_options,
                      name_when_new: "setting[llm_api_base_uri]",
                      placeholder: "Select or enter API Base URI",
                      autocomplete: :list,
                      data: { action: "input->llm-settings#updateModels hw-combobox:selection->llm-settings#updateModels hw-combobox:clear->llm-settings#updateModels" } %>
    </div>
    <p class="text-sm text-dim mb-1">
      Should look like: https://openrouter.ai/api/v1/
    </p>      

    <details class="mb-2">
      <summary class="text-sm text-dim cursor-pointer mb-2">
        Which should I use?
      </summary>
        <p class="text-sm text-dim pl-2">
          Any OpenAI-compatible API is supported.<br>
          If OpenRouter is used, app will track actual costs and context window usage.<br>
          This may be useful for heavier use or longer lessons.<br>
          It also allows trying various models from different providers easily, and avoids tiered limits.<br>
        </p>
    </details>

    <p data-llm-settings-target="sharedTokenHint" class="text-sm text-emerald-700 dark:text-emerald-300 mb-4 hidden">
      A shared access token is available for this provider. Leave blank to use the shared token, or enter your own to override.
    </p>

    <div class="mb-2">
      <p data-llm-settings-target="tokenStatus" class="text-sm text-dim">
        <span data-llm-settings-target="statusPersonal" class="<%= settings.llm_api_access_token.present? ? '' : 'hidden' %>">
          Using your personal access token
          <% if settings.llm_api_access_token.present? %>
            (<span class="font-mono"><%= settings.llm_api_access_token.first(4) %>...<%= settings.llm_api_access_token.last(2) %></span>)
          <% end %>.
        </span>
        <span data-llm-settings-target="statusShared" class="hidden">
          <span class="mr-1 font-semibold text-moss-700 dark:text-moss-300" aria-hidden="true">✓</span>
          Using the shared access token for this provider.
        </span>
        <span data-llm-settings-target="statusEnv" class="hidden">
          Default application token will be used if configured. Enter a token to override.
        </span>
        <span data-llm-settings-target="statusRequired" class="hidden">
          This provider has no shared token. Enter your access token to use it.
        </span>
        <span data-llm-settings-target="statusOauth" class="hidden">
          This provider uses your connected OpenAI OAuth credential.
        </span>
      </p>
      <div class="mt-2 flex flex-wrap items-center gap-2">
        <button type="button" class="btn-secondary text-sm py-1 px-2" data-llm-settings-target="tokenOverrideBtn" data-action="llm-settings#showTokenInput">
          Override token
        </button>
        <button type="button" class="btn-secondary text-sm py-1 px-2 hidden" data-llm-settings-target="useSharedTokenBtn" data-action="llm-settings#useSharedToken">
          Use shared token
        </button>
      </div>
    </div>

    <div data-llm-settings-target="tokenInputWrapper" class="hidden">
      <%= f.label :llm_api_access_token, "LLM API access token", class: "form-label" %>
      <%= f.text_field :llm_api_access_token, autocomplete: "off", class: "input-primary", 
        disabled: true, 
        placeholder: "Leave blank to use the default shared token",
        data: { llm_settings_target: "tokenInput" } %>
    </div>

    <p class="text-sm text-dim mb-4">
      <i>Will be stored in the database with encryption and only used for your account <% if current_user.role_teacher? %>and students<% end %>.</i>
    </p>

    <div class="mb-4">
      <%= f.label :llm_model_name, "LLM API model name", class: "form-label" %>
      <%= f.combobox "llm_model_name",
                      "#{user_settings_llm_models_path}?api_uri=#{settings.llm_api_base_uri}",
                      name_when_new: "setting[llm_model_name]",
                      placeholder: "Select or enter model name",
                      data: {
                        action: "",
                        llm_settings_target: "modelCombobox"
                      } %>
      <p class="text-sm text-dim mt-1">
        The main LLM used for chat/lessons. Avoid expensive or long-thinking models. Image support required.
      </p>
    </div>

    <div class="mb-4">
      <%= f.label :reasoning_model_name, "LLM reasoning model name (optional)", class: "form-label" %>
      <%= f.combobox "reasoning_model_name",
                      "#{user_settings_llm_models_path}?api_uri=#{settings.llm_api_base_uri}",
                      name_when_new: "setting[reasoning_model_name]",
                      placeholder: "Select or enter model name",
                      data: {
                        action: "",
                        llm_settings_target: "reasoningModelCombobox"
                      }
                      %>
      <p class="text-sm text-dim mt-1">
        Add a more expensive, frontier thinking model for better performance on curriculum-related tasks. Won't be used for chat. Must support structured outputs. Can be text-only.
      </p>
    </div>

    <div class="mb-6">
      <%= f.submit "Update Settings", class: "btn-primary" %>
    </div>
  </div> 

<% end %>
