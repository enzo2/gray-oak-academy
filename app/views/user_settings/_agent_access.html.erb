<% base_url = "#{request.base_url}/api/agent/v1" %>
<% skill_url = "#{base_url}/skill" %>
<% token = flash[:agent_api_token].presence %>
<% keys = current_user.agent_api_keys.recent_first %>
<% events = current_user.agent_api_events.includes(:agent_api_key).recent_first.limit(20) %>
<% skill_locals = TeacherAgent::SkillGenerator.template_locals(
  base_url: base_url,
  token_example: "goa_live_your_token_here",
  skill_url: skill_url,
  user: current_user
) %>

<div class="space-y-6">
  <section>
    <h3 class="mb-2 text-lg font-semibold">Agent Access</h3>
    <p class="mb-4 text-sm text-dim">
      Create a bearer token for a trusted local agent. This API can prepare drafts and resources, but cannot conduct lessons or publish lesson plans.
    </p>

    <div class="mb-4">
      <label class="form-label">Base URL</label>
      <div class="flex items-center gap-2">
        <code id="agent-api-base-url" class="block flex-1 overflow-x-auto rounded-sm border border-stone-300 bg-stone-100 p-2 text-sm dark:border-stone-700 dark:bg-stone-900"><%= base_url %></code>
        <sl-copy-button from="agent-api-base-url"></sl-copy-button>
      </div>
    </div>

    <% if token.present? %>
      <div class="mb-4 rounded-md border border-warning-300 bg-warning-50 p-3 dark:border-warning-800 dark:bg-warning-950/30">
        <p class="mb-2 text-sm font-semibold text-warning-900 dark:text-warning-200">Copy this token now. It will not be shown again.</p>
        <code id="agent-api-token" class="block overflow-x-auto rounded-sm bg-white p-2 text-sm dark:bg-stone-900"><%= token %></code>
        <div class="mt-2">
          <sl-copy-button from="agent-api-token" title="Copy token"></sl-copy-button>
        </div>
      </div>
    <% end %>

    <%= form_with url: agent_api_keys_path, scope: :agent_api_key, method: :post, class: "mb-6 flex flex-col gap-2 sm:flex-row sm:items-end" do |form| %>
      <div class="flex-1">
        <%= form.label :name, "Key name", class: "form-label" %>
        <%= form.text_field :name, class: "input-primary", placeholder: "Hermes on family server", autocomplete: "off" %>
      </div>
      <%= form.submit "Create Key", class: "btn-primary" %>
    <% end %>
  </section>

  <section>
    <h3 class="mb-2 text-lg font-semibold">Keys</h3>
    <% if keys.any? %>
      <div class="overflow-x-auto">
        <table class="min-w-full text-left text-sm">
          <thead class="border-b border-stone-200 text-dim dark:border-stone-700">
            <tr>
              <th class="py-2 pr-4">Name</th>
              <th class="py-2 pr-4">Prefix</th>
              <th class="py-2 pr-4">Last Used</th>
              <th class="py-2 pr-4">Status</th>
              <th class="py-2"></th>
            </tr>
          </thead>
          <tbody>
            <% keys.each do |key| %>
              <tr class="border-b border-stone-100 dark:border-stone-800">
                <td class="py-2 pr-4"><%= key.name %></td>
                <td class="py-2 pr-4 font-mono"><%= key.visible_prefix %>...</td>
                <td class="py-2 pr-4"><%= key.last_used_at ? time_ago_in_words(key.last_used_at) + " ago" : "Never" %></td>
                <td class="py-2 pr-4"><%= key.revoked? ? "Revoked" : "Active" %></td>
                <td class="py-2 text-right">
                  <% unless key.revoked? %>
                    <%= button_to "Revoke",
                                  agent_api_key_path(key),
                                  method: :delete,
                                  class: "btn-danger px-2 py-1 text-sm",
                                  form: { data: { turbo_confirm: "Revoke this agent API key?" } } %>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="text-sm text-dim">No agent API keys yet.</p>
    <% end %>
  </section>

  <section>
    <div class="mb-2 flex items-center justify-between gap-2">
      <h3 class="text-lg font-semibold">SKILL.md</h3>
      <%= link_to "Download", user_settings_agent_skill_path, class: "btn-secondary px-2 py-1 text-sm", data: { turbo: false } %>
    </div>
    <pre id="agent-skill-md" class="max-h-96 overflow-auto rounded-md border border-stone-300 bg-stone-100 p-3 text-xs dark:border-stone-700 dark:bg-stone-900"><%== CGI.escapeHTML(render(template: "teacher_agent/skill", formats: [ :md ], layout: false, locals: skill_locals).to_str) %></pre>
    <div class="mt-2">
      <sl-copy-button from="agent-skill-md">Copy SKILL.md</sl-copy-button>
    </div>
  </section>

  <section>
    <details class="group border-t border-stone-200 pt-4 dark:border-stone-700" open>
      <summary class="flex cursor-pointer list-none items-center justify-between gap-3 text-left [&::-webkit-details-marker]:hidden">
        <span class="text-lg font-semibold">Recent Activity</span>
        <span class="text-xs text-dim">
          <%= events.any? ? "Latest #{events.size}" : "None yet" %>
        </span>
      </summary>

      <% if events.any? %>
        <div class="mt-3 max-h-80 overflow-auto border border-stone-200 dark:border-stone-700">
          <table class="min-w-full text-left text-sm">
            <thead class="sticky top-0 border-b border-stone-200 bg-white text-dim dark:border-stone-700 dark:bg-stone-950">
              <tr>
                <th class="py-2 pr-4 pl-2">When</th>
                <th class="py-2 pr-4">Key</th>
                <th class="py-2 pr-4">Command</th>
                <th class="py-2 pr-4">Status</th>
                <th class="py-2 pr-2">Records</th>
              </tr>
            </thead>
            <tbody>
              <% events.each do |event| %>
                <% record_ids_json = event.record_ids.compact_blank.to_json %>
                <tr class="border-b border-stone-100 last:border-b-0 dark:border-stone-800">
                  <td class="py-2 pr-4 pl-2 whitespace-nowrap"><%= time_ago_in_words(event.requested_at) %> ago</td>
                  <td class="py-2 pr-4 whitespace-nowrap"><%= event.agent_api_key.name %></td>
                  <td class="max-w-64 py-2 pr-4 font-mono text-xs break-all"><%= event.command.presence || event.path %></td>
                  <td class="py-2 pr-4 whitespace-nowrap"><%= event.status %><%= " #{event.error_code}" if event.error_code.present? %></td>
                  <td class="max-w-72 py-2 pr-2 font-mono text-xs break-all" title="<%= record_ids_json %>"><%= truncate(record_ids_json, length: 120) %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <p class="mt-3 text-sm text-dim">No external-agent activity yet.</p>
      <% end %>
    </details>
  </section>
</div>
