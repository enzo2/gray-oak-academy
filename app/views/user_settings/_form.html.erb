<%= form_with(model: settings, url: user_settings_path, method: :patch, id: "user-settings-form") do |f| %>
  <% if settings.errors.any? %>
    <div class="mb-4 text-red-950 dark:text-red-300">
      <%= pluralize(settings.errors.count, "error") %> prevented the settings from being saved.
      <ul>
        <% settings.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <% if current_user.role_admin? %>
    <div data-controller="llm-settings" data-llm-settings-models-path-value="<%= user_settings_llm_models_path %>"> <%# Add Stimulus controller wrapper + models path %>
      <p class="mb-4 text-sm text-dim">
          <i>Note: If you leave any of these blank, the default settings from environment variables will be used.</i>
      </p>

      <div class="mb-1"> 
        <%= f.label :llm_api_base_uri, "LLM API base URI", class: "form-label" %>
        <%= f.combobox "llm_api_base_uri",
                       Llm.list_api_base_uris,
                       name_when_new: "setting[llm_api_base_uri]",
                       placeholder: "Select or enter API Base URI",
                       autocomplete: :list,
                       data: { action: "input->llm-settings#updateModels hw-combobox:selection->llm-settings#updateModels hw-combobox:clear->llm-settings#updateModels" } %>
      </div>
      <p class="text-sm text-dim mb-1">
        Should look like: https://openrouter.ai/api/v1/
      </p>      

      <details class="mb-4">
        <summary class="text-sm text-dim cursor-pointer mb-2">
          Which should I use?
        </summary>
          <p class="text-sm text-dim pl-2">
            Any OpenAI-compatible API is supported.<br>
            If OpenRouter is used, app will track actual costs and context window usage.<br>
            This may be useful for heavier use or longer lessons.<br>
            It also allows trying various models from different providers easily, and avoids tiered limits.<br>
            However, OpenRouter doesn't support audio input.
          </p>
      </details>

      <div class="">
        <%= f.label :llm_api_access_token, "LLM API access token", class: "form-label" %>
        <%= f.text_field :llm_api_access_token, class: "input-primary" %>
      </div>
      <p class="text-sm text-dim mb-4">
        Will be stored in the database. Encryption is not provided. Ensure the database is secure.
      </p>

      <div class="mb-4">
        <%= f.label :llm_model_name, "LLM API model name", class: "form-label" %>
        <%= f.combobox "llm_model_name",
                       "#{user_settings_llm_models_path}?api_uri=#{settings.llm_api_base_uri}",
                       name_when_new: "setting[llm_model_name]",
                       placeholder: "Select or enter Model Name",
                       data: {
                         action: "hw-combobox:selection->llm-settings#checkNewModel",
                         llm_settings_target: "modelCombobox"
                       } %>
      </div>

      <hr class="my-6 border-stone-300 dark:border-stone-700">

      <h4 class="text-lg font-semibold mb-2">Speech API Settings (Optional)</h4>
      <p class="mb-4 text-sm text-dim">
          To enable text-to-speech, add OpenAI-compatible Speech API credentials here.<br>
          To use defaults, add your OpenAI access token and leave the other fields empty.
      </p>

      <details class="mb-6">
        <summary class="cursor-pointer text-sm text-dim mb-2">Show settings</summary>

        <div class="mb-4">
          <%= f.label :speech_api_base_uri, "Speech API base URI", class: "form-label" %>
          <%= f.url_field :speech_api_base_uri, class: "input-primary", placeholder: "https://api.openai.com/v1/" %>
        </div>

        <div class="mb-4">
          <%= f.label :speech_api_access_token, "Speech API access token", class: "form-label" %>
          <%= f.text_field :speech_api_access_token, class: "input-primary" %>
          <p class="text-sm text-dim mt-1">
            Will be stored in the database. Encryption is not provided.
          </p>
        </div>

        <div class="mb-4">
          <%= f.label :tts_model_name, "Speech model name", class: "form-label" %>
          <%= f.text_field :tts_model_name, class: "input-primary", placeholder: "gpt-4o-mini-tts" %>
        </div>

        <div class="mb-4">
          <%= f.label :tts_voice_name, "Voice name", class: "form-label" %>
          <%= f.text_field :tts_voice_name, class: "input-primary", placeholder: "verse" %>
        </div>

        <div class="mb-4">
          <%= f.label :tts_instructions, "TTS instructions", class: "form-label" %>
          <%= f.text_area :tts_instructions, class: "input-primary", 
              placeholder: "Don't be too enthusiastic. Speak in a calm and friendly tone." %>
        </div>
      </details>

      <div class="mb-6">
        <%= f.submit "Update Settings", class: "btn-primary" %>
      </div>
    </div> 
  <% else %>
    There are no available preferences.
  <% end %>
<% end %>
