<%= turbo_frame_tag "dashboard-content" do %>
<div class="<%= current_user.role_admin? ? '' : 'p-4' %>">

  <div class="flex flex-row gap-4 h-[calc(100dvh-3.5rem)]" data-controller="code-executor">
    <!-- Chats Column -->
    <div class="flex-none w-32 pr-4 border-r border-gray-400">
      <div class="flex justify-between items-center mb-4">
        <h3 class="text-lg">Chats</h3>
        <%= link_to conversations_path,
            data: { turbo_method: :post, turbo_frame: "conversation-panel" },
            class: "inline-block" do %>
          <sl-icon-button name="plus-circle"></sl-icon-button>
        <% end %>
      </div>
      <div class="mb-6">
        <%= render partial: "conversations/list", locals: { conversations: @conversations, current_conversation: @conversation } %>
      </div>
    </div>

    <!-- Conversation Column -->
    <div class="w-[48rem]">
      <%= turbo_frame_tag "conversation-panel" do %>
        <%= render partial: "conversations/conversation", locals: { conversation: @conversation } %>
      <% end %>
    </div>

    <!-- Chalkboard Column -->
      <%= render partial: "shared/chalkboard" %>
  </div>

<div>
<% end %>
