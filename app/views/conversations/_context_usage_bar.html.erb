<% if context_usage > 0 %>
  <div class="flex items-center gap-2">
    <span class="flex-none text-sm text-stone-600 dark:text-stone-400">Token limit:</span>
    <sl-progress-bar value="<%= context_usage %>" max="100" style="width: 100%; --height: 6px;" class="grow">
    </sl-progress-bar> 
  </div>
<% end %>