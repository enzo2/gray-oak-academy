<%= turbo_stream_from "#{dom_id(conversation)}" %>

<div class="flex flex-col h-full max-w-full"
     data-controller="tts-stream"
     data-tts-stream-auto-read-value="<%= conversation.auto_read_default %>"
     data-tts-stream-speech-configured-value="<%= current_user.settings.speech_configured? %>"
     data-action="toggleAutoRead@window->tts-stream#toggleAutoRead">
  <div id="conversation-header">
    <% if conversation.lesson_progress.nil? %>
      <div class="mb-2 flex justify-between space-x-2">
        <%= link_to 'Clear Conversation', clear_conversation_path(conversation), 
          method: :delete, 
          class: "btn-danger",
          data: { 
            turbo_method: :delete,
            turbo_confirm: 'Are you sure you want to clear this conversation?'
          } %>
        <div class="flex space-x-2">
          <% if current_user.setting.speech_configured? %>
              <sl-icon-button 
                id="auto-read-toggle"
                name="<%= conversation.auto_read_default ? "volume-up" : "volume-mute" %>" 
                label="Auto-read" 
                class="text-xl [&::part(base)]:pt-2"
                data-action="click->tts-stream#toggleAutoRead"
                >
              </sl-icon-button>
          <% end %>
          <div class="xl:hidden text-dim text-xs italic leading-none text-right max-w-36">Screen too narrow for chalkboard.</div>
        </div>
      </div>
    <% end %>

    <%= turbo_frame_tag "context-usage-bar" do %>
      <%= render partial: "conversations/context_usage_bar", locals: { context_usage: conversation.context_usage } %>
    <% end %>
  
    <hr class="border-stone-500">
  </div>

  <div class="grow overflow-y-auto overflow-x-hidden pr-4" 
       id="<%= dom_id(conversation) %>"
       data-controller="conversation"
       data-conversation-target="messages"
       data-action="llm-completion-finished->tts-stream#handleNewAssistantMessageFinished">
      <% conversation.messages.each do |message| %>
        <%= render partial: "messages/message", locals: { message: message } %>
      <% end %>
  </div>

  <div class="flex-none">
    <%= render partial: "messages/form", locals: { conversation: conversation } %>
  </div>
</div>