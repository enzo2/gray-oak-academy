<%= turbo_stream_from "#{dom_id(conversation)}" %>

<div class="grow overflow-hidden h-full max-w-full
            flex flex-col"
     data-controller="tts-stream"
     data-tts-stream-auto-read-value="<%= conversation.auto_read_default %>"
     data-tts-stream-speech-configured-value="<%= AppSetting.tts_configured? %>"
     data-action="toggleAutoRead@window->tts-stream#toggleAutoRead">

  <!-- Conversation -->
  <div class="grow overflow-y-auto overflow-x-hidden pr-4"
       id="<%= dom_id(conversation) %>"
       data-controller="conversation"
       data-conversation-target="messages"
       data-conversation-welcome-messages-value="<%= conversation_welcome_messages.to_json %>"
       data-action="llm-completion-finished->tts-stream#handleNewAssistantMessageFinished">
    <% conversation.messages.each do |message| %>
      <%= render partial: "messages/message", locals: { message: message } %>
    <% end %>

    <div class="pointer-events-none flex w-full justify-start py-2"
         id="<%= dom_id(conversation) %>_accent"
         data-conversation-target="accent"
         aria-hidden="true">
      <div class="inline-flex items-center gap-2 rounded-full bg-stone-100/80 px-3 py-1.5 backdrop-blur-sm dark:bg-stone-800/80">
        <div data-conversation-target="accentIcon" class="tree-accent-icon">
          <%= image_tag "logo_icon.svg", size: "24", class: "tree-accent-icon__base opacity-80 dark:hidden", alt: "" %>
          <%= image_tag "logo_icon_negative.svg", size: "24", class: "tree-accent-icon__base opacity-80 hidden dark:block", alt: "" %>
          <%= image_tag "logo_icon.svg", size: "24", class: "tree-accent-icon__shine pointer-events-none absolute inset-0 dark:hidden", alt: "" %>
          <%= image_tag "logo_icon_negative.svg", size: "24", class: "tree-accent-icon__shine pointer-events-none absolute inset-0 hidden dark:block", alt: "" %>
        </div>
        <span data-conversation-target="accentText"
              class="text-sm font-sans text-stone-500 dark:text-stone-400 select-none"></span>
      </div>
    </div>
  </div>

  <div class="flex-none">
    <% if current_user == conversation.user %>
      <%= render partial: "messages/form", locals: { conversation: conversation } %>
    <% else %>
      <div class="flex flex-col items-center justify-center p-4 bg-stone-100 dark:bg-stone-800 text-center text-sm text-stone-600 dark:text-stone-400 border-t border-stone-200 dark:border-stone-700">
        <div class="flex items-center gap-2 mb-1">
          <sl-icon name="eye" class="text-lg"></sl-icon>
          <span class="font-semibold">Review Mode</span>
        </div>
        <p class="opacity-90">Viewing conversation of <span class="font-medium"><%= conversation.user.name %></span>.</p>
      </div>
    <% end %>
  </div>
</div>
