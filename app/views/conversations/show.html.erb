<!-- Horizontal flexbox container (sidebar, chat, chalkboard) -->
<div class="flex flex-row h-[calc(100dvh-2.5rem)]" 
     data-controller="sidebar drawer collapsible chalkboard"
     data-action="sidebar:open-mobile@window->sidebar#openMobile" 
     data-sidebar-storage-key-value="chatSidebar">

  <!-- Mobile Sidebar Overlay -->
  <div class="absolute inset-0 z-50 md:hidden hidden" data-sidebar-target="mobileSidebar">
    <div class="absolute inset-0 bg-black/50 transition-opacity duration-100" data-sidebar-target="mobileBackdrop" data-action="click->sidebar#closeMobile"></div>
    <div class="absolute inset-y-0 left-0 w-72 bg-stone-50 dark:bg-stone-900 shadow-xl border-r border-stone-200 dark:border-stone-800 transition-transform duration-100 ease-out" data-sidebar-target="mobilePanel">
      <div data-sidebar-target="sharedContent" class="h-full flex flex-col"></div>
    </div>
  </div>

  <!-- Chats Column (Collapsible Sidebar) -->
  <details class="group/sidebar relative z-20 h-full shrink-0 overflow-hidden border-r border-stone-200 bg-stone-50 max-md:hidden motion-safe:transition-all motion-safe:duration-100 dark:border-stone-800 dark:bg-stone-900" data-sidebar-target="desktopSidebar">
    
    <!-- Tiny Sidebar (shown when closed) -->
    <summary class="group-open/sidebar:hidden flex h-full cursor-e-resize list-none flex-col items-center pt-2 w-12 bg-stone-50 dark:bg-stone-900">
      <button class="flex mb-2 size-10 items-center justify-center rounded-lg text-stone-500 hover:bg-stone-100 focus:outline-none focus-visible:bg-stone-100 disabled:opacity-50 sm:size-9 dark:text-stone-400 hover:text-stone-700 dark:hover:text-stone-100 dark:hover:bg-stone-800 focus-visible:dark:bg-stone-800" 
              data-action="click->sidebar#open" aria-label="Expand sidebar">
        <sl-icon name="layout-text-sidebar-reverse" class="text-xl"></sl-icon>
      </button>
      
      <%= link_to conversations_path, data: { turbo_method: :post }, class: "flex size-10 items-center justify-center rounded-lg text-stone-500 hover:bg-stone-100 dark:text-stone-400 dark:hover:bg-stone-800", title: "New Chat" do %>
        <sl-icon name="plus-square" class="text-xl"></sl-icon>
      <% end %>
    </summary>

    <!-- Full Sidebar (shown when open) -->
    <div class="h-full w-72 overflow-x-clip overflow-y-auto bg-stone-50 text-clip whitespace-nowrap dark:bg-stone-900" data-sidebar-target="desktopContent">
      <!-- Shared Sidebar Content Template -->
      <template data-sidebar-target="contentTemplate">
        <nav class="flex flex-col h-full w-full">
           <div class="sticky top-0 z-30 bg-stone-50 dark:bg-stone-900 p-3 border-b border-stone-200 dark:border-stone-800 bg-opacity-95 backdrop-blur-sm">
              <div class="flex items-center justify-between">
                 <div class="flex items-center gap-2">
                   <h3 class="text-lg font-semibold text-stone-800 dark:text-stone-200">Chats</h3>
                   <%= link_to conversations_path, data: { turbo_method: :post }, class: "text-stone-600 hover:text-stone-900 dark:text-stone-400 dark:hover:text-stone-100" do %>
                     <sl-icon-button name="plus-square" label="New Chat"></sl-icon-button>
                   <% end %>
                 </div>
                 <button class="cursor-w-resize text-stone-500 hover:text-stone-700 dark:text-stone-400 dark:hover:text-stone-100 rounded-lg hover:bg-stone-100 dark:hover:bg-stone-800 p-1" 
                         data-action="click->sidebar#close" aria-label="Collapse sidebar">
                   <sl-icon name="layout-text-sidebar-reverse" class="text-xl"></sl-icon>
                 </button>
              </div>
           </div>
           
           <div class="px-2 pt-2 pb-4 overflow-y-auto flex-grow">
              <div id="conversation-list">
                <%= render partial: "conversations/list", locals: { conversations: @conversations, current_conversation: @conversation } %>
              </div>
           </div>
        </nav>
      </template>
    </div>
  </details>

  <!-- Conversation Column -->
  <div class="grow 
              min-w-0 max-w-[40rem] xl:max-2xl:max-w-[32rem] 
              h-full 
              flex flex-col px-2 md:px-3 pt-2" id="conversation-panel">
    <!-- Chat navigation bar -->
    <div class="flex flex-row justify-between text-xl">
      <div class="flex flex-row items-center"><!-- Left buttons -->
        <!-- Mobile only sidebar trigger using window event -->
        <sl-icon-button name="layout-text-sidebar-reverse" class="block md:hidden mr-1" aria-label="Open chats" 
                        onclick="window.dispatchEvent(new CustomEvent('sidebar:open-mobile'))"></sl-icon-button>
        
        <%= link_to conversations_path,
            data: { turbo_method: :post },
            class: "hidden md:block" do %> <!-- Hidden on mobile since it's in the mobile sidebar now, but kept on desktop for "New Chat" shortcut if needed, or remove? The old one had it. -->
          <sl-icon-button name="plus-square" label="New Chat"></sl-icon-button>
        <% end %>
        
        <%# Mobile chalkboard button - visible on smaller screens, hidden on xl+ %>
        <sl-icon-button
          name="easel"
          class="xl:hidden"
          label="Open chalkboard"
          aria-label="Open chalkboard"
          data-action="click->drawer#open"
          data-drawer-id="chalkboard">
        </sl-icon-button>
      </div>
      <div class="flex flex-row items-center"><!-- Right buttons -->
        <sl-icon-button data-collapsible-target="button" name="chevron-down" aria-controls="conversation-details" aria-expanded="false" label="Details" 
          data-action="click->collapsible#toggle"></sl-icon-button>
        <% if AppSetting.tts_configured? %>
        <sl-icon-button 
          id="auto-read-toggle"
          name="<%= @conversation.auto_read_default ? "volume-up" : "volume-mute" %>" 
          label="Auto-read" 
          class="text-xl [&::part(base)]:pt-2"
          onclick="window.dispatchEvent(new Event('toggleAutoRead'))"
          data-action="click->tts-stream#toggleAutoRead"></sl-icon-button>
        <% end %>
        <sl-dropdown class="" placement="bottom-end">
          <sl-icon-button name="three-dots-vertical" label="Additional chat options" slot="trigger" class="text-xl"></sl-icon-button>
          <sl-menu>
            <sl-menu-item data-action="click->drawer#showDialog" data-dialog-id="<%= dom_id(@conversation) %>_rename_dialog">
              <%# The rename sl-dialog is defined in the _list partial %>
              <div class="flex items-center">
                <sl-icon name="pencil" label="Rename conversation" class=""></sl-icon>
                <span class="pl-2">Rename</span>
              </div>
            </sl-menu-item>
            <sl-menu-item onclick="this.querySelector('button').click();">
              <%= button_to clear_conversation_path(@conversation), method: :delete, 
                  data: { turbo_method: :delete, turbo_confirm: 'This will delete all messages in the conversation.' } do %>
                <div class="flex items-center">
                  <sl-icon name="eraser" label="Clear conversation" class="hover:text-red-700"></sl-icon>
                  <span class="pl-2">Clear</span>
                </div>
              <% end %>
            </sl-menu-item>
            <sl-menu-item onclick="this.querySelector('button').click();">
              <%= button_to conversation_path(@conversation), method: :delete, 
                    data: { turbo_method: :delete, turbo_confirm: "Are you sure?" } do %>
                <div class="flex items-center">
                  <sl-icon name="trash" label="Delete conversation" class="hover:text-red-700"></sl-icon>
                  <span class="pl-2">Delete</span>
                </div>
              <% end %>
            </sl-menu-item>
          </sl-menu>
        </sl-dropdown>
      </div>
    </div>

    <div id="conversation-details" data-collapsible-target="panel" class="hidden">
      <div class="flex justify-between items-center space-x-4 mb-1">
        <div class="flex justify-start items-center space-x-2">
          <span class="text-dim text-sm"><%= @conversation.llm_in_use_name %></span>
        </div>
        <div class="xl:hidden max-w-36 text-right text-dim text-xs italic leading-none">Wider screen recommended for chalkboard.</div>
      </div>

      <%= turbo_frame_tag "context-usage-bar" do %>
        <%= render partial: "conversations/context_usage_bar", locals: { context_usage: @conversation.context_usage } %>
      <% end %>
      
    </div>

    <hr class="border-stone-500 mb-2">

    <%= render partial: "conversations/conversation", locals: { conversation: @conversation } %>
  </div>

  <!-- Chalkboard Column (desktop) -->
  <%= render partial: "shared/chalkboard" %>

  <%# Mobile Chalkboard Drawer - mobile-first overlay for small screens %>
  <sl-drawer style="--size: 100dvw;--header-spacing:4px;--body-spacing:0rem;--footer-spacing:0;" 
             placement="end" data-drawer-target="drawer" data-drawer-id="chalkboard">

    <div class="h-full">
      <%# Single-instance host where the chalkboard DOM will be moved into for mobile %>
      <div data-chalkboard-target="host" class="flex flex-col h-full bg-slate-100 dark:bg-stone-900"></div>
    </div>
  </sl-drawer>
</div>
