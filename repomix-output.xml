<file path="app/models/llm.rb">
# The model rows are auto-generated from the completion model.
# Used to store the context length and features, if the provider allows it to be queried. (OpenRouter)
class Llm < ApplicationRecord
  has_many :completions

  before_validation :ensure_api_provider_trailing_slash

  validates :model, presence: true
  validates :api_provider, presence: true
  validates :model, uniqueness: { scope: :api_provider }

  before_create :extract_model_provider_for_openrouter
  before_save :update_feature_flags_from_supported_parameters
  after_create_commit :update_metadata

  def supports_bidirectional_speech?
    supports_audio_input && supports_audio_output
  end

  DEFAULT_API_BASE_URLS = [
    "https://openrouter.ai/api/v1/",
    "https://api.openai.com/v1/",
    "https://generativelanguage.googleapis.com/v1beta/openai/"
  ].freeze

  # Returns the full list of API base URIs, including the defaults, and any others that have been used
  def self.list_api_base_uris
    custom_uris = Llm.pluck(:api_provider).uniq
    supported_uris = SupportedApi.selectable_uris
    (DEFAULT_API_BASE_URLS + supported_uris + custom_uris).uniq
  end

  # Options for the LLM API Base URI combobox with a visual marker for supported providers.
  # Returns an array of [display, value] pairs, e.g. ["https://openrouter.ai/api/v1/ ✅", "https://openrouter.ai/api/v1/"]
  def self.list_api_base_uri_options
    uris = list_api_base_uris
    supported = SupportedApi.selectable_uris
    uris.map do |uri|
      display = supported.include?(uri) ? "✅ #{uri}" : uri
      [ display, uri ]
    end
  end

  def self.list_models
    Llm.pluck(:model)
  end

  def supports_audio_input?
    supports_audio_input
  end

  def supports_image_input?
    supports_image_input
  end

  def supports_image_output?
    # Only support image models if the model can do image editing, since we use a 2-pass approach.
    supports_image_input && supports_image_output
  end

  def self.list_selectable_audio_models
    Llm.where(supports_audio_input: true, api_provider: SupportedApi.selectable_uris).order(:api_provider, :model)
  end

  # Return selectable image-capable models - only OpenRouter supported
  def self.list_selectable_image_models
    openrouter = SupportedApi.selectable_for_teachers.find_by(api_base_uri: "https://openrouter.ai/api/v1/")
    return [] unless openrouter
    Llm.where(supports_image_input: true, supports_image_output: true, api_provider: openrouter.api_base_uri).order(:model)
  end

  private

  # Sets a standard that API URIs will include the trailing slash
  def ensure_api_provider_trailing_slash
    if api_provider.present? && !api_provider.end_with?("/")
      self.api_provider = "#{api_provider}/"
    end
  end

  def extract_model_provider_for_openrouter
    if api_provider.include?("openrouter.ai")
      self.model_provider = model.split("/").first
    end
  end

  def update_feature_flags_from_supported_parameters
    return if supported_parameters.nil?

    self.supports_tool_use = supported_parameters.intersect?([ "tools", "tool_choice" ])
    self.supports_structured_outputs = supported_parameters.include?("structured_outputs")
  end

  def metadata_stale?
    metadata_fetched_at.nil? || metadata_fetched_at < 24.hours.ago
  end

  # OpenRouter provides an endpoint for fetching model metadata
  # If this initial check fails, will be retried as recurring job daily (via recurring.yml)
  def update_metadata
    return unless api_provider.include?("openrouter.ai") && metadata_stale?
    Rails.logger.debug "Updating metadata for LLM: #{self.inspect}"
    UpdateOpenrouterModelMetadataJob.set(wait: 5.seconds).perform_later(self) if metadata_stale?
  end
end
</file>

<file path="app/models/student_report.rb">
class StudentReport < ApplicationRecord
  # Reports stored as progress_data (JSONB).
  # As LLMs may not follow the desired schema for reports, don't depend on any particular JSON format.

  belongs_to :reportable, polymorphic: true # allows any model to have a StudentReport through reportable (eg. lesson report, enrollment report, misc)
  belongs_to :student, class_name: "User", inverse_of: :student_reports, optional: false
  belongs_to :teacher, class_name: "User", inverse_of: :authored_reports, optional: true # if teacher is deleted, report can remain

  enum :author_type, { ai_generated: "ai_generated", teacher_written: "teacher_written" }, prefix: true
  enum :status, { in_progress: "in_progress", completed: "completed" }, prefix: true

  # Automatically check if student course report needs to be generated
  after_create :trigger_course_report_check
  after_create_commit :trigger_memory_backfill

  scope :lesson_reports, -> { where(reportable_type: "LessonProgress") }
  scope :course_reports, -> { where(reportable_type: "Enrollment") }
  scope :orphaned, -> { where(reportable_id: nil) }

  def to_markdown
      report = progress_data
      return report.to_s unless report.is_a?(Hash)
    begin
      md = +""
      report.each do |key, value|
        # Convert the key (symbol or string) to a humanized heading.
        md << "**#{key.to_s.humanize}**\n"
        case value
        when Array
          if value.empty?
            md << "None.\n\n"
          else
            value.each do |item|
              md << "- #{item}\n"
            end
            md << "\n"
          end
        else
          md << "#{value}\n\n"
        end
      end
      md
    rescue StandardError => e
      Rails.logger.error "Error generating markdown for student report #{id}: #{e.message}"
      report.to_s
    end
  end

  private

  def trigger_course_report_check
    if reportable_type == "LessonProgress"
      Rails.logger.debug "Checking if need course report for student #{student.id} in course #{reportable.lesson.course.id}"
      enrollment = reportable.lesson.course.enrollments.find_by(student: student)
      enrollment.course_report_check
    end
  end

  # After LLM saves a lesson progress report, start job to semantically merge the memories.
  def trigger_memory_backfill
    return unless reportable_type == "LessonProgress"
    return unless progress_data&.dig("memories").present?

    BackfillMemoriesFromLessonReportJob.set(wait: 5.seconds).perform_later(self)
  end
end
</file>

<file path="app/models/user.rb">
class User < ApplicationRecord
  # Include default devise modules. Others available are:
  # :confirmable, :lockable, :timeoutable, and :omniauthable
  devise :database_authenticatable, :registerable,
         :recoverable, :rememberable, :validatable,
         :trackable

  # Superusers have maximum permissions, and can only be created/elevated manually from the console.
  # Admins only have access to their own students.
  # "Teacher" is not a user role, but but you can use role_teacher? instead of (role_admin? || role_superuser?)
  enum :role, { student: "student", admin: "admin", superuser: "superuser" }, prefix: true

  validates :first_name, presence: true
  validates :last_name, presence: true
  validate :validate_first_user_must_be_admin_or_superuser
  validate :validate_signup_code # A signup code is required for registration, to differentiate teachers and students
  validate :validate_teacher_role
  validate :validate_not_own_teacher
  attr_accessor :signup_code # Allow submission of the signup_code on registration

  after_create :ensure_setting
  after_create :seed_admin_data, if: :role_admin? || :role_superuser?

  has_many :students, class_name: "User", foreign_key: "teacher_id", inverse_of: :teacher
  belongs_to :teacher, class_name: "User", optional: true, inverse_of: :students
  has_one_attached :profile_picture, dependent: :destroy
  has_one :setting, dependent: :destroy
  has_many :enrollments, foreign_key: "student_id", inverse_of: :student
  has_many :courses, through: :enrollments, inverse_of: :students
  has_many :taught_courses, class_name: "Course", foreign_key: "teacher_id", inverse_of: :teacher
  has_many :lessons, through: :courses
  has_many :lesson_plans, foreign_key: "teacher_id", inverse_of: :teacher
  has_many :lesson_progresses, foreign_key: "student_id", inverse_of: :student, dependent: :destroy
  has_many :student_reports, foreign_key: "student_id", inverse_of: :student, dependent: :destroy # Retrieves all student reports. When querying, use scopes to narrow by reportable_type.
  has_many :user_context_reports, class_name: "StudentReport", as: :reportable # for generic reports; specific ones for course or completed lessons would be associated via ENROLLMENTS, or LESSON_PROGRESS
  has_many :authored_reports, class_name: "StudentReport", foreign_key: "teacher_id", inverse_of: :teacher, dependent: :nullify
  has_many :memories, foreign_key: "student_id", inverse_of: :student, dependent: :destroy
  has_many :authored_memories, class_name: "Memory", foreign_key: "author_id", inverse_of: :author, dependent: :nullify
  has_many :resources, foreign_key: "teacher_id", inverse_of: :teacher, dependent: :nullify # Don't destroy - might be valuable to keep for other teachers
  has_many :prompts, foreign_key: "teacher_id", inverse_of: :teacher, dependent: :destroy
  has_many :conversations, dependent: :destroy
  has_many :applets, dependent: :destroy

  def name
    "#{first_name} #{last_name}"
  end

  # access settings accessors logically e.g. current_user.settings.theme
  def settings
    setting
  end

  def role_teacher?
    role_admin? || role_superuser?
  end

  private

  def validate_teacher_role
    return if teacher.nil?
    errors.add(:teacher, "cannot be a student.") if teacher.role_student?
  end

  def validate_not_own_teacher
    return if teacher.nil?
    errors.add(:teacher, "cannot be yourself") if teacher == self
  end

  def ensure_setting
    create_setting! if setting.nil?
  end

  # Add seed data for teachers upon account creation
  def seed_admin_data
    yaml_file = Rails.root.join("config", "admin_user_seed_data.yml")
    data = YAML.load_file(yaml_file)
    process_initial_data(data)
  end

  def process_initial_data(data)
    data["resources"].each do |resource|
      # add the resource to db, with user set to current user
      Resource.create!(resource.merge(teacher: self))
    end
  end

  def validate_first_user_must_be_admin_or_superuser
    return unless new_record?
    return unless User.count.zero?
    errors.add(:role, "must not be a student, because it is the first user.") unless role_superuser? || role_admin?
  end

  def validate_signup_code
    return unless new_record?
    errors.add :signup_code, "is required" unless signup_code.present?

    case role
    when "admin" || "superuser"
      errors.add(:signup_code, "is invalid") unless signup_code == ENV["TEACHER_SIGNUP_CODE"]
    when "student"
      errors.add(:signup_code, "is invalid") unless signup_code == ENV["STUDENT_SIGNUP_CODE"]
    end
  end
end
</file>

<file path="app/services/image_generation_service.rb">
class ImageGenerationService
  # Generates images using an OpenRouter image-capable LLM in a two-pass flow:
  # 1) Generate initial image from prompt
  # 2) Re-prompt to check/regenerate for misspellings or factual errors
  #
  # Returns a Tempfile containing the processed JPEG image.

  def self.generate(user:, prompt:)
    raise ArgumentError, "Missing required parameter: user" unless user
    raise ArgumentError, "Missing required parameter: prompt" unless prompt.present?

    unless AppSetting.image_generation_configured?
      raise OpenAiError, "Image generation is not configured."
    end

    app_setting = AppSetting.settings
    llm = app_setting&.image_llm
    token = app_setting&.image_effective_token

    unless llm.api_provider&.include?("openrouter.ai")
      raise OpenAiError, "Only OpenRouter is supported for image generation."
    end

    # Build an explicit prompt including size/count hints to encourage single image output
    prompt_with_hints = prompt + "Return exactly 1 image. If you include any text in the image, ensure it is spelled correctly."

    client = OpenaiApiService.new(
      current_user: user,
      base_uri: llm.api_provider,
      access_token: token,
      model: llm.model,
      image_generation: true
    )

    # First pass
    messages = [
      { role: "user", content: prompt_with_hints }
    ]
    Rails.logger.debug "ImageGenerationService: sending first-pass generation to #{llm.model}"
    msg1 = client.complete(messages, temperature: 0.5)
    unless msg1.is_a?(Hash)
      raise OpenAiError, "Unexpected response from image model"
    end

    images1 = msg1["images"] || []
    img1 = images1.first
    img1_url = img1.dig("image_url", "url")
    content1 = msg1["content"].to_s

    unless img1_url.present? && img1_url.start_with?("data:image/")
      raise OpenAiError, "Image model returned no images on first pass."
    end

    # Second pass: ask the model to check and regenerate if needed.
    critique_instructions = "Thanks. Please review the image you just generated for errors such as misspellings, incorrect labels, or factual mistakes relative to the original prompt. Regenerate a corrected and improved image (even if you think the original is OK)."
    content_json = [ { "type": "text", "text": content1 } ]
    content_json << { "type": "image_url", "image_url": { "url": img1_url } }
    messages << { role: "assistant", content: content_json }
    messages << { role: "user", content: critique_instructions }

    Rails.logger.debug "ImageGenerationService: sending second-pass critique/regeneration to #{llm.model}"
    Rails.logger.debug "messages: #{messages}"
    msg2 = client.complete(messages, temperature: 0.5)
    unless msg2.is_a?(Hash)
      Rails.logger.warn "ImageGenerationService: second pass returned no image; falling back to first pass images"
      final_images = images1
      final_content = content1
    else
      images2 = msg2["images"] || []
      final_images = images2.any? ? images2 : images1
      final_content = msg2["content"].to_s.presence || content1
    end

    Rails.logger.debug "Content from image generation: #{final_content}"

    # Process and return a single Tempfile for the final image
    base64_url = final_images.first&.dig("image_url", "url")
    unless base64_url.present? && base64_url.start_with?("data:image/")
      raise OpenAiError, "Image generation failed: invalid image data"
    end

    # Extract mime and base64 payload
    match = base64_url.match(/\Adata:(image\/[a-zA-Z0-9.+-]+);base64,(.+)/)
    unless match
      raise OpenAiError, "Malformed data URL"
    end

    base64_data = match.captures.second

    begin
      decoded_data = Base64.strict_decode64(base64_data)
      unless decoded_data && decoded_data.length > 0
        raise OpenAiError, "Invalid base64 payload"
      end

      # Size check to prevent huge images
      if decoded_data.length > 10_000_000 # ~10MB limit
        raise OpenAiError, "Oversized image payload: #{decoded_data.length} bytes"
      end

      # Create Tempfile for original
      temp_original = Tempfile.new([ "generated-original", ".bin" ])
      temp_original.binmode
      temp_original.write(decoded_data)
      temp_original.rewind

      # Process: resize and convert to JPEG
      processed_path = ImageProcessing::Vips
        .source(temp_original.path)
        .resize_to_limit(1024, 1024)
        .convert("jpg")
        .saver(quality: 85)
        .call

      # Create Tempfile for processed image
      timestamp = Time.current.to_i
      temp_processed = Tempfile.new([ "generated-#{timestamp}", ".jpg" ])
      temp_processed.binmode
      File.open(processed_path, "rb") { |f| temp_processed.write(f.read) }
      temp_processed.rewind

      # Clean up original temp
      temp_original.close
      temp_original.unlink

      Rails.logger.debug "Image processed successfully: #{temp_processed.path}"

      temp_processed
    rescue Base64::Error, ArgumentError => e
      temp_original&.close
      temp_original&.unlink
      raise OpenAiError, "Decode error: #{e.message}"
    rescue => e
      temp_original&.close
      temp_original&.unlink
      raise OpenAiError, "Error processing image: #{e.message}"
    end
  rescue OpenAiError => e
    Rails.logger.error "ImageGenerationService OpenAiError: #{e.message}"
    raise
  rescue StandardError => e
    Rails.logger.error "ImageGenerationService Error: #{e.class}: #{e.message}"
    raise OpenAiError, "Image generation failed: #{e.message}"
  end
end
</file>

<file path="app/views/admin/app_settings/edit.html.erb">
<h1 class="text-2xl font-semibold mb-4">App Settings</h1>

<h2 class="text-xl font-semibold mb-4">Speech</h2>

