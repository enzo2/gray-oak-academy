<file path="app/models/completion.rb">
# For storing token usage and cost data.
class Completion < ApplicationRecord
  belongs_to :llm
  belongs_to :conversation, optional: true
  belongs_to :user, optional: true
  before_validation :associate_llm, :set_user_from_conversation
  self.implicit_order_column = "created_at"

  validates :model, presence: true

  # For querying token usage and cost data
  def self.usage_data_query(relation = self)
    relation
      .joins(:llm)
      .group("llms.id") # Single GROUP BY on the LLM ID is sufficient thanks to the unique index
      .select(
        "llms.model",
        "llms.api_provider",
        "llms.context_length",
        "llms.model_provider",
        "llms.supports_tool_use",
        "llms.supports_structured_outputs",
        "llms.supports_image_input",
        "llms.supports_image_output",
        "llms.supports_audio_input",
        "llms.supports_audio_output",
        "llms.supports_streaming_audio",
        "SUM(prompt_tokens) AS total_prompt_tokens",
        "SUM(cached_tokens) AS total_cached_tokens",
        "SUM(reasoning_tokens) AS total_reasoning_tokens",
        "SUM(completion_tokens) AS total_completion_tokens",
        "SUM(total_tokens) AS total_tokens",
        "SUM(total_cost) AS total_cost"
      )
  end

  # For querying token usage and cost data for all time
  def self.all_time_usage_data
    usage_data_query
  end

  scope :for_user_ids, ->(user_ids) {
    where(user_id: user_ids)
  }

  scope :in_date_range, ->(start_date, end_date) {
    where(created_at: start_date.beginning_of_day..end_date.end_of_day)
  }

  private

  # The Llm model is generated here, if it doesn't exist already.
  # This assures that any Llm instance is a valid model/API combination, since a completion had to be created first.
  def associate_llm
    self.llm = Llm.find_or_create_by!(
      model: model,
      api_provider: api_provider
    )
    Rails.logger.debug "Associated LLM #{self.llm.inspect} with completion #{self.inspect}"
  end

  def set_user_from_conversation
    self.user ||= conversation&.user
  end
end
</file>

<file path="app/models/enrollment.rb">
class Enrollment < ApplicationRecord
  belongs_to :student, class_name: "User", inverse_of: :enrollments
  belongs_to :course
  has_many :student_reports, as: :reportable, dependent: :nullify # used for course-end reports

  # Enforce no duplicate enrollments
  validates_uniqueness_of :student_id, scope: :course_id, message: "has already enrolled in this course"

  # Scopes filter completed/in_progress based on the presence of an enrollment report
  scope :completed, -> { joins(:student_reports).where(student_reports: { status: :completed }) }
  scope :in_progress, -> { where.not(
      id: joins(:student_reports).where(student_reports: { status: :completed }).select(:id)
  )}

  # Returns the lessons completed by the student, as determined by having a student report
  # (Would not include any lessons that were completed and then deleted)
  def completed_lessons
    course.lessons
      .joins(:student_reports)
      .where(student_reports: { student_id: student.id, status: :completed })
      .order(position: :asc)
  end

  def incomplete_lessons
    course.lessons.where.not(id: completed_lessons.pluck(:id)).order(position: :asc)
  end

  # Returns the number of lessons completed by the student in the course
  def completed_lessons_count
    completed_lessons.count
  end

  # Returns the total number of lessons in the course
  def total_lessons_count
    course.lessons.count
  end

  # Calculates the percentage of lessons completed in the course
  def progress_percentage
    return 0 if total_lessons_count.zero?
    (completed_lessons_count.to_f / total_lessons_count * 100).round
  end

  # Whether course has any published lessons not yet completed by student
  def has_available_lesson?
    incomplete_lessons.published.exists?
  end

  def next_available_lesson
    incomplete_lessons.published.first
  end

  # Determine if enrollment is completed by checking if all lessons have been completed
  def completed?
    return false unless course.lessons.any?
    completed_lessons_count == total_lessons_count
  end

  # When the course is completed, we need to generate a course-end summary report based on all the lesson reports.
  def course_report_check
    # If the course is completed and there are no student reports, generate a course report
    if completed? && !student_reports.exists?
      Rails.logger.info "Found missing enrollment report. Generating report for enrollment #{id}"
      GenerateCourseReportJob.perform_later(self)
    end
  end

  def lesson_history_for_prompt
    unless completed_lessons.empty?
      completed_lessons.map do |lesson|
        report = lesson.student_reports.where(student: student).first
        report_content = report.progress_data.to_s || "Report not available."
        "Lesson #{lesson.position}: #{lesson.title} | Goals: #{lesson.goals} | Student Report:#{report_content}"
      end.join("\n")
    else
      "No previous lessons completed in this course yet."
    end
  end
end
</file>

<file path="app/models/setting.rb">
class Setting < ApplicationRecord
  belongs_to :user
  # user.settings is alias for user.setting

  # Settings is a JSONB column; so it is not necessary to perform a DB migration to change the settings fields
  # t.jsonb :settings, null: false, default: {}

  # Encrypt all settings in the DB
  encrypts :settings

  before_validation :ensure_llm_api_base_uri_trailing_slash

  # add a store_accessor for each settings key to add methods to read/write it
  # e.g. user.settings.pref1="123", user.settings.save!
  store_accessor :settings, :llm_model_name
  store_accessor :settings, :llm_api_access_token
  store_accessor :settings, :llm_api_base_uri
  store_accessor :settings, :reasoning_model_name

  # Removed: :speech_api_base_uri, :speech_api_access_token, :tts_model_name, :tts_voice_name, :tts_instructions, :stt_model_name

  # keys that should be inherited from the teacher's settings for students:
  INHERITED_SETTING_KEYS = %i[
    llm_model_name
    reasoning_model_name
    llm_api_access_token
    llm_api_base_uri
  ].freeze

  # Override the getter for each inherited setting key to return the teacher's setting, if the user is a student
  INHERITED_SETTING_KEYS.each do |key|
    define_method(key) do
      if user.role_student? && user.teacher
        user.teacher.settings.public_send(key)
      else
        super()
      end
    end
  end

  # Check if an LLM is configured
  def llm_configured?
    # Effective base URI (user setting or ENV) and normalize trailing slash
    base_uri = ensure_trailing_slash(llm_api_base_uri.presence || ENV["OPENAI_API_BASE_URL"])

    has_base = base_uri.present?
    has_model = llm_model_name.present? || ENV["DEFAULT_MODEL"].present?

    # ENV key is only usable if the chosen base_uri matches the ENV base URI
    env_base = ensure_trailing_slash(ENV["OPENAI_API_BASE_URL"])
    env_key_usable = ENV["OPENAI_API_KEY"].present? && env_base.present? && has_base && (env_base == base_uri)

    has_access_token =
      llm_api_access_token.present? ||
      (has_base && SupportedApi.selectable_for_teachers.exists?(api_base_uri: base_uri)) ||
      env_key_usable

    has_base && has_access_token && has_model
  end

  private

  def ensure_trailing_slash(url)
    return url if url.blank? || url.end_with?("/")
    "#{url}/"
  end

  def ensure_llm_api_base_uri_trailing_slash
    # Note: We are modifying the value directly using the store_accessor method
    # This ensures the change is saved to the JSONB column
    self.llm_api_base_uri = ensure_trailing_slash(llm_api_base_uri) if llm_api_base_uri.present?
  end
end
</file>

<file path="app/models/supported_api.rb">
class SupportedApi < ApplicationRecord
  # Shared/supported OpenAI-compatible API configuration managed by superusers.

  # Encrypt the shared token in the DB
  encrypts :api_access_token

  before_validation :ensure_trailing_slash
  before_validation :nilify_blank_access_token

  validates :api_base_uri, presence: true, uniqueness: true

  # Only selectable for teachers if enabled and has a token
  scope :enabled, -> { where(enabled: true) }
  scope :with_token, -> { where.not(api_access_token: nil) }
  scope :selectable_for_teachers, -> { enabled.with_token }

  def self.selectable_uris
    selectable_for_teachers.pluck(:api_base_uri)
  end

  private

  def ensure_trailing_slash
    return if api_base_uri.blank?
    self.api_base_uri = api_base_uri.end_with?("/") ? api_base_uri : "#{api_base_uri}/"
  end

  def nilify_blank_access_token
    self.api_access_token = nil if api_access_token.blank?
  end
end
</file>

<file path="app/services/audio_converter.rb">
# Utility to convert audio files to 24kHz mono WAV and return Base64-encoded content.
class AudioConverter
  require "tempfile"
  require "base64"

  def self.convert_to_base64_wav(input_path)
    return nil unless input_path && File.exist?(input_path)

    temp_wav = Tempfile.new([ "stt_input", ".wav" ])
    begin
      # ffmpeg: convert to 24kHz mono wav
      # -y to overwrite, -ar 24000 sample rate, -ac 1 forces mono
      system("ffmpeg", "-i", input_path, "-ar", "24000", "-ac", "1", "-y", temp_wav.path)

      unless File.exist?(temp_wav.path) && File.size(temp_wav.path) > 0
        Rails.logger.error "FFmpeg conversion failed or produced an empty file for input: #{input_path}"
        return nil
      end

      Base64.strict_encode64(File.read(temp_wav.path))
    rescue StandardError => e
      Rails.logger.error "Error during audio conversion or encoding: #{e.message}"
      nil
    ensure
      temp_wav.close
      temp_wav.unlink
    end
  end
end
</file>

<file path="app/services/python_code_executor_service.rb">
require "net/http"
require "uri"
require "json"

class PythonCodeExecutorService
  TERRARIUM_URL = "http://terrarium:8080" # Runs in docker container

  def self.execute(code)
    uri = URI.parse(TERRARIUM_URL)
    http = Net::HTTP.new(uri.host, uri.port)
    req = Net::HTTP::Post.new(uri.request_uri)
    req["Content-Type"] = "application/json"
    req.body = { code: code }.to_json
    res = http.request(req)
    if res.is_a?(Net::HTTPSuccess)
      # Returns format  { "output_files": [], "final_expression": 2, "success": true, "std_out": "", "std_err": "", "code_runtime": 16 }
      # For now let's remove any file output
      JSON.parse(res.body).except(:output_files, :code_runtime) # Return a hash
    else
      { error: "Terrarium error: #{res.code} #{res.body}" }
    end
  rescue => e
    { error: e.message }
  end
end
</file>

