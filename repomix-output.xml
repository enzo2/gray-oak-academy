@import 'tailwindcss';

@plugin "@tailwindcss/forms" {
  strategy: "base";  /* provides form reset; add further styles using @utility classes */
}
@plugin "@tailwindcss/typography";

/* Applies dark mode when the `dark` class is added to the `html` element */
@custom-variant dark (&:where(.dark, .dark *));

@theme {

  --font-sans: "InterVariable", sans-serif;
  --font-serif: "Merriweather", serif;

  --color-moss-dark: #485340;
  --color-moss-light: #dbe5cc;

  --spacing-1\/2screen: 50vh;
  --spacing-2\/3screen: 66vh;
  --spacing-3\/4screen: 75vh;
  --spacing-5\/6screen: 83vh;
  --spacing-screen: 100vh;
}


/* custom overrides for hotwire-combobox */
@import '../tailwind/combobox_overrides.css';


/* base: where you can re-add styles to base elements that tailwind removed, 
   or fix the default base styles that tailwind added.
   Keep in mind that tailwind forms plugin already does a form reset. 
   Don't add default typographic styles (h1, h2, etc), use 'prose' instead .
   */
@layer base {  
  /*
    The default border color has changed to `currentColor` in Tailwind CSS v4,
    so we've added these compatibility styles to make sure everything still
    looks the same as it did with Tailwind CSS v3.

    If we ever want to remove these styles, we need to add an explicit border
    color utility to any element that depends on these defaults.
  */
  *,
  ::after,
  ::before,
  ::backdrop,
  ::file-selector-button {
    border-color: var(--color-stone-200, currentColor);
  }

  input[type="text"], input[type="hidden"], input[type="email"], 
  input[type="password"], input[type="search"], input[type="tel"], 
  input[type="url"], textarea {
    /* hack to override browser autofill styles that use !important 
    transition: color calc(infinity * 1s) step-end, background-color calc(infinity * 1s) step-end;  */

    @apply bg-transparent text-black dark:text-white placeholder-stone-500 dark:placeholder-stone-500;
