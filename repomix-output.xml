<div class="flex items-center justify-between mb-4">
  <h2 class="text-2xl font-semibold">LLM APIs</h2>
  <% if current_user.role_superuser? %>
    <%= link_to "New Supported API", new_admin_supported_api_path, class: "btn-primary" %>
  <% end %>
</div>

<p class="text-sm text-dim mb-4">
  <% if current_user.role_superuser? %>
    OpenAI-compatible APIs can be added with a shared API key for all teachers to use. 
  <% elsif current_user.role_admin? %>
    APIs listed here are available for use, if loaded with a shared API key. 
  <% end %>
</p>

<% if @supported_apis.any? %>
  <table class="table-auto w-full">
    <thead>
      <tr class="bg-stone-50 dark:bg-stone-900">
        <th class="px-2 py-1 text-left">API Base URI</th>
        <th class="px-2 py-1 text-left">Shared Token</th>
        <th class="px-2 py-1 text-left">Enabled</th>
        <% if current_user.role_superuser? %>
          <th class="px-2 py-1 text-left">Notes</th>
          <th class="px-2 py-1 text-right">Actions</th>
        <% end %>
      </tr>
    </thead>
    <tbody>
      <% @supported_apis.each_with_index do |api, idx| %>
        <tr class="<%= idx.odd? ? 'bg-stone-200 dark:bg-stone-700' : '' %>">
          <td class="px-2 py-1"><%= api.api_base_uri %></td>
          <td class="px-2 py-1">
            <% if api.api_access_token.present? %>
              <span class="text-emerald-700 dark:text-emerald-300">Present</span>
            <% else %>
              <span class="text-stone-500">None</span>
            <% end %>
          </td>
          <td class="px-2 py-1">
            <% if api.enabled? %>
              <span class="text-emerald-700 dark:text-emerald-300">Enabled</span>
            <% else %>
              <span class="text-stone-500">Disabled</span>
            <% end %>
          </td>
          
          <% if current_user.role_superuser? %>
            <td class="px-2 py-1 text-sm text-stone-700 dark:text-stone-300"><%= api.notes %></td>
            <td class="px-2 py-1 text-right">
              <%= link_to "Edit", edit_admin_supported_api_path(api), class: "hover:underline" %>
              <%= link_to "Delete", admin_supported_api_path(api), data: { turbo_method: :delete, turbo_confirm: "Delete this Supported API?" }, class: "hover:underline ml-2" %>
            </td>
          <% end %>

        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p class="text-sm text-dim">No Supported APIs found.</p>
<% end %>
</file>

