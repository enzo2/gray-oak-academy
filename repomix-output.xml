<file path="app/views/admin/resources/show.html.erb">
<h1 class="text-2xl font-bold mb-4">Resource Details</h1>

<div class="space-y-4">
  <div>
    <i>Category</i>
    <br>
    <%= @resource.category %>
  </div>

  <div>
    <i>Description</i>
    <br>
    <%= @resource.description %>
  </div>

  <div>
    <i>URI:</i>
    <br>
    <% if @resource.uri.present? %>
      <!-- Brakeman: URI is validated in the model and link text is escaped -->
      <%= link_to sanitize(@resource.uri), sanitize(@resource.uri, tags: []), target: "_blank", rel: "noopener noreferrer" %>
    <% else %>
      No URI provided.
    <% end %>
    
  </div>
  
  <div>
    <i>Attached File:</i>
    <br>
    <% if @resource.file.attached? %>
      <div class="flex items-center justify-baseline space-x-2 py-1">
        <%= link_to @resource.file.filename, rails_blob_path(@resource.file, disposition: "attachment") %>
        <%= button_to delete_file_admin_resource_path(@resource),
          method: :delete,
          data: { confirm: "Are you sure you want to delete this file?" },
          class: "hover:text-red-500 flex items-center" do %>
          <sl-icon name="trash"></sl-icon>
        <% end %>
      </div>
    <% else %>
      No attached file.
    <% end %>
  </div>

  <div>
    <i>Applet Code:</i>
    <br>
    <% if @resource.applet&.code.present? %>
      <details>
        <summary class="cursor-pointer hover:underline">View Applet Code (<%= @resource.applet.title %>)</summary>
        <% for_syntax_highlighting = "```js\n#{@resource.applet.code}\n```" %>
        <div class="bg-[var(--rouge-bg)] text-xs p-2 max-h-[200px] overflow-y-auto">
          <%= markdown(for_syntax_highlighting) %>
        </div>
      </details>
    <% else %>
      No applet provided.
    <% end %>
  </div>

  <div>
    <i>Linked to Lesson Plans:</i>
    <br>
    <% if @resource.lesson_plans.any? %>
      <ul class="[&_li]:pl-3">
        <% @resource.lesson_plans.each do |lesson_plan| %>
          <li><%= link_to lesson_plan.lesson.title, admin_course_lesson_path(lesson_plan.lesson.course, lesson_plan.lesson), class: "hover:underline" %>
        <% end %>
      </ul>
    <% else %>
      Not linked to any lesson plans.
    <% end %>
</div>

<div class="mt-6">
  <%= link_to 'Edit', edit_admin_resource_path(@resource), class: 'btn-primary' %>
  <%= link_to 'Back', admin_resources_path, class: 'btn-primary' %>
</div>
</file>

<file path="app/views/admin/students/_active_courses.html.erb">
<h3 class="text-lg mb-2">Enrolled Courses</h3>
<div class="w-full grid grid-cols-[repeat(auto-fill,20rem)] gap-4 mb-6">

  <% enrollments.each do |enrollment| %>
    <div id="<%= dom_id(enrollment) %>" class="p-4 rounded-sm border border-stone-300 dark:border-stone-700">
      <span class="font-medium mb-2 block"><%= enrollment.course.title %></span>

      <div class="mb-4 block">
        <%= render partial: "enrollments/enrollment_progress_bar", locals: { enrollment: enrollment } %>
      </div>

      <div class="mb-4 flex justify-start">
        <% if enrollment.has_available_lesson? %>
          <% if current_user == enrollment.student # Allow teachers to take lessons for themselves %>
            <%= link_to student_lesson_path(enrollment.next_available_lesson), 
                  class: "block btn-primary text-sm" do %>
              <div class="flex items-center">
                <sl-icon name="check-circle-fill" class="text-blue-700 pr-2"></sl-icon>
                <span>&nbsp;<%= enrollment.next_available_lesson.started_by?(current_user) ? "Continue" : "Start next" %> lesson</span>
              </div>
            <% end %>
          <% else %>
            <sl-icon name="check-circle-fill" class="text-lg mr-2 shrink-0 text-green-500" title="Available lessons"></sl-icon>
            <span class="text-sm">Next lesson ready.</span>
          <% end %>
        <% else %>
          <sl-icon name="exclamation-circle-fill" class="text-lg text-red-500 mr-2 shrink-0" title="No available lessons"></sl-icon>
          <span class="text-sm">No lessons available for student. Please 
            <%= link_to "publish a lesson plan", admin_course_lessons_path(enrollment.course), class: "underline" %>.
            </span>
        <% end %>
      </div>

      <% if enrollment.completed_lessons_count > 0 %>
        <div class="mb-4">
          <%= button_to enrollment_path(enrollment), 
                method: :get, 
                data: { turbo_stream: true },
                class: "btn-primary text-sm" do %>
            <div class="flex items-center">
              <sl-icon name="file-text" class="text-blue-700"></sl-icon>
              <span>&nbsp;View student progress</span>
            </div>
          <% end %>
        </div>
      <% end %>

      <%= button_to 'Unenroll', unenroll_admin_student_path(@student, course_id: enrollment.course.id),
          method: :delete,
          data: { 
            turbo_confirm: 'WARNING! This will delete all student progress and cannot be reversed. Student reports will be orphaned. It is better to retain the enrollment for record-keeping. Are you sure?',
            turbo_stream: true 
          }, 
          class: "btn-danger text-sm" %>

    </div>
  <% end %>

</div>
</file>

<file path="app/views/admin/supported_apis/_form.html.erb">
<%= form_with(model: [:admin, @supported_api], class: "space-y-4") do |f| %>
  <% if @supported_api.errors.any? %>
    <div class="mb-4 text-red-700 dark:text-red-300">
      <%= pluralize(@supported_api.errors.count, "error") %> prevented saving:
      <ul class="list-disc list-inside">
        <% @supported_api.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :api_base_uri, "API base URL", class: "form-label" %>
    <%= f.url_field :api_base_uri, class: "input-primary", placeholder: "https://openrouter.ai/api/v1/" %>
    <p class="text-xs text-dim mt-1">Must be OpenAI-compatible (Chat Completions API).</p>
  </div>

  <div>
    <%= f.label :api_access_token, "Shared access token", class: "form-label" %>
    <%= f.text_field :api_access_token, class: "input-primary", autocomplete: "off", 
      placeholder: (@supported_api.persisted? && @supported_api.api_access_token.present? ? "Leave blank to keep current token" : "Paste token here"),
      value: "" %>
    <% if @supported_api.persisted? %>
      <p class="text-xs text-dim mt-1">
        <% if @supported_api.api_access_token.present? %>
          Token: <span class="text-emerald-700 dark:text-emerald-300">
            Saved (<%= @supported_api.api_access_token.first(4) %>...<%= @supported_api.api_access_token.last(2) %>)
            </span> — leave blank to keep unchanged.
        <% else %>
          Token: <span class="text-stone-500">None</span>
        <% end %>
      </p>
    <% else %>
      <p class="text-xs text-dim mt-1">Stored with encryption. <b>Will be available for all teachers to use</b>.</p>
    <% end %>
  </div>

  <div class="flex items-center gap-2">
    <%= f.check_box :enabled, class: "checkbox-primary" %>
    <%= f.label :enabled, "Enabled for teacher use" %>
  </div>

  <div>
    <%= f.label :notes, "Notes (optional)", class: "form-label" %>
    <%= f.text_area :notes, class: "input-primary", rows: 3, placeholder: "Optional notes for admins" %>
  </div>

  <%# Only show inline verification box on NEW. For edit, use the dedicated section below. %>
  <% if @supported_api.new_record? && current_user.role_superuser? %>
    <div class="mt-4 p-3 border rounded">
      <h4 class="font-semibold mb-2">Verify models now (comma or newline separated)</h4>
      <%= text_area_tag :models_to_verify, nil, class: "input-primary w-full", rows: 3, placeholder: "e.g.\nopenai/gpt-5-mini\ngoogle/gemini-2.5-flash" %>
      <p class="text-xs text-dim mt-1">On save, a background job will verify each model by issuing a minimal completion and will add it to the site-wide Models list if successful.</p>
    </div>
  <% end %>

  <div class="mt-6">
    <%= f.submit (@supported_api.persisted? ? "Update" : "Create"), class: "btn-primary" %>
    <%= link_to "Cancel", admin_supported_apis_path, class: "btn-secondary ml-2" %>
  </div>
<% end %>

<%# Edit-only extras %>
<% if @supported_api.persisted? %>
  <% if defined?(@verified_models) && @verified_models.present? %>
    <div class="mt-6 p-3 border rounded">
      <h4 class="font-semibold mb-2">Verified models for this provider</h4>
      <table class="table-auto w-full">
        <thead>
          <tr class="bg-stone-50 dark:bg-stone-900">
            <th class="px-2 py-1 text-left">Model</th>
            <th class="px-2 py-1 text-left">Audio Input</th>
          </tr>
        </thead>
        <tbody>
          <% @verified_models.each_with_index do |llm, idx| %>
            <tr class="<%= idx.odd? ? 'bg-stone-200 dark:bg-stone-700' : '' %>">
              <td class="px-2 py-1"><%= llm.model %></td>
              <td class="px-2 py-1">
                <% if current_user.role_superuser? %>
                  <%= form_with(model: llm, url: admin_llm_path(llm), method: :patch, data: { turbo_stream: true }) do |f| %>
                    <%= f.check_box :supports_audio_input,
                          {
                            checked: llm.supports_audio_input,
                            data: { controller: "auto-submit-toggle", action: "auto-submit-toggle#submit" },
                            class: "checkbox-primary",
                            id: "llm_#{llm.id}_supports_audio_input"
                          } %>
                  <% end %>
                <% else %>
                  <%= llm.supports_audio_input ? "Yes" : "No" %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
      <p class="text-xs text-dim mt-1">Only superusers can change site-wide audio flags.</p>
      <% if current_user.role_superuser? %>
        <p class="text-xs mt-1"><%= link_to "Manage all LLM models", admin_llms_path, class: "hover:underline" %></p>
      <% end %>
    </div>
  <% else %>
    <p class="text-sm text-dim mt-4">No verified models yet for this provider.</p>
  <% end %>

  <div class="mt-6 p-3 border rounded">
    <h4 class="font-semibold mb-2">Verify additional models</h4>
    <%= form_with url: verify_models_admin_supported_api_path(@supported_api), method: :post, class: "space-y-2" do %>
      <%= text_area_tag :models_to_verify, nil, class: "input-primary w-full", rows: 3, placeholder: "Model names (comma or newline separated)" %>
      <div>
        <%= submit_tag "Enqueue Verification", class: "btn-primary" %>
      </div>
    <% end %>
    <p class="text-xs text-dim mt-1">This runs verification without changing the current Supported API details.</p>
  </div>

<% end %>
</file>

