class GenerateCourseReportJob < ApplicationJob
  queue_as :default

  REPORT_SCHEMA = {
    "strict": true,
    "name": "Course_Report",
    "description": "A summary of the student's performance in the course.",
    "schema": {
      "type": "object",
      "properties": {
        "summary": {
          "type": "string",
          "description": "A detailed overview of the student's performance and understanding during the course."
        },
        "strengths": {
          "type": "array",
          "items": { "type": "string" },
          "description": "List areas (if any) where the student demonstrated adequate-to-strong understanding, which will require minimal to no review in subsequent courses. May include knowledge or skills."
        },
        "areas_for_review": {
          "type": "array",
          "items": { "type": "string" },
          "description": "List aspects (if any) of the course material/plan where the student should receive additional clarification, review or practice in subsequent courses or remedial sessions."
        },
        "teaching_methods": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Note any aspects of teaching methodology that were particularly effective or ineffective for the student."
        }
      },
      "required": [ "summary", "strengths", "areas_for_review", "teaching_methods" ],
      "additionalProperties": false
    }
  }

  def perform(enrollment)
    course = enrollment.course
    student = enrollment.student
    teacher = course.teacher
    lessons_history = enrollment.lesson_history_for_prompt
    task_prompt = Prompt.get_prompt(category: "generate_student_course_report", user: teacher)

    customized_prompt = task_prompt
      .gsub("{course_title}", course.title)
      .gsub("{course_summary}", course.summary)
      .gsub("{lessons}", lessons_history)

    # Prepare messages for the LLM
    messages = [ { role: "user", content: customized_prompt } ]

    begin
      # Make the LLM request
      client = OpenaiApiService.new(
        current_user: teacher,
        reasoning_model: true
      )
      parsed_content = client.complete(
        messages,
        response_format: {
          type: "json_schema",
          json_schema: REPORT_SCHEMA[:schema]
        },
        schema: REPORT_SCHEMA[:schema],
        prefill: "{"
      )

      # Create the student report
      StudentReport.create!(
        student: student,
        teacher: teacher,
        reportable: enrollment,
        progress_data: parsed_content,
        author_type: :ai_generated,
        status: :completed
      )

      Rails.logger.info "Course report generated for enrollment: #{enrollment.id}"

    rescue StandardError => e
      Rails.logger.error "Error generating course report for enrollment #{enrollment.id}: #{e.message}"
      # Optionally, broadcast an error message
    end
  end
end
</file>

<file path="app/models/app_setting.rb">
class AppSetting < ApplicationRecord
  # Singleton app-wide settings stored in a JSONB `settings` column
  encrypts :settings

  # Expose common keys as accessors
  store_accessor :settings,
                 :provider_supported_api_id,
                 :stt_method,
                 :stt_model,
                 :stt_model_id,
                 :tts_model,
                 :tts_voice,
                 :tts_instructions,
                 :token_override,
                 :image_llm_id

  validates :singleton, inclusion: { in: [ true, false ] }

  # Convenience accessor to always return the single app setting
  def self.settings
    first
  end

  # Return the associated SupportedApi record for the configured provider, if any
  def provider_supported_api
    return nil unless provider_supported_api_id.present?
    SupportedApi.find_by(id: provider_supported_api_id.to_i)
  end

  # Returns the effective API token to use: the SupportedApi token also used for chat, or an override token
  def effective_token
    token_override.presence || provider_supported_api&.api_access_token
  end

  # Returns provider base URI if configured
  def provider_base_uri
    provider_supported_api&.api_base_uri
  end

  # Image generation configuration
  def image_llm
    return nil unless image_llm_id.present?
    Llm.find_by(id: image_llm_id.to_i)
  end

  def image_effective_token
    return nil unless image_llm.present?
    provider = SupportedApi.selectable_for_teachers.find_by(api_base_uri: image_llm.api_provider)
    provider&.api_access_token
  end

  # Checks whether Speech API (OpenAI-compatible) is configured for TTS/STT
  def self.speech_configured?
    app_setting = self.first
    app_setting&.provider_base_uri.present? && app_setting&.effective_token.present?
  end

  def self.tts_configured?
    # Currently, Speech API is the only way to provide TTS.
    self.speech_configured?
  end

  # STT can be done via Speech API, or audio LLMs. Webmaster must choose.
  def self.stt_configured?
    app_setting = self.first
    return false unless app_setting

    case app_setting.stt_method
    when "speech" # Using Speech API for STT
      app_setting.provider_base_uri.present? &&
      app_setting.effective_token.present? &&
      app_setting.stt_model.present?
    when "chat" # Using LLM for STT
      app_setting.stt_model_id.present?
    else
      false
    end
  end

  def self.image_generation_configured?
    app_setting = self.first
    app_setting&.image_llm.present? &&
    app_setting.image_llm.supports_image_output? &&
    app_setting.image_effective_token.present?
  end
end
</file>

<file path="app/models/applet.rb">
class Applet < ApplicationRecord
  belongs_to :user
  belongs_to :resource, optional: true

  validates :title, presence: true
  validates :code, presence: true

  validate :validate_js_syntax, if: :code_changed?

  private

  def validate_js_syntax
    return if code.blank?
    syntax_check = NodeJsSyntaxChecker.check(code)
    unless syntax_check[:valid]
      errors.add(:code, "JavaScript syntax errors: #{syntax_check[:errors].join('; ')}")
    end
  end
end
