    <% end %>
  </td>
  <td class="py-2 px-3 text-right [&_a:hover]:underline">
    <%= link_to "Edit", edit_admin_course_lesson_path(lesson.course, lesson), class: "inline-block mr-2", data: { turbo_stream: true } %>
    <%= button_to "Delete", admin_course_lesson_path(lesson.course, lesson), 
          method: :delete, 
          class: "inline-block mr-2 hover:underline", 
          data: { 
            turbo_confirm: "Are you sure? This will delete the associated lesson plan too." 
          } %>
