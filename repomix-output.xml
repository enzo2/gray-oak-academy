<file path="app/models/course.rb">
class Course < ApplicationRecord
  belongs_to :teacher, class_name: "User", inverse_of: :taught_courses
  has_many :students, through: :enrollments, inverse_of: :courses
  has_many :lessons, -> { order(position: :asc) }, dependent: :destroy
  has_many :enrollments
  has_many :student_reports, through: :enrollments

  enum :status, { active: "active", archived: "archived" }, default: "active", prefix: true
  # scope :active, -> { where(status: "active") }
  # scope :archived, -> { where(status: "archived") }

  validates :title, presence: true, length: { minimum: 3, maximum: 100 }
  validates :summary, presence: true, length: { minimum: 10, maximum: 2000 }
  validates :grade_level,
            presence: true,
            format: {
              with: /\A([A-Z]|[1-9]\d*)\z/,
              message: "must be a single uppercase letter or a positive integer."
            }
    validate :validate_outline_format

  def enrolled_in?(student)
    enrollments.exists?(student: student)
  end

  def completed_by?(student)
    enrollments.exists?(student: student, completed: true)
  end

  def self.available_for_enrollment(student, teacher)
    # status_active.where(teacher: teacher).reject { |course| course.enrolled_in?(student) }
    status_active
      .where(teacher: teacher)
      .where.not(id: student.courses.select(:id))
  end

  def for_llm
    {
      id: self.id,
      title: self.title,
      summary: self.summary,
      grade_level: self.grade_level,
      status: self.status,
      outline: self.outline,
      lessons: self.lessons.map do |l|
        {
          id: l.id,
          title: l.title,
          goals: l.goals,
          approx_duration_min: l.approx_duration_min,
          position: l.position,
          plan_status: l.lesson_plan&.status
        }
      end
    }
  end

  private

  def validate_outline_format
    if outline.present?
      outline.each do |item|
        if item.keys.first.blank? || item.values.first.blank?
          errors.add(:outline, "entries must have both a topic and details.")
        end
      end
    end
  end
end
</file>

<file path="app/models/lesson_plan.rb">
class LessonPlan < ApplicationRecord
  belongs_to :lesson
  belongs_to :teacher, class_name: "User", inverse_of: :lesson_plans
  has_one :course, through: :lesson
  has_and_belongs_to_many :resources

  validates_uniqueness_of :lesson_id # lesson has_one lesson_plan

  # Field: t.jsonb :content, default: [] # Array of hashes [{type => details}, ...]
  # Field: t.jsonb :suggested_resources, default: [] # Array of hashes [{type => description}, ...]
  # Field: t.boolean :chalkboard_enabled, default: true, null: false
  # Field: t.enum :audio, enum_type: :audio_setting, default: "enabled", null: false

  enum :status, { draft: "draft", published: "published" }, prefix: true
  # "archived" status also available in the enum column, but can't think of a use case

  # Setting for audio input: see conversation.rb for definitions
  enum :audio, { enabled: "enabled", only: "audio-only" }, prefix: true
  # "disabled" status also available in the enum column, but confusing since STT is always enabled

  # Allow blank content if still new draft
  validate :validate_content_format, unless: -> { status == "draft" && content.blank? }

  after_initialize :link_default_resources, if: :new_record?

  private

  def link_default_resources
    default_resources = Resource.where(include_by_default: true)
    resources << default_resources
  end

  def validate_content_format
    if content.empty?
      errors.add(:content, "must be added.")
    else
      content.each do |item|
        if item.keys.first.blank? || item.values.first.blank?
          errors.add(:content, "entries must have both a type and details.")
        end
      end
    end
  end
end
</file>

<file path="app/models/lesson_progress.rb">
class LessonProgress < ApplicationRecord
  # Represents a lesson in progress for a student

  belongs_to :student, class_name: "User"
  belongs_to :lesson
  has_one :teacher, through: :lesson
  has_one :conversation, dependent: :destroy
  has_one :student_report, as: :reportable, dependent: :nullify # Don't destroy student reports if the lesson/course is deleted.

  # Enforce no duplicate progresses for the same student and lesson
  validates_uniqueness_of :student_id, scope: :lesson_id, message: "has already started progress on this lesson."

  # Also includes JSONB fields for :chat_history and :progress_data; not currently needed since chat is in the Conversation and progress is in the StudentReport

  def find_or_create_conversation(user)
    conversation || create_conversation!(user)
  end

  def completed?
    student_report.present? && student_report.status_completed?
  end

  scope :completed, -> { joins(:student_report).where(student_reports: { status: :completed }) }

  def course # For convenience
    lesson.course
  end

  def lesson_plan # For convenience
    lesson.lesson_plan
  end

  def resources # For convenience
    lesson_plan.resources
  end

  def build_task_system_prompt
    # The lesson task_system_prompt is very important.
    # It contains all the information needed to 1) conduct the lesson, 2) personalized to the student, and 3) evaluate the student at the end.
    # In the future it can also include student profile information gathered from other courses, or the teacher.
    # We don't include student age for pedagogical reasons, since we want students to advance beyond their age level.
    generative_guidelines = Prompt.get_prompt(category: "generative_guidelines", user: teacher)
    lesson_tutor_session_prompt = Prompt.get_prompt(category: "lesson_tutor_session", user: teacher)
    lesson_info = <<~LESSON_INFO
      Course: #{course.title}
      Grade Level: #{course.grade_level}
      Lesson Title: #{lesson.title}
      Estimated Duration: #{lesson.approx_duration_min} minutes (just a guide; could be shorter)
      Chalkboard enabled?: #{lesson_plan.chalkboard_enabled?}
      Audio setting: #{ (lesson_plan.audio == "audio-only" ? "Audio/Speech-only. Keyboard is disabled." : "Flexible: Student can type or use speech-to-text.") }
      Goals: #{lesson.goals}
      Lesson Plan:
      #{lesson_plan.content}

      Resources marked as available:
      #{resources.format_collection}

      Student's name: #{student.name}
      Student's progress in previous lessons in this course:
      #{student.enrollments.find_by(course: lesson.course)&.lesson_history_for_prompt}
      Memories about this student:
      #{Memory.for_prompt(user: student)}
    LESSON_INFO
    generative_guidelines + "\n\n" + lesson_tutor_session_prompt + "\n\n" + lesson_info
  end

  private

  def create_conversation!(user)
    conversation = Conversation.create!(
      user: user,
      lesson_progress: self,
      title: lesson.title,
      # This prompt will contain all the information needed to conduct the lesson and evaluate the student
      task_system_prompt: build_task_system_prompt
    )

    Message.create!(
      conversation: conversation,
      role: :assistant,
      content: "Ready to begin?"
    )

    conversation
  end
end
</file>

<file path="app/models/message.rb">
class Message < ApplicationRecord
  include ActionView::RecordIdentifier

  self.implicit_order_column = "created_at" # just in case IDs get out of order somehow

  enum :role, { system: "system", assistant: "assistant", user: "user", tool: "tool" }, prefix: true

  belongs_to :conversation
  has_many :images, dependent: :destroy # Message content field contains text. Images are kept separately.
  has_many :audios, dependent: :destroy # Audio is kept separately.

  before_create :ensure_text_present

  # Include broadcast logic in the model, since it's an inherent property of Messages
  # that they will need to be viewed immediately and should always be kept up to date.
  after_create_commit -> { broadcast_created; check_context_limit }
  after_update_commit -> { broadcast_updated }
  after_destroy_commit -> { broadcast_destroyed }

  def broadcast_created
    return if role_tool? # Don't broadcast tool messages, as they are only shown to the LLM.
    Rails.logger.debug "Broadcasting created message: #{self.inspect}"
    # Remove any temporary new message placeholder
    broadcast_remove_to("#{dom_id(conversation)}", target: "new_message") if role_assistant?
    # broadcast_append_later_to seems to work without misordering messages, but keep it synchronous
    broadcast_append_to(
      "#{dom_id(conversation)}",
      partial: "messages/message",
      target: "#{dom_id(conversation)}",
      locals: { message: self }
    )
  end

  def broadcast_updated
    Rails.logger.debug "Broadcasting updated message: #{self.inspect}"
    # See https://github.com/hotwired/turbo-rails/issues/644
    # Replace only the message content using the inner_html of the rendered partial.
    html = ApplicationController.renderer_with_signed_in_user(conversation.user).render(partial: "messages/message_content", locals: { message: self })
    dom = Nokogiri::HTML.fragment(html)
    html = dom.at_css(":root").inner_html

    # Need to broadcast the updates at a rapid rate as they are streamed.
    # Broadcast_update_later_to uses Jobs that are processed out of order and message becomes janky and truncated.
    # Tried adding concurrency control, sped up solid_queue dispatcher to 100ms, and buffered the updates to 120ms -
    # this improved jank but still sometimes left the last chunk missing.
    # So we use broadcast_update_to instead. The rendering was already done, anyway, so it's not much more work to send the broadcast.
    broadcast_update_to(
      "#{dom_id(conversation)}",
      target: "#{dom_id(self)}_content",
      html: html
    )
  end

  def broadcast_destroyed
    Rails.logger.debug "Broadcasting destroyed message: #{self.inspect}"
    broadcast_remove_to("#{dom_id(conversation)}", target: dom_id(self))
    broadcast_remove_to("#{dom_id(conversation)}", target: "#{dom_id(self)}_buttons")
  end

  # Return content in JSON format with base64 images for LLM APIs.
  def content_with_images
    if images.empty?
      # OpenAI API accepts a string or array. Stick with the string for now.
      # return [{ "type": "text", "text": content }] if role_tool?
      # For other roles, just return the raw text string.
      return content
    end

    # If there are images, always return an array.
    content_json = [ { "type": "text", "text": content } ]
    images.each do |image|
      content_json << { "type": "image_url", "image_url": { "url": image.image_for_LLM } }
    end
    content_json
  end

  # Return content in JSON format with base64 images and audio for LLM APIs.
  def content_with_media
    base_content = content_with_images
    return base_content if audios.empty?

    if base_content.empty?
      # If base_content is empty, start with an empty array.
      content_json = []
    elsif base_content.is_a?(String)
      # If base_content is just a string (text only or empty), convert to array format since we'll be adding audio.
      content_json = [ { "type": "text", "text": base_content } ]
    else
      # Otherwise, it's already in the correct format.
      content_json = base_content
    end

    audios.each do |audio|
      audio_data = audio.base64_for_LLM
      content_json << { "type": "input_audio", "input_audio": audio_data } if audio_data
    end
    content_json
  end

  # Format messages for the LLM api
  def self.for_completion_with_media(messages:, audio: false)
    messages.map do |message|
      msg_hash = { role: message.role, content: audio ? message.content_with_media : message.content_with_images }
      msg_hash[:tool_call_id] = message.tool_call_id if message.role_tool? && message.respond_to?(:tool_call_id) && message.tool_call_id.present?
      msg_hash[:tool_calls] = message.tool_calls if message.role_assistant? && message.respond_to?(:tool_calls) && message.tool_calls.present?
      msg_hash
    end
  end

  private

  # Some LLM providers may not accept image-only messages.
  # Ensure that if there are images but no text or audio, we add some text.
  def ensure_text_present
    if content.blank? && audios.empty? && images.any?
      Rails.logger.info "Images with empty message content. Adding some text."
      self.content = "See image(s)."
    end
  end

  def check_context_limit
    return unless role_user? # Only run this check for user messages
    Rails.logger.debug "Checking context limit for message: #{self.inspect}"

    # Get the model's context limit
    llm = conversation.llm_in_use
    return unless llm
    context_limit = llm.context_length
    return unless context_limit # Skip if context limit is not set

    # Check the threshold (model's context limit - 64,000)
    threshold = context_limit - 64000

    if conversation.last_prompt_tokens > threshold
      Rails.logger.warn("Conversation #{conversation.id} is approaching the context limit: #{conversation.last_prompt_tokens} / #{threshold}")
      # Display the flash warning
      Turbo::StreamsChannel.broadcast_update_to(
        "#{dom_id(conversation)}",
        target: "flash_bar",
        partial: "shared/flash",
        locals: { flash: { warning: "The conversation is approaching the token limit. Please notify the teacher to switch to a model with a larger limit." } }
      )

      # Send email to teacher/admin
      Rails.logger.debug "Sending email to admin for conversation: #{conversation.id}"
      ContextLimitMailer.notify_admin(conversation).deliver_later
    end
  end
end
</file>

<file path="app/views/admin/llms/index.html.erb">
<div class="flex items-center justify-between mb-4">
