    </div>

    <div data-stt-settings-target="speechWrapper" class="">
      <%= f.label :stt_model, "STT model (Speech API)", class: "form-label" %>
      <%= f.text_field :stt_model,
            value: (@setting&.stt_method == "speech" ? @setting.stt_model : nil),
            class: "input-primary",
            placeholder: "gpt-4o-mini-transcribe",
            data: { stt_settings_target: "speechInput" } %>
      <p class="text-xs text-dim mt-1">OpenAI Speech API model</p>
    </div>

    <div data-stt-settings-target="chatWrapper" class="hidden">
      <%= f.label :stt_model_id, "LLM for transcriptions", class: "form-label" %>
      <% llms = Llm.list_selectable_audio_models %>
      <% groups = llms.group_by { |llm| (URI.parse(llm.api_provider).host rescue llm.api_provider) }.to_a %>
      <%= f.grouped_collection_select :stt_model_id,
            groups,
            :last,
            :first,
            :id,
            :model,
            { include_blank: "Select a model", selected: @setting&.stt_model_id },
            { class: "input-primary", data: { stt_settings_target: "chatInput" } } %>
