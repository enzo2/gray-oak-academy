              <sl-icon-button name="three-dots-vertical" label="Main Menu" slot="trigger" class="text-2xl"></sl-icon-button>
              <sl-menu>
                <sl-menu-item onclick="this.children[0].click"><a href="<%= root_path %>">Dashboard</a></sl-menu-item>
                <sl-menu-item onclick="this.children[0].click"><a href="<%= edit_user_registration_path %>">Settings</a></sl-menu-item>
