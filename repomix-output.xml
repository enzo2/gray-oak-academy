class Conversation < ApplicationRecord
  has_many :messages, -> { order(created_at: :asc) }, dependent: :destroy
  has_many :completions
  belongs_to :user
  belongs_to :lesson_progress, optional: true

  # Conversation stores the thread of messages, along with an optional task_system_prompt in a separate field.
  # The task_system_prompt should be specific to the type of conversation,
  # and should not include the app-wide system prompts, which are added in OpenAiApiService.

  scope :generic, -> { where(lesson_progress_id: nil) }
  scope :belongs_to_lesson, -> { where.not(lesson_progress_id: nil) }

  def last_prompt_tokens
    completions.last&.prompt_tokens || 0
  end

  # Returns the Llm model instance that will be used.
  # May return nil if the set LLM has never been used, as Llm is created only after the first completion or when verified by a superuser.
  def llm_in_use
    model = user.setting.llm_model_name.presence || ENV["DEFAULT_MODEL"]
    api = user.setting.llm_api_base_uri.presence || ENV["OPENAI_API_BASE_URL"]
    Llm.find_by(model: model, api_provider: api)
  end

  def llm_in_use_name
    llm_in_use&.model || user.setting.llm_model_name.presence || ENV["DEFAULT_MODEL"] || "No LLM set."
  end

  def audio_input_supported?
    llm_in_use&.supports_audio_input?
  end

  # The teacher sets whether raw audio message input is disabled, enabled, or "only" (audio forced, whether raw or STT).
  # This does not affect transcription, which is always available if the user has configured speech-to-text.
  # In the event the LLM does not support audio input, the audio recorder will fall back to transcription.
  def audio_setting
    if lesson_progress # for lesson conversations
      lesson_progress.lesson_plan.audio # Can be "disabled", "enabled", or "only"
    else # for generic conversations
      audio_input_supported? ? "enabled" : "disabled"
    end
  end

  # Check if the current LLM supports audio input, and the conversation is set to allow it.
  # This will determine whether the client posts to the audio endpoint or the transcription endpoint.
  def audio_input_permitted?
    audio_input_supported? && audio_setting != "disabled"
  end

  # Auto-read TTS function enabled by default for "only" audio setting
  def auto_read_default
    audio_setting == "only" && AppSetting.speech_configured? ? true : false
  end

  # Returns the percentage of the context limit used by the conversation.
  # Return 0 if no context length is available.
  def context_usage
    context_limit = llm_in_use&.context_length
    Rails.logger.debug "Context limit: #{context_limit}"
    return 0 unless context_limit
    last_prompt_tokens.to_f / context_limit.to_f * 100
  end
end
</file>

<file path="app/views/admin/resources/_form.html.erb">
<%= form_with(model: [:admin, resource], id: "resource-form", data: { controller: "embed-checker" }) do |form| %>
  <% if resource.errors.any? %>
    <div class="mb-4 text-red-950 dark:text-red-300" role="alert">
      <h2 class="font-bold mb-2"><%= pluralize(resource.errors.count, "error") %> prohibited this resource from being saved:</h2>
      <ul class="list-disc list-inside">
        <% resource.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%# If lesson_plan is present, include it so the resource can be linked %>
  <% if local_assigns[:lesson_plan] %>
    <%= form.hidden_field :lesson_plan_id, value: lesson_plan.id %>
  <% end %>

  <p class="text-sm text-dim mb-4">
    Resources allow you to add your own content to lessons.<br>
    They can include content displayable on the chalkboard by the LLM: <b>videos, websites, PDFs, images, applets</b>. (Other file types can be uploaded, and a download link will be shown.) <br>
    Or, you can include <b>only a description</b> to reference external resources available to the student, e.g. book, tool, workshop, demonstration, software, person.
  </p>

  <%# If this resource already has an associated persisted applet, lock category to "Applet" %>
  <% if resource.applet&.persisted? %>
    <div class="mb-4">
      <%= form.label :category, "Category", class: "form-label" %>
      Applet
      <%= form.hidden_field :category, value: "Applet" %>
    </div>
  <% else %>
    <div class="mb-4">
      <%= form.label :category, "Category (optional)", class: "form-label" %>
      <%= form.text_field :category, class: "input-primary", required: false %>
    </div>
  <% end %>

  <div class="mb-4">
    <%= form.label :description, class: "form-label" %>
    <%= form.text_area :description, rows: 4, class: "input-primary", required: true %>
  </div>

  <hr class="hr-primary mb-2">

  <% unless resource.applet&.persisted? %>
    <div class="mb-2">
      <%= form.label :uri, "URL (optional)", class: "form-label" %>
      <%= form.url_field :uri, class: "input-primary" %>
    </div>
    <p class="text-sm text-dim mb-4">Make sure the site or video supports embedding. For YouTube, use the embed link, e.g. https://www.youtube.com/embed/abc123....<br>
      Use this <sl-button outline size="small" data-action="click->embed-checker#openDialog">embed checker</sl-button> to verify.
    </p>
    <sl-dialog style="--width: 50vw;" data-embed-checker-target="dialog" label="Embed checker">
        <p>Make sure the site loads correctly. Many sites do not allow embedding.</p>
        <iframe width="100%" height="600px" style="border: 1px solid #ccc;" data-embed-checker-target="embedCheckerIframe"></iframe>
    </sl-dialog>

    <hr class="hr-primary mb-2">
  <% end %>

  <% unless resource.applet&.persisted? %>
    <div class="mb-4">
      <% if resource.file.attached? && resource.file.persisted? %>
        <%= form.label :file, "Current File", class: "form-label" %>
        <%= link_to resource.file.filename, rails_blob_path(resource.file, disposition: "attachment") %>
        <%= link_to delete_file_admin_resource_path(resource),
                    class: "inline-block",
                    data: {
                      turbo_method: :delete,
                      turbo_confirm: "Are you sure you want to delete this file?"
                    } do %>
          <sl-icon name="trash"></sl-icon>
        <% end %>
      <% else %>
        <%= form.label :file, "File (optional)", class: "form-label" %>
        <%= form.file_field :file, class: "input-primary" %>
      <% end %>
    </div>
    <hr class="hr-primary mb-2">
  <% end %>

  <div class="mb-4">
    <% applet = resource.applet || resource.build_applet(user: current_user) %>
    <%= form.fields_for :applet, applet do |applet_form| %>
      <%= applet_form.label :title, "Applet Title (for JavaScript applets)", class: "form-label" %>
      <%= applet_form.text_field :title, class: "input-primary mb-2" %>

      <%= applet_form.label :code, "Applet Code", class: "form-label" %>
      <%= applet_form.text_area :code, rows: 6, class: "input-primary font-mono text-xs", placeholder: "Due to special requirements, only use applets generated by LLM in this app." %>
      <p class="text-sm text-dim mt-1 ">
        <i>To generate compatible applets, have the LLM in this app write them, save the applet, and then convert them to a resource from the Applets dashboard.</i>
      </p>
      <hr class="hr-primary my-2">
    <% end %>
  </div>

  <div class="mb-4 flex items-center justify-start">
    <%= form.check_box :include_by_default, class: "mr-2 checkbox-primary" %>
    <%= form.label :include_by_default, "Include by default on new lesson plans", class: "form-label" %>
  </div>

  <div class="flex items-center justify-between mb-4">
    <%= form.submit class: "btn-primary" %>
  </div>
<% end %>
</file>

<file path="app/views/admin/students/_student_dashboard.html.erb">
<h2 class="text-xl font-semibold mb-4"><%= @student.name %></h2>

  <sl-tab-group id="student-dashboard-tabs" class="">
  <sl-tab slot="nav" panel="active_courses" <%= "active" if @active_tab == :active_courses %>>Active Courses</sl-tab>
  <sl-tab slot="nav" panel="past_courses" <%= "active" if @active_tab == :past_courses %>>Past Courses</sl-tab>
  <sl-tab slot="nav" panel="enroll" <%= "active" if @active_tab == :enroll %>>Add Course</sl-tab>
  <sl-tab slot="nav" panel="memories" <%= "active" if @active_tab == :memories %>>Memories</sl-tab>
  <sl-tab slot="nav" panel="applets" <%= "active" if @active_tab == :applets %>>Applets</sl-tab>
  <sl-tab slot="nav" panel="settings" <%= "active" if @active_tab == :settings %>>Settings</sl-tab>

  <sl-tab-panel name="active_courses" <%= "active" if @active_tab == :active_courses %>>
    <% if @active_enrollments.presence %>
      <%= render 'active_courses', enrollments: @active_enrollments %>
    <% else %>
      <p class="">This student is not currently enrolled in any courses.</p>
    <% end %>
  </sl-tab-panel>
  
  <sl-tab-panel name="past_courses" <%= "active" if @active_tab == :past_courses %>>
    <% if @completed_enrollments.presence %>
      <%= render 'completed_courses', enrollments: @completed_enrollments %>
    <% else %>
      <p class="">This student has not completed any courses.</p>
    <% end %>

    <% if @orphaned_reports.presence %>
      <br>
      <hr class="my-2">
      <h2 class="text-lg mb-2">Orphaned Reports</h2>
      <p>Student Reports from previously deleted lessons were found:</p>
        <sl-details summary="Show Orphaned Reports" class="my-1 max-w-3xl">
          <% @orphaned_reports.each do |student_report| %>
            <div class="bg-stone-300 dark:bg-stone-700 rounded-lg my-2 px-4 py-2 pl-4
                          prose dark:prose-invert prose-stone
                          max-w-2xl
                          prose-p:mb-0 leading-tight
                          prose-li:my-0  prose-ul:my-0
                          prose-ul:marker:text-stone-800 dark:prose-ul:marker:text-stone-100">
              <span class="mb-3"><i>Completed <%= student_report.created_at.strftime("%B %d, %Y") %></i>:</span>
              <%= markdown(student_report.to_markdown) %>
            </div>
          <% end %>
        </sl-details>
    <% end %>
  </sl-tab-panel>

  <sl-tab-panel name="enroll" <%= "active" if @active_tab == :enroll %>>
    <h3 class="text-lg">Enroll in a New Course</h3>
    <% available_courses = Course.available_for_enrollment(@student, current_user) %>
    <% if available_courses.any? %>
      <%= form_with url: enroll_admin_student_path(@student), method: :post, class: "mt-2 flex", data: { turbo_stream: true } do |form| %>
        <%= form.collection_select :course_id, available_courses, :id, :title,
          { prompt: "Select Course" }, { class: "form-select-primary" } %>
        <%= form.submit 'Enroll', class: "btn-primary ml-2" %>
      <% end %>
    <% else %>
      <p class="text-sm">No courses available for enrollment.</p>
    <% end %>
  </sl-tab-panel>

  <sl-tab-panel name="memories" <%= "active" if @active_tab == :memories %>>
    <h3 class="text-lg font-semibold">Memories</h3>

    <p class="text-sm text-stone-600 dark:text-stone-400 mb-4">
      Memories are anything the LLM should know about the student. <br>
      They will be learned automatically over time, but you should add some manually too.
    </p>

    <div class="mb-4">
      <%= render 'admin/memories/form', memory: Memory.new  %>
    </div>

    <div class="space-y-4" id="memories-list">
      <% if @memories.any? %>
        <%= render partial: "admin/memories/memory", collection: @memories %>
      <% else %>
        <p><i>No memories yet.</i></p>
      <% end %>
    </div>
  </sl-tab-panel>

  <sl-tab-panel name="applets" <%= "active" if @active_tab == :applets %>>
    <h2 class="text-lg mb-4">Applets</h2>
    <p class="mb-4 block">
      These are JavaScript applets the student has archived.
      <br>To re-use them in future lessons, convert to a Resource.
    </p>
    <%= render "applets/applets_table", applets: @student.applets %>
  </sl-tab-panel>

  <sl-tab-panel name="settings" <%= "active" if @active_tab == :settings %>>
    <h3 class="text-lg mb-4">Settings</h3>
      <% if @student.teacher == current_user %>
        <p class="text-sm text-dim mb-1">You can release the student so that another teacher can adopt them.</p>
        <%= button_to 'Release student', unadopt_admin_student_path(@student), 
          method: :delete, 
          data: { turbo_confirm: 'This will remove the student from your list. Are you sure?' }, 
          class: "btn-danger text-sm" %>
      <% end %>
      
      <% if current_user.role_superuser? && current_user != @student %>
        <details class="mt-4">
          <summary class="cursor-pointer text-red-600 font-bold">Danger Zone</summary>
          <%= button_to 'DELETE STUDENT ACCOUNT', admin_student_path(@student),
              method: :delete,
              data: { turbo_confirm: 'THIS CANNOT BE UNDONE. ALL STUDENT DATA WILL BE LOST. YOU SHOULD ONLY REMOVE ACCOUNTS CREATED IN ERROR. CONTINUE?' },
              class: "btn-danger text-sm mt-2 block"%>
        </details>
      <% elsif !current_user.role_superuser? && current_user != @student %>
          <p class="text-sm text-dim">Only a superuser can delete student accounts.</p>
      <% elsif current_user == @student %>
        <p class="text-sm text-dim">There are no student settings, since you are a looking at your own account.</p>
      <% end %>
  </sl-tab-panel>
</sl-tab-group>
</file>

