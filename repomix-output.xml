        </div>

        <div class="mb-6">
          <%= f.submit "Update", class: "btn-primary" %>
        </div>
      <% end %>

      <hr class="hr-primary">

      <div class="mb-4 mx-auto">
        <h3 class="text-lg font-bold mb-2 mt-6">Delete my account</h3>

        <%#= button_to "Delete my account", registration_path(resource_name), 
          data: { confirm: "Are you sure?", turbo_confirm: "Are you sure?" }, 
          method: :delete, class: "btn-danger w-48" %>

        <% if current_user.role_superuser? %>
          <p class="mb-2 text-dim">You are a superuser. If you really need to delete your account, use the console.</p>
        <% else %>
          <p class="mb-2 text-dim">You must ask the administrator to delete your account.</p>
        <% end %>
      </div>

    </sl-tab-panel>
  </sl-tab-group>
</main>
</file>

<file path="app/views/lessons/_chalkboard_markdown.html.erb">
<div class="chalkboard-markdown prose dark:prose-invert max-w-none p-4">
  <%= markdown do %>
    <%# Plain-text markdown partial for chalkboard rendering. Expects a local `lesson` variable. %>
    <% lp = lesson.lesson_plan %>
    # <%= lesson.title %>

    **Goals:** <%= lesson.goals %>
    **Duration:** <%= lesson.approx_duration_min %> minutes

    <% if lp && lp.content.present? %>
    ## Lesson Plan
    <% lp.content.each do |item| %>
    - **<%= h(item.keys.first || "Item") %>**: <%= item.values.first.to_s.strip.gsub(/\r\n?/, "\n").gsub(/\n+/, "\n\n") %>
    <% end %>
    <% else %>
    _No lesson plan content available._
    <% end %>

    <% if lp && lp.suggested_resources.present? %>
    ## Suggested Resources
    <% lp.suggested_resources.each do |res| %>
    - **<%= h(res.keys.first || "Resource") %>**: <%= res.values.first.to_s %>
    <% end %>
    <% end %>

    <%# Linked resources associated with the lesson plan (explicit resource records) %>
    <% if lp && lp.resources.any? %>
      ## Linked Resources
      <% lp.resources.each do |r| %>
        - <%# Show category/description and available identifier/uri/file info %>
          **<%= h(r.category.presence || "Resource") %>**:
        <% if r.uri.present? %>
          URI: <%= r.uri %>
        <% end %>
        <% if r.file.attached? %>
          File: <%= r.file.filename.to_s %> (resource id: <%= r.id %>)
        <% end %>
        <% if r.description.present? %>
          Description: <%= r.description %>
        <% end %>
      <% end %>
    <% else %>
      _No linked resources for this lesson._
    <% end %>

    <% if lp %> **Audio setting:** <%= lp.audio %> <% end %>

    <% if lp && lp.chalkboard_enabled == false %>
    _Note: Chalkboard disabled for this lesson plan._
    <% end %>

  <% end %>
</div>
</file>

