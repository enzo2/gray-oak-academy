<file path="bin/docker-entrypoint">
#!/bin/bash -e

# Enable jemalloc for reduced memory usage and latency.
if [ -z "${LD_PRELOAD+x}" ]; then
    LD_PRELOAD=$(find /usr/lib -name libjemalloc.so.2 -print -quit)
    export LD_PRELOAD
fi

# Automatically set up the credentials file, if it doesn't exist.
# This will add the secret_key_base and ActiveRecord encryption keys to the credentials file.
bundle exec rake credentials:setup

prepare_database() {
  ./bin/rails db:prepare
}

# If running the rails server through either rails or thrust, prepare the database
case "$1" in
  "./bin/thrust")
    if [ "$2" == "./bin/rails" ] && [ "$3" == "server" ]; then
      prepare_database
    fi
    ;;
  "./bin/rails")
    if [ "$2" == "server" ]; then
      prepare_database
    fi
    ;;
esac

# Always run seeds, since we need to make sure all prompts and tools are present
./bin/rails db:seed

exec "${@}"
</file>

