<file path="app/views/admin/courses/_form.html.erb">
<%= form_with(model: [:admin, course], id: "course-form") do |f| %>
  <% if course.errors.any? %>
    <div class="mb-4 text-red-950 dark:text-red-300">
      <%= pluralize(course.errors.count, "error") %> prevented this course from being saved.
      <ul>
        <% course.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-4">
    <%= f.label :title, class: "form-label" %>
    <%= f.text_field :title, class: "input-primary", required: true %>
  </div>

  <div class="mb-4">
    <%= f.label :summary, class: "form-label" %>
    <p class="block text-sm mb-2"><i>Briefly describe the course goals.</i></p>
    <%= f.text_area :summary, class: "input-primary", required: true %>
  </div>

  <div class="mb-2">
    <%= f.label :grade_level, class: "form-label" %>
    <%= f.text_field :grade_level, class: "input-primary", required: true %>
  </div>
  <p class="text-sm mb-4"><i>Hint: The grade level is useful for tuning the LLM's behavior. It doesn't have the be the exact grade level of the student.</i></p>

  <div class="mb-4" data-controller="outline" data-outline-target="fieldContainer">
    <%= f.label :outline, "Course Outline", class: "form-label" %>
    <p class="block text-sm mb-2">   
      <i>
        <% if course.outline.empty? %>To have the LLM draft the course outline, leave it blank for now.<br><% end %>   
        The outline will be used by the LLM to generate the list of lessons. Include any desired content.
      </i>
    </p>

    <% if course.outline.any? %>
      <% course.outline.each do |item| %>
        <div class="flex items-center mb-2 space-x-2">
          <%= text_field_tag "course[outline_topics][]", item.keys.first, placeholder: "Topic", class: "input-primary w-1/4 py-1" %>
          <%= text_field_tag "course[outline_details][]", item.values.first, placeholder: "Details", class: "input-primary w-3/4 py-1" %>
          <sl-icon-button name="arrow-up" class="move-up" data-action="click->outline#moveUp"></sl-icon-button>
          <sl-icon-button name="arrow-down" class="move-down" data-action="click->outline#moveDown"></sl-icon-button>
          <sl-icon-button name="x-circle" class="remove-field" data-action="click->outline#removeField"></sl-icon-button>
        </div>
      <% end %>
    <% end %>
    <sl-button class="mb-2" data-action="click->outline#addField" outline>
      <sl-icon slot="prefix" name="plus-circle"></sl-icon>
      Add outline item
    </sl-button>
    <template>
      <div class="flex items-center mb-2 space-x-2">
        <%= text_field_tag "course[outline_topics][]", "", placeholder: "Topic", class: "input-primary w-1/4 py-1", required: true %>
        <%= text_field_tag "course[outline_details][]", "", placeholder: "Details", class: "input-primary w-3/4 py-1", required: true %>
        <sl-icon-button name="arrow-up" class="move-up" data-action="click->outline#moveUp"></sl-icon-button>
        <sl-icon-button name="arrow-down" class="move-down" data-action="click->outline#moveDown"></sl-icon-button>
        <sl-icon-button name="x-circle" class="remove-field" data-action="click->outline#removeField"></sl-icon-button>
      </div>
    </template>
  </div>

  <div class="flex flex-row space-x-5">
    <%= f.submit "Save", class: "btn-primary" %>
    <%= link_to "Cancel", admin_courses_path, class: "btn-primary" %>
  </div>
<% end %>
</file>

