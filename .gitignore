# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# Temporary files generated by your text editor or operating system
# belong in git's global ignore instead:
# `$XDG_CONFIG_HOME/git/ignore` or `~/.config/git/ignore`
#################################################################

# For any private or local files.
/private

/.claude/settings.local.json
kickbacks.vsix

# Ignore bundler config.
/.bundle

# Ignore all environment files
.env
.env.production
.env.development

# Ignore all logfiles and tempfiles.
*.tmp
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep

# Ignore build artifacts
/public/assets
/app/assets/builds/*
!/app/assets/builds/.keep

# Ignore self-signed SSL certificates, these are auto-generated
/config/certs

# Ignore master keys
# For production, you should use the `RAILS_MASTER_KEY` environment variable
# For development, key is created by `bin/setup` and should not be checked in
/config/*.key
/config/credentials/*.key

# Ignore local encrypted credentials, but keep the encrypted production
# credentials in source control. The production master key remains external.
*.enc
/config/*.enc
/config/credentials/*.enc
!/config/credentials/production.yml.enc
