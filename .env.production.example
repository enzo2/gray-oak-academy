RAILS_MASTER_KEY=[your key, 32 alphanumeric characters]
APP_NAME=Gray Oak Academy  #Can be personalized
APP_HOST=localhost  #Your domain
WEBMASTER_EMAIL_ADDRESS=webmaster@example.com
SMTP_ADDRESS=[your SMTP server URL]
SMTP_PORT=587
SMTP_USER=[your username]
SMTP_PASSWORD=[your pw]
TEACHER_SIGNUP_CODE=[your code]  #Set your own code here
STUDENT_SIGNUP_CODE=[your code] #Set your own code here
ALLOW_SIGNUPS=false  # true enables new user registrations using the signup code

# Optional:
# Ensure your environment is secure before adding an API key!
# They can also be added on a per-teacher basis in user settings.
OPENAI_API_BASE_URL=https://openrouter.ai/api/v1/ #Any OpenAI-compatible API (OpenRouter enables extra features)
OPENAI_API_KEY=[your token] #Not just for OpenAI platform; supports OpenAI-compatible APIs. By default OpenRouter.
DEFAULT_MODEL=google/gemini-3-flash-preview #Can be overridden in user settings
