#Ensure your environment is secure before adding API keys!
#
APP_NAME=Gray Oak Academy  #Can be personalized
APP_HOST=[your domain]
WEBMASTER_EMAIL_ADDRESS=webmaster@example.com
SMTP_ADDRESS=[your SMTP server URL]
SMTP_PORT=587
SMTP_USER=[your username]
SMTP_PASSWORD=[your pw]
TEACHER_SIGNUP_CODE=123456  #Set your own code here
OPENAI_API_BASE_URI=https://openrouter.ai/api  #OpenRouter by default
DEFAULT_MODEL=anthropic/claude-3.5-sonnet:beta #Can be overridden in user settings; consider leaving a free model as default
OPENAI_API_KEY=[your token] #Not just for OpenAI platform; supports OpenAI-compatible APIs. By default OpenRouter.