#!/bin/bash -e

# Enable jemalloc for reduced memory usage and latency.
if [ -z "${LD_PRELOAD+x}" ]; then
    LD_PRELOAD=$(find /usr/lib -name libjemalloc.so.2 -print -quit)
    export LD_PRELOAD
fi

prepare_database() {
  ./bin/rails db:prepare
}

# If running the rails server through either rails or thrust, prepare the database
case "$1" in
  "./bin/thrust")
    if [ "$2" == "./bin/rails" ] && [ "$3" == "server" ]; then
      prepare_database
    fi
    ;;
  "./bin/rails")
    if [ "$2" == "server" ]; then
      prepare_database
    fi
    ;;
esac

# Always run seeds, since we need to make sure all prompts and tools are present
./bin/rails db:seed

exec "${@}"
