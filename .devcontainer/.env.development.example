
RAILS_ENV=development
APP_NAME=Gray Oak Academy  #Can be personalized
TEACHER_SIGNUP_CODE=123456  #Set your own code here
OPENAI_API_BASE_URI=https://openrouter.ai/api/v1/  #OpenAI-compatible APIs -- OpenRouter by default.
DEFAULT_MODEL=google/gemini-2.0-flash-001 #Can be overridden in user settings; consider leaving a cheap/free model as default
#Ensure your environment is secure before adding API keys!
OPENAI_API_KEY=[your token] #Not just for OpenAI platform; supports OpenAI-compatible APIs. By default OpenRouter.

#Set up mail, if you like
WEBMASTER_EMAIL_ADDRESS=webmaster@example.com
SMTP_ADDRESS=smtp.example.com
SMTP_PORT=587
SMTP_USER=username
SMTP_PASSWORD=password
