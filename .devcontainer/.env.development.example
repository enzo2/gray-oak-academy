
RAILS_ENV=development
APP_NAME=Gray Oak Academy  #Can be personalized
APP_HOST=localhost
TEACHER_SIGNUP_CODE=123456  #Set your own code here
STUDENT_SIGNUP_CODE=123456  #Set your own code here
ALLOW_SIGNUPS=true  # true enables new user registrations using the signup code
OPENAI_API_BASE_URL=https://openrouter.ai/api/v1/  #OpenAI-compatible APIs -- OpenRouter by default.
DEFAULT_MODEL=google/gemini-2.5-flash-preview-09-2025 #Can be overridden in user settings; consider leaving an inexpensive model as default
#Ensure your environment is secure before adding API keys!
OPENAI_API_KEY=[your token] #Not just for OpenAI platform; supports OpenAI-compatible APIs. By default OpenRouter.

#Set up mail, if you like
WEBMASTER_EMAIL_ADDRESS=webmaster@example.com
SMTP_ADDRESS=smtp.example.com
SMTP_PORT=587
SMTP_USER=username
SMTP_PASSWORD=password
